      withLabelsMixin(labels): { spec+: { forProvider+: { labels+: labels } } },
      '#withPhysicalBlockSizeBytes':: d.fn(help="\"Physical block size of the persistent disk, in bytes. If not present in a request, a default value is used. Currently supported sizes are 4096 and 16384, other sizes may be added in the future. If an unsupported value is requested, the error message will list the supported values for the caller's project.\"", args=[d.arg(name='physicalBlockSizeBytes', type=d.T.number)]),
      withPhysicalBlockSizeBytes(physicalBlockSizeBytes): { spec+: { forProvider+: { physicalBlockSizeBytes: physicalBlockSizeBytes } } },
