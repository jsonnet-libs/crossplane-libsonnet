      withProvisionedIops(provisionedIops): { spec+: { forProvider+: { provisionedIops: provisionedIops } } },
      '#withSize':: d.fn(help='"Size of the persistent disk, specified in GB. You can specify this field when creating a persistent disk using the image or snapshot parameter, or specify it alone to create an empty persistent disk. If you specify this field along with image or snapshot, the value must not be less than the size of the image or the size of the snapshot. You can add lifecycle.prevent_destroy in the config to prevent destroying and recreating."', args=[d.arg(name='size', type=d.T.number)]),
      withSize(size): { spec+: { forProvider+: { size: size } } },
