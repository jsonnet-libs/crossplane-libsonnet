  '#spec':: d.obj(help='"DiskSpec defines the desired state of Disk"'),
  spec: {
    '#forProvider':: d.obj(help=''),
    forProvider: {
      '#diskEncryptionKey':: d.obj(help='"Encrypts the disk using a customer-supplied encryption key. After you encrypt a disk with a customer-supplied key, you must provide the same key if you use the disk later (e.g. to create a disk snapshot or an image, or to attach the disk to a virtual machine). Customer-supplied encryption keys do not protect access to metadata of the disk. If you do not provide an encryption key when creating the disk, then the disk will be encrypted using an automatically generated key and you do not need to provide a key to use the disk later. Structure is documented below."'),
      diskEncryptionKey: {
        '#rawKeySecretRef':: d.obj(help='"Specifies a 256-bit customer-supplied encryption key, encoded in RFC 4648 base64 to either encrypt or decrypt this resource. Note: This property is sensitive and will not be displayed in the plan."'),
        rawKeySecretRef: {
          '#withKey':: d.fn(help='"The key to select."', args=[d.arg(name='key', type=d.T.string)]),
          withKey(key): { rawKeySecretRef+: { key: key } },
          '#withName':: d.fn(help='"Name of the secret."', args=[d.arg(name='name', type=d.T.string)]),
          withName(name): { rawKeySecretRef+: { name: name } },
          '#withNamespace':: d.fn(help='"Namespace of the secret."', args=[d.arg(name='namespace', type=d.T.string)]),
          withNamespace(namespace): { rawKeySecretRef+: { namespace: namespace } },
        },
        '#withKmsKeySelfLink':: d.fn(help="\"The self link of the encryption key used to encrypt the disk. Also called KmsKeyName in the cloud console. Your project's Compute Engine System service account (service-{{PROJECT_NUMBER}}@compute-system.iam.gserviceaccount.com) must have roles/cloudkms.cryptoKeyEncrypterDecrypter to use this feature. See https://cloud.google.com/compute/docs/disks/customer-managed-encryption#encrypt_a_new_persistent_disk_with_your_own_keys\"", args=[d.arg(name='kmsKeySelfLink', type=d.T.string)]),
        withKmsKeySelfLink(kmsKeySelfLink): { kmsKeySelfLink: kmsKeySelfLink },
        '#withKmsKeyServiceAccount':: d.fn(help='"The service account used for the encryption request for the given KMS key. If absent, the Compute Engine Service Agent service account is used."', args=[d.arg(name='kmsKeyServiceAccount', type=d.T.string)]),
        withKmsKeyServiceAccount(kmsKeyServiceAccount): { kmsKeyServiceAccount: kmsKeyServiceAccount },
      },
      '#sourceImageEncryptionKey':: d.obj(help='"The customer-supplied encryption key of the source image. Required if the source image is protected by a customer-supplied encryption key. Structure is documented below."'),
      sourceImageEncryptionKey: {
        '#withKmsKeySelfLink':: d.fn(help="\"The self link of the encryption key used to encrypt the disk. Also called KmsKeyName in the cloud console. Your project's Compute Engine System service account (service-{{PROJECT_NUMBER}}@compute-system.iam.gserviceaccount.com) must have roles/cloudkms.cryptoKeyEncrypterDecrypter to use this feature. See https://cloud.google.com/compute/docs/disks/customer-managed-encryption#encrypt_a_new_persistent_disk_with_your_own_keys\"", args=[d.arg(name='kmsKeySelfLink', type=d.T.string)]),
        withKmsKeySelfLink(kmsKeySelfLink): { kmsKeySelfLink: kmsKeySelfLink },
        '#withKmsKeyServiceAccount':: d.fn(help='"The service account used for the encryption request for the given KMS key. If absent, the Compute Engine Service Agent service account is used."', args=[d.arg(name='kmsKeyServiceAccount', type=d.T.string)]),
        withKmsKeyServiceAccount(kmsKeyServiceAccount): { kmsKeyServiceAccount: kmsKeyServiceAccount },
        '#withRawKey':: d.fn(help='"Specifies a 256-bit customer-supplied encryption key, encoded in RFC 4648 base64 to either encrypt or decrypt this resource."', args=[d.arg(name='rawKey', type=d.T.string)]),
        withRawKey(rawKey): { rawKey: rawKey },
