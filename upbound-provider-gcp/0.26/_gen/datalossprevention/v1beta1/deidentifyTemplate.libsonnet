              withCharacterMaskConfig(characterMaskConfig): { characterMaskConfig: if std.isArray(v=characterMaskConfig) then characterMaskConfig else [characterMaskConfig] },
              '#withCharacterMaskConfigMixin':: d.fn(help='"Partially mask a string by replacing a given number of characters with a fixed character. Masking can start from the beginning or end of the string. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='characterMaskConfig', type=d.T.array)]),
              withCharacterMaskConfigMixin(characterMaskConfig): { characterMaskConfig+: if std.isArray(v=characterMaskConfig) then characterMaskConfig else [characterMaskConfig] },
              '#withCryptoDeterministicConfig':: d.fn(help='"Pseudonymization method that generates deterministic encryption for the given input. Outputs a base64 encoded representation of the encrypted output. Uses AES-SIV based on the RFC https://tools.ietf.org/html/rfc5297. Structure is documented below."', args=[d.arg(name='cryptoDeterministicConfig', type=d.T.array)]),
              withCryptoDeterministicConfig(cryptoDeterministicConfig): { cryptoDeterministicConfig: if std.isArray(v=cryptoDeterministicConfig) then cryptoDeterministicConfig else [cryptoDeterministicConfig] },
              '#withCryptoDeterministicConfigMixin':: d.fn(help='"Pseudonymization method that generates deterministic encryption for the given input. Outputs a base64 encoded representation of the encrypted output. Uses AES-SIV based on the RFC https://tools.ietf.org/html/rfc5297. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='cryptoDeterministicConfig', type=d.T.array)]),
              withCryptoDeterministicConfigMixin(cryptoDeterministicConfig): { cryptoDeterministicConfig+: if std.isArray(v=cryptoDeterministicConfig) then cryptoDeterministicConfig else [cryptoDeterministicConfig] },
              '#withCryptoReplaceFfxFpeConfig':: d.fn(help='"Replaces an identifier with a surrogate using Format Preserving Encryption (FPE) with the FFX mode of operation; however when used in the content.reidentify API method, it serves the opposite function by reversing the surrogate back into the original identifier. The identifier must be encoded as ASCII. For a given crypto key and context, the same identifier will be replaced with the same surrogate. Identifiers must be at least two characters long. In the case that the identifier is the empty string, it will be skipped. See https://cloud.google.com/dlp/docs/pseudonymization to learn more. Note: We recommend using CryptoDeterministicConfig for all use cases which do not require preserving the input alphabet space and size, plus warrant referential integrity. Structure is documented below."', args=[d.arg(name='cryptoReplaceFfxFpeConfig', type=d.T.array)]),
              withCryptoReplaceFfxFpeConfig(cryptoReplaceFfxFpeConfig): { cryptoReplaceFfxFpeConfig: if std.isArray(v=cryptoReplaceFfxFpeConfig) then cryptoReplaceFfxFpeConfig else [cryptoReplaceFfxFpeConfig] },
