              '#withReplaceConfigMixin':: d.fn(help='"Replace each input value with a given value. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='replaceConfig', type=d.T.array)]),
              withReplaceConfigMixin(replaceConfig): { replaceConfig+: if std.isArray(v=replaceConfig) then replaceConfig else [replaceConfig] },
