                  '#withKmsWrappedMixin':: d.fn(help='"Kms wrapped key Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='kmsWrapped', type=d.T.array)]),
                  withKmsWrappedMixin(kmsWrapped): { kmsWrapped+: if std.isArray(v=kmsWrapped) then kmsWrapped else [kmsWrapped] },
                  '#withTransient':: d.fn(help='"Transient crypto key Structure is documented below."', args=[d.arg(name='transient', type=d.T.array)]),
                  withTransient(transient): { transient: if std.isArray(v=transient) then transient else [transient] },
                  '#withTransientMixin':: d.fn(help='"Transient crypto key Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='transient', type=d.T.array)]),
                  withTransientMixin(transient): { transient+: if std.isArray(v=transient) then transient else [transient] },
                  '#withUnwrapped':: d.fn(help='"Unwrapped crypto key Structure is documented below."', args=[d.arg(name='unwrapped', type=d.T.array)]),
                  withUnwrapped(unwrapped): { unwrapped: if std.isArray(v=unwrapped) then unwrapped else [unwrapped] },
                  '#withUnwrappedMixin':: d.fn(help='"Unwrapped crypto key Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='unwrapped', type=d.T.array)]),
                  withUnwrappedMixin(unwrapped): { unwrapped+: if std.isArray(v=unwrapped) then unwrapped else [unwrapped] },
                },
                '#surrogateInfoType':: d.obj(help="\"The custom infoType to annotate the surrogate with. This annotation will be applied to the surrogate by prefixing it with the name of the custom infoType followed by the number of characters comprising the surrogate. The following scheme defines the format: info_type_name(surrogate_character_count):surrogate For example, if the name of custom infoType is 'MY_TOKEN_INFO_TYPE' and the surrogate is 'abc', the full replacement value will be: 'MY_TOKEN_INFO_TYPE(3):abc' This annotation identifies the surrogate when inspecting content using the custom infoType SurrogateType. This facilitates reversal of the surrogate when it occurs in free text. In order for inspection to work properly, the name of this infoType must not occur naturally anywhere in your data; otherwise, inspection may find a surrogate that does not correspond to an actual identifier. Therefore, choose your custom infoType name carefully after considering what your data looks like. One way to select a name that has a high chance of yielding reliable detection is to include one or more unicode characters that are highly improbable to exist in your data. For example, assuming your data is entered from a regular ASCII keyboard, the symbol with the hex code point 29DD might be used like so: ⧝MY_TOKEN_TYPE Structure is documented below.\""),
                surrogateInfoType: {
                  '#withName':: d.fn(help='"Name of the key. This is an arbitrary string used to differentiate different keys. A unique key is generated per name: two separate TransientCryptoKey protos share the same generated key if their names are the same. When the data crypto key is generated, this name is not used in any way (repeating the api call will result in a different key being generated)."', args=[d.arg(name='name', type=d.T.string)]),
                  withName(name): { name: name },
                },
                '#withCommonAlphabet':: d.fn(help='"Common alphabets. Possible values are FFX_COMMON_NATIVE_ALPHABET_UNSPECIFIED, NUMERIC, HEXADECIMAL, UPPER_CASE_ALPHA_NUMERIC, and ALPHA_NUMERIC."', args=[d.arg(name='commonAlphabet', type=d.T.string)]),
                withCommonAlphabet(commonAlphabet): { commonAlphabet: commonAlphabet },
                '#withContext':: d.fn(help="\"The 'tweak', a context may be used for higher security since the same identifier in two different contexts won't be given the same surrogate. If the context is not set, a default tweak will be used. If the context is set but:\"", args=[d.arg(name='context', type=d.T.array)]),
                withContext(context): { context: if std.isArray(v=context) then context else [context] },
                '#withContextMixin':: d.fn(help="\"The 'tweak', a context may be used for higher security since the same identifier in two different contexts won't be given the same surrogate. If the context is not set, a default tweak will be used. If the context is set but:\"\n\n**Note:** This function appends passed data to existing values", args=[d.arg(name='context', type=d.T.array)]),
                withContextMixin(context): { context+: if std.isArray(v=context) then context else [context] },
                '#withCryptoKey':: d.fn(help='"The key used by the encryption algorithm. Structure is documented below."', args=[d.arg(name='cryptoKey', type=d.T.array)]),
                withCryptoKey(cryptoKey): { cryptoKey: if std.isArray(v=cryptoKey) then cryptoKey else [cryptoKey] },
                '#withCryptoKeyMixin':: d.fn(help='"The key used by the encryption algorithm. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='cryptoKey', type=d.T.array)]),
                withCryptoKeyMixin(cryptoKey): { cryptoKey+: if std.isArray(v=cryptoKey) then cryptoKey else [cryptoKey] },
                '#withCustomAlphabet':: d.fn(help="\"This is supported by mapping these to the alphanumeric characters that the FFX mode natively supports. This happens before/after encryption/decryption. Each character listed must appear only once. Number of characters must be in the range [2, 95]. This must be encoded as ASCII. The order of characters does not matter. The full list of allowed characters is: 0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz ~`!@#$%^\u0026*()_-+={[}]|:;\\\"'\u003c,\u003e.?/\"", args=[d.arg(name='customAlphabet', type=d.T.string)]),
                withCustomAlphabet(customAlphabet): { customAlphabet: customAlphabet },
                '#withRadix':: d.fn(help='"The native way to select the alphabet. Must be in the range [2, 95]."', args=[d.arg(name='radix', type=d.T.number)]),
                withRadix(radix): { radix: radix },
                '#withSurrogateInfoType':: d.fn(help="\"The custom infoType to annotate the surrogate with. This annotation will be applied to the surrogate by prefixing it with the name of the custom infoType followed by the number of characters comprising the surrogate. The following scheme defines the format: info_type_name(surrogate_character_count):surrogate For example, if the name of custom infoType is 'MY_TOKEN_INFO_TYPE' and the surrogate is 'abc', the full replacement value will be: 'MY_TOKEN_INFO_TYPE(3):abc' This annotation identifies the surrogate when inspecting content using the custom infoType SurrogateType. This facilitates reversal of the surrogate when it occurs in free text. In order for inspection to work properly, the name of this infoType must not occur naturally anywhere in your data; otherwise, inspection may find a surrogate that does not correspond to an actual identifier. Therefore, choose your custom infoType name carefully after considering what your data looks like. One way to select a name that has a high chance of yielding reliable detection is to include one or more unicode characters that are highly improbable to exist in your data. For example, assuming your data is entered from a regular ASCII keyboard, the symbol with the hex code point 29DD might be used like so: ⧝MY_TOKEN_TYPE Structure is documented below.\"", args=[d.arg(name='surrogateInfoType', type=d.T.array)]),
                withSurrogateInfoType(surrogateInfoType): { surrogateInfoType: if std.isArray(v=surrogateInfoType) then surrogateInfoType else [surrogateInfoType] },
                '#withSurrogateInfoTypeMixin':: d.fn(help="\"The custom infoType to annotate the surrogate with. This annotation will be applied to the surrogate by prefixing it with the name of the custom infoType followed by the number of characters comprising the surrogate. The following scheme defines the format: info_type_name(surrogate_character_count):surrogate For example, if the name of custom infoType is 'MY_TOKEN_INFO_TYPE' and the surrogate is 'abc', the full replacement value will be: 'MY_TOKEN_INFO_TYPE(3):abc' This annotation identifies the surrogate when inspecting content using the custom infoType SurrogateType. This facilitates reversal of the surrogate when it occurs in free text. In order for inspection to work properly, the name of this infoType must not occur naturally anywhere in your data; otherwise, inspection may find a surrogate that does not correspond to an actual identifier. Therefore, choose your custom infoType name carefully after considering what your data looks like. One way to select a name that has a high chance of yielding reliable detection is to include one or more unicode characters that are highly improbable to exist in your data. For example, assuming your data is entered from a regular ASCII keyboard, the symbol with the hex code point 29DD might be used like so: ⧝MY_TOKEN_TYPE Structure is documented below.\"\n\n**Note:** This function appends passed data to existing values", args=[d.arg(name='surrogateInfoType', type=d.T.array)]),
                withSurrogateInfoTypeMixin(surrogateInfoType): { surrogateInfoType+: if std.isArray(v=surrogateInfoType) then surrogateInfoType else [surrogateInfoType] },
              },
