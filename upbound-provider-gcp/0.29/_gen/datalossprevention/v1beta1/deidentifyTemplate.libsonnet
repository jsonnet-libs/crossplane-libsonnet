                withCommonAlphabet(commonAlphabet): { commonAlphabet: commonAlphabet },
                '#withContext':: d.fn(help='"Points to the field that contains the context, for example, an entity id. If set, must also set cryptoKey. If set, shift will be consistent for the given context. Structure is documented below."', args=[d.arg(name='context', type=d.T.array)]),
                withContext(context): { context: if std.isArray(v=context) then context else [context] },
                '#withContextMixin':: d.fn(help='"Points to the field that contains the context, for example, an entity id. If set, must also set cryptoKey. If set, shift will be consistent for the given context. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='context', type=d.T.array)]),
                withContextMixin(context): { context+: if std.isArray(v=context) then context else [context] },
                '#withCryptoKey':: d.fn(help='"Causes the shift to be computed based on this key and the context. This results in the same shift for the same context and cryptoKey. If set, must also set context. Can only be applied to table items. Structure is documented below."', args=[d.arg(name='cryptoKey', type=d.T.array)]),
                withCryptoKey(cryptoKey): { cryptoKey: if std.isArray(v=cryptoKey) then cryptoKey else [cryptoKey] },
