                withCryptoKeyMixin(cryptoKey): { cryptoKey+: if std.isArray(v=cryptoKey) then cryptoKey else [cryptoKey] },
                '#withCustomAlphabet':: d.fn(help="\"This is supported by mapping these to the alphanumeric characters that the FFX mode natively supports. This happens before/after encryption/decryption. Each character listed must appear only once. Number of characters must be in the range [2, 95]. This must be encoded as ASCII. The order of characters does not matter. The full list of allowed characters is: 0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz ~`!@#$%^\u0026*()_-+={[}]|:;\\\"'\u003c,\u003e.?/\"", args=[d.arg(name='customAlphabet', type=d.T.string)]),
                withCustomAlphabet(customAlphabet): { customAlphabet: customAlphabet },
