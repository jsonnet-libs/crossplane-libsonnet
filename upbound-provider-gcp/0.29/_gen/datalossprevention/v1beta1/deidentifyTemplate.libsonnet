              withCharacterMaskConfigMixin(characterMaskConfig): { characterMaskConfig+: if std.isArray(v=characterMaskConfig) then characterMaskConfig else [characterMaskConfig] },
              '#withCryptoDeterministicConfig':: d.fn(help='"Pseudonymization method that generates deterministic encryption for the given input. Outputs a base64 encoded representation of the encrypted output. Uses AES-SIV based on the RFC https://tools.ietf.org/html/rfc5297. Structure is documented below."', args=[d.arg(name='cryptoDeterministicConfig', type=d.T.array)]),
