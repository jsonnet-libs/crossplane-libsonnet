        '#recordTransformations':: d.obj(help='"Treat the dataset as structured. Transformations can be applied to specific locations within structured datasets, such as transforming a column within a table. Structure is documented below."'),
        recordTransformations: {
          '#fieldTransformations':: d.obj(help='"Transform the record by applying various field transformations. Structure is documented below."'),
          fieldTransformations: {
            '#condition':: d.obj(help='"A condition that when it evaluates to true will result in the record being evaluated to be suppressed from the transformed content. Structure is documented below."'),
            condition: {
              '#expressions':: d.obj(help='"An expression, consisting of an operator and conditions. Structure is documented below."'),
              expressions: {
                '#conditions':: d.obj(help='"Conditions to apply to the expression. Structure is documented below."'),
                conditions: {
                  '#conditions':: d.obj(help='"Conditions to apply to the expression. Structure is documented below."'),
                  conditions: {
                    '#field':: d.obj(help='"Field within the record this condition is evaluated against. Structure is documented below."'),
                    field: {
                      '#withName':: d.fn(help='"Name of the key. This is an arbitrary string used to differentiate different keys. A unique key is generated per name: two separate TransientCryptoKey protos share the same generated key if their names are the same. When the data crypto key is generated, this name is not used in any way (repeating the api call will result in a different key being generated)."', args=[d.arg(name='name', type=d.T.string)]),
                      withName(name): { name: name },
                    },
                    '#value':: d.obj(help='"Value to compare against. The value block must only contain one argument. For example when a condition is evaluated against a string-type field, only string_value should be set. This argument is mandatory, except for conditions using the EXISTS operator. Structure is documented below."'),
