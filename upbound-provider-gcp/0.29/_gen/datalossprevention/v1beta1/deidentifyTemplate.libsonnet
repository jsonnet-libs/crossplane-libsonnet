                  kmsWrapped: {
                    '#withCryptoKeyName':: d.fn(help='"The resource name of the KMS CryptoKey to use for unwrapping."', args=[d.arg(name='cryptoKeyName', type=d.T.string)]),
                    withCryptoKeyName(cryptoKeyName): { cryptoKeyName: cryptoKeyName },
                    '#withWrappedKey':: d.fn(help='"The wrapped data crypto key. A base64-encoded string."', args=[d.arg(name='wrappedKey', type=d.T.string)]),
                    withWrappedKey(wrappedKey): { wrappedKey: wrappedKey },
                  },
                  '#transient':: d.obj(help='"Transient crypto key. Use this to have a random data crypto key generated. It will be discarded after the request finishes. Structure is documented below."'),
                  transient: {
                    '#withName':: d.fn(help='"Name of the key. This is an arbitrary string used to differentiate different keys. A unique key is generated per name: two separate TransientCryptoKey protos share the same generated key if their names are the same. When the data crypto key is generated, this name is not used in any way (repeating the api call will result in a different key being generated)."', args=[d.arg(name='name', type=d.T.string)]),
