              '#withCryptoHashConfig':: d.fn(help='"Pseudonymization method that generates surrogates via cryptographic hashing. Uses SHA-256. The key size must be either 32 or 64 bytes. Outputs a base64 encoded representation of the hashed output (for example, L7k0BHmF1ha5U3NfGykjro4xWi1MPVQPjhMAZbSV9mM=). Currently, only string and integer values can be hashed. See https://cloud.google.com/dlp/docs/pseudonymization to learn more. Structure is documented below."', args=[d.arg(name='cryptoHashConfig', type=d.T.array)]),
              withCryptoHashConfig(cryptoHashConfig): { cryptoHashConfig: if std.isArray(v=cryptoHashConfig) then cryptoHashConfig else [cryptoHashConfig] },
              '#withCryptoHashConfigMixin':: d.fn(help='"Pseudonymization method that generates surrogates via cryptographic hashing. Uses SHA-256. The key size must be either 32 or 64 bytes. Outputs a base64 encoded representation of the hashed output (for example, L7k0BHmF1ha5U3NfGykjro4xWi1MPVQPjhMAZbSV9mM=). Currently, only string and integer values can be hashed. See https://cloud.google.com/dlp/docs/pseudonymization to learn more. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='cryptoHashConfig', type=d.T.array)]),
              withCryptoHashConfigMixin(cryptoHashConfig): { cryptoHashConfig+: if std.isArray(v=cryptoHashConfig) then cryptoHashConfig else [cryptoHashConfig] },
              '#withCryptoReplaceFfxFpeConfig':: d.fn(help='"Replaces an identifier with a surrogate using Format Preserving Encryption (FPE) with the FFX mode of operation; however when used in the content.reidentify API method, it serves the opposite function by reversing the surrogate back into the original identifier. The identifier must be encoded as ASCII. For a given crypto key and context, the same identifier will be replaced with the same surrogate. Identifiers must be at least two characters long. In the case that the identifier is the empty string, it will be skipped. See https://cloud.google.com/dlp/docs/pseudonymization to learn more. Note: We recommend using CryptoDeterministicConfig for all use cases which do not require preserving the input alphabet space and size, plus warrant referential integrity. Structure is documented below."', args=[d.arg(name='cryptoReplaceFfxFpeConfig', type=d.T.array)]),
              withCryptoReplaceFfxFpeConfig(cryptoReplaceFfxFpeConfig): { cryptoReplaceFfxFpeConfig: if std.isArray(v=cryptoReplaceFfxFpeConfig) then cryptoReplaceFfxFpeConfig else [cryptoReplaceFfxFpeConfig] },
              '#withCryptoReplaceFfxFpeConfigMixin':: d.fn(help='"Replaces an identifier with a surrogate using Format Preserving Encryption (FPE) with the FFX mode of operation; however when used in the content.reidentify API method, it serves the opposite function by reversing the surrogate back into the original identifier. The identifier must be encoded as ASCII. For a given crypto key and context, the same identifier will be replaced with the same surrogate. Identifiers must be at least two characters long. In the case that the identifier is the empty string, it will be skipped. See https://cloud.google.com/dlp/docs/pseudonymization to learn more. Note: We recommend using CryptoDeterministicConfig for all use cases which do not require preserving the input alphabet space and size, plus warrant referential integrity. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='cryptoReplaceFfxFpeConfig', type=d.T.array)]),
