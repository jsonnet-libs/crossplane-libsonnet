            withBlueGreenSettings(blueGreenSettings): { blueGreenSettings: if std.isArray(v=blueGreenSettings) then blueGreenSettings else [blueGreenSettings] },
            '#withBlueGreenSettingsMixin':: d.fn(help='"Settings for blue-green upgrade strategy. To be specified when strategy is set to BLUE_GREEN. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='blueGreenSettings', type=d.T.array)]),
