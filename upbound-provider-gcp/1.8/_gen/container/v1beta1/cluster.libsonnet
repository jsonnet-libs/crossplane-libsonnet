                '#withBatchNodeCount':: d.fn(help='"Number of blue nodes to drain in a batch. Only one of the batch_percentage or batch_node_count can be specified."', args=[d.arg(name='batchNodeCount', type=d.T.number)]),
                withBatchNodeCount(batchNodeCount): { batchNodeCount: batchNodeCount },
                '#withBatchPercentage':: d.fn(help='":  Percentage of the bool pool nodes to drain in a batch. The range of this field should be (0.0, 1.0). Only one of the batch_percentage or batch_node_count can be specified."', args=[d.arg(name='batchPercentage', type=d.T.number)]),
                withBatchPercentage(batchPercentage): { batchPercentage: batchPercentage },
                '#withBatchSoakDuration':: d.fn(help="\"Soak time after each batch gets drained. A duration in seconds with up to nine fractional digits, ending with 's'. Example: \\\"3.5s\\\".`.\"", args=[d.arg(name='batchSoakDuration', type=d.T.string)]),
                withBatchSoakDuration(batchSoakDuration): { batchSoakDuration: batchSoakDuration },
              },
