        '#withHttpLoadBalancing':: d.fn(help='"The status of the HTTP (L7) load balancing\\ncontroller addon, which makes it easy to set up HTTP load balancers for services in a\\ncluster. It is enabled by default; set disabled = true to disable."', args=[d.arg(name='httpLoadBalancing', type=d.T.array)]),
        withHttpLoadBalancing(httpLoadBalancing): { httpLoadBalancing: if std.isArray(v=httpLoadBalancing) then httpLoadBalancing else [httpLoadBalancing] },
        '#withHttpLoadBalancingMixin':: d.fn(help='"The status of the HTTP (L7) load balancing\\ncontroller addon, which makes it easy to set up HTTP load balancers for services in a\\ncluster. It is enabled by default; set disabled = true to disable."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='httpLoadBalancing', type=d.T.array)]),
        withHttpLoadBalancingMixin(httpLoadBalancing): { httpLoadBalancing+: if std.isArray(v=httpLoadBalancing) then httpLoadBalancing else [httpLoadBalancing] },
        '#withNetworkPolicyConfig':: d.fn(help='"Whether we should enable the network policy addon\\nfor the master.  This must be enabled in order to enable network policy for the nodes.\\nTo enable this, you must also define a network_policy block,\\notherwise nothing will happen.\\nIt can only be disabled if the nodes already do not have network policies enabled.\\nDefaults to disabled; set disabled = false to enable."', args=[d.arg(name='networkPolicyConfig', type=d.T.array)]),
        withNetworkPolicyConfig(networkPolicyConfig): { networkPolicyConfig: if std.isArray(v=networkPolicyConfig) then networkPolicyConfig else [networkPolicyConfig] },
        '#withNetworkPolicyConfigMixin':: d.fn(help='"Whether we should enable the network policy addon\\nfor the master.  This must be enabled in order to enable network policy for the nodes.\\nTo enable this, you must also define a network_policy block,\\notherwise nothing will happen.\\nIt can only be disabled if the nodes already do not have network policies enabled.\\nDefaults to disabled; set disabled = false to enable."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='networkPolicyConfig', type=d.T.array)]),
        withNetworkPolicyConfigMixin(networkPolicyConfig): { networkPolicyConfig+: if std.isArray(v=networkPolicyConfig) then networkPolicyConfig else [networkPolicyConfig] },
        '#withRayOperatorConfig':: d.fn(help='". The status of the Ray Operator\\naddon.\\nIt is disabled by default. Set enabled = true to enable. The minimum\\ncluster version to enable Ray is 1.30.0-gke.1747000."', args=[d.arg(name='rayOperatorConfig', type=d.T.array)]),
        withRayOperatorConfig(rayOperatorConfig): { rayOperatorConfig: if std.isArray(v=rayOperatorConfig) then rayOperatorConfig else [rayOperatorConfig] },
        '#withRayOperatorConfigMixin':: d.fn(help='". The status of the Ray Operator\\naddon.\\nIt is disabled by default. Set enabled = true to enable. The minimum\\ncluster version to enable Ray is 1.30.0-gke.1747000."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='rayOperatorConfig', type=d.T.array)]),
        withRayOperatorConfigMixin(rayOperatorConfig): { rayOperatorConfig+: if std.isArray(v=rayOperatorConfig) then rayOperatorConfig else [rayOperatorConfig] },
        '#withStatefulHaConfig':: d.fn(help='".\\nThe status of the Stateful HA addon, which provides automatic configurable failover for stateful applications.\\nIt is disabled by default for Standard clusters. Set enabled = true to enable."', args=[d.arg(name='statefulHaConfig', type=d.T.array)]),
