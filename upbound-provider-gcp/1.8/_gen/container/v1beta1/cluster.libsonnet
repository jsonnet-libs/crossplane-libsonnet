            '#withAutoRepair':: d.fn(help='"Specifies whether the node auto-repair is enabled for the node pool. If enabled, the nodes in this node pool will be monitored and, if they fail health checks too many times, an automatic repair action will be triggered."', args=[d.arg(name='autoRepair', type=d.T.boolean)]),
            withAutoRepair(autoRepair): { autoRepair: autoRepair },
