      '#addonsConfig':: d.obj(help='"The configuration for addons supported by GKE.\\nStructure is documented below."'),
      addonsConfig: {
        '#cloudrunConfig':: d.obj(help='". Structure is documented below."'),
        cloudrunConfig: {
          '#withDisabled':: d.fn(help='"The status of the Istio addon, which makes it easy to set up Istio for services in a\\ncluster. It is disabled by default. Set disabled = false to enable."', args=[d.arg(name='disabled', type=d.T.boolean)]),
          withDisabled(disabled): { disabled: disabled },
          '#withLoadBalancerType':: d.fn(help='"The load balancer type of CloudRun ingress service. It is external load balancer by default.\\nSet load_balancer_type=LOAD_BALANCER_TYPE_INTERNAL to configure it as internal load balancer."', args=[d.arg(name='loadBalancerType', type=d.T.string)]),
          withLoadBalancerType(loadBalancerType): { loadBalancerType: loadBalancerType },
        },
        '#configConnectorConfig':: d.obj(help='".\\nThe status of the ConfigConnector addon. It is disabled by default; Set enabled = true to enable."'),
        configConnectorConfig: {
          '#withEnabled':: d.fn(help='"Enables vertical pod autoscaling"', args=[d.arg(name='enabled', type=d.T.boolean)]),
          withEnabled(enabled): { enabled: enabled },
        },
        '#dnsCacheConfig':: d.obj(help='".\\nThe status of the NodeLocal DNSCache addon. It is disabled by default.\\nSet enabled = true to enable."'),
        dnsCacheConfig: {
          '#withEnabled':: d.fn(help='"Enables vertical pod autoscaling"', args=[d.arg(name='enabled', type=d.T.boolean)]),
          withEnabled(enabled): { enabled: enabled },
