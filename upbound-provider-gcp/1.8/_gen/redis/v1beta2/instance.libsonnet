        withWeeklyMaintenanceWindow(weeklyMaintenanceWindow): { spec+: { forProvider+: { maintenancePolicy+: { weeklyMaintenanceWindow: if std.isArray(v=weeklyMaintenanceWindow) then weeklyMaintenanceWindow else [weeklyMaintenanceWindow] } } } },
