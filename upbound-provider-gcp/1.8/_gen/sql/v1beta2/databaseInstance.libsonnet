          '#withQueryStringLength':: d.fn(help='"Maximum query length stored in bytes. Between 256 and 4500. Default to 1024. Higher query lengths are more useful for analytical queries, but they also require more memory. Changing the query length requires you to restart the instance. You can still add tags to queries that exceed the length limit."', args=[d.arg(name='queryStringLength', type=d.T.number)]),
          withQueryStringLength(queryStringLength): { spec+: { initProvider+: { settings+: { insightsConfig+: { queryStringLength: queryStringLength } } } } },
