        withConnectorEnforcement(connectorEnforcement): { spec+: { forProvider+: { settings+: { connectorEnforcement: connectorEnforcement } } } },
        '#withDatabaseFlags':: d.fn(help='', args=[d.arg(name='databaseFlags', type=d.T.array)]),
        withDatabaseFlags(databaseFlags): { spec+: { forProvider+: { settings+: { databaseFlags: if std.isArray(v=databaseFlags) then databaseFlags else [databaseFlags] } } } },
        '#withDatabaseFlagsMixin':: d.fn(help='\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='databaseFlags', type=d.T.array)]),
        withDatabaseFlagsMixin(databaseFlags): { spec+: { forProvider+: { settings+: { databaseFlags+: if std.isArray(v=databaseFlags) then databaseFlags else [databaseFlags] } } } },
        '#withDeletionProtectionEnabled':: d.fn(help='"."', args=[d.arg(name='deletionProtectionEnabled', type=d.T.boolean)]),
        withDeletionProtectionEnabled(deletionProtectionEnabled): { spec+: { forProvider+: { settings+: { deletionProtectionEnabled: deletionProtectionEnabled } } } },
        '#withDiskAutoresize':: d.fn(help='"Enables auto-resizing of the storage size. Defaults to true."', args=[d.arg(name='diskAutoresize', type=d.T.boolean)]),
        withDiskAutoresize(diskAutoresize): { spec+: { forProvider+: { settings+: { diskAutoresize: diskAutoresize } } } },
        '#withDiskAutoresizeLimit':: d.fn(help='"The maximum size to which storage capacity can be automatically increased. The default value is 0, which specifies that there is no limit."', args=[d.arg(name='diskAutoresizeLimit', type=d.T.number)]),
        withDiskAutoresizeLimit(diskAutoresizeLimit): { spec+: { forProvider+: { settings+: { diskAutoresizeLimit: diskAutoresizeLimit } } } },
        '#withDiskSize':: d.fn(help='"The size of data disk, in GB. Size of a running instance cannot be reduced but can be increased. The minimum value is 10GB."', args=[d.arg(name='diskSize', type=d.T.number)]),
        withDiskSize(diskSize): { spec+: { forProvider+: { settings+: { diskSize: diskSize } } } },
        '#withDiskType':: d.fn(help='"The type of data disk: PD_SSD or PD_HDD. Defaults to PD_SSD."', args=[d.arg(name='diskType', type=d.T.string)]),
        withDiskType(diskType): { spec+: { forProvider+: { settings+: { diskType: diskType } } } },
        '#withEdition':: d.fn(help='"The edition of the instance, can be ENTERPRISE or ENTERPRISE_PLUS."', args=[d.arg(name='edition', type=d.T.string)]),
        withEdition(edition): { spec+: { forProvider+: { settings+: { edition: edition } } } },
        '#withEnableGoogleMlIntegration':: d.fn(help='"Enables Cloud SQL instances to connect to Vertex AI and pass requests for real-time predictions and insights. Defaults to false."', args=[d.arg(name='enableGoogleMlIntegration', type=d.T.boolean)]),
        withEnableGoogleMlIntegration(enableGoogleMlIntegration): { spec+: { forProvider+: { settings+: { enableGoogleMlIntegration: enableGoogleMlIntegration } } } },
        '#withPricingPlan':: d.fn(help='"Pricing plan for this instance, can only be PER_USE."', args=[d.arg(name='pricingPlan', type=d.T.string)]),
        withPricingPlan(pricingPlan): { spec+: { forProvider+: { settings+: { pricingPlan: pricingPlan } } } },
        '#withTier':: d.fn(help='"The machine type to use. See tiers\\nfor more details and supported versions. Postgres supports only shared-core machine types,\\nand custom machine types such as db-custom-2-13312. See the Custom Machine Type Documentation to learn about specifying custom machine types."', args=[d.arg(name='tier', type=d.T.string)]),
        withTier(tier): { spec+: { forProvider+: { settings+: { tier: tier } } } },
        '#withTimeZone':: d.fn(help='"The time_zone to be used by the database engine (supported only for SQL Server), in SQL Server timezone format."', args=[d.arg(name='timeZone', type=d.T.string)]),
        withTimeZone(timeZone): { spec+: { forProvider+: { settings+: { timeZone: timeZone } } } },
        '#withUserLabels':: d.fn(help='"A set of key/value user label pairs to assign to the instance."', args=[d.arg(name='userLabels', type=d.T.object)]),
        withUserLabels(userLabels): { spec+: { forProvider+: { settings+: { userLabels: userLabels } } } },
        '#withUserLabelsMixin':: d.fn(help='"A set of key/value user label pairs to assign to the instance."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='userLabels', type=d.T.object)]),
        withUserLabelsMixin(userLabels): { spec+: { forProvider+: { settings+: { userLabels+: userLabels } } } },
      },
      '#withDatabaseVersion':: d.fn(help='"The MySQL, PostgreSQL or\\nSQL Server version to use. Supported values include MYSQL_5_6,\\nMYSQL_5_7, MYSQL_8_0, POSTGRES_9_6,POSTGRES_10, POSTGRES_11,\\nPOSTGRES_12, POSTGRES_13, POSTGRES_14, POSTGRES_15, SQLSERVER_2017_STANDARD,\\nSQLSERVER_2017_ENTERPRISE, SQLSERVER_2017_EXPRESS, SQLSERVER_2017_WEB.\\nSQLSERVER_2019_STANDARD, SQLSERVER_2019_ENTERPRISE, SQLSERVER_2019_EXPRESS,\\nSQLSERVER_2019_WEB.\\nDatabase Version Policies\\nincludes an up-to-date reference of supported versions."', args=[d.arg(name='databaseVersion', type=d.T.string)]),
      withDatabaseVersion(databaseVersion): { spec+: { forProvider+: { databaseVersion: databaseVersion } } },
      '#withDeletionProtection':: d.fn(help='"When the field is set to false, deleting the instance is allowed."', args=[d.arg(name='deletionProtection', type=d.T.boolean)]),
      withDeletionProtection(deletionProtection): { spec+: { forProvider+: { deletionProtection: deletionProtection } } },
      '#withEncryptionKeyName':: d.fn(help='"The full path to the encryption key used for the CMEK disk encryption.\\nThe provided key must be in the same region as the SQL instance.  In order\\nto use this feature, a special kind of service account must be created and\\ngranted permission on this key.  This step can currently only be done\\nmanually, please see this step.\\nThat service account needs the Cloud KMS > Cloud KMS CryptoKey Encrypter/Decrypter role on your\\nkey - please see this step."', args=[d.arg(name='encryptionKeyName', type=d.T.string)]),
      withEncryptionKeyName(encryptionKeyName): { spec+: { forProvider+: { encryptionKeyName: encryptionKeyName } } },
      '#withMaintenanceVersion':: d.fn(help='"The current software version on the instance. This attribute can not be set during creation. Refer to available_maintenance_versions attribute to see what maintenance_version are available for upgrade. When this attribute gets updated, it will cause an instance restart. Setting a maintenance_version value that is older than the current one on the instance will be ignored."', args=[d.arg(name='maintenanceVersion', type=d.T.string)]),
      withMaintenanceVersion(maintenanceVersion): { spec+: { forProvider+: { maintenanceVersion: maintenanceVersion } } },
      '#withMasterInstanceName':: d.fn(help='"The name of the existing instance that will\\nact as the master in the replication setup. Note, this requires the master to\\nhave binary_log_enabled set, as well as existing backups."', args=[d.arg(name='masterInstanceName', type=d.T.string)]),
      withMasterInstanceName(masterInstanceName): { spec+: { forProvider+: { masterInstanceName: masterInstanceName } } },
      '#withProject':: d.fn(help='"The ID of the project in which the resource belongs. If it\\nis not provided, the provider project is used."', args=[d.arg(name='project', type=d.T.string)]),
      withProject(project): { spec+: { forProvider+: { project: project } } },
      '#withRegion':: d.fn(help='"The region the instance will sit in. If a region is not provided in the resource definition,\\nthe provider region will be used instead."', args=[d.arg(name='region', type=d.T.string)]),
      withRegion(region): { spec+: { forProvider+: { region: region } } },
    },
    '#initProvider':: d.obj(help='"THIS IS A BETA FIELD. It will be honored\\nunless the Management Policies feature flag is disabled.\\nInitProvider holds the same fields as ForProvider, with the exception\\nof Identifier and other resource reference fields. The fields that are\\nin InitProvider are merged into ForProvider when the resource is created.\\nThe same fields are also added to the terraform ignore_changes hook, to\\navoid updating them after creation. This is useful for fields that are\\nrequired on creation, but we do not desire to update them after creation,\\nfor example because of an external controller is managing them, like an\\nautoscaler."'),
    initProvider: {
      '#clone':: d.obj(help='"The context needed to create this instance as a clone of another instance. The\\nconfiguration is detailed below."'),
      clone: {
        '#withAllocatedIpRange':: d.fn(help='"The name of the allocated ip range for the private ip CloudSQL instance. For example: \\"google-managed-services-default\\". If set, the cloned instance ip will be created in the allocated range. The range name must comply with RFC 1035. Specifically, the name must be 1-63 characters long and match the regular expression a-z?."', args=[d.arg(name='allocatedIpRange', type=d.T.string)]),
        withAllocatedIpRange(allocatedIpRange): { spec+: { initProvider+: { clone+: { allocatedIpRange: allocatedIpRange } } } },
        '#withDatabaseNames':: d.fn(help='"(SQL Server only, use with point_in_time) Clone only the specified databases from the source instance. Clone all databases if empty."', args=[d.arg(name='databaseNames', type=d.T.array)]),
        withDatabaseNames(databaseNames): { spec+: { initProvider+: { clone+: { databaseNames: if std.isArray(v=databaseNames) then databaseNames else [databaseNames] } } } },
        '#withDatabaseNamesMixin':: d.fn(help='"(SQL Server only, use with point_in_time) Clone only the specified databases from the source instance. Clone all databases if empty."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='databaseNames', type=d.T.array)]),
        withDatabaseNamesMixin(databaseNames): { spec+: { initProvider+: { clone+: { databaseNames+: if std.isArray(v=databaseNames) then databaseNames else [databaseNames] } } } },
        '#withPointInTime':: d.fn(help='"The timestamp of the point in time that should be restored."', args=[d.arg(name='pointInTime', type=d.T.string)]),
        withPointInTime(pointInTime): { spec+: { initProvider+: { clone+: { pointInTime: pointInTime } } } },
        '#withPreferredZone':: d.fn(help='"(Point-in-time recovery for PostgreSQL only) Clone to an instance in the specified zone. If no zone is specified, clone to the same zone as the source instance. clone-unavailable-instance"', args=[d.arg(name='preferredZone', type=d.T.string)]),
        withPreferredZone(preferredZone): { spec+: { initProvider+: { clone+: { preferredZone: preferredZone } } } },
        '#withSourceInstanceName':: d.fn(help='"Name of the source instance which will be cloned."', args=[d.arg(name='sourceInstanceName', type=d.T.string)]),
        withSourceInstanceName(sourceInstanceName): { spec+: { initProvider+: { clone+: { sourceInstanceName: sourceInstanceName } } } },
      },
