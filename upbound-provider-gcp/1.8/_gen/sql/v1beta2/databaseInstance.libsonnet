          withPscConfigMixin(pscConfig): { spec+: { forProvider+: { settings+: { ipConfiguration+: { pscConfig+: if std.isArray(v=pscConfig) then pscConfig else [pscConfig] } } } } },
          '#withRequireSsl':: d.fn(help='"Whether SSL connections over IP are enforced or not. To change this field, also set the corresponding value in ssl_mode. It will be fully deprecated in a future major release. For now, please use ssl_mode with a compatible require_ssl value instead."', args=[d.arg(name='requireSsl', type=d.T.boolean)]),
          withRequireSsl(requireSsl): { spec+: { forProvider+: { settings+: { ipConfiguration+: { requireSsl: requireSsl } } } } },
          '#withSslMode':: d.fn(help='"Specify how SSL connection should be enforced in DB connections. This field provides more SSL enforcment options compared to require_ssl. To change this field, also set the correspoding value in require_ssl."', args=[d.arg(name='sslMode', type=d.T.string)]),
          withSslMode(sslMode): { spec+: { forProvider+: { settings+: { ipConfiguration+: { sslMode: sslMode } } } } },
