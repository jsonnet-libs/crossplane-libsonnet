          withQueryStringLength(queryStringLength): { spec+: { forProvider+: { settings+: { insightsConfig+: { queryStringLength: queryStringLength } } } } },
          '#withRecordApplicationTags':: d.fn(help='"True if Query Insights will record application tags from query when enabled."', args=[d.arg(name='recordApplicationTags', type=d.T.boolean)]),
          withRecordApplicationTags(recordApplicationTags): { spec+: { forProvider+: { settings+: { insightsConfig+: { recordApplicationTags: recordApplicationTags } } } } },
          '#withRecordClientAddress':: d.fn(help='"True if Query Insights will record client address when enabled."', args=[d.arg(name='recordClientAddress', type=d.T.boolean)]),
          withRecordClientAddress(recordClientAddress): { spec+: { forProvider+: { settings+: { insightsConfig+: { recordClientAddress: recordClientAddress } } } } },
        },
