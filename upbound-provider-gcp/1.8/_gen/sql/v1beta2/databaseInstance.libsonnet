        withDumpFilePath(dumpFilePath): { spec+: { initProvider+: { replicaConfiguration+: { dumpFilePath: dumpFilePath } } } },
        '#withFailoverTarget':: d.fn(help='"Specifies if the replica is the failover target.\\nIf the field is set to true the replica will be designated as a failover replica.\\nIf the master instance fails, the replica instance will be promoted as\\nthe new master instance.\\n~> NOTE: Not supported for Postgres database."', args=[d.arg(name='failoverTarget', type=d.T.boolean)]),
        withFailoverTarget(failoverTarget): { spec+: { initProvider+: { replicaConfiguration+: { failoverTarget: failoverTarget } } } },
