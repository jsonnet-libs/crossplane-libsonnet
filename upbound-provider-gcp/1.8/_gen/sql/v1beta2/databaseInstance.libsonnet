            withPscEnabled(pscEnabled): { pscEnabled: pscEnabled },
          },
          '#withAllocatedIpRange':: d.fn(help='"The name of the allocated ip range for the private ip CloudSQL instance. For example: \\"google-managed-services-default\\". If set, the instance ip will be created in the allocated range. The range name must comply with RFC 1035. Specifically, the name must be 1-63 characters long and match the regular expression a-z?."', args=[d.arg(name='allocatedIpRange', type=d.T.string)]),
          withAllocatedIpRange(allocatedIpRange): { spec+: { forProvider+: { settings+: { ipConfiguration+: { allocatedIpRange: allocatedIpRange } } } } },
          '#withAuthorizedNetworks':: d.fn(help='', args=[d.arg(name='authorizedNetworks', type=d.T.array)]),
          withAuthorizedNetworks(authorizedNetworks): { spec+: { forProvider+: { settings+: { ipConfiguration+: { authorizedNetworks: if std.isArray(v=authorizedNetworks) then authorizedNetworks else [authorizedNetworks] } } } } },
          '#withAuthorizedNetworksMixin':: d.fn(help='\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='authorizedNetworks', type=d.T.array)]),
