        withCaCertificate(caCertificate): { spec+: { initProvider+: { replicaConfiguration+: { caCertificate: caCertificate } } } },
        '#withClientCertificate':: d.fn(help="\"PEM representation of the replica's x509\\ncertificate.\"", args=[d.arg(name='clientCertificate', type=d.T.string)]),
        withClientCertificate(clientCertificate): { spec+: { initProvider+: { replicaConfiguration+: { clientCertificate: clientCertificate } } } },
        '#withClientKey':: d.fn(help="\"PEM representation of the replica's private key. The\\ncorresponding public key in encoded in the client_certificate.\"", args=[d.arg(name='clientKey', type=d.T.string)]),
        withClientKey(clientKey): { spec+: { initProvider+: { replicaConfiguration+: { clientKey: clientKey } } } },
