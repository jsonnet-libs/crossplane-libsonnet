          withPasswordChangeInterval(passwordChangeInterval): { spec+: { forProvider+: { settings+: { passwordValidationPolicy+: { passwordChangeInterval: passwordChangeInterval } } } } },
          '#withReuseInterval':: d.fn(help="\"Specifies the number of previous passwords that you can't reuse.\"", args=[d.arg(name='reuseInterval', type=d.T.number)]),
          withReuseInterval(reuseInterval): { spec+: { forProvider+: { settings+: { passwordValidationPolicy+: { reuseInterval: reuseInterval } } } } },
