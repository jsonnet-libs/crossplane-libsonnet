          withBucket(bucket): { spec+: { forProvider+: { settings+: { sqlServerAuditConfig+: { bucket: bucket } } } } },
          '#withRetentionInterval':: d.fn(help="\"How long to keep generated audit files. A duration in seconds with up to nine fractional digits, terminated by 's'. Example: \\\"3.5s\\\".\"", args=[d.arg(name='retentionInterval', type=d.T.string)]),
          withRetentionInterval(retentionInterval): { spec+: { forProvider+: { settings+: { sqlServerAuditConfig+: { retentionInterval: retentionInterval } } } } },
          '#withUploadInterval':: d.fn(help="\"How often to upload generated audit files. A duration in seconds with up to nine fractional digits, terminated by 's'. Example: \\\"3.5s\\\".\"", args=[d.arg(name='uploadInterval', type=d.T.string)]),
          withUploadInterval(uploadInterval): { spec+: { forProvider+: { settings+: { sqlServerAuditConfig+: { uploadInterval: uploadInterval } } } } },
        },
        '#withActivationPolicy':: d.fn(help='"This specifies when the instance should be\\nactive. Can be either ALWAYS, NEVER or ON_DEMAND."', args=[d.arg(name='activationPolicy', type=d.T.string)]),
        withActivationPolicy(activationPolicy): { spec+: { forProvider+: { settings+: { activationPolicy: activationPolicy } } } },
        '#withAvailabilityType':: d.fn(help="\"The availability type of the Cloud SQL\\ninstance, high availability (REGIONAL) or single zone (ZONAL).' For all instances, ensure that\\nsettings.backup_configuration.enabled is set to true.\\nFor MySQL instances, ensure that settings.backup_configuration.binary_log_enabled is set to true.\\nFor Postgres and SQL Server instances, ensure that settings.backup_configuration.point_in_time_recovery_enabled\\nis set to true. Defaults to ZONAL.\"", args=[d.arg(name='availabilityType', type=d.T.string)]),
        withAvailabilityType(availabilityType): { spec+: { forProvider+: { settings+: { availabilityType: availabilityType } } } },
        '#withCollation':: d.fn(help='"The name of server instance collation."', args=[d.arg(name='collation', type=d.T.string)]),
        withCollation(collation): { spec+: { forProvider+: { settings+: { collation: collation } } } },
