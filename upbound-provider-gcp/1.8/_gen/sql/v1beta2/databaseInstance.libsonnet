        withMasterHeartbeatPeriod(masterHeartbeatPeriod): { spec+: { initProvider+: { replicaConfiguration+: { masterHeartbeatPeriod: masterHeartbeatPeriod } } } },
        '#withSslCipher':: d.fn(help='"Permissible ciphers for use in SSL encryption."', args=[d.arg(name='sslCipher', type=d.T.string)]),
        withSslCipher(sslCipher): { spec+: { initProvider+: { replicaConfiguration+: { sslCipher: sslCipher } } } },
        '#withUsername':: d.fn(help='"Username for replication connection."', args=[d.arg(name='username', type=d.T.string)]),
