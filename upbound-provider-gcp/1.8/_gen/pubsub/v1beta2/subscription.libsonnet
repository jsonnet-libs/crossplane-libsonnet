        '#withDropUnknownFields':: d.fn(help="\"When true and use_topic_schema or use_table_schema is true, any fields that are a part of the topic schema or message schema that\\nare not part of the BigQuery table schema are dropped when writing to BigQuery. Otherwise, the schemas must be kept in sync\\nand any messages with extra fields are not written and remain in the subscription's backlog.\"", args=[d.arg(name='dropUnknownFields', type=d.T.boolean)]),
