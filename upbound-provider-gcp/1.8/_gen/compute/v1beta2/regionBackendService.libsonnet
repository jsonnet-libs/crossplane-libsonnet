      '#withHealthChecks':: d.fn(help='"The set of URLs to HealthCheck resources for health checking\\nthis RegionBackendService. Currently at most one health\\ncheck can be specified.\\nA health check must be specified unless the backend service uses an internet\\nor serverless NEG as a backend."', args=[d.arg(name='healthChecks', type=d.T.array)]),
      withHealthChecks(healthChecks): { spec+: { initProvider+: { healthChecks: if std.isArray(v=healthChecks) then healthChecks else [healthChecks] } } },
