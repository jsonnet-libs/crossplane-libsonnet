      '#withLoadBalancingScheme':: d.fn(help='"is set to INTERNAL_MANAGED"', args=[d.arg(name='loadBalancingScheme', type=d.T.string)]),
      withLoadBalancingScheme(loadBalancingScheme): { spec+: { initProvider+: { loadBalancingScheme: loadBalancingScheme } } },
