      withConnectionDrainingTimeoutSec(connectionDrainingTimeoutSec): { spec+: { initProvider+: { connectionDrainingTimeoutSec: connectionDrainingTimeoutSec } } },
      '#withDescription':: d.fn(help='"An optional description of this resource."', args=[d.arg(name='description', type=d.T.string)]),
