      withBackendMixin(backend): { spec+: { forProvider+: { backend+: if std.isArray(v=backend) then backend else [backend] } } },
      '#withCompressionMode':: d.fn(help="\"Compress text responses using Brotli or gzip compression, based on the client's Accept-Encoding header.\\nPossible values are: AUTOMATIC, DISABLED.\"", args=[d.arg(name='compressionMode', type=d.T.string)]),
      withCompressionMode(compressionMode): { spec+: { forProvider+: { compressionMode: compressionMode } } },
      '#withConnectionDrainingTimeoutSec':: d.fn(help='"Time for which instance will be drained (not accept new\\nconnections, but still work to finish started)."', args=[d.arg(name='connectionDrainingTimeoutSec', type=d.T.number)]),
      withConnectionDrainingTimeoutSec(connectionDrainingTimeoutSec): { spec+: { forProvider+: { connectionDrainingTimeoutSec: connectionDrainingTimeoutSec } } },
      '#withCustomRequestHeaders':: d.fn(help='"Headers that the HTTP/S load balancer should add to proxied\\nrequests."', args=[d.arg(name='customRequestHeaders', type=d.T.array)]),
      withCustomRequestHeaders(customRequestHeaders): { spec+: { forProvider+: { customRequestHeaders: if std.isArray(v=customRequestHeaders) then customRequestHeaders else [customRequestHeaders] } } },
      '#withCustomRequestHeadersMixin':: d.fn(help='"Headers that the HTTP/S load balancer should add to proxied\\nrequests."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='customRequestHeaders', type=d.T.array)]),
      withCustomRequestHeadersMixin(customRequestHeaders): { spec+: { forProvider+: { customRequestHeaders+: if std.isArray(v=customRequestHeaders) then customRequestHeaders else [customRequestHeaders] } } },
      '#withCustomResponseHeaders':: d.fn(help='"Headers that the HTTP/S load balancer should add to proxied\\nresponses."', args=[d.arg(name='customResponseHeaders', type=d.T.array)]),
      withCustomResponseHeaders(customResponseHeaders): { spec+: { forProvider+: { customResponseHeaders: if std.isArray(v=customResponseHeaders) then customResponseHeaders else [customResponseHeaders] } } },
      '#withCustomResponseHeadersMixin':: d.fn(help='"Headers that the HTTP/S load balancer should add to proxied\\nresponses."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='customResponseHeaders', type=d.T.array)]),
      withCustomResponseHeadersMixin(customResponseHeaders): { spec+: { forProvider+: { customResponseHeaders+: if std.isArray(v=customResponseHeaders) then customResponseHeaders else [customResponseHeaders] } } },
