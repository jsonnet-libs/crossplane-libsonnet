      '#backend':: d.obj(help='"The set of backends that serve this BackendService.\\nStructure is documented below."'),
      backend: {
        '#groupRef':: d.obj(help='"Reference to a InstanceGroupManager in compute to populate group."'),
        groupRef: {
          '#policy':: d.obj(help='"Policies for referencing."'),
