      withDescription(description): { spec+: { forProvider+: { description: description } } },
      '#withEdgeSecurityPolicy':: d.fn(help='"The resource URL for the edge security policy associated with this backend service."', args=[d.arg(name='edgeSecurityPolicy', type=d.T.string)]),
      withEdgeSecurityPolicy(edgeSecurityPolicy): { spec+: { forProvider+: { edgeSecurityPolicy: edgeSecurityPolicy } } },
      '#withEnableCdn':: d.fn(help='"If true, enable Cloud CDN for this BackendService."', args=[d.arg(name='enableCdn', type=d.T.boolean)]),
      withEnableCdn(enableCdn): { spec+: { forProvider+: { enableCdn: enableCdn } } },
      '#withHealthChecks':: d.fn(help='"The set of URLs to the HttpHealthCheck or HttpsHealthCheck resource\\nfor health checking this BackendService. Currently at most one health\\ncheck can be specified.\\nA health check must be specified unless the backend service uses an internet\\nor serverless NEG as a backend.\\nFor internal load balancing, a URL to a HealthCheck resource must be specified instead."', args=[d.arg(name='healthChecks', type=d.T.array)]),
      withHealthChecks(healthChecks): { spec+: { forProvider+: { healthChecks: if std.isArray(v=healthChecks) then healthChecks else [healthChecks] } } },
      '#withHealthChecksMixin':: d.fn(help='"The set of URLs to the HttpHealthCheck or HttpsHealthCheck resource\\nfor health checking this BackendService. Currently at most one health\\ncheck can be specified.\\nA health check must be specified unless the backend service uses an internet\\nor serverless NEG as a backend.\\nFor internal load balancing, a URL to a HealthCheck resource must be specified instead."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='healthChecks', type=d.T.array)]),
      withHealthChecksMixin(healthChecks): { spec+: { forProvider+: { healthChecks+: if std.isArray(v=healthChecks) then healthChecks else [healthChecks] } } },
      '#withHealthChecksRefs':: d.fn(help='"References to HealthCheck in compute to populate healthChecks."', args=[d.arg(name='healthChecksRefs', type=d.T.array)]),
      withHealthChecksRefs(healthChecksRefs): { spec+: { forProvider+: { healthChecksRefs: if std.isArray(v=healthChecksRefs) then healthChecksRefs else [healthChecksRefs] } } },
      '#withHealthChecksRefsMixin':: d.fn(help='"References to HealthCheck in compute to populate healthChecks."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='healthChecksRefs', type=d.T.array)]),
      withHealthChecksRefsMixin(healthChecksRefs): { spec+: { forProvider+: { healthChecksRefs+: if std.isArray(v=healthChecksRefs) then healthChecksRefs else [healthChecksRefs] } } },
      '#withLoadBalancingScheme':: d.fn(help='"Indicates whether the backend service will be used with internal or\\nexternal load balancing. A backend service created for one type of\\nload balancing cannot be used with the other. For more information, refer to\\nChoosing a load balancer.\\nDefault value is EXTERNAL.\\nPossible values are: EXTERNAL, INTERNAL_SELF_MANAGED, INTERNAL_MANAGED, EXTERNAL_MANAGED."', args=[d.arg(name='loadBalancingScheme', type=d.T.string)]),
      withLoadBalancingScheme(loadBalancingScheme): { spec+: { forProvider+: { loadBalancingScheme: loadBalancingScheme } } },
      '#withLocalityLbPolicies':: d.fn(help='"A list of locality load balancing policies to be used in order of\\npreference. Either the policy or the customPolicy field should be set.\\nOverrides any value set in the localityLbPolicy field.\\nlocalityLbPolicies is only supported when the BackendService is referenced\\nby a URL Map that is referenced by a target gRPC proxy that has the\\nvalidateForProxyless field set to true.\\nStructure is documented below."', args=[d.arg(name='localityLbPolicies', type=d.T.array)]),
      withLocalityLbPolicies(localityLbPolicies): { spec+: { forProvider+: { localityLbPolicies: if std.isArray(v=localityLbPolicies) then localityLbPolicies else [localityLbPolicies] } } },
      '#withLocalityLbPoliciesMixin':: d.fn(help='"A list of locality load balancing policies to be used in order of\\npreference. Either the policy or the customPolicy field should be set.\\nOverrides any value set in the localityLbPolicy field.\\nlocalityLbPolicies is only supported when the BackendService is referenced\\nby a URL Map that is referenced by a target gRPC proxy that has the\\nvalidateForProxyless field set to true.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='localityLbPolicies', type=d.T.array)]),
      withLocalityLbPoliciesMixin(localityLbPolicies): { spec+: { forProvider+: { localityLbPolicies+: if std.isArray(v=localityLbPolicies) then localityLbPolicies else [localityLbPolicies] } } },
      '#withLocalityLbPolicy':: d.fn(help='"The load balancing algorithm used within the scope of the locality.\\nThe possible values are:"', args=[d.arg(name='localityLbPolicy', type=d.T.string)]),
      withLocalityLbPolicy(localityLbPolicy): { spec+: { forProvider+: { localityLbPolicy: localityLbPolicy } } },
      '#withPortName':: d.fn(help='"Name of backend port. The same name should appear in the instance\\ngroups referenced by this service. Required when the load balancing\\nscheme is EXTERNAL."', args=[d.arg(name='portName', type=d.T.string)]),
      withPortName(portName): { spec+: { forProvider+: { portName: portName } } },
      '#withProject':: d.fn(help='"The ID of the project in which the resource belongs.\\nIf it is not provided, the provider project is used."', args=[d.arg(name='project', type=d.T.string)]),
      withProject(project): { spec+: { forProvider+: { project: project } } },
      '#withProtocol':: d.fn(help='"The protocol this BackendService uses to communicate with backends.\\nThe default is HTTP. NOTE: HTTP2 is only valid for beta HTTP/2 load balancer\\ntypes and may result in errors if used with the GA API. NOTE: With protocol “UNSPECIFIED”,\\nthe backend service can be used by Layer 4 Internal Load Balancing or Network Load Balancing\\nwith TCP/UDP/L3_DEFAULT Forwarding Rule protocol.\\nPossible values are: HTTP, HTTPS, HTTP2, TCP, SSL, GRPC, UNSPECIFIED."', args=[d.arg(name='protocol', type=d.T.string)]),
      withProtocol(protocol): { spec+: { forProvider+: { protocol: protocol } } },
      '#withSecurityPolicy':: d.fn(help='"The security policy associated with this backend service."', args=[d.arg(name='securityPolicy', type=d.T.string)]),
      withSecurityPolicy(securityPolicy): { spec+: { forProvider+: { securityPolicy: securityPolicy } } },
      '#withServiceLbPolicy':: d.fn(help='"URL to networkservices.ServiceLbPolicy resource.\\nCan only be set if load balancing scheme is EXTERNAL, EXTERNAL_MANAGED, INTERNAL_MANAGED or INTERNAL_SELF_MANAGED and the scope is global."', args=[d.arg(name='serviceLbPolicy', type=d.T.string)]),
      withServiceLbPolicy(serviceLbPolicy): { spec+: { forProvider+: { serviceLbPolicy: serviceLbPolicy } } },
      '#withSessionAffinity':: d.fn(help='"Type of session affinity to use. The default is NONE. Session affinity is\\nnot applicable if the protocol is UDP.\\nPossible values are: NONE, CLIENT_IP, CLIENT_IP_PORT_PROTO, CLIENT_IP_PROTO, GENERATED_COOKIE, HEADER_FIELD, HTTP_COOKIE."', args=[d.arg(name='sessionAffinity', type=d.T.string)]),
      withSessionAffinity(sessionAffinity): { spec+: { forProvider+: { sessionAffinity: sessionAffinity } } },
      '#withTimeoutSec':: d.fn(help='"The backend service timeout has a different meaning depending on the type of load balancer.\\nFor more information see, Backend service settings.\\nThe default is 30 seconds.\\nThe full range of timeout values allowed goes from 1 through 2,147,483,647 seconds."', args=[d.arg(name='timeoutSec', type=d.T.number)]),
      withTimeoutSec(timeoutSec): { spec+: { forProvider+: { timeoutSec: timeoutSec } } },
    },
    '#initProvider':: d.obj(help='"THIS IS A BETA FIELD. It will be honored\\nunless the Management Policies feature flag is disabled.\\nInitProvider holds the same fields as ForProvider, with the exception\\nof Identifier and other resource reference fields. The fields that are\\nin InitProvider are merged into ForProvider when the resource is created.\\nThe same fields are also added to the terraform ignore_changes hook, to\\navoid updating them after creation. This is useful for fields that are\\nrequired on creation, but we do not desire to update them after creation,\\nfor example because of an external controller is managing them, like an\\nautoscaler."'),
    initProvider: {
      '#backend':: d.obj(help='"The set of backends that serve this BackendService.\\nStructure is documented below."'),
      backend: {
        '#groupRef':: d.obj(help='"Reference to a InstanceGroupManager in compute to populate group."'),
        groupRef: {
          '#policy':: d.obj(help='"Policies for referencing."'),
          policy: {
            '#withResolution':: d.fn(help="\"Resolution specifies whether resolution of this reference is required.\\nThe default is 'Required', which means the reconcile will fail if the\\nreference cannot be resolved. 'Optional' means this reference will be\\na no-op if it cannot be resolved.\"", args=[d.arg(name='resolution', type=d.T.string)]),
            withResolution(resolution): { groupRef+: { policy+: { resolution: resolution } } },
            '#withResolve':: d.fn(help="\"Resolve specifies when this reference should be resolved. The default\\nis 'IfNotPresent', which will attempt to resolve the reference only when\\nthe corresponding field is not present. Use 'Always' to resolve the\\nreference on every reconcile.\"", args=[d.arg(name='resolve', type=d.T.string)]),
            withResolve(resolve): { groupRef+: { policy+: { resolve: resolve } } },
          },
          '#withName':: d.fn(help='"Name of the referenced object."', args=[d.arg(name='name', type=d.T.string)]),
          withName(name): { groupRef+: { name: name } },
        },
        '#groupSelector':: d.obj(help='"Selector for a InstanceGroupManager in compute to populate group."'),
        groupSelector: {
          '#policy':: d.obj(help='"Policies for selection."'),
          policy: {
            '#withResolution':: d.fn(help="\"Resolution specifies whether resolution of this reference is required.\\nThe default is 'Required', which means the reconcile will fail if the\\nreference cannot be resolved. 'Optional' means this reference will be\\na no-op if it cannot be resolved.\"", args=[d.arg(name='resolution', type=d.T.string)]),
            withResolution(resolution): { groupSelector+: { policy+: { resolution: resolution } } },
            '#withResolve':: d.fn(help="\"Resolve specifies when this reference should be resolved. The default\\nis 'IfNotPresent', which will attempt to resolve the reference only when\\nthe corresponding field is not present. Use 'Always' to resolve the\\nreference on every reconcile.\"", args=[d.arg(name='resolve', type=d.T.string)]),
            withResolve(resolve): { groupSelector+: { policy+: { resolve: resolve } } },
          },
          '#withMatchControllerRef':: d.fn(help='"MatchControllerRef ensures an object with the same controller reference\\nas the selecting object is selected."', args=[d.arg(name='matchControllerRef', type=d.T.boolean)]),
          withMatchControllerRef(matchControllerRef): { groupSelector+: { matchControllerRef: matchControllerRef } },
          '#withMatchLabels':: d.fn(help='"MatchLabels ensures an object with matching labels is selected."', args=[d.arg(name='matchLabels', type=d.T.object)]),
          withMatchLabels(matchLabels): { groupSelector+: { matchLabels: matchLabels } },
          '#withMatchLabelsMixin':: d.fn(help='"MatchLabels ensures an object with matching labels is selected."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='matchLabels', type=d.T.object)]),
          withMatchLabelsMixin(matchLabels): { groupSelector+: { matchLabels+: matchLabels } },
        },
        '#withBalancingMode':: d.fn(help='"Specifies the balancing mode for this backend.\\nFor global HTTP(S) or TCP/SSL load balancing, the default is\\nUTILIZATION. Valid values are UTILIZATION, RATE (for HTTP(S))\\nand CONNECTION (for TCP/SSL).\\nSee the Backend Services Overview\\nfor an explanation of load balancing modes.\\nFrom version 6.0.0 default value will be UTILIZATION to match default GCP value.\\nDefault value is UTILIZATION.\\nPossible values are: UTILIZATION, RATE, CONNECTION."', args=[d.arg(name='balancingMode', type=d.T.string)]),
        withBalancingMode(balancingMode): { balancingMode: balancingMode },
        '#withCapacityScaler':: d.fn(help="\"A multiplier applied to the group's maximum servicing capacity\\n(based on UTILIZATION, RATE or CONNECTION).\\nDefault value is 1, which means the group will serve up to 100%\\nof its configured capacity (depending on balancingMode). A\\nsetting of 0 means the group is completely drained, offering\\n0% of its available Capacity. Valid range is [0.0,1.0].\"", args=[d.arg(name='capacityScaler', type=d.T.number)]),
        withCapacityScaler(capacityScaler): { capacityScaler: capacityScaler },
        '#withDescription':: d.fn(help='"An optional description of this resource.\\nProvide this property when you create the resource."', args=[d.arg(name='description', type=d.T.string)]),
        withDescription(description): { description: description },
        '#withGroup':: d.fn(help='"The fully-qualified URL of an Instance Group or Network Endpoint\\nGroup resource. In case of instance group this defines the list\\nof instances that serve traffic. Member virtual machine\\ninstances from each instance group must live in the same zone as\\nthe instance group itself. No two backends in a backend service\\nare allowed to use same Instance Group resource.\\nFor Network Endpoint Groups this defines list of endpoints. All\\nendpoints of Network Endpoint Group must be hosted on instances\\nlocated in the same zone as the Network Endpoint Group.\\nBackend services cannot mix Instance Group and\\nNetwork Endpoint Group backends.\\nNote that you must specify an Instance Group or Network Endpoint\\nGroup resource using the fully-qualified URL, rather than a\\npartial URL."', args=[d.arg(name='group', type=d.T.string)]),
        withGroup(group): { group: group },
        '#withMaxConnections':: d.fn(help='"The max number of simultaneous connections for the group. Can\\nbe used with either CONNECTION or UTILIZATION balancing modes.\\nFor CONNECTION mode, either maxConnections or one\\nof maxConnectionsPerInstance or maxConnectionsPerEndpoint,\\nas appropriate for group type, must be set."', args=[d.arg(name='maxConnections', type=d.T.number)]),
        withMaxConnections(maxConnections): { maxConnections: maxConnections },
        '#withMaxConnectionsPerEndpoint':: d.fn(help='"The max number of simultaneous connections that a single backend\\nnetwork endpoint can handle. This is used to calculate the\\ncapacity of the group. Can be used in either CONNECTION or\\nUTILIZATION balancing modes.\\nFor CONNECTION mode, either\\nmaxConnections or maxConnectionsPerEndpoint must be set."', args=[d.arg(name='maxConnectionsPerEndpoint', type=d.T.number)]),
        withMaxConnectionsPerEndpoint(maxConnectionsPerEndpoint): { maxConnectionsPerEndpoint: maxConnectionsPerEndpoint },
        '#withMaxConnectionsPerInstance':: d.fn(help='"The max number of simultaneous connections that a single\\nbackend instance can handle. This is used to calculate the\\ncapacity of the group. Can be used in either CONNECTION or\\nUTILIZATION balancing modes.\\nFor CONNECTION mode, either maxConnections or\\nmaxConnectionsPerInstance must be set."', args=[d.arg(name='maxConnectionsPerInstance', type=d.T.number)]),
        withMaxConnectionsPerInstance(maxConnectionsPerInstance): { maxConnectionsPerInstance: maxConnectionsPerInstance },
        '#withMaxRate':: d.fn(help='"The max requests per second (RPS) of the group.\\nCan be used with either RATE or UTILIZATION balancing modes,\\nbut required if RATE mode. For RATE mode, either maxRate or one\\nof maxRatePerInstance or maxRatePerEndpoint, as appropriate for\\ngroup type, must be set."', args=[d.arg(name='maxRate', type=d.T.number)]),
        withMaxRate(maxRate): { maxRate: maxRate },
        '#withMaxRatePerEndpoint':: d.fn(help='"The max requests per second (RPS) that a single backend network\\nendpoint can handle. This is used to calculate the capacity of\\nthe group. Can be used in either balancing mode. For RATE mode,\\neither maxRate or maxRatePerEndpoint must be set."', args=[d.arg(name='maxRatePerEndpoint', type=d.T.number)]),
        withMaxRatePerEndpoint(maxRatePerEndpoint): { maxRatePerEndpoint: maxRatePerEndpoint },
        '#withMaxRatePerInstance':: d.fn(help='"The max requests per second (RPS) that a single backend\\ninstance can handle. This is used to calculate the capacity of\\nthe group. Can be used in either balancing mode. For RATE mode,\\neither maxRate or maxRatePerInstance must be set."', args=[d.arg(name='maxRatePerInstance', type=d.T.number)]),
        withMaxRatePerInstance(maxRatePerInstance): { maxRatePerInstance: maxRatePerInstance },
        '#withMaxUtilization':: d.fn(help='"Used when balancingMode is UTILIZATION. This ratio defines the\\nCPU utilization target for the group. Valid range is [0.0, 1.0]."', args=[d.arg(name='maxUtilization', type=d.T.number)]),
        withMaxUtilization(maxUtilization): { maxUtilization: maxUtilization },
      },
      '#cdnPolicy':: d.obj(help='"Cloud CDN configuration for this BackendService.\\nStructure is documented below."'),
      cdnPolicy: {
        '#bypassCacheOnRequestHeaders':: d.obj(help='"Bypass the cache when the specified request headers are matched - e.g. Pragma or Authorization headers. Up to 5 headers can be specified.\\nThe cache is bypassed for all cdnPolicy.cacheMode settings.\\nStructure is documented below."'),
        bypassCacheOnRequestHeaders: {
          '#withHeaderName':: d.fn(help='"The header field name to match on when bypassing cache. Values are case-insensitive."', args=[d.arg(name='headerName', type=d.T.string)]),
          withHeaderName(headerName): { headerName: headerName },
        },
        '#cacheKeyPolicy':: d.obj(help='"The CacheKeyPolicy for this CdnPolicy.\\nStructure is documented below."'),
        cacheKeyPolicy: {
          '#withIncludeHost':: d.fn(help='"If true requests to different hosts will be cached separately."', args=[d.arg(name='includeHost', type=d.T.boolean)]),
          withIncludeHost(includeHost): { spec+: { initProvider+: { cdnPolicy+: { cacheKeyPolicy+: { includeHost: includeHost } } } } },
          '#withIncludeHttpHeaders':: d.fn(help='"Allows HTTP request headers (by name) to be used in the\\ncache key."', args=[d.arg(name='includeHttpHeaders', type=d.T.array)]),
          withIncludeHttpHeaders(includeHttpHeaders): { spec+: { initProvider+: { cdnPolicy+: { cacheKeyPolicy+: { includeHttpHeaders: if std.isArray(v=includeHttpHeaders) then includeHttpHeaders else [includeHttpHeaders] } } } } },
          '#withIncludeHttpHeadersMixin':: d.fn(help='"Allows HTTP request headers (by name) to be used in the\\ncache key."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='includeHttpHeaders', type=d.T.array)]),
          withIncludeHttpHeadersMixin(includeHttpHeaders): { spec+: { initProvider+: { cdnPolicy+: { cacheKeyPolicy+: { includeHttpHeaders+: if std.isArray(v=includeHttpHeaders) then includeHttpHeaders else [includeHttpHeaders] } } } } },
          '#withIncludeNamedCookies':: d.fn(help='"Names of cookies to include in cache keys."', args=[d.arg(name='includeNamedCookies', type=d.T.array)]),
          withIncludeNamedCookies(includeNamedCookies): { spec+: { initProvider+: { cdnPolicy+: { cacheKeyPolicy+: { includeNamedCookies: if std.isArray(v=includeNamedCookies) then includeNamedCookies else [includeNamedCookies] } } } } },
          '#withIncludeNamedCookiesMixin':: d.fn(help='"Names of cookies to include in cache keys."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='includeNamedCookies', type=d.T.array)]),
          withIncludeNamedCookiesMixin(includeNamedCookies): { spec+: { initProvider+: { cdnPolicy+: { cacheKeyPolicy+: { includeNamedCookies+: if std.isArray(v=includeNamedCookies) then includeNamedCookies else [includeNamedCookies] } } } } },
          '#withIncludeProtocol':: d.fn(help='"If true, http and https requests will be cached separately."', args=[d.arg(name='includeProtocol', type=d.T.boolean)]),
          withIncludeProtocol(includeProtocol): { spec+: { initProvider+: { cdnPolicy+: { cacheKeyPolicy+: { includeProtocol: includeProtocol } } } } },
          '#withIncludeQueryString':: d.fn(help='"If true, include query string parameters in the cache key\\naccording to query_string_whitelist and\\nquery_string_blacklist. If neither is set, the entire query\\nstring will be included.\\nIf false, the query string will be excluded from the cache\\nkey entirely."', args=[d.arg(name='includeQueryString', type=d.T.boolean)]),
          withIncludeQueryString(includeQueryString): { spec+: { initProvider+: { cdnPolicy+: { cacheKeyPolicy+: { includeQueryString: includeQueryString } } } } },
          '#withQueryStringBlacklist':: d.fn(help="\"Names of query string parameters to exclude in cache keys.\\nAll other parameters will be included. Either specify\\nquery_string_whitelist or query_string_blacklist, not both.\\n'\u0026' and '=' will be percent encoded and not treated as\\ndelimiters.\"", args=[d.arg(name='queryStringBlacklist', type=d.T.array)]),
          withQueryStringBlacklist(queryStringBlacklist): { spec+: { initProvider+: { cdnPolicy+: { cacheKeyPolicy+: { queryStringBlacklist: if std.isArray(v=queryStringBlacklist) then queryStringBlacklist else [queryStringBlacklist] } } } } },
          '#withQueryStringBlacklistMixin':: d.fn(help="\"Names of query string parameters to exclude in cache keys.\\nAll other parameters will be included. Either specify\\nquery_string_whitelist or query_string_blacklist, not both.\\n'\u0026' and '=' will be percent encoded and not treated as\\ndelimiters.\"\n\n**Note:** This function appends passed data to existing values", args=[d.arg(name='queryStringBlacklist', type=d.T.array)]),
          withQueryStringBlacklistMixin(queryStringBlacklist): { spec+: { initProvider+: { cdnPolicy+: { cacheKeyPolicy+: { queryStringBlacklist+: if std.isArray(v=queryStringBlacklist) then queryStringBlacklist else [queryStringBlacklist] } } } } },
          '#withQueryStringWhitelist':: d.fn(help="\"Names of query string parameters to include in cache keys.\\nAll other parameters will be excluded. Either specify\\nquery_string_whitelist or query_string_blacklist, not both.\\n'\u0026' and '=' will be percent encoded and not treated as\\ndelimiters.\"", args=[d.arg(name='queryStringWhitelist', type=d.T.array)]),
          withQueryStringWhitelist(queryStringWhitelist): { spec+: { initProvider+: { cdnPolicy+: { cacheKeyPolicy+: { queryStringWhitelist: if std.isArray(v=queryStringWhitelist) then queryStringWhitelist else [queryStringWhitelist] } } } } },
          '#withQueryStringWhitelistMixin':: d.fn(help="\"Names of query string parameters to include in cache keys.\\nAll other parameters will be excluded. Either specify\\nquery_string_whitelist or query_string_blacklist, not both.\\n'\u0026' and '=' will be percent encoded and not treated as\\ndelimiters.\"\n\n**Note:** This function appends passed data to existing values", args=[d.arg(name='queryStringWhitelist', type=d.T.array)]),
          withQueryStringWhitelistMixin(queryStringWhitelist): { spec+: { initProvider+: { cdnPolicy+: { cacheKeyPolicy+: { queryStringWhitelist+: if std.isArray(v=queryStringWhitelist) then queryStringWhitelist else [queryStringWhitelist] } } } } },
        },
        '#negativeCachingPolicy':: d.obj(help="\"Sets a cache TTL for the specified HTTP status code. negativeCaching must be enabled to configure negativeCachingPolicy.\\nOmitting the policy and leaving negativeCaching enabled will use Cloud CDN's default cache TTLs.\\nStructure is documented below.\""),
        negativeCachingPolicy: {
          '#withCode':: d.fn(help='"The HTTP status code to define a TTL against. Only HTTP status codes 300, 301, 308, 404, 405, 410, 421, 451 and 501\\ncan be specified as values, and you cannot specify a status code more than once."', args=[d.arg(name='code', type=d.T.number)]),
          withCode(code): { code: code },
          '#withTtl':: d.fn(help='"The TTL (in seconds) for which to cache responses with the corresponding status code. The maximum allowed value is 1800s\\n(30 minutes), noting that infrequently accessed objects may be evicted from the cache before the defined TTL."', args=[d.arg(name='ttl', type=d.T.number)]),
          withTtl(ttl): { ttl: ttl },
        },
        '#withBypassCacheOnRequestHeaders':: d.fn(help='"Bypass the cache when the specified request headers are matched - e.g. Pragma or Authorization headers. Up to 5 headers can be specified.\\nThe cache is bypassed for all cdnPolicy.cacheMode settings.\\nStructure is documented below."', args=[d.arg(name='bypassCacheOnRequestHeaders', type=d.T.array)]),
        withBypassCacheOnRequestHeaders(bypassCacheOnRequestHeaders): { spec+: { initProvider+: { cdnPolicy+: { bypassCacheOnRequestHeaders: if std.isArray(v=bypassCacheOnRequestHeaders) then bypassCacheOnRequestHeaders else [bypassCacheOnRequestHeaders] } } } },
        '#withBypassCacheOnRequestHeadersMixin':: d.fn(help='"Bypass the cache when the specified request headers are matched - e.g. Pragma or Authorization headers. Up to 5 headers can be specified.\\nThe cache is bypassed for all cdnPolicy.cacheMode settings.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='bypassCacheOnRequestHeaders', type=d.T.array)]),
        withBypassCacheOnRequestHeadersMixin(bypassCacheOnRequestHeaders): { spec+: { initProvider+: { cdnPolicy+: { bypassCacheOnRequestHeaders+: if std.isArray(v=bypassCacheOnRequestHeaders) then bypassCacheOnRequestHeaders else [bypassCacheOnRequestHeaders] } } } },
        '#withCacheMode':: d.fn(help='"Specifies the cache setting for all responses from this backend.\\nThe possible values are: USE_ORIGIN_HEADERS, FORCE_CACHE_ALL and CACHE_ALL_STATIC\\nPossible values are: USE_ORIGIN_HEADERS, FORCE_CACHE_ALL, CACHE_ALL_STATIC."', args=[d.arg(name='cacheMode', type=d.T.string)]),
        withCacheMode(cacheMode): { spec+: { initProvider+: { cdnPolicy+: { cacheMode: cacheMode } } } },
        '#withClientTtl':: d.fn(help='"Specifies the maximum allowed TTL for cached content served by this origin."', args=[d.arg(name='clientTtl', type=d.T.number)]),
        withClientTtl(clientTtl): { spec+: { initProvider+: { cdnPolicy+: { clientTtl: clientTtl } } } },
        '#withDefaultTtl':: d.fn(help='"Specifies the default TTL for cached content served by this origin for responses\\nthat do not have an existing valid TTL (max-age or s-max-age)."', args=[d.arg(name='defaultTtl', type=d.T.number)]),
        withDefaultTtl(defaultTtl): { spec+: { initProvider+: { cdnPolicy+: { defaultTtl: defaultTtl } } } },
        '#withMaxTtl':: d.fn(help='"Specifies the maximum allowed TTL for cached content served by this origin."', args=[d.arg(name='maxTtl', type=d.T.number)]),
        withMaxTtl(maxTtl): { spec+: { initProvider+: { cdnPolicy+: { maxTtl: maxTtl } } } },
        '#withNegativeCaching':: d.fn(help='"Negative caching allows per-status code TTLs to be set, in order to apply fine-grained caching for common errors or redirects."', args=[d.arg(name='negativeCaching', type=d.T.boolean)]),
        withNegativeCaching(negativeCaching): { spec+: { initProvider+: { cdnPolicy+: { negativeCaching: negativeCaching } } } },
        '#withNegativeCachingPolicy':: d.fn(help="\"Sets a cache TTL for the specified HTTP status code. negativeCaching must be enabled to configure negativeCachingPolicy.\\nOmitting the policy and leaving negativeCaching enabled will use Cloud CDN's default cache TTLs.\\nStructure is documented below.\"", args=[d.arg(name='negativeCachingPolicy', type=d.T.array)]),
        withNegativeCachingPolicy(negativeCachingPolicy): { spec+: { initProvider+: { cdnPolicy+: { negativeCachingPolicy: if std.isArray(v=negativeCachingPolicy) then negativeCachingPolicy else [negativeCachingPolicy] } } } },
        '#withNegativeCachingPolicyMixin':: d.fn(help="\"Sets a cache TTL for the specified HTTP status code. negativeCaching must be enabled to configure negativeCachingPolicy.\\nOmitting the policy and leaving negativeCaching enabled will use Cloud CDN's default cache TTLs.\\nStructure is documented below.\"\n\n**Note:** This function appends passed data to existing values", args=[d.arg(name='negativeCachingPolicy', type=d.T.array)]),
        withNegativeCachingPolicyMixin(negativeCachingPolicy): { spec+: { initProvider+: { cdnPolicy+: { negativeCachingPolicy+: if std.isArray(v=negativeCachingPolicy) then negativeCachingPolicy else [negativeCachingPolicy] } } } },
        '#withServeWhileStale':: d.fn(help='"Serve existing content from the cache (if available) when revalidating content with the origin, or when an error is encountered when refreshing the cache."', args=[d.arg(name='serveWhileStale', type=d.T.number)]),
        withServeWhileStale(serveWhileStale): { spec+: { initProvider+: { cdnPolicy+: { serveWhileStale: serveWhileStale } } } },
        '#withSignedUrlCacheMaxAgeSec':: d.fn(help='"Maximum number of seconds the response to a signed URL request\\nwill be considered fresh, defaults to 1hr (3600s). After this\\ntime period, the response will be revalidated before\\nbeing served.\\nWhen serving responses to signed URL requests, Cloud CDN will\\ninternally behave as though all responses from this backend had a\\n\\"Cache-Control: public, max-age=[TTL]\\" header, regardless of any\\nexisting Cache-Control header. The actual headers served in\\nresponses will not be altered."', args=[d.arg(name='signedUrlCacheMaxAgeSec', type=d.T.number)]),
        withSignedUrlCacheMaxAgeSec(signedUrlCacheMaxAgeSec): { spec+: { initProvider+: { cdnPolicy+: { signedUrlCacheMaxAgeSec: signedUrlCacheMaxAgeSec } } } },
      },
      '#circuitBreakers':: d.obj(help='"Settings controlling the volume of connections to a backend service. This field\\nis applicable only when the load_balancing_scheme is set to INTERNAL_SELF_MANAGED.\\nStructure is documented below."'),
      circuitBreakers: {
        '#withMaxConnections':: d.fn(help='"The maximum number of connections to the backend cluster.\\nDefaults to 1024."', args=[d.arg(name='maxConnections', type=d.T.number)]),
        withMaxConnections(maxConnections): { spec+: { initProvider+: { circuitBreakers+: { maxConnections: maxConnections } } } },
        '#withMaxPendingRequests':: d.fn(help='"The maximum number of pending requests to the backend cluster.\\nDefaults to 1024."', args=[d.arg(name='maxPendingRequests', type=d.T.number)]),
        withMaxPendingRequests(maxPendingRequests): { spec+: { initProvider+: { circuitBreakers+: { maxPendingRequests: maxPendingRequests } } } },
        '#withMaxRequests':: d.fn(help='"The maximum number of parallel requests to the backend cluster.\\nDefaults to 1024."', args=[d.arg(name='maxRequests', type=d.T.number)]),
        withMaxRequests(maxRequests): { spec+: { initProvider+: { circuitBreakers+: { maxRequests: maxRequests } } } },
        '#withMaxRequestsPerConnection':: d.fn(help='"Maximum requests for a single backend connection. This parameter\\nis respected by both the HTTP/1.1 and HTTP/2 implementations. If\\nnot specified, there is no limit. Setting this parameter to 1\\nwill effectively disable keep alive."', args=[d.arg(name='maxRequestsPerConnection', type=d.T.number)]),
        withMaxRequestsPerConnection(maxRequestsPerConnection): { spec+: { initProvider+: { circuitBreakers+: { maxRequestsPerConnection: maxRequestsPerConnection } } } },
        '#withMaxRetries':: d.fn(help='"The maximum number of parallel retries to the backend cluster.\\nDefaults to 3."', args=[d.arg(name='maxRetries', type=d.T.number)]),
        withMaxRetries(maxRetries): { spec+: { initProvider+: { circuitBreakers+: { maxRetries: maxRetries } } } },
      },
      '#consistentHash':: d.obj(help='"Consistent Hash-based load balancing can be used to provide soft session\\naffinity based on HTTP headers, cookies or other properties. This load balancing\\npolicy is applicable only for HTTP connections. The affinity to a particular\\ndestination host will be lost when one or more hosts are added/removed from the\\ndestination service. This field specifies parameters that control consistent\\nhashing. This field only applies if the load_balancing_scheme is set to\\nINTERNAL_SELF_MANAGED. This field is only applicable when locality_lb_policy is\\nset to MAGLEV or RING_HASH.\\nStructure is documented below."'),
      consistentHash: {
        '#httpCookie':: d.obj(help='"Hash is based on HTTP Cookie. This field describes a HTTP cookie\\nthat will be used as the hash key for the consistent hash load\\nbalancer. If the cookie is not present, it will be generated.\\nThis field is applicable if the sessionAffinity is set to HTTP_COOKIE.\\nStructure is documented below."'),
        httpCookie: {
          '#ttl':: d.obj(help='"The TTL (in seconds) for which to cache responses with the corresponding status code. The maximum allowed value is 1800s\\n(30 minutes), noting that infrequently accessed objects may be evicted from the cache before the defined TTL."'),
          ttl: {
            '#withNanos':: d.fn(help="\"Span of time that's a fraction of a second at nanosecond\\nresolution. Durations less than one second are represented\\nwith a 0 seconds field and a positive nanos field. Must\\nbe from 0 to 999,999,999 inclusive.\"", args=[d.arg(name='nanos', type=d.T.number)]),
            withNanos(nanos): { spec+: { initProvider+: { consistentHash+: { httpCookie+: { ttl+: { nanos: nanos } } } } } },
            '#withSeconds':: d.fn(help='"Span of time at a resolution of a second.\\nMust be from 0 to 315,576,000,000 inclusive."', args=[d.arg(name='seconds', type=d.T.number)]),
            withSeconds(seconds): { spec+: { initProvider+: { consistentHash+: { httpCookie+: { ttl+: { seconds: seconds } } } } } },
          },
          '#withName':: d.fn(help='"The name of a locality load balancer policy to be used. The value\\nshould be one of the predefined ones as supported by localityLbPolicy,\\nalthough at the moment only ROUND_ROBIN is supported.\\nThis field should only be populated when the customPolicy field is not\\nused.\\nNote that specifying the same policy more than once for a backend is\\nnot a valid configuration and will be rejected.\\nThe possible values are:"', args=[d.arg(name='name', type=d.T.string)]),
          withName(name): { spec+: { initProvider+: { consistentHash+: { httpCookie+: { name: name } } } } },
          '#withPath':: d.fn(help='"Path to set for the cookie."', args=[d.arg(name='path', type=d.T.string)]),
          withPath(path): { spec+: { initProvider+: { consistentHash+: { httpCookie+: { path: path } } } } },
        },
        '#withHttpHeaderName':: d.fn(help='"The hash based on the value of the specified header field.\\nThis field is applicable if the sessionAffinity is set to HEADER_FIELD."', args=[d.arg(name='httpHeaderName', type=d.T.string)]),
        withHttpHeaderName(httpHeaderName): { spec+: { initProvider+: { consistentHash+: { httpHeaderName: httpHeaderName } } } },
        '#withMinimumRingSize':: d.fn(help='"The minimum number of virtual nodes to use for the hash ring.\\nLarger ring sizes result in more granular load\\ndistributions. If the number of hosts in the load balancing pool\\nis larger than the ring size, each host will be assigned a single\\nvirtual node.\\nDefaults to 1024."', args=[d.arg(name='minimumRingSize', type=d.T.number)]),
        withMinimumRingSize(minimumRingSize): { spec+: { initProvider+: { consistentHash+: { minimumRingSize: minimumRingSize } } } },
      },
      '#healthChecksRefs':: d.obj(help='"References to HealthCheck in compute to populate healthChecks."'),
      healthChecksRefs: {
        '#policy':: d.obj(help='"Policies for referencing."'),
        policy: {
          '#withResolution':: d.fn(help="\"Resolution specifies whether resolution of this reference is required.\\nThe default is 'Required', which means the reconcile will fail if the\\nreference cannot be resolved. 'Optional' means this reference will be\\na no-op if it cannot be resolved.\"", args=[d.arg(name='resolution', type=d.T.string)]),
          withResolution(resolution): { policy+: { resolution: resolution } },
          '#withResolve':: d.fn(help="\"Resolve specifies when this reference should be resolved. The default\\nis 'IfNotPresent', which will attempt to resolve the reference only when\\nthe corresponding field is not present. Use 'Always' to resolve the\\nreference on every reconcile.\"", args=[d.arg(name='resolve', type=d.T.string)]),
          withResolve(resolve): { policy+: { resolve: resolve } },
        },
        '#withName':: d.fn(help='"Name of the referenced object."', args=[d.arg(name='name', type=d.T.string)]),
        withName(name): { name: name },
      },
      '#healthChecksSelector':: d.obj(help='"Selector for a list of HealthCheck in compute to populate healthChecks."'),
      healthChecksSelector: {
        '#policy':: d.obj(help='"Policies for selection."'),
        policy: {
          '#withResolution':: d.fn(help="\"Resolution specifies whether resolution of this reference is required.\\nThe default is 'Required', which means the reconcile will fail if the\\nreference cannot be resolved. 'Optional' means this reference will be\\na no-op if it cannot be resolved.\"", args=[d.arg(name='resolution', type=d.T.string)]),
          withResolution(resolution): { spec+: { initProvider+: { healthChecksSelector+: { policy+: { resolution: resolution } } } } },
          '#withResolve':: d.fn(help="\"Resolve specifies when this reference should be resolved. The default\\nis 'IfNotPresent', which will attempt to resolve the reference only when\\nthe corresponding field is not present. Use 'Always' to resolve the\\nreference on every reconcile.\"", args=[d.arg(name='resolve', type=d.T.string)]),
          withResolve(resolve): { spec+: { initProvider+: { healthChecksSelector+: { policy+: { resolve: resolve } } } } },
        },
        '#withMatchControllerRef':: d.fn(help='"MatchControllerRef ensures an object with the same controller reference\\nas the selecting object is selected."', args=[d.arg(name='matchControllerRef', type=d.T.boolean)]),
        withMatchControllerRef(matchControllerRef): { spec+: { initProvider+: { healthChecksSelector+: { matchControllerRef: matchControllerRef } } } },
        '#withMatchLabels':: d.fn(help='"MatchLabels ensures an object with matching labels is selected."', args=[d.arg(name='matchLabels', type=d.T.object)]),
        withMatchLabels(matchLabels): { spec+: { initProvider+: { healthChecksSelector+: { matchLabels: matchLabels } } } },
        '#withMatchLabelsMixin':: d.fn(help='"MatchLabels ensures an object with matching labels is selected."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='matchLabels', type=d.T.object)]),
        withMatchLabelsMixin(matchLabels): { spec+: { initProvider+: { healthChecksSelector+: { matchLabels+: matchLabels } } } },
      },
      '#iap':: d.obj(help='"Settings for enabling Cloud Identity Aware Proxy\\nStructure is documented below."'),
      iap: {
        '#oauth2ClientSecretSecretRef':: d.obj(help='"OAuth2 Client Secret for IAP\\nNote: This property is sensitive and will not be displayed in the plan."'),
        oauth2ClientSecretSecretRef: {
          '#withKey':: d.fn(help='"The key to select."', args=[d.arg(name='key', type=d.T.string)]),
          withKey(key): { spec+: { initProvider+: { iap+: { oauth2ClientSecretSecretRef+: { key: key } } } } },
          '#withName':: d.fn(help='"Name of the secret."', args=[d.arg(name='name', type=d.T.string)]),
          withName(name): { spec+: { initProvider+: { iap+: { oauth2ClientSecretSecretRef+: { name: name } } } } },
          '#withNamespace':: d.fn(help='"Namespace of the secret."', args=[d.arg(name='namespace', type=d.T.string)]),
          withNamespace(namespace): { spec+: { initProvider+: { iap+: { oauth2ClientSecretSecretRef+: { namespace: namespace } } } } },
        },
        '#withOauth2ClientId':: d.fn(help='"OAuth2 Client ID for IAP"', args=[d.arg(name='oauth2ClientId', type=d.T.string)]),
        withOauth2ClientId(oauth2ClientId): { spec+: { initProvider+: { iap+: { oauth2ClientId: oauth2ClientId } } } },
      },
      '#localityLbPolicies':: d.obj(help='"A list of locality load balancing policies to be used in order of\\npreference. Either the policy or the customPolicy field should be set.\\nOverrides any value set in the localityLbPolicy field.\\nlocalityLbPolicies is only supported when the BackendService is referenced\\nby a URL Map that is referenced by a target gRPC proxy that has the\\nvalidateForProxyless field set to true.\\nStructure is documented below."'),
      localityLbPolicies: {
        '#customPolicy':: d.obj(help='"The configuration for a custom policy implemented by the user and\\ndeployed with the client.\\nStructure is documented below."'),
        customPolicy: {
          '#withData':: d.fn(help='"An optional, arbitrary JSON object with configuration data, understood\\nby a locally installed custom policy implementation."', args=[d.arg(name='data', type=d.T.string)]),
          withData(data): { customPolicy+: { data: data } },
          '#withName':: d.fn(help='"The name of a locality load balancer policy to be used. The value\\nshould be one of the predefined ones as supported by localityLbPolicy,\\nalthough at the moment only ROUND_ROBIN is supported.\\nThis field should only be populated when the customPolicy field is not\\nused.\\nNote that specifying the same policy more than once for a backend is\\nnot a valid configuration and will be rejected.\\nThe possible values are:"', args=[d.arg(name='name', type=d.T.string)]),
          withName(name): { customPolicy+: { name: name } },
        },
        '#policy':: d.obj(help='"The configuration for a built-in load balancing policy.\\nStructure is documented below."'),
        policy: {
          '#withName':: d.fn(help='"The name of a locality load balancer policy to be used. The value\\nshould be one of the predefined ones as supported by localityLbPolicy,\\nalthough at the moment only ROUND_ROBIN is supported.\\nThis field should only be populated when the customPolicy field is not\\nused.\\nNote that specifying the same policy more than once for a backend is\\nnot a valid configuration and will be rejected.\\nThe possible values are:"', args=[d.arg(name='name', type=d.T.string)]),
          withName(name): { policy+: { name: name } },
        },
      },
      '#logConfig':: d.obj(help='"This field denotes the logging options for the load balancer traffic served by this backend service.\\nIf logging is enabled, logs will be exported to Stackdriver.\\nStructure is documented below."'),
      logConfig: {
        '#withEnable':: d.fn(help='"Whether to enable logging for the load balancer traffic served by this backend service."', args=[d.arg(name='enable', type=d.T.boolean)]),
        withEnable(enable): { spec+: { initProvider+: { logConfig+: { enable: enable } } } },
        '#withSampleRate':: d.fn(help='"This field can only be specified if logging is enabled for this backend service. The value of\\nthe field must be in [0, 1]. This configures the sampling rate of requests to the load balancer\\nwhere 1.0 means all logged requests are reported and 0.0 means no logged requests are reported.\\nThe default value is 1.0."', args=[d.arg(name='sampleRate', type=d.T.number)]),
        withSampleRate(sampleRate): { spec+: { initProvider+: { logConfig+: { sampleRate: sampleRate } } } },
      },
      '#outlierDetection':: d.obj(help='"Settings controlling eviction of unhealthy hosts from the load balancing pool.\\nApplicable backend service types can be a global backend service with the\\nloadBalancingScheme set to INTERNAL_SELF_MANAGED or EXTERNAL_MANAGED.\\nFrom version 6.0.\\nDefault values are enforce by GCP without providing them.\\nStructure is documented below."'),
      outlierDetection: {
        '#baseEjectionTime':: d.obj(help='"The base time that a host is ejected for. The real time is equal to the base\\ntime multiplied by the number of times the host has been ejected. Defaults to\\n30000ms or 30s.\\nStructure is documented below."'),
        baseEjectionTime: {
          '#withNanos':: d.fn(help="\"Span of time that's a fraction of a second at nanosecond\\nresolution. Durations less than one second are represented\\nwith a 0 seconds field and a positive nanos field. Must\\nbe from 0 to 999,999,999 inclusive.\"", args=[d.arg(name='nanos', type=d.T.number)]),
          withNanos(nanos): { spec+: { initProvider+: { outlierDetection+: { baseEjectionTime+: { nanos: nanos } } } } },
          '#withSeconds':: d.fn(help='"Span of time at a resolution of a second.\\nMust be from 0 to 315,576,000,000 inclusive."', args=[d.arg(name='seconds', type=d.T.number)]),
          withSeconds(seconds): { spec+: { initProvider+: { outlierDetection+: { baseEjectionTime+: { seconds: seconds } } } } },
        },
        '#interval':: d.obj(help='"Time interval between ejection sweep analysis. This can result in both new\\nejections as well as hosts being returned to service. Defaults to 10 seconds.\\nStructure is documented below."'),
        interval: {
          '#withNanos':: d.fn(help="\"Span of time that's a fraction of a second at nanosecond\\nresolution. Durations less than one second are represented\\nwith a 0 seconds field and a positive nanos field. Must\\nbe from 0 to 999,999,999 inclusive.\"", args=[d.arg(name='nanos', type=d.T.number)]),
          withNanos(nanos): { spec+: { initProvider+: { outlierDetection+: { interval+: { nanos: nanos } } } } },
          '#withSeconds':: d.fn(help='"Span of time at a resolution of a second.\\nMust be from 0 to 315,576,000,000 inclusive."', args=[d.arg(name='seconds', type=d.T.number)]),
          withSeconds(seconds): { spec+: { initProvider+: { outlierDetection+: { interval+: { seconds: seconds } } } } },
        },
        '#withConsecutiveErrors':: d.fn(help='"Number of errors before a host is ejected from the connection pool. When the\\nbackend host is accessed over HTTP, a 5xx return code qualifies as an error.\\nDefaults to 5."', args=[d.arg(name='consecutiveErrors', type=d.T.number)]),
        withConsecutiveErrors(consecutiveErrors): { spec+: { initProvider+: { outlierDetection+: { consecutiveErrors: consecutiveErrors } } } },
        '#withConsecutiveGatewayFailure':: d.fn(help='"The number of consecutive gateway failures (502, 503, 504 status or connection\\nerrors that are mapped to one of those status codes) before a consecutive\\ngateway failure ejection occurs. Defaults to 5."', args=[d.arg(name='consecutiveGatewayFailure', type=d.T.number)]),
        withConsecutiveGatewayFailure(consecutiveGatewayFailure): { spec+: { initProvider+: { outlierDetection+: { consecutiveGatewayFailure: consecutiveGatewayFailure } } } },
        '#withEnforcingConsecutiveErrors':: d.fn(help='"The percentage chance that a host will be actually ejected when an outlier\\nstatus is detected through consecutive 5xx. This setting can be used to disable\\nejection or to ramp it up slowly. Defaults to 100."', args=[d.arg(name='enforcingConsecutiveErrors', type=d.T.number)]),
        withEnforcingConsecutiveErrors(enforcingConsecutiveErrors): { spec+: { initProvider+: { outlierDetection+: { enforcingConsecutiveErrors: enforcingConsecutiveErrors } } } },
        '#withEnforcingConsecutiveGatewayFailure':: d.fn(help='"The percentage chance that a host will be actually ejected when an outlier\\nstatus is detected through consecutive gateway failures. This setting can be\\nused to disable ejection or to ramp it up slowly. Defaults to 0."', args=[d.arg(name='enforcingConsecutiveGatewayFailure', type=d.T.number)]),
        withEnforcingConsecutiveGatewayFailure(enforcingConsecutiveGatewayFailure): { spec+: { initProvider+: { outlierDetection+: { enforcingConsecutiveGatewayFailure: enforcingConsecutiveGatewayFailure } } } },
        '#withEnforcingSuccessRate':: d.fn(help='"The percentage chance that a host will be actually ejected when an outlier\\nstatus is detected through success rate statistics. This setting can be used to\\ndisable ejection or to ramp it up slowly. Defaults to 100."', args=[d.arg(name='enforcingSuccessRate', type=d.T.number)]),
        withEnforcingSuccessRate(enforcingSuccessRate): { spec+: { initProvider+: { outlierDetection+: { enforcingSuccessRate: enforcingSuccessRate } } } },
        '#withMaxEjectionPercent':: d.fn(help='"Maximum percentage of hosts in the load balancing pool for the backend service\\nthat can be ejected. Defaults to 10%."', args=[d.arg(name='maxEjectionPercent', type=d.T.number)]),
        withMaxEjectionPercent(maxEjectionPercent): { spec+: { initProvider+: { outlierDetection+: { maxEjectionPercent: maxEjectionPercent } } } },
        '#withSuccessRateMinimumHosts':: d.fn(help='"The number of hosts in a cluster that must have enough request volume to detect\\nsuccess rate outliers. If the number of hosts is less than this setting, outlier\\ndetection via success rate statistics is not performed for any host in the\\ncluster. Defaults to 5."', args=[d.arg(name='successRateMinimumHosts', type=d.T.number)]),
        withSuccessRateMinimumHosts(successRateMinimumHosts): { spec+: { initProvider+: { outlierDetection+: { successRateMinimumHosts: successRateMinimumHosts } } } },
        '#withSuccessRateRequestVolume':: d.fn(help='"The minimum number of total requests that must be collected in one interval (as\\ndefined by the interval duration above) to include this host in success rate\\nbased outlier detection. If the volume is lower than this setting, outlier\\ndetection via success rate statistics is not performed for that host. Defaults\\nto 100."', args=[d.arg(name='successRateRequestVolume', type=d.T.number)]),
        withSuccessRateRequestVolume(successRateRequestVolume): { spec+: { initProvider+: { outlierDetection+: { successRateRequestVolume: successRateRequestVolume } } } },
        '#withSuccessRateStdevFactor':: d.fn(help='"This factor is used to determine the ejection threshold for success rate outlier\\nejection. The ejection threshold is the difference between the mean success\\nrate, and the product of this factor and the standard deviation of the mean\\nsuccess rate: mean - (stdev * success_rate_stdev_factor). This factor is divided\\nby a thousand to get a double. That is, if the desired factor is 1.9, the\\nruntime value should be 1900. Defaults to 1900."', args=[d.arg(name='successRateStdevFactor', type=d.T.number)]),
        withSuccessRateStdevFactor(successRateStdevFactor): { spec+: { initProvider+: { outlierDetection+: { successRateStdevFactor: successRateStdevFactor } } } },
      },
      '#securitySettings':: d.obj(help='"The security settings that apply to this backend service. This field is applicable to either\\na regional backend service with the service_protocol set to HTTP, HTTPS, or HTTP2, and\\nload_balancing_scheme set to INTERNAL_MANAGED; or a global backend service with the\\nload_balancing_scheme set to INTERNAL_SELF_MANAGED.\\nStructure is documented below."'),
      securitySettings: {
        '#awsV4Authentication':: d.obj(help="\"The configuration needed to generate a signature for access to private storage buckets that support AWS's Signature Version 4 for authentication.\\nAllowed only for INTERNET_IP_PORT and INTERNET_FQDN_PORT NEG backends.\\nStructure is documented below.\""),
        awsV4Authentication: {
          '#accessKeySecretRef':: d.obj(help='"The access key used for s3 bucket authentication.\\nRequired for updating or creating a backend that uses AWS v4 signature authentication, but will not be returned as part of the configuration when queried with a REST API GET request.\\nNote: This property is sensitive and will not be displayed in the plan."'),
          accessKeySecretRef: {
            '#withKey':: d.fn(help='"The key to select."', args=[d.arg(name='key', type=d.T.string)]),
            withKey(key): { spec+: { initProvider+: { securitySettings+: { awsV4Authentication+: { accessKeySecretRef+: { key: key } } } } } },
            '#withName':: d.fn(help='"Name of the secret."', args=[d.arg(name='name', type=d.T.string)]),
            withName(name): { spec+: { initProvider+: { securitySettings+: { awsV4Authentication+: { accessKeySecretRef+: { name: name } } } } } },
            '#withNamespace':: d.fn(help='"Namespace of the secret."', args=[d.arg(name='namespace', type=d.T.string)]),
            withNamespace(namespace): { spec+: { initProvider+: { securitySettings+: { awsV4Authentication+: { accessKeySecretRef+: { namespace: namespace } } } } } },
          },
          '#withAccessKeyId':: d.fn(help='"The identifier of an access key used for s3 bucket authentication."', args=[d.arg(name='accessKeyId', type=d.T.string)]),
          withAccessKeyId(accessKeyId): { spec+: { initProvider+: { securitySettings+: { awsV4Authentication+: { accessKeyId: accessKeyId } } } } },
          '#withAccessKeyVersion':: d.fn(help='"The optional version identifier for the access key. You can use this to keep track of different iterations of your access key."', args=[d.arg(name='accessKeyVersion', type=d.T.string)]),
          withAccessKeyVersion(accessKeyVersion): { spec+: { initProvider+: { securitySettings+: { awsV4Authentication+: { accessKeyVersion: accessKeyVersion } } } } },
          '#withOriginRegion':: d.fn(help='"The name of the cloud region of your origin. This is a free-form field with the name of the region your cloud uses to host your origin.\\nFor example, \\"us-east-1\\" for AWS or \\"us-ashburn-1\\" for OCI."', args=[d.arg(name='originRegion', type=d.T.string)]),
          withOriginRegion(originRegion): { spec+: { initProvider+: { securitySettings+: { awsV4Authentication+: { originRegion: originRegion } } } } },
        },
        '#withClientTlsPolicy':: d.fn(help='"ClientTlsPolicy is a resource that specifies how a client should authenticate\\nconnections to backends of a service. This resource itself does not affect\\nconfiguration unless it is attached to a backend service resource."', args=[d.arg(name='clientTlsPolicy', type=d.T.string)]),
        withClientTlsPolicy(clientTlsPolicy): { spec+: { initProvider+: { securitySettings+: { clientTlsPolicy: clientTlsPolicy } } } },
        '#withSubjectAltNames':: d.fn(help="\"A list of alternate names to verify the subject identity in the certificate.\\nIf specified, the client will verify that the server certificate's subject\\nalt name matches one of the specified values.\"", args=[d.arg(name='subjectAltNames', type=d.T.array)]),
        withSubjectAltNames(subjectAltNames): { spec+: { initProvider+: { securitySettings+: { subjectAltNames: if std.isArray(v=subjectAltNames) then subjectAltNames else [subjectAltNames] } } } },
        '#withSubjectAltNamesMixin':: d.fn(help="\"A list of alternate names to verify the subject identity in the certificate.\\nIf specified, the client will verify that the server certificate's subject\\nalt name matches one of the specified values.\"\n\n**Note:** This function appends passed data to existing values", args=[d.arg(name='subjectAltNames', type=d.T.array)]),
        withSubjectAltNamesMixin(subjectAltNames): { spec+: { initProvider+: { securitySettings+: { subjectAltNames+: if std.isArray(v=subjectAltNames) then subjectAltNames else [subjectAltNames] } } } },
      },
      '#withAffinityCookieTtlSec':: d.fn(help='"Lifetime of cookies in seconds if session_affinity is\\nGENERATED_COOKIE. If set to 0, the cookie is non-persistent and lasts\\nonly until the end of the browser session (or equivalent). The\\nmaximum allowed value for TTL is one day.\\nWhen the load balancing scheme is INTERNAL, this field is not used."', args=[d.arg(name='affinityCookieTtlSec', type=d.T.number)]),
      withAffinityCookieTtlSec(affinityCookieTtlSec): { spec+: { initProvider+: { affinityCookieTtlSec: affinityCookieTtlSec } } },
      '#withBackend':: d.fn(help='"The set of backends that serve this BackendService.\\nStructure is documented below."', args=[d.arg(name='backend', type=d.T.array)]),
      withBackend(backend): { spec+: { initProvider+: { backend: if std.isArray(v=backend) then backend else [backend] } } },
      '#withBackendMixin':: d.fn(help='"The set of backends that serve this BackendService.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='backend', type=d.T.array)]),
      withBackendMixin(backend): { spec+: { initProvider+: { backend+: if std.isArray(v=backend) then backend else [backend] } } },
      '#withCompressionMode':: d.fn(help="\"Compress text responses using Brotli or gzip compression, based on the client's Accept-Encoding header.\\nPossible values are: AUTOMATIC, DISABLED.\"", args=[d.arg(name='compressionMode', type=d.T.string)]),
      withCompressionMode(compressionMode): { spec+: { initProvider+: { compressionMode: compressionMode } } },
      '#withConnectionDrainingTimeoutSec':: d.fn(help='"Time for which instance will be drained (not accept new\\nconnections, but still work to finish started)."', args=[d.arg(name='connectionDrainingTimeoutSec', type=d.T.number)]),
      withConnectionDrainingTimeoutSec(connectionDrainingTimeoutSec): { spec+: { initProvider+: { connectionDrainingTimeoutSec: connectionDrainingTimeoutSec } } },
      '#withCustomRequestHeaders':: d.fn(help='"Headers that the HTTP/S load balancer should add to proxied\\nrequests."', args=[d.arg(name='customRequestHeaders', type=d.T.array)]),
      withCustomRequestHeaders(customRequestHeaders): { spec+: { initProvider+: { customRequestHeaders: if std.isArray(v=customRequestHeaders) then customRequestHeaders else [customRequestHeaders] } } },
      '#withCustomRequestHeadersMixin':: d.fn(help='"Headers that the HTTP/S load balancer should add to proxied\\nrequests."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='customRequestHeaders', type=d.T.array)]),
      withCustomRequestHeadersMixin(customRequestHeaders): { spec+: { initProvider+: { customRequestHeaders+: if std.isArray(v=customRequestHeaders) then customRequestHeaders else [customRequestHeaders] } } },
      '#withCustomResponseHeaders':: d.fn(help='"Headers that the HTTP/S load balancer should add to proxied\\nresponses."', args=[d.arg(name='customResponseHeaders', type=d.T.array)]),
      withCustomResponseHeaders(customResponseHeaders): { spec+: { initProvider+: { customResponseHeaders: if std.isArray(v=customResponseHeaders) then customResponseHeaders else [customResponseHeaders] } } },
      '#withCustomResponseHeadersMixin':: d.fn(help='"Headers that the HTTP/S load balancer should add to proxied\\nresponses."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='customResponseHeaders', type=d.T.array)]),
      withCustomResponseHeadersMixin(customResponseHeaders): { spec+: { initProvider+: { customResponseHeaders+: if std.isArray(v=customResponseHeaders) then customResponseHeaders else [customResponseHeaders] } } },
      '#withDescription':: d.fn(help='"An optional description of this resource."', args=[d.arg(name='description', type=d.T.string)]),
      withDescription(description): { spec+: { initProvider+: { description: description } } },
      '#withEdgeSecurityPolicy':: d.fn(help='"The resource URL for the edge security policy associated with this backend service."', args=[d.arg(name='edgeSecurityPolicy', type=d.T.string)]),
      withEdgeSecurityPolicy(edgeSecurityPolicy): { spec+: { initProvider+: { edgeSecurityPolicy: edgeSecurityPolicy } } },
      '#withEnableCdn':: d.fn(help='"If true, enable Cloud CDN for this BackendService."', args=[d.arg(name='enableCdn', type=d.T.boolean)]),
      withEnableCdn(enableCdn): { spec+: { initProvider+: { enableCdn: enableCdn } } },
      '#withHealthChecks':: d.fn(help='"The set of URLs to the HttpHealthCheck or HttpsHealthCheck resource\\nfor health checking this BackendService. Currently at most one health\\ncheck can be specified.\\nA health check must be specified unless the backend service uses an internet\\nor serverless NEG as a backend.\\nFor internal load balancing, a URL to a HealthCheck resource must be specified instead."', args=[d.arg(name='healthChecks', type=d.T.array)]),
      withHealthChecks(healthChecks): { spec+: { initProvider+: { healthChecks: if std.isArray(v=healthChecks) then healthChecks else [healthChecks] } } },
      '#withHealthChecksMixin':: d.fn(help='"The set of URLs to the HttpHealthCheck or HttpsHealthCheck resource\\nfor health checking this BackendService. Currently at most one health\\ncheck can be specified.\\nA health check must be specified unless the backend service uses an internet\\nor serverless NEG as a backend.\\nFor internal load balancing, a URL to a HealthCheck resource must be specified instead."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='healthChecks', type=d.T.array)]),
      withHealthChecksMixin(healthChecks): { spec+: { initProvider+: { healthChecks+: if std.isArray(v=healthChecks) then healthChecks else [healthChecks] } } },
      '#withHealthChecksRefs':: d.fn(help='"References to HealthCheck in compute to populate healthChecks."', args=[d.arg(name='healthChecksRefs', type=d.T.array)]),
      withHealthChecksRefs(healthChecksRefs): { spec+: { initProvider+: { healthChecksRefs: if std.isArray(v=healthChecksRefs) then healthChecksRefs else [healthChecksRefs] } } },
      '#withHealthChecksRefsMixin':: d.fn(help='"References to HealthCheck in compute to populate healthChecks."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='healthChecksRefs', type=d.T.array)]),
      withHealthChecksRefsMixin(healthChecksRefs): { spec+: { initProvider+: { healthChecksRefs+: if std.isArray(v=healthChecksRefs) then healthChecksRefs else [healthChecksRefs] } } },
      '#withLoadBalancingScheme':: d.fn(help='"Indicates whether the backend service will be used with internal or\\nexternal load balancing. A backend service created for one type of\\nload balancing cannot be used with the other. For more information, refer to\\nChoosing a load balancer.\\nDefault value is EXTERNAL.\\nPossible values are: EXTERNAL, INTERNAL_SELF_MANAGED, INTERNAL_MANAGED, EXTERNAL_MANAGED."', args=[d.arg(name='loadBalancingScheme', type=d.T.string)]),
      withLoadBalancingScheme(loadBalancingScheme): { spec+: { initProvider+: { loadBalancingScheme: loadBalancingScheme } } },
      '#withLocalityLbPolicies':: d.fn(help='"A list of locality load balancing policies to be used in order of\\npreference. Either the policy or the customPolicy field should be set.\\nOverrides any value set in the localityLbPolicy field.\\nlocalityLbPolicies is only supported when the BackendService is referenced\\nby a URL Map that is referenced by a target gRPC proxy that has the\\nvalidateForProxyless field set to true.\\nStructure is documented below."', args=[d.arg(name='localityLbPolicies', type=d.T.array)]),
      withLocalityLbPolicies(localityLbPolicies): { spec+: { initProvider+: { localityLbPolicies: if std.isArray(v=localityLbPolicies) then localityLbPolicies else [localityLbPolicies] } } },
      '#withLocalityLbPoliciesMixin':: d.fn(help='"A list of locality load balancing policies to be used in order of\\npreference. Either the policy or the customPolicy field should be set.\\nOverrides any value set in the localityLbPolicy field.\\nlocalityLbPolicies is only supported when the BackendService is referenced\\nby a URL Map that is referenced by a target gRPC proxy that has the\\nvalidateForProxyless field set to true.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='localityLbPolicies', type=d.T.array)]),
      withLocalityLbPoliciesMixin(localityLbPolicies): { spec+: { initProvider+: { localityLbPolicies+: if std.isArray(v=localityLbPolicies) then localityLbPolicies else [localityLbPolicies] } } },
      '#withLocalityLbPolicy':: d.fn(help='"The load balancing algorithm used within the scope of the locality.\\nThe possible values are:"', args=[d.arg(name='localityLbPolicy', type=d.T.string)]),
      withLocalityLbPolicy(localityLbPolicy): { spec+: { initProvider+: { localityLbPolicy: localityLbPolicy } } },
      '#withPortName':: d.fn(help='"Name of backend port. The same name should appear in the instance\\ngroups referenced by this service. Required when the load balancing\\nscheme is EXTERNAL."', args=[d.arg(name='portName', type=d.T.string)]),
      withPortName(portName): { spec+: { initProvider+: { portName: portName } } },
      '#withProject':: d.fn(help='"The ID of the project in which the resource belongs.\\nIf it is not provided, the provider project is used."', args=[d.arg(name='project', type=d.T.string)]),
      withProject(project): { spec+: { initProvider+: { project: project } } },
      '#withProtocol':: d.fn(help='"The protocol this BackendService uses to communicate with backends.\\nThe default is HTTP. NOTE: HTTP2 is only valid for beta HTTP/2 load balancer\\ntypes and may result in errors if used with the GA API. NOTE: With protocol “UNSPECIFIED”,\\nthe backend service can be used by Layer 4 Internal Load Balancing or Network Load Balancing\\nwith TCP/UDP/L3_DEFAULT Forwarding Rule protocol.\\nPossible values are: HTTP, HTTPS, HTTP2, TCP, SSL, GRPC, UNSPECIFIED."', args=[d.arg(name='protocol', type=d.T.string)]),
      withProtocol(protocol): { spec+: { initProvider+: { protocol: protocol } } },
      '#withSecurityPolicy':: d.fn(help='"The security policy associated with this backend service."', args=[d.arg(name='securityPolicy', type=d.T.string)]),
      withSecurityPolicy(securityPolicy): { spec+: { initProvider+: { securityPolicy: securityPolicy } } },
      '#withServiceLbPolicy':: d.fn(help='"URL to networkservices.ServiceLbPolicy resource.\\nCan only be set if load balancing scheme is EXTERNAL, EXTERNAL_MANAGED, INTERNAL_MANAGED or INTERNAL_SELF_MANAGED and the scope is global."', args=[d.arg(name='serviceLbPolicy', type=d.T.string)]),
      withServiceLbPolicy(serviceLbPolicy): { spec+: { initProvider+: { serviceLbPolicy: serviceLbPolicy } } },
      '#withSessionAffinity':: d.fn(help='"Type of session affinity to use. The default is NONE. Session affinity is\\nnot applicable if the protocol is UDP.\\nPossible values are: NONE, CLIENT_IP, CLIENT_IP_PORT_PROTO, CLIENT_IP_PROTO, GENERATED_COOKIE, HEADER_FIELD, HTTP_COOKIE."', args=[d.arg(name='sessionAffinity', type=d.T.string)]),
      withSessionAffinity(sessionAffinity): { spec+: { initProvider+: { sessionAffinity: sessionAffinity } } },
      '#withTimeoutSec':: d.fn(help='"The backend service timeout has a different meaning depending on the type of load balancer.\\nFor more information see, Backend service settings.\\nThe default is 30 seconds.\\nThe full range of timeout values allowed goes from 1 through 2,147,483,647 seconds."', args=[d.arg(name='timeoutSec', type=d.T.number)]),
      withTimeoutSec(timeoutSec): { spec+: { initProvider+: { timeoutSec: timeoutSec } } },
    },
    '#providerConfigRef':: d.obj(help='"ProviderConfigReference specifies how the provider that will be used to\\ncreate, observe, update, and delete this managed resource should be\\nconfigured."'),
    providerConfigRef: {
      '#policy':: d.obj(help='"Policies for referencing."'),
      policy: {
        '#withResolution':: d.fn(help="\"Resolution specifies whether resolution of this reference is required.\\nThe default is 'Required', which means the reconcile will fail if the\\nreference cannot be resolved. 'Optional' means this reference will be\\na no-op if it cannot be resolved.\"", args=[d.arg(name='resolution', type=d.T.string)]),
        withResolution(resolution): { spec+: { providerConfigRef+: { policy+: { resolution: resolution } } } },
        '#withResolve':: d.fn(help="\"Resolve specifies when this reference should be resolved. The default\\nis 'IfNotPresent', which will attempt to resolve the reference only when\\nthe corresponding field is not present. Use 'Always' to resolve the\\nreference on every reconcile.\"", args=[d.arg(name='resolve', type=d.T.string)]),
        withResolve(resolve): { spec+: { providerConfigRef+: { policy+: { resolve: resolve } } } },
      },
      '#withName':: d.fn(help='"Name of the referenced object."', args=[d.arg(name='name', type=d.T.string)]),
      withName(name): { spec+: { providerConfigRef+: { name: name } } },
    },
    '#publishConnectionDetailsTo':: d.obj(help='"PublishConnectionDetailsTo specifies the connection secret config which\\ncontains a name, metadata and a reference to secret store config to\\nwhich any connection details for this managed resource should be written.\\nConnection details frequently include the endpoint, username,\\nand password required to connect to the managed resource."'),
    publishConnectionDetailsTo: {
      '#configRef':: d.obj(help='"SecretStoreConfigRef specifies which secret store config should be used\\nfor this ConnectionSecret."'),
      configRef: {
        '#policy':: d.obj(help='"Policies for referencing."'),
        policy: {
          '#withResolution':: d.fn(help="\"Resolution specifies whether resolution of this reference is required.\\nThe default is 'Required', which means the reconcile will fail if the\\nreference cannot be resolved. 'Optional' means this reference will be\\na no-op if it cannot be resolved.\"", args=[d.arg(name='resolution', type=d.T.string)]),
          withResolution(resolution): { spec+: { publishConnectionDetailsTo+: { configRef+: { policy+: { resolution: resolution } } } } },
          '#withResolve':: d.fn(help="\"Resolve specifies when this reference should be resolved. The default\\nis 'IfNotPresent', which will attempt to resolve the reference only when\\nthe corresponding field is not present. Use 'Always' to resolve the\\nreference on every reconcile.\"", args=[d.arg(name='resolve', type=d.T.string)]),
          withResolve(resolve): { spec+: { publishConnectionDetailsTo+: { configRef+: { policy+: { resolve: resolve } } } } },
        },
        '#withName':: d.fn(help='"Name of the referenced object."', args=[d.arg(name='name', type=d.T.string)]),
        withName(name): { spec+: { publishConnectionDetailsTo+: { configRef+: { name: name } } } },
      },
