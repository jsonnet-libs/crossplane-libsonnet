                  withNanos(nanos): { routeAction+: { faultInjectionPolicy+: { delay+: { fixedDelay+: { nanos: nanos } } } } },
                  '#withSeconds':: d.fn(help='"Span of time at a resolution of a second. Must be from 0 to 315,576,000,000\\ninclusive."', args=[d.arg(name='seconds', type=d.T.string)]),
                  withSeconds(seconds): { routeAction+: { faultInjectionPolicy+: { delay+: { fixedDelay+: { seconds: seconds } } } } },
                },
