      withHostRule(hostRule): { spec+: { forProvider+: { hostRule: if std.isArray(v=hostRule) then hostRule else [hostRule] } } },
      '#withHostRuleMixin':: d.fn(help='"The list of HostRules to use against the URL.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='hostRule', type=d.T.array)]),
