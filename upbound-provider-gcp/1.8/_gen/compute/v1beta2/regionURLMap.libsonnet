              '#withPrefixMatch':: d.fn(help="\"For satisfying the matchRule condition, the request's path must begin with the\\nspecified prefixMatch. prefixMatch must begin with a /. The value must be\\nbetween 1 and 1024 characters. Only one of prefixMatch, fullPathMatch or\\nregexMatch must be specified.\"", args=[d.arg(name='prefixMatch', type=d.T.string)]),
              withPrefixMatch(prefixMatch): { prefixMatch: prefixMatch },
              '#withPresentMatch':: d.fn(help='"Specifies that the queryParameterMatch matches if the request contains the query\\nparameter, irrespective of whether the parameter has a value or not. Only one of\\npresentMatch, exactMatch and regexMatch must be set."', args=[d.arg(name='presentMatch', type=d.T.boolean)]),
              withPresentMatch(presentMatch): { presentMatch: presentMatch },
              '#withRegexMatch':: d.fn(help='"The queryParameterMatch matches if the value of the parameter matches the\\nregular expression specified by regexMatch. For the regular expression grammar,\\nplease see en.cppreference.com/w/cpp/regex/ecmascript  Only one of presentMatch,\\nexactMatch and regexMatch must be set."', args=[d.arg(name='regexMatch', type=d.T.string)]),
              withRegexMatch(regexMatch): { regexMatch: regexMatch },
              '#withSuffixMatch':: d.fn(help='"The value of the header must end with the contents of suffixMatch. Only one of\\nexactMatch, prefixMatch, suffixMatch, regexMatch, presentMatch or rangeMatch\\nmust be set."', args=[d.arg(name='suffixMatch', type=d.T.string)]),
              withSuffixMatch(suffixMatch): { suffixMatch: suffixMatch },
            },
            '#metadataFilters':: d.obj(help='"Opaque filter criteria used by Loadbalancer to restrict routing configuration to\\na limited set xDS compliant clients. In their xDS requests to Loadbalancer, xDS\\nclients present node metadata. If a match takes place, the relevant routing\\nconfiguration is made available to those proxies. For each metadataFilter in\\nthis list, if its filterMatchCriteria is set to MATCH_ANY, at least one of the\\nfilterLabels must match the corresponding label provided in the metadata. If its\\nfilterMatchCriteria is set to MATCH_ALL, then all of its filterLabels must match\\nwith corresponding labels in the provided metadata. metadataFilters specified\\nhere can be overrides those specified in ForwardingRule that refers to this\\nUrlMap. metadataFilters only applies to Loadbalancers that have their\\nloadBalancingScheme set to INTERNAL_SELF_MANAGED.\\nStructure is documented below."'),
            metadataFilters: {
              '#filterLabels':: d.obj(help='"The list of label value pairs that must match labels in the provided metadata\\nbased on filterMatchCriteria  This list must not be empty and can have at the\\nmost 64 entries.\\nStructure is documented below."'),
              filterLabels: {
                '#withName':: d.fn(help='"The name of the query parameter to match. The query parameter must exist in the\\nrequest, in the absence of which the request match fails."', args=[d.arg(name='name', type=d.T.string)]),
                withName(name): { name: name },
                '#withValue':: d.fn(help='"The value of the label must match the specified value. value can have a maximum\\nlength of 1024 characters."', args=[d.arg(name='value', type=d.T.string)]),
                withValue(value): { value: value },
              },
              '#withFilterLabels':: d.fn(help='"The list of label value pairs that must match labels in the provided metadata\\nbased on filterMatchCriteria  This list must not be empty and can have at the\\nmost 64 entries.\\nStructure is documented below."', args=[d.arg(name='filterLabels', type=d.T.array)]),
              withFilterLabels(filterLabels): { filterLabels: if std.isArray(v=filterLabels) then filterLabels else [filterLabels] },
              '#withFilterLabelsMixin':: d.fn(help='"The list of label value pairs that must match labels in the provided metadata\\nbased on filterMatchCriteria  This list must not be empty and can have at the\\nmost 64 entries.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='filterLabels', type=d.T.array)]),
              withFilterLabelsMixin(filterLabels): { filterLabels+: if std.isArray(v=filterLabels) then filterLabels else [filterLabels] },
              '#withFilterMatchCriteria':: d.fn(help='"Specifies how individual filterLabel matches within the list of filterLabels\\ncontribute towards the overall metadataFilter match. Supported values are:"', args=[d.arg(name='filterMatchCriteria', type=d.T.string)]),
              withFilterMatchCriteria(filterMatchCriteria): { filterMatchCriteria: filterMatchCriteria },
            },
            '#queryParameterMatches':: d.obj(help='"Specifies a list of query parameter match criteria, all of which must match\\ncorresponding query parameters in the request.\\nStructure is documented below."'),
            queryParameterMatches: {
              '#withExactMatch':: d.fn(help='"The queryParameterMatch matches if the value of the parameter exactly matches\\nthe contents of exactMatch. Only one of presentMatch, exactMatch and regexMatch\\nmust be set."', args=[d.arg(name='exactMatch', type=d.T.string)]),
              withExactMatch(exactMatch): { exactMatch: exactMatch },
              '#withName':: d.fn(help='"The name of the query parameter to match. The query parameter must exist in the\\nrequest, in the absence of which the request match fails."', args=[d.arg(name='name', type=d.T.string)]),
              withName(name): { name: name },
              '#withPresentMatch':: d.fn(help='"Specifies that the queryParameterMatch matches if the request contains the query\\nparameter, irrespective of whether the parameter has a value or not. Only one of\\npresentMatch, exactMatch and regexMatch must be set."', args=[d.arg(name='presentMatch', type=d.T.boolean)]),
              withPresentMatch(presentMatch): { presentMatch: presentMatch },
              '#withRegexMatch':: d.fn(help='"The queryParameterMatch matches if the value of the parameter matches the\\nregular expression specified by regexMatch. For the regular expression grammar,\\nplease see en.cppreference.com/w/cpp/regex/ecmascript  Only one of presentMatch,\\nexactMatch and regexMatch must be set."', args=[d.arg(name='regexMatch', type=d.T.string)]),
              withRegexMatch(regexMatch): { regexMatch: regexMatch },
            },
            '#withFullPathMatch':: d.fn(help='"For satisfying the matchRule condition, the path of the request must exactly\\nmatch the value specified in fullPathMatch after removing any query parameters\\nand anchor that may be part of the original URL. FullPathMatch must be between 1\\nand 1024 characters. Only one of prefixMatch, fullPathMatch or regexMatch must\\nbe specified."', args=[d.arg(name='fullPathMatch', type=d.T.string)]),
            withFullPathMatch(fullPathMatch): { fullPathMatch: fullPathMatch },
            '#withHeaderMatches':: d.fn(help='"Specifies a list of header match criteria, all of which must match corresponding\\nheaders in the request.\\nStructure is documented below."', args=[d.arg(name='headerMatches', type=d.T.array)]),
            withHeaderMatches(headerMatches): { headerMatches: if std.isArray(v=headerMatches) then headerMatches else [headerMatches] },
            '#withHeaderMatchesMixin':: d.fn(help='"Specifies a list of header match criteria, all of which must match corresponding\\nheaders in the request.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='headerMatches', type=d.T.array)]),
            withHeaderMatchesMixin(headerMatches): { headerMatches+: if std.isArray(v=headerMatches) then headerMatches else [headerMatches] },
            '#withIgnoreCase':: d.fn(help='"Specifies that prefixMatch and fullPathMatch matches are case sensitive.\\nDefaults to false."', args=[d.arg(name='ignoreCase', type=d.T.boolean)]),
            withIgnoreCase(ignoreCase): { ignoreCase: ignoreCase },
            '#withMetadataFilters':: d.fn(help='"Opaque filter criteria used by Loadbalancer to restrict routing configuration to\\na limited set xDS compliant clients. In their xDS requests to Loadbalancer, xDS\\nclients present node metadata. If a match takes place, the relevant routing\\nconfiguration is made available to those proxies. For each metadataFilter in\\nthis list, if its filterMatchCriteria is set to MATCH_ANY, at least one of the\\nfilterLabels must match the corresponding label provided in the metadata. If its\\nfilterMatchCriteria is set to MATCH_ALL, then all of its filterLabels must match\\nwith corresponding labels in the provided metadata. metadataFilters specified\\nhere can be overrides those specified in ForwardingRule that refers to this\\nUrlMap. metadataFilters only applies to Loadbalancers that have their\\nloadBalancingScheme set to INTERNAL_SELF_MANAGED.\\nStructure is documented below."', args=[d.arg(name='metadataFilters', type=d.T.array)]),
            withMetadataFilters(metadataFilters): { metadataFilters: if std.isArray(v=metadataFilters) then metadataFilters else [metadataFilters] },
            '#withMetadataFiltersMixin':: d.fn(help='"Opaque filter criteria used by Loadbalancer to restrict routing configuration to\\na limited set xDS compliant clients. In their xDS requests to Loadbalancer, xDS\\nclients present node metadata. If a match takes place, the relevant routing\\nconfiguration is made available to those proxies. For each metadataFilter in\\nthis list, if its filterMatchCriteria is set to MATCH_ANY, at least one of the\\nfilterLabels must match the corresponding label provided in the metadata. If its\\nfilterMatchCriteria is set to MATCH_ALL, then all of its filterLabels must match\\nwith corresponding labels in the provided metadata. metadataFilters specified\\nhere can be overrides those specified in ForwardingRule that refers to this\\nUrlMap. metadataFilters only applies to Loadbalancers that have their\\nloadBalancingScheme set to INTERNAL_SELF_MANAGED.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='metadataFilters', type=d.T.array)]),
            withMetadataFiltersMixin(metadataFilters): { metadataFilters+: if std.isArray(v=metadataFilters) then metadataFilters else [metadataFilters] },
            '#withPathTemplateMatch':: d.fn(help='"For satisfying the matchRule condition, the path of the request\\nmust match the wildcard pattern specified in pathTemplateMatch\\nafter removing any query parameters and anchor that may be part\\nof the original URL.\\npathTemplateMatch must be between 1 and 255 characters\\n(inclusive).  The pattern specified by pathTemplateMatch may\\nhave at most 5 wildcard operators and at most 5 variable\\ncaptures in total."', args=[d.arg(name='pathTemplateMatch', type=d.T.string)]),
            withPathTemplateMatch(pathTemplateMatch): { pathTemplateMatch: pathTemplateMatch },
            '#withPrefixMatch':: d.fn(help="\"For satisfying the matchRule condition, the request's path must begin with the\\nspecified prefixMatch. prefixMatch must begin with a /. The value must be\\nbetween 1 and 1024 characters. Only one of prefixMatch, fullPathMatch or\\nregexMatch must be specified.\"", args=[d.arg(name='prefixMatch', type=d.T.string)]),
            withPrefixMatch(prefixMatch): { prefixMatch: prefixMatch },
            '#withQueryParameterMatches':: d.fn(help='"Specifies a list of query parameter match criteria, all of which must match\\ncorresponding query parameters in the request.\\nStructure is documented below."', args=[d.arg(name='queryParameterMatches', type=d.T.array)]),
            withQueryParameterMatches(queryParameterMatches): { queryParameterMatches: if std.isArray(v=queryParameterMatches) then queryParameterMatches else [queryParameterMatches] },
            '#withQueryParameterMatchesMixin':: d.fn(help='"Specifies a list of query parameter match criteria, all of which must match\\ncorresponding query parameters in the request.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='queryParameterMatches', type=d.T.array)]),
            withQueryParameterMatchesMixin(queryParameterMatches): { queryParameterMatches+: if std.isArray(v=queryParameterMatches) then queryParameterMatches else [queryParameterMatches] },
            '#withRegexMatch':: d.fn(help='"The queryParameterMatch matches if the value of the parameter matches the\\nregular expression specified by regexMatch. For the regular expression grammar,\\nplease see en.cppreference.com/w/cpp/regex/ecmascript  Only one of presentMatch,\\nexactMatch and regexMatch must be set."', args=[d.arg(name='regexMatch', type=d.T.string)]),
            withRegexMatch(regexMatch): { regexMatch: regexMatch },
          },
          '#routeAction':: d.obj(help='"In response to a matching matchRule, the load balancer performs advanced routing\\nactions like URL rewrites, header transformations, etc. prior to forwarding the\\nrequest to the selected backend. If  routeAction specifies any\\nweightedBackendServices, service must not be set. Conversely if service is set,\\nrouteAction cannot contain any  weightedBackendServices. Only one of routeAction\\nor urlRedirect must be set.\\nStructure is documented below."'),
          routeAction: {
            '#corsPolicy':: d.obj(help='"The specification for allowing client side cross-origin requests. Please see W3C\\nRecommendation for Cross Origin Resource Sharing\\nStructure is documented below."'),
            corsPolicy: {
              '#withAllowCredentials':: d.fn(help='"In response to a preflight request, setting this to true indicates that the\\nactual request can include user credentials. This translates to the Access-\\nControl-Allow-Credentials header. Defaults to false."', args=[d.arg(name='allowCredentials', type=d.T.boolean)]),
              withAllowCredentials(allowCredentials): { routeAction+: { corsPolicy+: { allowCredentials: allowCredentials } } },
              '#withAllowHeaders':: d.fn(help='"Specifies the content for the Access-Control-Allow-Headers header."', args=[d.arg(name='allowHeaders', type=d.T.array)]),
              withAllowHeaders(allowHeaders): { routeAction+: { corsPolicy+: { allowHeaders: if std.isArray(v=allowHeaders) then allowHeaders else [allowHeaders] } } },
              '#withAllowHeadersMixin':: d.fn(help='"Specifies the content for the Access-Control-Allow-Headers header."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='allowHeaders', type=d.T.array)]),
              withAllowHeadersMixin(allowHeaders): { routeAction+: { corsPolicy+: { allowHeaders+: if std.isArray(v=allowHeaders) then allowHeaders else [allowHeaders] } } },
              '#withAllowMethods':: d.fn(help='"Specifies the content for the Access-Control-Allow-Methods header."', args=[d.arg(name='allowMethods', type=d.T.array)]),
              withAllowMethods(allowMethods): { routeAction+: { corsPolicy+: { allowMethods: if std.isArray(v=allowMethods) then allowMethods else [allowMethods] } } },
              '#withAllowMethodsMixin':: d.fn(help='"Specifies the content for the Access-Control-Allow-Methods header."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='allowMethods', type=d.T.array)]),
              withAllowMethodsMixin(allowMethods): { routeAction+: { corsPolicy+: { allowMethods+: if std.isArray(v=allowMethods) then allowMethods else [allowMethods] } } },
              '#withAllowOriginRegexes':: d.fn(help='"Specifies the regular expression patterns that match allowed origins. For\\nregular expression grammar please see en.cppreference.com/w/cpp/regex/ecmascript\\nAn origin is allowed if it matches either allow_origins or allow_origin_regex."', args=[d.arg(name='allowOriginRegexes', type=d.T.array)]),
              withAllowOriginRegexes(allowOriginRegexes): { routeAction+: { corsPolicy+: { allowOriginRegexes: if std.isArray(v=allowOriginRegexes) then allowOriginRegexes else [allowOriginRegexes] } } },
              '#withAllowOriginRegexesMixin':: d.fn(help='"Specifies the regular expression patterns that match allowed origins. For\\nregular expression grammar please see en.cppreference.com/w/cpp/regex/ecmascript\\nAn origin is allowed if it matches either allow_origins or allow_origin_regex."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='allowOriginRegexes', type=d.T.array)]),
              withAllowOriginRegexesMixin(allowOriginRegexes): { routeAction+: { corsPolicy+: { allowOriginRegexes+: if std.isArray(v=allowOriginRegexes) then allowOriginRegexes else [allowOriginRegexes] } } },
              '#withAllowOrigins':: d.fn(help='"Specifies the list of origins that will be allowed to do CORS requests. An\\norigin is allowed if it matches either allow_origins or allow_origin_regex."', args=[d.arg(name='allowOrigins', type=d.T.array)]),
              withAllowOrigins(allowOrigins): { routeAction+: { corsPolicy+: { allowOrigins: if std.isArray(v=allowOrigins) then allowOrigins else [allowOrigins] } } },
              '#withAllowOriginsMixin':: d.fn(help='"Specifies the list of origins that will be allowed to do CORS requests. An\\norigin is allowed if it matches either allow_origins or allow_origin_regex."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='allowOrigins', type=d.T.array)]),
              withAllowOriginsMixin(allowOrigins): { routeAction+: { corsPolicy+: { allowOrigins+: if std.isArray(v=allowOrigins) then allowOrigins else [allowOrigins] } } },
              '#withDisabled':: d.fn(help='"If true, specifies the CORS policy is disabled.\\nwhich indicates that the CORS policy is in effect. Defaults to false."', args=[d.arg(name='disabled', type=d.T.boolean)]),
              withDisabled(disabled): { routeAction+: { corsPolicy+: { disabled: disabled } } },
              '#withExposeHeaders':: d.fn(help='"Specifies the content for the Access-Control-Expose-Headers header."', args=[d.arg(name='exposeHeaders', type=d.T.array)]),
              withExposeHeaders(exposeHeaders): { routeAction+: { corsPolicy+: { exposeHeaders: if std.isArray(v=exposeHeaders) then exposeHeaders else [exposeHeaders] } } },
              '#withExposeHeadersMixin':: d.fn(help='"Specifies the content for the Access-Control-Expose-Headers header."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='exposeHeaders', type=d.T.array)]),
              withExposeHeadersMixin(exposeHeaders): { routeAction+: { corsPolicy+: { exposeHeaders+: if std.isArray(v=exposeHeaders) then exposeHeaders else [exposeHeaders] } } },
              '#withMaxAge':: d.fn(help='"Specifies how long the results of a preflight request can be cached. This\\ntranslates to the content for the Access-Control-Max-Age header."', args=[d.arg(name='maxAge', type=d.T.number)]),
              withMaxAge(maxAge): { routeAction+: { corsPolicy+: { maxAge: maxAge } } },
            },
            '#faultInjectionPolicy':: d.obj(help='"The specification for fault injection introduced into traffic to test the\\nresiliency of clients to backend service failure. As part of fault injection,\\nwhen clients send requests to a backend service, delays can be introduced by\\nLoadbalancer on a percentage of requests before sending those request to the\\nbackend service. Similarly requests from clients can be aborted by the\\nLoadbalancer for a percentage of requests. timeout and retry_policy will be\\nignored by clients that are configured with a fault_injection_policy.\\nStructure is documented below."'),
            faultInjectionPolicy: {
              '#abort':: d.obj(help='"The specification for how client requests are aborted as part of fault\\ninjection.\\nStructure is documented below."'),
              abort: {
                '#withHttpStatus':: d.fn(help='"The HTTP status code used to abort the request. The value must be between 200\\nand 599 inclusive."', args=[d.arg(name='httpStatus', type=d.T.number)]),
                withHttpStatus(httpStatus): { routeAction+: { faultInjectionPolicy+: { abort+: { httpStatus: httpStatus } } } },
                '#withPercentage':: d.fn(help='"The percentage of traffic (connections/operations/requests) on which delay will\\nbe introduced as part of fault injection. The value must be between 0.0 and\\n100.0 inclusive."', args=[d.arg(name='percentage', type=d.T.number)]),
                withPercentage(percentage): { routeAction+: { faultInjectionPolicy+: { abort+: { percentage: percentage } } } },
              },
              '#delay':: d.obj(help='"The specification for how client requests are delayed as part of fault\\ninjection, before being sent to a backend service.\\nStructure is documented below."'),
              delay: {
                '#fixedDelay':: d.obj(help='"Specifies the value of the fixed delay interval.\\nStructure is documented below."'),
                fixedDelay: {
                  '#withNanos':: d.fn(help="\"Span of time that's a fraction of a second at nanosecond resolution. Durations\\nless than one second are represented with a 0 seconds field and a positive\\nnanos field. Must be from 0 to 999,999,999 inclusive.\"", args=[d.arg(name='nanos', type=d.T.number)]),
                  withNanos(nanos): { routeAction+: { faultInjectionPolicy+: { delay+: { fixedDelay+: { nanos: nanos } } } } },
                  '#withSeconds':: d.fn(help='"Span of time at a resolution of a second. Must be from 0 to 315,576,000,000\\ninclusive."', args=[d.arg(name='seconds', type=d.T.string)]),
                  withSeconds(seconds): { routeAction+: { faultInjectionPolicy+: { delay+: { fixedDelay+: { seconds: seconds } } } } },
                },
                '#withPercentage':: d.fn(help='"The percentage of traffic (connections/operations/requests) on which delay will\\nbe introduced as part of fault injection. The value must be between 0.0 and\\n100.0 inclusive."', args=[d.arg(name='percentage', type=d.T.number)]),
                withPercentage(percentage): { routeAction+: { faultInjectionPolicy+: { delay+: { percentage: percentage } } } },
              },
            },
            '#requestMirrorPolicy':: d.obj(help="\"Specifies the policy on how requests intended for the route's backends are\\nshadowed to a separate mirrored backend service. Loadbalancer does not wait for\\nresponses from the shadow service. Prior to sending traffic to the shadow\\nservice, the host / authority header is suffixed with -shadow.\\nStructure is documented below.\""),
            requestMirrorPolicy: {
              '#withBackendService':: d.fn(help='"The default RegionBackendService resource. Before\\nforwarding the request to backendService, the loadbalancer applies any relevant\\nheaderActions specified as part of this backendServiceWeight."', args=[d.arg(name='backendService', type=d.T.string)]),
              withBackendService(backendService): { routeAction+: { requestMirrorPolicy+: { backendService: backendService } } },
            },
            '#retryPolicy':: d.obj(help='"Specifies the retry policy associated with this route.\\nStructure is documented below."'),
            retryPolicy: {
              '#perTryTimeout':: d.obj(help='"Specifies a non-zero timeout per retry attempt.\\nStructure is documented below."'),
              perTryTimeout: {
                '#withNanos':: d.fn(help="\"Span of time that's a fraction of a second at nanosecond resolution. Durations\\nless than one second are represented with a 0 seconds field and a positive\\nnanos field. Must be from 0 to 999,999,999 inclusive.\"", args=[d.arg(name='nanos', type=d.T.number)]),
                withNanos(nanos): { routeAction+: { retryPolicy+: { perTryTimeout+: { nanos: nanos } } } },
                '#withSeconds':: d.fn(help='"Span of time at a resolution of a second. Must be from 0 to 315,576,000,000\\ninclusive."', args=[d.arg(name='seconds', type=d.T.string)]),
                withSeconds(seconds): { routeAction+: { retryPolicy+: { perTryTimeout+: { seconds: seconds } } } },
              },
              '#withNumRetries':: d.fn(help='"Specifies the allowed number retries. This number must be > 0."', args=[d.arg(name='numRetries', type=d.T.number)]),
              withNumRetries(numRetries): { routeAction+: { retryPolicy+: { numRetries: numRetries } } },
              '#withRetryConditions':: d.fn(help='"Specifies one or more conditions when this retry rule applies. Valid values are:"', args=[d.arg(name='retryConditions', type=d.T.array)]),
              withRetryConditions(retryConditions): { routeAction+: { retryPolicy+: { retryConditions: if std.isArray(v=retryConditions) then retryConditions else [retryConditions] } } },
              '#withRetryConditionsMixin':: d.fn(help='"Specifies one or more conditions when this retry rule applies. Valid values are:"\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='retryConditions', type=d.T.array)]),
              withRetryConditionsMixin(retryConditions): { routeAction+: { retryPolicy+: { retryConditions+: if std.isArray(v=retryConditions) then retryConditions else [retryConditions] } } },
            },
            '#timeout':: d.obj(help='"Specifies the timeout for the selected route. Timeout is computed from the time\\nthe request is has been fully processed (i.e. end-of-stream) up until the\\nresponse has been completely processed. Timeout includes all retries. If not\\nspecified, the default value is 15 seconds.\\nStructure is documented below."'),
            timeout: {
              '#withNanos':: d.fn(help="\"Span of time that's a fraction of a second at nanosecond resolution. Durations\\nless than one second are represented with a 0 seconds field and a positive\\nnanos field. Must be from 0 to 999,999,999 inclusive.\"", args=[d.arg(name='nanos', type=d.T.number)]),
              withNanos(nanos): { routeAction+: { timeout+: { nanos: nanos } } },
              '#withSeconds':: d.fn(help='"Span of time at a resolution of a second. Must be from 0 to 315,576,000,000\\ninclusive."', args=[d.arg(name='seconds', type=d.T.string)]),
              withSeconds(seconds): { routeAction+: { timeout+: { seconds: seconds } } },
            },
            '#urlRewrite':: d.obj(help='"The spec to modify the URL of the request, prior to forwarding the request to\\nthe matched service\\nStructure is documented below."'),
            urlRewrite: {
              '#withHostRewrite':: d.fn(help="\"Prior to forwarding the request to the selected service, the request's host\\nheader is replaced with contents of hostRewrite. The value must be between 1 and\\n255 characters.\"", args=[d.arg(name='hostRewrite', type=d.T.string)]),
              withHostRewrite(hostRewrite): { routeAction+: { urlRewrite+: { hostRewrite: hostRewrite } } },
              '#withPathPrefixRewrite':: d.fn(help="\"Prior to forwarding the request to the selected backend service, the matching\\nportion of the request's path is replaced by pathPrefixRewrite. The value must\\nbe between 1 and 1024 characters.\"", args=[d.arg(name='pathPrefixRewrite', type=d.T.string)]),
              withPathPrefixRewrite(pathPrefixRewrite): { routeAction+: { urlRewrite+: { pathPrefixRewrite: pathPrefixRewrite } } },
              '#withPathTemplateRewrite':: d.fn(help="\"Prior to forwarding the request to the selected origin, if the\\nrequest matched a pathTemplateMatch, the matching portion of the\\nrequest's path is replaced re-written using the pattern specified\\nby pathTemplateRewrite.\\npathTemplateRewrite must be between 1 and 255 characters\\n(inclusive), must start with a '/', and must only use variables\\ncaptured by the route's pathTemplate matchers.\\npathTemplateRewrite may only be used when all of a route's\\nMatchRules specify pathTemplate.\\nOnly one of pathPrefixRewrite and pathTemplateRewrite may be\\nspecified.\"", args=[d.arg(name='pathTemplateRewrite', type=d.T.string)]),
              withPathTemplateRewrite(pathTemplateRewrite): { routeAction+: { urlRewrite+: { pathTemplateRewrite: pathTemplateRewrite } } },
            },
            '#weightedBackendServices':: d.obj(help='"A list of weighted backend services to send traffic to when a route match\\noccurs. The weights determine the fraction of traffic that flows to their\\ncorresponding backend service. If all traffic needs to go to a single backend\\nservice, there must be one  weightedBackendService with weight set to a non 0\\nnumber. Once a backendService is identified and before forwarding the request to\\nthe backend service, advanced routing actions like Url rewrites and header\\ntransformations are applied depending on additional settings specified in this\\nHttpRouteAction.\\nStructure is documented below."'),
            weightedBackendServices: {
              '#headerAction':: d.obj(help='"Specifies changes to request and response headers that need to take effect for\\nthe selected backendService. headerAction specified here take effect before\\nheaderAction in the enclosing HttpRouteRule, PathMatcher and UrlMap.\\nStructure is documented below."'),
              headerAction: {
                '#requestHeadersToAdd':: d.obj(help='"Headers to add to a matching request prior to forwarding the request to the\\nbackendService.\\nStructure is documented below."'),
                requestHeadersToAdd: {
