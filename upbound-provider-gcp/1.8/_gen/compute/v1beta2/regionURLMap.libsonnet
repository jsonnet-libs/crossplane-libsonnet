      withPathMatcher(pathMatcher): { spec+: { forProvider+: { pathMatcher: if std.isArray(v=pathMatcher) then pathMatcher else [pathMatcher] } } },
      '#withPathMatcherMixin':: d.fn(help='"The list of named PathMatchers to use against the URL.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='pathMatcher', type=d.T.array)]),
      withPathMatcherMixin(pathMatcher): { spec+: { forProvider+: { pathMatcher+: if std.isArray(v=pathMatcher) then pathMatcher else [pathMatcher] } } },
      '#withProject':: d.fn(help='"The ID of the project in which the resource belongs.\\nIf it is not provided, the provider project is used."', args=[d.arg(name='project', type=d.T.string)]),
