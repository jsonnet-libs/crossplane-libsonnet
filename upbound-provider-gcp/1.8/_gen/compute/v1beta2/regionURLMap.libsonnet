        '#withDefaultService':: d.fn(help="\"A reference to a RegionBackendService resource. This will be used if\\nnone of the pathRules defined by this PathMatcher is matched by\\nthe URL's path portion.\"", args=[d.arg(name='defaultService', type=d.T.string)]),
