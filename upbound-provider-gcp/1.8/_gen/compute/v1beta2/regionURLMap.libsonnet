                  '#withHeaderValue':: d.fn(help='"The value of the header to add."', args=[d.arg(name='headerValue', type=d.T.string)]),
                  withHeaderValue(headerValue): { headerValue: headerValue },
                  '#withReplace':: d.fn(help='"If false, headerValue is appended to any values that already exist for the\\nheader. If true, headerValue is set for the header, discarding any values that\\nwere set for that header."', args=[d.arg(name='replace', type=d.T.boolean)]),
                  withReplace(replace): { replace: replace },
                },
                '#responseHeadersToAdd':: d.obj(help='"Headers to add the response prior to sending the response back to the client.\\nStructure is documented below."'),
                responseHeadersToAdd: {
                  '#withHeaderName':: d.fn(help='"The name of the header."', args=[d.arg(name='headerName', type=d.T.string)]),
                  withHeaderName(headerName): { headerName: headerName },
                  '#withHeaderValue':: d.fn(help='"The value of the header to add."', args=[d.arg(name='headerValue', type=d.T.string)]),
                  withHeaderValue(headerValue): { headerValue: headerValue },
                  '#withReplace':: d.fn(help='"If false, headerValue is appended to any values that already exist for the\\nheader. If true, headerValue is set for the header, discarding any values that\\nwere set for that header."', args=[d.arg(name='replace', type=d.T.boolean)]),
                  withReplace(replace): { replace: replace },
                },
                '#withRequestHeadersToAdd':: d.fn(help='"Headers to add to a matching request prior to forwarding the request to the\\nbackendService.\\nStructure is documented below."', args=[d.arg(name='requestHeadersToAdd', type=d.T.array)]),
                withRequestHeadersToAdd(requestHeadersToAdd): { headerAction+: { requestHeadersToAdd: if std.isArray(v=requestHeadersToAdd) then requestHeadersToAdd else [requestHeadersToAdd] } },
                '#withRequestHeadersToAddMixin':: d.fn(help='"Headers to add to a matching request prior to forwarding the request to the\\nbackendService.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='requestHeadersToAdd', type=d.T.array)]),
                withRequestHeadersToAddMixin(requestHeadersToAdd): { headerAction+: { requestHeadersToAdd+: if std.isArray(v=requestHeadersToAdd) then requestHeadersToAdd else [requestHeadersToAdd] } },
                '#withRequestHeadersToRemove':: d.fn(help='"A list of header names for headers that need to be removed from the request\\nprior to forwarding the request to the backendService."', args=[d.arg(name='requestHeadersToRemove', type=d.T.array)]),
                withRequestHeadersToRemove(requestHeadersToRemove): { headerAction+: { requestHeadersToRemove: if std.isArray(v=requestHeadersToRemove) then requestHeadersToRemove else [requestHeadersToRemove] } },
                '#withRequestHeadersToRemoveMixin':: d.fn(help='"A list of header names for headers that need to be removed from the request\\nprior to forwarding the request to the backendService."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='requestHeadersToRemove', type=d.T.array)]),
                withRequestHeadersToRemoveMixin(requestHeadersToRemove): { headerAction+: { requestHeadersToRemove+: if std.isArray(v=requestHeadersToRemove) then requestHeadersToRemove else [requestHeadersToRemove] } },
                '#withResponseHeadersToAdd':: d.fn(help='"Headers to add the response prior to sending the response back to the client.\\nStructure is documented below."', args=[d.arg(name='responseHeadersToAdd', type=d.T.array)]),
                withResponseHeadersToAdd(responseHeadersToAdd): { headerAction+: { responseHeadersToAdd: if std.isArray(v=responseHeadersToAdd) then responseHeadersToAdd else [responseHeadersToAdd] } },
                '#withResponseHeadersToAddMixin':: d.fn(help='"Headers to add the response prior to sending the response back to the client.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='responseHeadersToAdd', type=d.T.array)]),
                withResponseHeadersToAddMixin(responseHeadersToAdd): { headerAction+: { responseHeadersToAdd+: if std.isArray(v=responseHeadersToAdd) then responseHeadersToAdd else [responseHeadersToAdd] } },
                '#withResponseHeadersToRemove':: d.fn(help='"A list of header names for headers that need to be removed from the response\\nprior to sending the response back to the client."', args=[d.arg(name='responseHeadersToRemove', type=d.T.array)]),
                withResponseHeadersToRemove(responseHeadersToRemove): { headerAction+: { responseHeadersToRemove: if std.isArray(v=responseHeadersToRemove) then responseHeadersToRemove else [responseHeadersToRemove] } },
                '#withResponseHeadersToRemoveMixin':: d.fn(help='"A list of header names for headers that need to be removed from the response\\nprior to sending the response back to the client."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='responseHeadersToRemove', type=d.T.array)]),
                withResponseHeadersToRemoveMixin(responseHeadersToRemove): { headerAction+: { responseHeadersToRemove+: if std.isArray(v=responseHeadersToRemove) then responseHeadersToRemove else [responseHeadersToRemove] } },
              },
              '#withBackendService':: d.fn(help='"The default RegionBackendService resource. Before\\nforwarding the request to backendService, the loadbalancer applies any relevant\\nheaderActions specified as part of this backendServiceWeight."', args=[d.arg(name='backendService', type=d.T.string)]),
              withBackendService(backendService): { backendService: backendService },
              '#withWeight':: d.fn(help="\"Specifies the fraction of traffic sent to backendService, computed as weight /\\n(sum of all weightedBackendService weights in routeAction) . The selection of a\\nbackend service is determined only for new traffic. Once a user's request has\\nbeen directed to a backendService, subsequent requests will be sent to the same\\nbackendService as determined by the BackendService's session affinity policy.\\nThe value must be between 0 and 1000\"", args=[d.arg(name='weight', type=d.T.number)]),
              withWeight(weight): { weight: weight },
            },
            '#withWeightedBackendServices':: d.fn(help='"A list of weighted backend services to send traffic to when a route match\\noccurs. The weights determine the fraction of traffic that flows to their\\ncorresponding backend service. If all traffic needs to go to a single backend\\nservice, there must be one  weightedBackendService with weight set to a non 0\\nnumber. Once a backendService is identified and before forwarding the request to\\nthe backend service, advanced routing actions like Url rewrites and header\\ntransformations are applied depending on additional settings specified in this\\nHttpRouteAction.\\nStructure is documented below."', args=[d.arg(name='weightedBackendServices', type=d.T.array)]),
            withWeightedBackendServices(weightedBackendServices): { routeAction+: { weightedBackendServices: if std.isArray(v=weightedBackendServices) then weightedBackendServices else [weightedBackendServices] } },
            '#withWeightedBackendServicesMixin':: d.fn(help='"A list of weighted backend services to send traffic to when a route match\\noccurs. The weights determine the fraction of traffic that flows to their\\ncorresponding backend service. If all traffic needs to go to a single backend\\nservice, there must be one  weightedBackendService with weight set to a non 0\\nnumber. Once a backendService is identified and before forwarding the request to\\nthe backend service, advanced routing actions like Url rewrites and header\\ntransformations are applied depending on additional settings specified in this\\nHttpRouteAction.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='weightedBackendServices', type=d.T.array)]),
            withWeightedBackendServicesMixin(weightedBackendServices): { routeAction+: { weightedBackendServices+: if std.isArray(v=weightedBackendServices) then weightedBackendServices else [weightedBackendServices] } },
          },
          '#serviceRef':: d.obj(help='"Reference to a RegionBackendService in compute to populate service."'),
          serviceRef: {
            '#policy':: d.obj(help='"Policies for referencing."'),
            policy: {
              '#withResolution':: d.fn(help="\"Resolution specifies whether resolution of this reference is required.\\nThe default is 'Required', which means the reconcile will fail if the\\nreference cannot be resolved. 'Optional' means this reference will be\\na no-op if it cannot be resolved.\"", args=[d.arg(name='resolution', type=d.T.string)]),
