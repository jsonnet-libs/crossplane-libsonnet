              withRetryConditions(retryConditions): { routeAction+: { retryPolicy+: { retryConditions: if std.isArray(v=retryConditions) then retryConditions else [retryConditions] } } },
              '#withRetryConditionsMixin':: d.fn(help='"Specifies one or more conditions when this retry rule applies. Valid values are:"\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='retryConditions', type=d.T.array)]),
