        withEmail(email): { spec+: { forProvider+: { serviceAccount+: { email: email } } } },
        '#withScopes':: d.fn(help='"A list of service scopes. Both OAuth2 URLs and gcloud\\nshort names are supported. To allow full access to all Cloud APIs, use the\\ncloud-platform scope. See a complete list of scopes here.\\nNote: allow_stopping_for_update must be set to true or your instance must have a desired_status of TERMINATED in order to update this field."', args=[d.arg(name='scopes', type=d.T.array)]),
        withScopes(scopes): { spec+: { forProvider+: { serviceAccount+: { scopes: if std.isArray(v=scopes) then scopes else [scopes] } } } },
        '#withScopesMixin':: d.fn(help='"A list of service scopes. Both OAuth2 URLs and gcloud\\nshort names are supported. To allow full access to all Cloud APIs, use the\\ncloud-platform scope. See a complete list of scopes here.\\nNote: allow_stopping_for_update must be set to true or your instance must have a desired_status of TERMINATED in order to update this field."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='scopes', type=d.T.array)]),
