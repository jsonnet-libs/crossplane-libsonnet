      withLabels(labels): { spec+: { forProvider+: { labels: labels } } },
      '#withLabelsMixin':: d.fn(help="\"A map of key/value label pairs to assign to the instance.\\nNote: This field is non-authoritative, and will only manage the labels present in your configuration.\\nPlease refer to the field 'effective_labels' for all of the labels present on the resource.\"\n\n**Note:** This function appends passed data to existing values", args=[d.arg(name='labels', type=d.T.object)]),
      withLabelsMixin(labels): { spec+: { forProvider+: { labels+: labels } } },
