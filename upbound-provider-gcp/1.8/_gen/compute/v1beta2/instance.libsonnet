          withPublicPtrDomainName(publicPtrDomainName): { publicPtrDomainName: publicPtrDomainName },
        },
        '#aliasIpRange':: d.obj(help='"An\\narray of alias IP ranges for this network interface. Can only be specified for network\\ninterfaces on subnet-mode networks. Structure documented below."'),
        aliasIpRange: {
          '#withIpCidrRange':: d.fn(help='"The IP CIDR range represented by this alias IP range. This IP CIDR range\\nmust belong to the specified subnetwork and cannot contain IP addresses reserved by\\nsystem or used by other network interfaces. This range may be a single IP address\\n(e.g. 10.2.3.4), a netmask (e.g. /24) or a CIDR format string (e.g. 10.1.2.0/24)."', args=[d.arg(name='ipCidrRange', type=d.T.string)]),
          withIpCidrRange(ipCidrRange): { ipCidrRange: ipCidrRange },
          '#withSubnetworkRangeName':: d.fn(help='"The subnetwork secondary range name specifying\\nthe secondary range from which to allocate the IP CIDR range for this alias IP\\nrange. If left unspecified, the primary range of the subnetwork will be used."', args=[d.arg(name='subnetworkRangeName', type=d.T.string)]),
          withSubnetworkRangeName(subnetworkRangeName): { subnetworkRangeName: subnetworkRangeName },
        },
