      '#serviceAccount':: d.obj(help='"Service account to attach to the instance.\\nStructure is documented below.\\nNote: allow_stopping_for_update must be set to true or your instance must have a desired_status of TERMINATED in order to update this field."'),
      serviceAccount: {
        '#emailRef':: d.obj(help='"Reference to a ServiceAccount in cloudplatform to populate email."'),
        emailRef: {
          '#policy':: d.obj(help='"Policies for referencing."'),
