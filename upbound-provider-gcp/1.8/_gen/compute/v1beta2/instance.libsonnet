        withKmsKeySelfLink(kmsKeySelfLink): { spec+: { forProvider+: { bootDisk+: { kmsKeySelfLink: kmsKeySelfLink } } } },
        '#withMode':: d.fn(help='"The mode in which to attach this disk, either READ_WRITE\\nor READ_ONLY. If not specified, the default is to attach the disk in READ_WRITE mode."', args=[d.arg(name='mode', type=d.T.string)]),
        withMode(mode): { spec+: { forProvider+: { bootDisk+: { mode: mode } } } },
        '#withSource':: d.fn(help='"The name or self_link of the existing disk (such as those managed by\\ngoogle_compute_disk) or disk image. To create an instance from a snapshot, first create a\\ngoogle_compute_disk from a snapshot and reference it here."', args=[d.arg(name='source', type=d.T.string)]),
        withSource(source): { spec+: { forProvider+: { bootDisk+: { source: source } } } },
      },
      '#confidentialInstanceConfig':: d.obj(help='"Enable Confidential Mode on this VM. Structure is documented below"'),
      confidentialInstanceConfig: {
        '#withConfidentialInstanceType':: d.fn(help='"Defines the confidential computing technology the instance uses. SEV is an AMD feature. One of the following values: SEV, SEV_SNP. on_host_maintenance can be set to MIGRATE if confidential_instance_type is set to SEV and min_cpu_platform is set to \\"AMD Milan\\". Otherwise, on_host_maintenance has to be set to TERMINATE or this will fail to create the VM. If SEV_SNP, currently min_cpu_platform has to be set to \\"AMD Milan\\" or this will fail to create the VM."', args=[d.arg(name='confidentialInstanceType', type=d.T.string)]),
        withConfidentialInstanceType(confidentialInstanceType): { spec+: { forProvider+: { confidentialInstanceConfig+: { confidentialInstanceType: confidentialInstanceType } } } },
        '#withEnableConfidentialCompute':: d.fn(help='"Defines whether the instance should have confidential compute enabled with AMD SEV. If enabled, on_host_maintenance can be set to MIGRATE if min_cpu_platform is set to \\"AMD Milan\\". Otherwise, on_host_maintenance has to be set to TERMINATE or this will fail to create the VM."', args=[d.arg(name='enableConfidentialCompute', type=d.T.boolean)]),
        withEnableConfidentialCompute(enableConfidentialCompute): { spec+: { forProvider+: { confidentialInstanceConfig+: { enableConfidentialCompute: enableConfidentialCompute } } } },
      },
      '#guestAccelerator':: d.obj(help='"List of the type and count of accelerator cards attached to the instance. Structure documented below.\\nNote: GPU accelerators can only be used with on_host_maintenance option set to TERMINATE.\\nNote: This field uses attr-as-block mode to avoid\\nbreaking users during the 0.12 upgrade. To explicitly send a list\\nof zero objects you must use the following syntax:\\nexample=[]\\nFor more details about this behavior, see this section."'),
