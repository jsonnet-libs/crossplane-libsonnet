        ipv6AccessConfig: {
          '#withExternalIpv6':: d.fn(help="\"The first IPv6 address of the external IPv6 range associated\\nwith this instance, prefix length is stored in externalIpv6PrefixLength in ipv6AccessConfig.\\nTo use a static external IP address, it must be unused and in the same region as the instance's zone.\\nIf not specified, Google Cloud will automatically assign an external IPv6 address from the instance's subnetwork.\"", args=[d.arg(name='externalIpv6', type=d.T.string)]),
          withExternalIpv6(externalIpv6): { externalIpv6: externalIpv6 },
