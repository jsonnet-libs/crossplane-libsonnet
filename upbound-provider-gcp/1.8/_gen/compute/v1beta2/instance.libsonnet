      withEnableDisplay(enableDisplay): { spec+: { forProvider+: { enableDisplay: enableDisplay } } },
      '#withGuestAccelerator':: d.fn(help='"List of the type and count of accelerator cards attached to the instance. Structure documented below.\\nNote: GPU accelerators can only be used with on_host_maintenance option set to TERMINATE.\\nNote: This field uses attr-as-block mode to avoid\\nbreaking users during the 0.12 upgrade. To explicitly send a list\\nof zero objects you must use the following syntax:\\nexample=[]\\nFor more details about this behavior, see this section."', args=[d.arg(name='guestAccelerator', type=d.T.array)]),
      withGuestAccelerator(guestAccelerator): { spec+: { forProvider+: { guestAccelerator: if std.isArray(v=guestAccelerator) then guestAccelerator else [guestAccelerator] } } },
      '#withGuestAcceleratorMixin':: d.fn(help='"List of the type and count of accelerator cards attached to the instance. Structure documented below.\\nNote: GPU accelerators can only be used with on_host_maintenance option set to TERMINATE.\\nNote: This field uses attr-as-block mode to avoid\\nbreaking users during the 0.12 upgrade. To explicitly send a list\\nof zero objects you must use the following syntax:\\nexample=[]\\nFor more details about this behavior, see this section."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='guestAccelerator', type=d.T.array)]),
      withGuestAcceleratorMixin(guestAccelerator): { spec+: { forProvider+: { guestAccelerator+: if std.isArray(v=guestAccelerator) then guestAccelerator else [guestAccelerator] } } },
      '#withHostname':: d.fn(help='"A custom hostname for the instance. Must be a fully qualified DNS name and RFC-1035-valid.\\nValid format is a series of labels 1-63 characters long matching the regular expression [a-z]([-a-z0-9]*[a-z0-9]), concatenated with periods.\\nThe entire hostname must not exceed 253 characters. Changing this forces a new resource to be created."', args=[d.arg(name='hostname', type=d.T.string)]),
      withHostname(hostname): { spec+: { forProvider+: { hostname: hostname } } },
