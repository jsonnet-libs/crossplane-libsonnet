      withAllowStoppingForUpdate(allowStoppingForUpdate): { spec+: { forProvider+: { allowStoppingForUpdate: allowStoppingForUpdate } } },
      '#withAttachedDisk':: d.fn(help='"Additional disks to attach to the instance. Can be repeated multiple times for multiple disks. Structure is documented below."', args=[d.arg(name='attachedDisk', type=d.T.array)]),
      withAttachedDisk(attachedDisk): { spec+: { forProvider+: { attachedDisk: if std.isArray(v=attachedDisk) then attachedDisk else [attachedDisk] } } },
