        withMetadata(metadata): { spec+: { initProvider+: { logConfig+: { metadata: metadata } } } },
        '#withMetadataFields':: d.fn(help='"List of metadata fields that should be added to reported logs.\\nCan only be specified if VPC flow logs for this subnetwork is enabled and \\"metadata\\" is set to CUSTOM_METADATA."', args=[d.arg(name='metadataFields', type=d.T.array)]),
