        withAvailabilityDomainCount(availabilityDomainCount): { spec+: { forProvider+: { groupPlacementPolicy+: { availabilityDomainCount: availabilityDomainCount } } } },
        '#withCollocation':: d.fn(help='"Collocation specifies whether to place VMs inside the same availability domain on the same low-latency network.\\nSpecify COLLOCATED to enable collocation. Can only be specified with vm_count. If compute instances are created\\nwith a COLLOCATED policy, then exactly vm_count instances must be created at the same time with the resource policy\\nattached.\\nPossible values are: COLLOCATED."', args=[d.arg(name='collocation', type=d.T.string)]),
        withCollocation(collocation): { spec+: { forProvider+: { groupPlacementPolicy+: { collocation: collocation } } } },
        '#withVmCount':: d.fn(help='"Number of VMs in this placement group. Google does not recommend that you use this field\\nunless you use a compact policy and you want your policy to work only if it contains this\\nexact number of VMs."', args=[d.arg(name='vmCount', type=d.T.number)]),
