            '#withStartTime':: d.fn(help='"Time within the window to start the operations.\\nIt must be in format \\"HH:MM\\", where HH : [00-23] and MM : [00-00] GMT."', args=[d.arg(name='startTime', type=d.T.string)]),
            withStartTime(startTime): { spec+: { forProvider+: { snapshotSchedulePolicy+: { schedule+: { hourlySchedule+: { startTime: startTime } } } } } },
