        '#withInstanceRedistributionType':: d.fn(help='"- The instance redistribution policy for regional managed instance groups. Valid values are: \\"PROACTIVE\\", \\"NONE\\". If PROACTIVE (default), the group attempts to maintain an even distribution of VM instances across zones in the region. If NONE, proactive redistribution is disabled."', args=[d.arg(name='instanceRedistributionType', type=d.T.string)]),
