        withDiskSizeGb(diskSizeGb): { diskSizeGb: diskSizeGb },
        '#withDiskType':: d.fn(help='"The GCE disk type. Such as \\"pd-ssd\\", \\"local-ssd\\",\\n\\"pd-balanced\\" or \\"pd-standard\\"."', args=[d.arg(name='diskType', type=d.T.string)]),
        withDiskType(diskType): { diskType: diskType },
        '#withInterface':: d.fn(help='"Specifies the disk interface to use for attaching this disk,\\nwhich is either SCSI or NVME. The default is SCSI. Persistent disks must always use SCSI\\nand the request will fail if you attempt to attach a persistent disk in any other format\\nthan SCSI. Local SSDs can use either NVME or SCSI."', args=[d.arg(name='interface', type=d.T.string)]),
