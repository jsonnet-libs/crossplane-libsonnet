      '#documentation':: d.obj(help='"Documentation that is included with notifications and incidents related\\nto this policy. Best practice is for the documentation to include information\\nto help responders understand, mitigate, escalate, and correct the underlying\\nproblems detected by the alerting policy. Notification channels that have\\nlimited capacity might not show this documentation.\\nStructure is documented below."'),
      documentation: {
        '#links':: d.obj(help='"Links to content such as playbooks, repositories, and other resources. This field can contain up to 3 entries.\\nStructure is documented below."'),
        links: {
          '#withDisplayName':: d.fn(help='"A short display name for the link. The display name must not be empty or exceed 63 characters. Example: \\"playbook\\"."', args=[d.arg(name='displayName', type=d.T.string)]),
          withDisplayName(displayName): { displayName: displayName },
          '#withUrl':: d.fn(help='"The url of a webpage. A url can be templatized by using variables in the path or the query parameters. The total length of a URL should not exceed 2083 characters before and after variable expansion. Example: \\"https://my_domain.com/playbook?name=${resource.name}\\"."', args=[d.arg(name='url', type=d.T.string)]),
          withUrl(url): { url: url },
        },
        '#withContent':: d.fn(help='"The text of the documentation, interpreted according to mimeType.\\nThe content may not exceed 8,192 Unicode characters and may not\\nexceed more than 10,240 bytes when encoded in UTF-8 format,\\nwhichever is smaller."', args=[d.arg(name='content', type=d.T.string)]),
        withContent(content): { content: content },
        '#withLinks':: d.fn(help='"Links to content such as playbooks, repositories, and other resources. This field can contain up to 3 entries.\\nStructure is documented below."', args=[d.arg(name='links', type=d.T.array)]),
        withLinks(links): { links: if std.isArray(v=links) then links else [links] },
        '#withLinksMixin':: d.fn(help='"Links to content such as playbooks, repositories, and other resources. This field can contain up to 3 entries.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='links', type=d.T.array)]),
        withLinksMixin(links): { links+: if std.isArray(v=links) then links else [links] },
        '#withMimeType':: d.fn(help='"The format of the content field. Presently, only the value\\n\\"text/markdown\\" is supported."', args=[d.arg(name='mimeType', type=d.T.string)]),
        withMimeType(mimeType): { mimeType: mimeType },
        '#withSubject':: d.fn(help='"The subject line of the notification. The subject line may not\\nexceed 10,240 bytes. In notifications generated by this policy the contents\\nof the subject line after variable expansion will be truncated to 255 bytes\\nor shorter at the latest UTF-8 character boundary."', args=[d.arg(name='subject', type=d.T.string)]),
        withSubject(subject): { subject: subject },
      },
      '#withAlertStrategy':: d.fn(help="\"Control over how this alert policy's notification channels are notified.\\nStructure is documented below.\"", args=[d.arg(name='alertStrategy', type=d.T.array)]),
      withAlertStrategy(alertStrategy): { spec+: { forProvider+: { alertStrategy: if std.isArray(v=alertStrategy) then alertStrategy else [alertStrategy] } } },
      '#withAlertStrategyMixin':: d.fn(help="\"Control over how this alert policy's notification channels are notified.\\nStructure is documented below.\"\n\n**Note:** This function appends passed data to existing values", args=[d.arg(name='alertStrategy', type=d.T.array)]),
      withAlertStrategyMixin(alertStrategy): { spec+: { forProvider+: { alertStrategy+: if std.isArray(v=alertStrategy) then alertStrategy else [alertStrategy] } } },
      '#withCombiner':: d.fn(help='"How to combine the results of multiple conditions to\\ndetermine if an incident should be opened.\\nPossible values are: AND, OR, AND_WITH_MATCHING_RESOURCE."', args=[d.arg(name='combiner', type=d.T.string)]),
      withCombiner(combiner): { spec+: { forProvider+: { combiner: combiner } } },
      '#withConditions':: d.fn(help='"A list of conditions for the policy. The conditions are combined by\\nAND or OR according to the combiner field. If the combined conditions\\nevaluate to true, then an incident is created. A policy can have from\\none to six conditions.\\nStructure is documented below."', args=[d.arg(name='conditions', type=d.T.array)]),
      withConditions(conditions): { spec+: { forProvider+: { conditions: if std.isArray(v=conditions) then conditions else [conditions] } } },
      '#withConditionsMixin':: d.fn(help='"A list of conditions for the policy. The conditions are combined by\\nAND or OR according to the combiner field. If the combined conditions\\nevaluate to true, then an incident is created. A policy can have from\\none to six conditions.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='conditions', type=d.T.array)]),
      withConditionsMixin(conditions): { spec+: { forProvider+: { conditions+: if std.isArray(v=conditions) then conditions else [conditions] } } },
      '#withDisplayName':: d.fn(help="\"A short name or phrase used to identify the policy in\\ndashboards, notifications, and incidents. To avoid confusion, don't use\\nthe same display name for multiple policies in the same project. The\\nname is limited to 512 Unicode characters.\"", args=[d.arg(name='displayName', type=d.T.string)]),
      withDisplayName(displayName): { spec+: { forProvider+: { displayName: displayName } } },
      '#withDocumentation':: d.fn(help='"Documentation that is included with notifications and incidents related\\nto this policy. Best practice is for the documentation to include information\\nto help responders understand, mitigate, escalate, and correct the underlying\\nproblems detected by the alerting policy. Notification channels that have\\nlimited capacity might not show this documentation.\\nStructure is documented below."', args=[d.arg(name='documentation', type=d.T.array)]),
      withDocumentation(documentation): { spec+: { forProvider+: { documentation: if std.isArray(v=documentation) then documentation else [documentation] } } },
      '#withDocumentationMixin':: d.fn(help='"Documentation that is included with notifications and incidents related\\nto this policy. Best practice is for the documentation to include information\\nto help responders understand, mitigate, escalate, and correct the underlying\\nproblems detected by the alerting policy. Notification channels that have\\nlimited capacity might not show this documentation.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='documentation', type=d.T.array)]),
      withDocumentationMixin(documentation): { spec+: { forProvider+: { documentation+: if std.isArray(v=documentation) then documentation else [documentation] } } },
      '#withEnabled':: d.fn(help='"Whether or not the policy is enabled. The default is true."', args=[d.arg(name='enabled', type=d.T.boolean)]),
      withEnabled(enabled): { spec+: { forProvider+: { enabled: enabled } } },
      '#withNotificationChannels':: d.fn(help='"Identifies the notification channels to which notifications should be\\nsent when incidents are opened or closed or when new violations occur\\non an already opened incident. Each element of this array corresponds\\nto the name field in each of the NotificationChannel objects that are\\nreturned from the notificationChannels.list method. The syntax of the\\nentries in this field is\\nprojects/[PROJECT_ID]/notificationChannels/[CHANNEL_ID]"', args=[d.arg(name='notificationChannels', type=d.T.array)]),
      withNotificationChannels(notificationChannels): { spec+: { forProvider+: { notificationChannels: if std.isArray(v=notificationChannels) then notificationChannels else [notificationChannels] } } },
      '#withNotificationChannelsMixin':: d.fn(help='"Identifies the notification channels to which notifications should be\\nsent when incidents are opened or closed or when new violations occur\\non an already opened incident. Each element of this array corresponds\\nto the name field in each of the NotificationChannel objects that are\\nreturned from the notificationChannels.list method. The syntax of the\\nentries in this field is\\nprojects/[PROJECT_ID]/notificationChannels/[CHANNEL_ID]"\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='notificationChannels', type=d.T.array)]),
      withNotificationChannelsMixin(notificationChannels): { spec+: { forProvider+: { notificationChannels+: if std.isArray(v=notificationChannels) then notificationChannels else [notificationChannels] } } },
      '#withProject':: d.fn(help='"The ID of the project in which the resource belongs.\\nIf it is not provided, the provider project is used."', args=[d.arg(name='project', type=d.T.string)]),
      withProject(project): { spec+: { forProvider+: { project: project } } },
      '#withSeverity':: d.fn(help='"The severity of an alert policy indicates how important incidents generated\\nby that policy are. The severity level will be displayed on the Incident\\ndetail page and in notifications.\\nPossible values are: CRITICAL, ERROR, WARNING."', args=[d.arg(name='severity', type=d.T.string)]),
      withSeverity(severity): { spec+: { forProvider+: { severity: severity } } },
      '#withUserLabels':: d.fn(help='"This field is intended to be used for organizing and identifying the AlertPolicy\\nobjects.The field can contain up to 64 entries. Each key and value is limited\\nto 63 Unicode characters or 128 bytes, whichever is smaller. Labels and values\\ncan contain only lowercase letters, numerals, underscores, and dashes. Keys\\nmust begin with a letter."', args=[d.arg(name='userLabels', type=d.T.object)]),
      withUserLabels(userLabels): { spec+: { forProvider+: { userLabels: userLabels } } },
      '#withUserLabelsMixin':: d.fn(help='"This field is intended to be used for organizing and identifying the AlertPolicy\\nobjects.The field can contain up to 64 entries. Each key and value is limited\\nto 63 Unicode characters or 128 bytes, whichever is smaller. Labels and values\\ncan contain only lowercase letters, numerals, underscores, and dashes. Keys\\nmust begin with a letter."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='userLabels', type=d.T.object)]),
      withUserLabelsMixin(userLabels): { spec+: { forProvider+: { userLabels+: userLabels } } },
    },
    '#initProvider':: d.obj(help='"THIS IS A BETA FIELD. It will be honored\\nunless the Management Policies feature flag is disabled.\\nInitProvider holds the same fields as ForProvider, with the exception\\nof Identifier and other resource reference fields. The fields that are\\nin InitProvider are merged into ForProvider when the resource is created.\\nThe same fields are also added to the terraform ignore_changes hook, to\\navoid updating them after creation. This is useful for fields that are\\nrequired on creation, but we do not desire to update them after creation,\\nfor example because of an external controller is managing them, like an\\nautoscaler."'),
    initProvider: {
      '#alertStrategy':: d.obj(help="\"Control over how this alert policy's notification channels are notified.\\nStructure is documented below.\""),
      alertStrategy: {
        '#notificationChannelStrategy':: d.obj(help='"Control over how the notification channels in notification_channels\\nare notified when this alert fires, on a per-channel basis.\\nStructure is documented below."'),
        notificationChannelStrategy: {
          '#withNotificationChannelNames':: d.fn(help='"The notification channels that these settings apply to. Each of these\\ncorrespond to the name field in one of the NotificationChannel objects\\nreferenced in the notification_channels field of this AlertPolicy. The format is\\nprojects/[PROJECT_ID_OR_NUMBER]/notificationChannels/[CHANNEL_ID]"', args=[d.arg(name='notificationChannelNames', type=d.T.array)]),
          withNotificationChannelNames(notificationChannelNames): { notificationChannelNames: if std.isArray(v=notificationChannelNames) then notificationChannelNames else [notificationChannelNames] },
          '#withNotificationChannelNamesMixin':: d.fn(help='"The notification channels that these settings apply to. Each of these\\ncorrespond to the name field in one of the NotificationChannel objects\\nreferenced in the notification_channels field of this AlertPolicy. The format is\\nprojects/[PROJECT_ID_OR_NUMBER]/notificationChannels/[CHANNEL_ID]"\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='notificationChannelNames', type=d.T.array)]),
          withNotificationChannelNamesMixin(notificationChannelNames): { notificationChannelNames+: if std.isArray(v=notificationChannelNames) then notificationChannelNames else [notificationChannelNames] },
          '#withRenotifyInterval':: d.fn(help='"The frequency at which to send reminder notifications for open incidents."', args=[d.arg(name='renotifyInterval', type=d.T.string)]),
          withRenotifyInterval(renotifyInterval): { renotifyInterval: renotifyInterval },
        },
        '#notificationRateLimit':: d.obj(help='"Required for alert policies with a LogMatch condition.\\nThis limit is not implemented for alert policies that are not log-based.\\nStructure is documented below."'),
        notificationRateLimit: {
          '#withPeriod':: d.fn(help='"Not more than one notification per period."', args=[d.arg(name='period', type=d.T.string)]),
          withPeriod(period): { period: period },
        },
        '#withAutoClose':: d.fn(help='"If an alert policy that was active has no data for this long, any open incidents will close."', args=[d.arg(name='autoClose', type=d.T.string)]),
        withAutoClose(autoClose): { autoClose: autoClose },
        '#withNotificationChannelStrategy':: d.fn(help='"Control over how the notification channels in notification_channels\\nare notified when this alert fires, on a per-channel basis.\\nStructure is documented below."', args=[d.arg(name='notificationChannelStrategy', type=d.T.array)]),
        withNotificationChannelStrategy(notificationChannelStrategy): { notificationChannelStrategy: if std.isArray(v=notificationChannelStrategy) then notificationChannelStrategy else [notificationChannelStrategy] },
        '#withNotificationChannelStrategyMixin':: d.fn(help='"Control over how the notification channels in notification_channels\\nare notified when this alert fires, on a per-channel basis.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='notificationChannelStrategy', type=d.T.array)]),
        withNotificationChannelStrategyMixin(notificationChannelStrategy): { notificationChannelStrategy+: if std.isArray(v=notificationChannelStrategy) then notificationChannelStrategy else [notificationChannelStrategy] },
        '#withNotificationRateLimit':: d.fn(help='"Required for alert policies with a LogMatch condition.\\nThis limit is not implemented for alert policies that are not log-based.\\nStructure is documented below."', args=[d.arg(name='notificationRateLimit', type=d.T.array)]),
        withNotificationRateLimit(notificationRateLimit): { notificationRateLimit: if std.isArray(v=notificationRateLimit) then notificationRateLimit else [notificationRateLimit] },
        '#withNotificationRateLimitMixin':: d.fn(help='"Required for alert policies with a LogMatch condition.\\nThis limit is not implemented for alert policies that are not log-based.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='notificationRateLimit', type=d.T.array)]),
        withNotificationRateLimitMixin(notificationRateLimit): { notificationRateLimit+: if std.isArray(v=notificationRateLimit) then notificationRateLimit else [notificationRateLimit] },
      },
      '#conditions':: d.obj(help='"A list of conditions for the policy. The conditions are combined by\\nAND or OR according to the combiner field. If the combined conditions\\nevaluate to true, then an incident is created. A policy can have from\\none to six conditions.\\nStructure is documented below."'),
      conditions: {
        '#conditionAbsent':: d.obj(help='"A condition that checks that a time series\\ncontinues to receive new data points.\\nStructure is documented below."'),
        conditionAbsent: {
          '#aggregations':: d.obj(help='"Specifies the alignment of data points in\\nindividual time series as well as how to\\ncombine the retrieved time series together\\n(such as when aggregating multiple streams\\non each resource to a single stream for each\\nresource or when aggregating streams across\\nall members of a group of resources).\\nMultiple aggregations are applied in the\\norder specified.This field is similar to the\\none in the MetricService.ListTimeSeries\\nrequest. It is advisable to use the\\nListTimeSeries method when debugging this\\nfield.\\nStructure is documented below."'),
          aggregations: {
            '#withAlignmentPeriod':: d.fn(help='"The alignment period for per-time\\nseries alignment. If present,\\nalignmentPeriod must be at least\\n60 seconds. After per-time series\\nalignment, each time series will\\ncontain data points only on the\\nperiod boundaries. If\\nperSeriesAligner is not specified\\nor equals ALIGN_NONE, then this\\nfield is ignored. If\\nperSeriesAligner is specified and\\ndoes not equal ALIGN_NONE, then\\nthis field must be defined;\\notherwise an error is returned."', args=[d.arg(name='alignmentPeriod', type=d.T.string)]),
            withAlignmentPeriod(alignmentPeriod): { alignmentPeriod: alignmentPeriod },
            '#withCrossSeriesReducer':: d.fn(help='"The approach to be used to combine\\ntime series. Not all reducer\\nfunctions may be applied to all\\ntime series, depending on the\\nmetric type and the value type of\\nthe original time series.\\nReduction may change the metric\\ntype of value type of the time\\nseries.Time series data must be\\naligned in order to perform cross-\\ntime series reduction. If\\ncrossSeriesReducer is specified,\\nthen perSeriesAligner must be\\nspecified and not equal ALIGN_NONE\\nand alignmentPeriod must be\\nspecified; otherwise, an error is\\nreturned.\\nPossible values are: REDUCE_NONE, REDUCE_MEAN, REDUCE_MIN, REDUCE_MAX, REDUCE_SUM, REDUCE_STDDEV, REDUCE_COUNT, REDUCE_COUNT_TRUE, REDUCE_COUNT_FALSE, REDUCE_FRACTION_TRUE, REDUCE_PERCENTILE_99, REDUCE_PERCENTILE_95, REDUCE_PERCENTILE_50, REDUCE_PERCENTILE_05."', args=[d.arg(name='crossSeriesReducer', type=d.T.string)]),
            withCrossSeriesReducer(crossSeriesReducer): { crossSeriesReducer: crossSeriesReducer },
            '#withGroupByFields':: d.fn(help='"The set of fields to preserve when\\ncrossSeriesReducer is specified.\\nThe groupByFields determine how\\nthe time series are partitioned\\ninto subsets prior to applying the\\naggregation function. Each subset\\ncontains time series that have the\\nsame value for each of the\\ngrouping fields. Each individual\\ntime series is a member of exactly\\none subset. The crossSeriesReducer\\nis applied to each subset of time\\nseries. It is not possible to\\nreduce across different resource\\ntypes, so this field implicitly\\ncontains resource.type. Fields not\\nspecified in groupByFields are\\naggregated away. If groupByFields\\nis not specified and all the time\\nseries have the same resource\\ntype, then the time series are\\naggregated into a single output\\ntime series. If crossSeriesReducer\\nis not defined, this field is\\nignored."', args=[d.arg(name='groupByFields', type=d.T.array)]),
            withGroupByFields(groupByFields): { groupByFields: if std.isArray(v=groupByFields) then groupByFields else [groupByFields] },
            '#withGroupByFieldsMixin':: d.fn(help='"The set of fields to preserve when\\ncrossSeriesReducer is specified.\\nThe groupByFields determine how\\nthe time series are partitioned\\ninto subsets prior to applying the\\naggregation function. Each subset\\ncontains time series that have the\\nsame value for each of the\\ngrouping fields. Each individual\\ntime series is a member of exactly\\none subset. The crossSeriesReducer\\nis applied to each subset of time\\nseries. It is not possible to\\nreduce across different resource\\ntypes, so this field implicitly\\ncontains resource.type. Fields not\\nspecified in groupByFields are\\naggregated away. If groupByFields\\nis not specified and all the time\\nseries have the same resource\\ntype, then the time series are\\naggregated into a single output\\ntime series. If crossSeriesReducer\\nis not defined, this field is\\nignored."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='groupByFields', type=d.T.array)]),
            withGroupByFieldsMixin(groupByFields): { groupByFields+: if std.isArray(v=groupByFields) then groupByFields else [groupByFields] },
            '#withPerSeriesAligner':: d.fn(help='"The approach to be used to align\\nindividual time series. Not all\\nalignment functions may be applied\\nto all time series, depending on\\nthe metric type and value type of\\nthe original time series.\\nAlignment may change the metric\\ntype or the value type of the time\\nseries.Time series data must be\\naligned in order to perform cross-\\ntime series reduction. If\\ncrossSeriesReducer is specified,\\nthen perSeriesAligner must be\\nspecified and not equal ALIGN_NONE\\nand alignmentPeriod must be\\nspecified; otherwise, an error is\\nreturned.\\nPossible values are: ALIGN_NONE, ALIGN_DELTA, ALIGN_RATE, ALIGN_INTERPOLATE, ALIGN_NEXT_OLDER, ALIGN_MIN, ALIGN_MAX, ALIGN_MEAN, ALIGN_COUNT, ALIGN_SUM, ALIGN_STDDEV, ALIGN_COUNT_TRUE, ALIGN_COUNT_FALSE, ALIGN_FRACTION_TRUE, ALIGN_PERCENTILE_99, ALIGN_PERCENTILE_95, ALIGN_PERCENTILE_50, ALIGN_PERCENTILE_05, ALIGN_PERCENT_CHANGE."', args=[d.arg(name='perSeriesAligner', type=d.T.string)]),
            withPerSeriesAligner(perSeriesAligner): { perSeriesAligner: perSeriesAligner },
          },
          '#trigger':: d.obj(help='"The number/percent of time series for which\\nthe comparison must hold in order for the\\ncondition to trigger. If unspecified, then\\nthe condition will trigger if the comparison\\nis true for any of the time series that have\\nbeen identified by filter and aggregations,\\nor by the ratio, if denominator_filter and\\ndenominator_aggregations are specified.\\nStructure is documented below."'),
          trigger: {
            '#withCount':: d.fn(help='"The absolute number of time series\\nthat must fail the predicate for the\\ncondition to be triggered."', args=[d.arg(name='count', type=d.T.number)]),
            withCount(count): { count: count },
            '#withPercent':: d.fn(help='"The percentage of time series that\\nmust fail the predicate for the\\ncondition to be triggered."', args=[d.arg(name='percent', type=d.T.number)]),
            withPercent(percent): { percent: percent },
          },
          '#withAggregations':: d.fn(help='"Specifies the alignment of data points in\\nindividual time series as well as how to\\ncombine the retrieved time series together\\n(such as when aggregating multiple streams\\non each resource to a single stream for each\\nresource or when aggregating streams across\\nall members of a group of resources).\\nMultiple aggregations are applied in the\\norder specified.This field is similar to the\\none in the MetricService.ListTimeSeries\\nrequest. It is advisable to use the\\nListTimeSeries method when debugging this\\nfield.\\nStructure is documented below."', args=[d.arg(name='aggregations', type=d.T.array)]),
          withAggregations(aggregations): { aggregations: if std.isArray(v=aggregations) then aggregations else [aggregations] },
          '#withAggregationsMixin':: d.fn(help='"Specifies the alignment of data points in\\nindividual time series as well as how to\\ncombine the retrieved time series together\\n(such as when aggregating multiple streams\\non each resource to a single stream for each\\nresource or when aggregating streams across\\nall members of a group of resources).\\nMultiple aggregations are applied in the\\norder specified.This field is similar to the\\none in the MetricService.ListTimeSeries\\nrequest. It is advisable to use the\\nListTimeSeries method when debugging this\\nfield.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='aggregations', type=d.T.array)]),
          withAggregationsMixin(aggregations): { aggregations+: if std.isArray(v=aggregations) then aggregations else [aggregations] },
          '#withDuration':: d.fn(help='"The amount of time that a time series must\\nviolate the threshold to be considered\\nfailing. Currently, only values that are a\\nmultiple of a minute--e.g., 0, 60, 120, or\\n300 seconds--are supported. If an invalid\\nvalue is given, an error will be returned.\\nWhen choosing a duration, it is useful to\\nkeep in mind the frequency of the underlying\\ntime series data (which may also be affected\\nby any alignments specified in the\\naggregations field); a good duration is long\\nenough so that a single outlier does not\\ngenerate spurious alerts, but short enough\\nthat unhealthy states are detected and\\nalerted on quickly."', args=[d.arg(name='duration', type=d.T.string)]),
          withDuration(duration): { duration: duration },
          '#withFilter':: d.fn(help='"A filter that identifies which time series\\nshould be compared with the threshold.The\\nfilter is similar to the one that is\\nspecified in the\\nMetricService.ListTimeSeries request (that\\ncall is useful to verify the time series\\nthat will be retrieved / processed) and must\\nspecify the metric type and optionally may\\ncontain restrictions on resource type,\\nresource labels, and metric labels. This\\nfield may not exceed 2048 Unicode characters\\nin length."', args=[d.arg(name='filter', type=d.T.string)]),
          withFilter(filter): { filter: filter },
          '#withTrigger':: d.fn(help='"The number/percent of time series for which\\nthe comparison must hold in order for the\\ncondition to trigger. If unspecified, then\\nthe condition will trigger if the comparison\\nis true for any of the time series that have\\nbeen identified by filter and aggregations,\\nor by the ratio, if denominator_filter and\\ndenominator_aggregations are specified.\\nStructure is documented below."', args=[d.arg(name='trigger', type=d.T.array)]),
          withTrigger(trigger): { trigger: if std.isArray(v=trigger) then trigger else [trigger] },
          '#withTriggerMixin':: d.fn(help='"The number/percent of time series for which\\nthe comparison must hold in order for the\\ncondition to trigger. If unspecified, then\\nthe condition will trigger if the comparison\\nis true for any of the time series that have\\nbeen identified by filter and aggregations,\\nor by the ratio, if denominator_filter and\\ndenominator_aggregations are specified.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='trigger', type=d.T.array)]),
          withTriggerMixin(trigger): { trigger+: if std.isArray(v=trigger) then trigger else [trigger] },
        },
        '#conditionMatchedLog':: d.obj(help='"A condition that checks for log messages matching given constraints.\\nIf set, no other conditions can be present.\\nStructure is documented below."'),
        conditionMatchedLog: {
          '#withFilter':: d.fn(help='"A filter that identifies which time series\\nshould be compared with the threshold.The\\nfilter is similar to the one that is\\nspecified in the\\nMetricService.ListTimeSeries request (that\\ncall is useful to verify the time series\\nthat will be retrieved / processed) and must\\nspecify the metric type and optionally may\\ncontain restrictions on resource type,\\nresource labels, and metric labels. This\\nfield may not exceed 2048 Unicode characters\\nin length."', args=[d.arg(name='filter', type=d.T.string)]),
          withFilter(filter): { filter: filter },
          '#withLabelExtractors':: d.fn(help='"A map from a label key to an extractor expression, which is used to\\nextract the value for this label key. Each entry in this map is\\na specification for how data should be extracted from log entries that\\nmatch filter. Each combination of extracted values is treated as\\na separate rule for the purposes of triggering notifications.\\nLabel keys and corresponding values can be used in notifications\\ngenerated by this condition."', args=[d.arg(name='labelExtractors', type=d.T.object)]),
          withLabelExtractors(labelExtractors): { labelExtractors: labelExtractors },
          '#withLabelExtractorsMixin':: d.fn(help='"A map from a label key to an extractor expression, which is used to\\nextract the value for this label key. Each entry in this map is\\na specification for how data should be extracted from log entries that\\nmatch filter. Each combination of extracted values is treated as\\na separate rule for the purposes of triggering notifications.\\nLabel keys and corresponding values can be used in notifications\\ngenerated by this condition."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='labelExtractors', type=d.T.object)]),
          withLabelExtractorsMixin(labelExtractors): { labelExtractors+: labelExtractors },
        },
        '#conditionMonitoringQueryLanguage':: d.obj(help='"A Monitoring Query Language query that outputs a boolean stream\\nStructure is documented below."'),
        conditionMonitoringQueryLanguage: {
          '#trigger':: d.obj(help='"The number/percent of time series for which\\nthe comparison must hold in order for the\\ncondition to trigger. If unspecified, then\\nthe condition will trigger if the comparison\\nis true for any of the time series that have\\nbeen identified by filter and aggregations,\\nor by the ratio, if denominator_filter and\\ndenominator_aggregations are specified.\\nStructure is documented below."'),
          trigger: {
            '#withCount':: d.fn(help='"The absolute number of time series\\nthat must fail the predicate for the\\ncondition to be triggered."', args=[d.arg(name='count', type=d.T.number)]),
            withCount(count): { count: count },
            '#withPercent':: d.fn(help='"The percentage of time series that\\nmust fail the predicate for the\\ncondition to be triggered."', args=[d.arg(name='percent', type=d.T.number)]),
            withPercent(percent): { percent: percent },
          },
          '#withDuration':: d.fn(help='"The amount of time that a time series must\\nviolate the threshold to be considered\\nfailing. Currently, only values that are a\\nmultiple of a minute--e.g., 0, 60, 120, or\\n300 seconds--are supported. If an invalid\\nvalue is given, an error will be returned.\\nWhen choosing a duration, it is useful to\\nkeep in mind the frequency of the underlying\\ntime series data (which may also be affected\\nby any alignments specified in the\\naggregations field); a good duration is long\\nenough so that a single outlier does not\\ngenerate spurious alerts, but short enough\\nthat unhealthy states are detected and\\nalerted on quickly."', args=[d.arg(name='duration', type=d.T.string)]),
          withDuration(duration): { duration: duration },
          '#withEvaluationMissingData':: d.fn(help='"A condition control that determines how\\nmetric-threshold conditions are evaluated when\\ndata stops arriving.\\nPossible values are: EVALUATION_MISSING_DATA_INACTIVE, EVALUATION_MISSING_DATA_ACTIVE, EVALUATION_MISSING_DATA_NO_OP."', args=[d.arg(name='evaluationMissingData', type=d.T.string)]),
          withEvaluationMissingData(evaluationMissingData): { evaluationMissingData: evaluationMissingData },
          '#withQuery':: d.fn(help='"The PromQL expression to evaluate. Every evaluation cycle this\\nexpression is evaluated at the current time, and all resultant time\\nseries become pending/firing alerts. This field must not be empty."', args=[d.arg(name='query', type=d.T.string)]),
          withQuery(query): { query: query },
          '#withTrigger':: d.fn(help='"The number/percent of time series for which\\nthe comparison must hold in order for the\\ncondition to trigger. If unspecified, then\\nthe condition will trigger if the comparison\\nis true for any of the time series that have\\nbeen identified by filter and aggregations,\\nor by the ratio, if denominator_filter and\\ndenominator_aggregations are specified.\\nStructure is documented below."', args=[d.arg(name='trigger', type=d.T.array)]),
          withTrigger(trigger): { trigger: if std.isArray(v=trigger) then trigger else [trigger] },
          '#withTriggerMixin':: d.fn(help='"The number/percent of time series for which\\nthe comparison must hold in order for the\\ncondition to trigger. If unspecified, then\\nthe condition will trigger if the comparison\\nis true for any of the time series that have\\nbeen identified by filter and aggregations,\\nor by the ratio, if denominator_filter and\\ndenominator_aggregations are specified.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='trigger', type=d.T.array)]),
          withTriggerMixin(trigger): { trigger+: if std.isArray(v=trigger) then trigger else [trigger] },
        },
        '#conditionPrometheusQueryLanguage':: d.obj(help='"A condition type that allows alert policies to be defined using\\nPrometheus Query Language (PromQL).\\nThe PrometheusQueryLanguageCondition message contains information\\nfrom a Prometheus alerting rule and its associated rule group.\\nStructure is documented below."'),
        conditionPrometheusQueryLanguage: {
          '#withAlertRule':: d.fn(help='"The alerting rule name of this alert in the corresponding Prometheus\\nconfiguration file.\\nSome external tools may require this field to be populated correctly\\nin order to refer to the original Prometheus configuration file.\\nThe rule group name and the alert name are necessary to update the\\nrelevant AlertPolicies in case the definition of the rule group changes\\nin the future.\\nThis field is optional. If this field is not empty, then it must be a\\nvalid Prometheus label name."', args=[d.arg(name='alertRule', type=d.T.string)]),
          withAlertRule(alertRule): { alertRule: alertRule },
          '#withDuration':: d.fn(help='"The amount of time that a time series must\\nviolate the threshold to be considered\\nfailing. Currently, only values that are a\\nmultiple of a minute--e.g., 0, 60, 120, or\\n300 seconds--are supported. If an invalid\\nvalue is given, an error will be returned.\\nWhen choosing a duration, it is useful to\\nkeep in mind the frequency of the underlying\\ntime series data (which may also be affected\\nby any alignments specified in the\\naggregations field); a good duration is long\\nenough so that a single outlier does not\\ngenerate spurious alerts, but short enough\\nthat unhealthy states are detected and\\nalerted on quickly."', args=[d.arg(name='duration', type=d.T.string)]),
          withDuration(duration): { duration: duration },
          '#withEvaluationInterval':: d.fn(help='"How often this rule should be evaluated. Must be a positive multiple\\nof 30 seconds or missing. The default value is 30 seconds. If this\\nPrometheusQueryLanguageCondition was generated from a Prometheus\\nalerting rule, then this value should be taken from the enclosing\\nrule group."', args=[d.arg(name='evaluationInterval', type=d.T.string)]),
          withEvaluationInterval(evaluationInterval): { evaluationInterval: evaluationInterval },
          '#withLabels':: d.fn(help='"Labels to add to or overwrite in the PromQL query result. Label names\\nmust be valid.\\nLabel values can be templatized by using variables. The only available\\nvariable names are the names of the labels in the PromQL result, including\\n\\"name\\" and \\"value\\". \\"labels\\" may be empty. This field is intended to be\\nused for organizing and identifying the AlertPolicy"', args=[d.arg(name='labels', type=d.T.object)]),
          withLabels(labels): { labels: labels },
          '#withLabelsMixin':: d.fn(help='"Labels to add to or overwrite in the PromQL query result. Label names\\nmust be valid.\\nLabel values can be templatized by using variables. The only available\\nvariable names are the names of the labels in the PromQL result, including\\n\\"name\\" and \\"value\\". \\"labels\\" may be empty. This field is intended to be\\nused for organizing and identifying the AlertPolicy"\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='labels', type=d.T.object)]),
          withLabelsMixin(labels): { labels+: labels },
          '#withQuery':: d.fn(help='"The PromQL expression to evaluate. Every evaluation cycle this\\nexpression is evaluated at the current time, and all resultant time\\nseries become pending/firing alerts. This field must not be empty."', args=[d.arg(name='query', type=d.T.string)]),
          withQuery(query): { query: query },
          '#withRuleGroup':: d.fn(help='"The rule group name of this alert in the corresponding Prometheus\\nconfiguration file.\\nSome external tools may require this field to be populated correctly\\nin order to refer to the original Prometheus configuration file.\\nThe rule group name and the alert name are necessary to update the\\nrelevant AlertPolicies in case the definition of the rule group changes\\nin the future. This field is optional."', args=[d.arg(name='ruleGroup', type=d.T.string)]),
          withRuleGroup(ruleGroup): { ruleGroup: ruleGroup },
        },
        '#conditionThreshold':: d.obj(help='"A condition that compares a time series against a\\nthreshold.\\nStructure is documented below."'),
        conditionThreshold: {
          '#aggregations':: d.obj(help='"Specifies the alignment of data points in\\nindividual time series as well as how to\\ncombine the retrieved time series together\\n(such as when aggregating multiple streams\\non each resource to a single stream for each\\nresource or when aggregating streams across\\nall members of a group of resources).\\nMultiple aggregations are applied in the\\norder specified.This field is similar to the\\none in the MetricService.ListTimeSeries\\nrequest. It is advisable to use the\\nListTimeSeries method when debugging this\\nfield.\\nStructure is documented below."'),
          aggregations: {
            '#withAlignmentPeriod':: d.fn(help='"The alignment period for per-time\\nseries alignment. If present,\\nalignmentPeriod must be at least\\n60 seconds. After per-time series\\nalignment, each time series will\\ncontain data points only on the\\nperiod boundaries. If\\nperSeriesAligner is not specified\\nor equals ALIGN_NONE, then this\\nfield is ignored. If\\nperSeriesAligner is specified and\\ndoes not equal ALIGN_NONE, then\\nthis field must be defined;\\notherwise an error is returned."', args=[d.arg(name='alignmentPeriod', type=d.T.string)]),
            withAlignmentPeriod(alignmentPeriod): { alignmentPeriod: alignmentPeriod },
            '#withCrossSeriesReducer':: d.fn(help='"The approach to be used to combine\\ntime series. Not all reducer\\nfunctions may be applied to all\\ntime series, depending on the\\nmetric type and the value type of\\nthe original time series.\\nReduction may change the metric\\ntype of value type of the time\\nseries.Time series data must be\\naligned in order to perform cross-\\ntime series reduction. If\\ncrossSeriesReducer is specified,\\nthen perSeriesAligner must be\\nspecified and not equal ALIGN_NONE\\nand alignmentPeriod must be\\nspecified; otherwise, an error is\\nreturned.\\nPossible values are: REDUCE_NONE, REDUCE_MEAN, REDUCE_MIN, REDUCE_MAX, REDUCE_SUM, REDUCE_STDDEV, REDUCE_COUNT, REDUCE_COUNT_TRUE, REDUCE_COUNT_FALSE, REDUCE_FRACTION_TRUE, REDUCE_PERCENTILE_99, REDUCE_PERCENTILE_95, REDUCE_PERCENTILE_50, REDUCE_PERCENTILE_05."', args=[d.arg(name='crossSeriesReducer', type=d.T.string)]),
            withCrossSeriesReducer(crossSeriesReducer): { crossSeriesReducer: crossSeriesReducer },
            '#withGroupByFields':: d.fn(help='"The set of fields to preserve when\\ncrossSeriesReducer is specified.\\nThe groupByFields determine how\\nthe time series are partitioned\\ninto subsets prior to applying the\\naggregation function. Each subset\\ncontains time series that have the\\nsame value for each of the\\ngrouping fields. Each individual\\ntime series is a member of exactly\\none subset. The crossSeriesReducer\\nis applied to each subset of time\\nseries. It is not possible to\\nreduce across different resource\\ntypes, so this field implicitly\\ncontains resource.type. Fields not\\nspecified in groupByFields are\\naggregated away. If groupByFields\\nis not specified and all the time\\nseries have the same resource\\ntype, then the time series are\\naggregated into a single output\\ntime series. If crossSeriesReducer\\nis not defined, this field is\\nignored."', args=[d.arg(name='groupByFields', type=d.T.array)]),
            withGroupByFields(groupByFields): { groupByFields: if std.isArray(v=groupByFields) then groupByFields else [groupByFields] },
            '#withGroupByFieldsMixin':: d.fn(help='"The set of fields to preserve when\\ncrossSeriesReducer is specified.\\nThe groupByFields determine how\\nthe time series are partitioned\\ninto subsets prior to applying the\\naggregation function. Each subset\\ncontains time series that have the\\nsame value for each of the\\ngrouping fields. Each individual\\ntime series is a member of exactly\\none subset. The crossSeriesReducer\\nis applied to each subset of time\\nseries. It is not possible to\\nreduce across different resource\\ntypes, so this field implicitly\\ncontains resource.type. Fields not\\nspecified in groupByFields are\\naggregated away. If groupByFields\\nis not specified and all the time\\nseries have the same resource\\ntype, then the time series are\\naggregated into a single output\\ntime series. If crossSeriesReducer\\nis not defined, this field is\\nignored."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='groupByFields', type=d.T.array)]),
            withGroupByFieldsMixin(groupByFields): { groupByFields+: if std.isArray(v=groupByFields) then groupByFields else [groupByFields] },
            '#withPerSeriesAligner':: d.fn(help='"The approach to be used to align\\nindividual time series. Not all\\nalignment functions may be applied\\nto all time series, depending on\\nthe metric type and value type of\\nthe original time series.\\nAlignment may change the metric\\ntype or the value type of the time\\nseries.Time series data must be\\naligned in order to perform cross-\\ntime series reduction. If\\ncrossSeriesReducer is specified,\\nthen perSeriesAligner must be\\nspecified and not equal ALIGN_NONE\\nand alignmentPeriod must be\\nspecified; otherwise, an error is\\nreturned.\\nPossible values are: ALIGN_NONE, ALIGN_DELTA, ALIGN_RATE, ALIGN_INTERPOLATE, ALIGN_NEXT_OLDER, ALIGN_MIN, ALIGN_MAX, ALIGN_MEAN, ALIGN_COUNT, ALIGN_SUM, ALIGN_STDDEV, ALIGN_COUNT_TRUE, ALIGN_COUNT_FALSE, ALIGN_FRACTION_TRUE, ALIGN_PERCENTILE_99, ALIGN_PERCENTILE_95, ALIGN_PERCENTILE_50, ALIGN_PERCENTILE_05, ALIGN_PERCENT_CHANGE."', args=[d.arg(name='perSeriesAligner', type=d.T.string)]),
            withPerSeriesAligner(perSeriesAligner): { perSeriesAligner: perSeriesAligner },
          },
          '#denominatorAggregations':: d.obj(help='"Specifies the alignment of data points in\\nindividual time series selected by\\ndenominatorFilter as well as how to combine\\nthe retrieved time series together (such as\\nwhen aggregating multiple streams on each\\nresource to a single stream for each\\nresource or when aggregating streams across\\nall members of a group of resources).When\\ncomputing ratios, the aggregations and\\ndenominator_aggregations fields must use the\\nsame alignment period and produce time\\nseries that have the same periodicity and\\nlabels.This field is similar to the one in\\nthe MetricService.ListTimeSeries request. It\\nis advisable to use the ListTimeSeries\\nmethod when debugging this field.\\nStructure is documented below."'),
          denominatorAggregations: {
            '#withAlignmentPeriod':: d.fn(help='"The alignment period for per-time\\nseries alignment. If present,\\nalignmentPeriod must be at least\\n60 seconds. After per-time series\\nalignment, each time series will\\ncontain data points only on the\\nperiod boundaries. If\\nperSeriesAligner is not specified\\nor equals ALIGN_NONE, then this\\nfield is ignored. If\\nperSeriesAligner is specified and\\ndoes not equal ALIGN_NONE, then\\nthis field must be defined;\\notherwise an error is returned."', args=[d.arg(name='alignmentPeriod', type=d.T.string)]),
            withAlignmentPeriod(alignmentPeriod): { alignmentPeriod: alignmentPeriod },
            '#withCrossSeriesReducer':: d.fn(help='"The approach to be used to combine\\ntime series. Not all reducer\\nfunctions may be applied to all\\ntime series, depending on the\\nmetric type and the value type of\\nthe original time series.\\nReduction may change the metric\\ntype of value type of the time\\nseries.Time series data must be\\naligned in order to perform cross-\\ntime series reduction. If\\ncrossSeriesReducer is specified,\\nthen perSeriesAligner must be\\nspecified and not equal ALIGN_NONE\\nand alignmentPeriod must be\\nspecified; otherwise, an error is\\nreturned.\\nPossible values are: REDUCE_NONE, REDUCE_MEAN, REDUCE_MIN, REDUCE_MAX, REDUCE_SUM, REDUCE_STDDEV, REDUCE_COUNT, REDUCE_COUNT_TRUE, REDUCE_COUNT_FALSE, REDUCE_FRACTION_TRUE, REDUCE_PERCENTILE_99, REDUCE_PERCENTILE_95, REDUCE_PERCENTILE_50, REDUCE_PERCENTILE_05."', args=[d.arg(name='crossSeriesReducer', type=d.T.string)]),
            withCrossSeriesReducer(crossSeriesReducer): { crossSeriesReducer: crossSeriesReducer },
            '#withGroupByFields':: d.fn(help='"The set of fields to preserve when\\ncrossSeriesReducer is specified.\\nThe groupByFields determine how\\nthe time series are partitioned\\ninto subsets prior to applying the\\naggregation function. Each subset\\ncontains time series that have the\\nsame value for each of the\\ngrouping fields. Each individual\\ntime series is a member of exactly\\none subset. The crossSeriesReducer\\nis applied to each subset of time\\nseries. It is not possible to\\nreduce across different resource\\ntypes, so this field implicitly\\ncontains resource.type. Fields not\\nspecified in groupByFields are\\naggregated away. If groupByFields\\nis not specified and all the time\\nseries have the same resource\\ntype, then the time series are\\naggregated into a single output\\ntime series. If crossSeriesReducer\\nis not defined, this field is\\nignored."', args=[d.arg(name='groupByFields', type=d.T.array)]),
            withGroupByFields(groupByFields): { groupByFields: if std.isArray(v=groupByFields) then groupByFields else [groupByFields] },
            '#withGroupByFieldsMixin':: d.fn(help='"The set of fields to preserve when\\ncrossSeriesReducer is specified.\\nThe groupByFields determine how\\nthe time series are partitioned\\ninto subsets prior to applying the\\naggregation function. Each subset\\ncontains time series that have the\\nsame value for each of the\\ngrouping fields. Each individual\\ntime series is a member of exactly\\none subset. The crossSeriesReducer\\nis applied to each subset of time\\nseries. It is not possible to\\nreduce across different resource\\ntypes, so this field implicitly\\ncontains resource.type. Fields not\\nspecified in groupByFields are\\naggregated away. If groupByFields\\nis not specified and all the time\\nseries have the same resource\\ntype, then the time series are\\naggregated into a single output\\ntime series. If crossSeriesReducer\\nis not defined, this field is\\nignored."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='groupByFields', type=d.T.array)]),
            withGroupByFieldsMixin(groupByFields): { groupByFields+: if std.isArray(v=groupByFields) then groupByFields else [groupByFields] },
            '#withPerSeriesAligner':: d.fn(help='"The approach to be used to align\\nindividual time series. Not all\\nalignment functions may be applied\\nto all time series, depending on\\nthe metric type and value type of\\nthe original time series.\\nAlignment may change the metric\\ntype or the value type of the time\\nseries.Time series data must be\\naligned in order to perform cross-\\ntime series reduction. If\\ncrossSeriesReducer is specified,\\nthen perSeriesAligner must be\\nspecified and not equal ALIGN_NONE\\nand alignmentPeriod must be\\nspecified; otherwise, an error is\\nreturned.\\nPossible values are: ALIGN_NONE, ALIGN_DELTA, ALIGN_RATE, ALIGN_INTERPOLATE, ALIGN_NEXT_OLDER, ALIGN_MIN, ALIGN_MAX, ALIGN_MEAN, ALIGN_COUNT, ALIGN_SUM, ALIGN_STDDEV, ALIGN_COUNT_TRUE, ALIGN_COUNT_FALSE, ALIGN_FRACTION_TRUE, ALIGN_PERCENTILE_99, ALIGN_PERCENTILE_95, ALIGN_PERCENTILE_50, ALIGN_PERCENTILE_05, ALIGN_PERCENT_CHANGE."', args=[d.arg(name='perSeriesAligner', type=d.T.string)]),
            withPerSeriesAligner(perSeriesAligner): { perSeriesAligner: perSeriesAligner },
          },
          '#forecastOptions':: d.obj(help='"When this field is present, the MetricThreshold\\ncondition forecasts whether the time series is\\npredicted to violate the threshold within the\\nforecastHorizon. When this field is not set, the\\nMetricThreshold tests the current value of the\\ntimeseries against the threshold.\\nStructure is documented below."'),
          forecastOptions: {
            '#withForecastHorizon':: d.fn(help='"The length of time into the future to forecast\\nwhether a timeseries will violate the threshold.\\nIf the predicted value is found to violate the\\nthreshold, and the violation is observed in all\\nforecasts made for the Configured duration,\\nthen the timeseries is considered to be failing."', args=[d.arg(name='forecastHorizon', type=d.T.string)]),
            withForecastHorizon(forecastHorizon): { forecastHorizon: forecastHorizon },
          },
          '#trigger':: d.obj(help='"The number/percent of time series for which\\nthe comparison must hold in order for the\\ncondition to trigger. If unspecified, then\\nthe condition will trigger if the comparison\\nis true for any of the time series that have\\nbeen identified by filter and aggregations,\\nor by the ratio, if denominator_filter and\\ndenominator_aggregations are specified.\\nStructure is documented below."'),
          trigger: {
            '#withCount':: d.fn(help='"The absolute number of time series\\nthat must fail the predicate for the\\ncondition to be triggered."', args=[d.arg(name='count', type=d.T.number)]),
            withCount(count): { count: count },
            '#withPercent':: d.fn(help='"The percentage of time series that\\nmust fail the predicate for the\\ncondition to be triggered."', args=[d.arg(name='percent', type=d.T.number)]),
            withPercent(percent): { percent: percent },
          },
          '#withAggregations':: d.fn(help='"Specifies the alignment of data points in\\nindividual time series as well as how to\\ncombine the retrieved time series together\\n(such as when aggregating multiple streams\\non each resource to a single stream for each\\nresource or when aggregating streams across\\nall members of a group of resources).\\nMultiple aggregations are applied in the\\norder specified.This field is similar to the\\none in the MetricService.ListTimeSeries\\nrequest. It is advisable to use the\\nListTimeSeries method when debugging this\\nfield.\\nStructure is documented below."', args=[d.arg(name='aggregations', type=d.T.array)]),
          withAggregations(aggregations): { aggregations: if std.isArray(v=aggregations) then aggregations else [aggregations] },
          '#withAggregationsMixin':: d.fn(help='"Specifies the alignment of data points in\\nindividual time series as well as how to\\ncombine the retrieved time series together\\n(such as when aggregating multiple streams\\non each resource to a single stream for each\\nresource or when aggregating streams across\\nall members of a group of resources).\\nMultiple aggregations are applied in the\\norder specified.This field is similar to the\\none in the MetricService.ListTimeSeries\\nrequest. It is advisable to use the\\nListTimeSeries method when debugging this\\nfield.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='aggregations', type=d.T.array)]),
          withAggregationsMixin(aggregations): { aggregations+: if std.isArray(v=aggregations) then aggregations else [aggregations] },
          '#withComparison':: d.fn(help='"The comparison to apply between the time\\nseries (indicated by filter and aggregation)\\nand the threshold (indicated by\\nthreshold_value). The comparison is applied\\non each time series, with the time series on\\nthe left-hand side and the threshold on the\\nright-hand side. Only COMPARISON_LT and\\nCOMPARISON_GT are supported currently.\\nPossible values are: COMPARISON_GT, COMPARISON_GE, COMPARISON_LT, COMPARISON_LE, COMPARISON_EQ, COMPARISON_NE."', args=[d.arg(name='comparison', type=d.T.string)]),
          withComparison(comparison): { comparison: comparison },
          '#withDenominatorAggregations':: d.fn(help='"Specifies the alignment of data points in\\nindividual time series selected by\\ndenominatorFilter as well as how to combine\\nthe retrieved time series together (such as\\nwhen aggregating multiple streams on each\\nresource to a single stream for each\\nresource or when aggregating streams across\\nall members of a group of resources).When\\ncomputing ratios, the aggregations and\\ndenominator_aggregations fields must use the\\nsame alignment period and produce time\\nseries that have the same periodicity and\\nlabels.This field is similar to the one in\\nthe MetricService.ListTimeSeries request. It\\nis advisable to use the ListTimeSeries\\nmethod when debugging this field.\\nStructure is documented below."', args=[d.arg(name='denominatorAggregations', type=d.T.array)]),
          withDenominatorAggregations(denominatorAggregations): { denominatorAggregations: if std.isArray(v=denominatorAggregations) then denominatorAggregations else [denominatorAggregations] },
          '#withDenominatorAggregationsMixin':: d.fn(help='"Specifies the alignment of data points in\\nindividual time series selected by\\ndenominatorFilter as well as how to combine\\nthe retrieved time series together (such as\\nwhen aggregating multiple streams on each\\nresource to a single stream for each\\nresource or when aggregating streams across\\nall members of a group of resources).When\\ncomputing ratios, the aggregations and\\ndenominator_aggregations fields must use the\\nsame alignment period and produce time\\nseries that have the same periodicity and\\nlabels.This field is similar to the one in\\nthe MetricService.ListTimeSeries request. It\\nis advisable to use the ListTimeSeries\\nmethod when debugging this field.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='denominatorAggregations', type=d.T.array)]),
          withDenominatorAggregationsMixin(denominatorAggregations): { denominatorAggregations+: if std.isArray(v=denominatorAggregations) then denominatorAggregations else [denominatorAggregations] },
          '#withDenominatorFilter':: d.fn(help='"A filter that identifies a time series that\\nshould be used as the denominator of a ratio\\nthat will be compared with the threshold. If\\na denominator_filter is specified, the time\\nseries specified by the filter field will be\\nused as the numerator.The filter is similar\\nto the one that is specified in the\\nMetricService.ListTimeSeries request (that\\ncall is useful to verify the time series\\nthat will be retrieved / processed) and must\\nspecify the metric type and optionally may\\ncontain restrictions on resource type,\\nresource labels, and metric labels. This\\nfield may not exceed 2048 Unicode characters\\nin length."', args=[d.arg(name='denominatorFilter', type=d.T.string)]),
          withDenominatorFilter(denominatorFilter): { denominatorFilter: denominatorFilter },
          '#withDuration':: d.fn(help='"The amount of time that a time series must\\nviolate the threshold to be considered\\nfailing. Currently, only values that are a\\nmultiple of a minute--e.g., 0, 60, 120, or\\n300 seconds--are supported. If an invalid\\nvalue is given, an error will be returned.\\nWhen choosing a duration, it is useful to\\nkeep in mind the frequency of the underlying\\ntime series data (which may also be affected\\nby any alignments specified in the\\naggregations field); a good duration is long\\nenough so that a single outlier does not\\ngenerate spurious alerts, but short enough\\nthat unhealthy states are detected and\\nalerted on quickly."', args=[d.arg(name='duration', type=d.T.string)]),
          withDuration(duration): { duration: duration },
          '#withEvaluationMissingData':: d.fn(help='"A condition control that determines how\\nmetric-threshold conditions are evaluated when\\ndata stops arriving.\\nPossible values are: EVALUATION_MISSING_DATA_INACTIVE, EVALUATION_MISSING_DATA_ACTIVE, EVALUATION_MISSING_DATA_NO_OP."', args=[d.arg(name='evaluationMissingData', type=d.T.string)]),
          withEvaluationMissingData(evaluationMissingData): { evaluationMissingData: evaluationMissingData },
          '#withFilter':: d.fn(help='"A filter that identifies which time series\\nshould be compared with the threshold.The\\nfilter is similar to the one that is\\nspecified in the\\nMetricService.ListTimeSeries request (that\\ncall is useful to verify the time series\\nthat will be retrieved / processed) and must\\nspecify the metric type and optionally may\\ncontain restrictions on resource type,\\nresource labels, and metric labels. This\\nfield may not exceed 2048 Unicode characters\\nin length."', args=[d.arg(name='filter', type=d.T.string)]),
          withFilter(filter): { filter: filter },
          '#withForecastOptions':: d.fn(help='"When this field is present, the MetricThreshold\\ncondition forecasts whether the time series is\\npredicted to violate the threshold within the\\nforecastHorizon. When this field is not set, the\\nMetricThreshold tests the current value of the\\ntimeseries against the threshold.\\nStructure is documented below."', args=[d.arg(name='forecastOptions', type=d.T.array)]),
          withForecastOptions(forecastOptions): { forecastOptions: if std.isArray(v=forecastOptions) then forecastOptions else [forecastOptions] },
          '#withForecastOptionsMixin':: d.fn(help='"When this field is present, the MetricThreshold\\ncondition forecasts whether the time series is\\npredicted to violate the threshold within the\\nforecastHorizon. When this field is not set, the\\nMetricThreshold tests the current value of the\\ntimeseries against the threshold.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='forecastOptions', type=d.T.array)]),
          withForecastOptionsMixin(forecastOptions): { forecastOptions+: if std.isArray(v=forecastOptions) then forecastOptions else [forecastOptions] },
          '#withThresholdValue':: d.fn(help='"A value against which to compare the time\\nseries."', args=[d.arg(name='thresholdValue', type=d.T.number)]),
          withThresholdValue(thresholdValue): { thresholdValue: thresholdValue },
          '#withTrigger':: d.fn(help='"The number/percent of time series for which\\nthe comparison must hold in order for the\\ncondition to trigger. If unspecified, then\\nthe condition will trigger if the comparison\\nis true for any of the time series that have\\nbeen identified by filter and aggregations,\\nor by the ratio, if denominator_filter and\\ndenominator_aggregations are specified.\\nStructure is documented below."', args=[d.arg(name='trigger', type=d.T.array)]),
          withTrigger(trigger): { trigger: if std.isArray(v=trigger) then trigger else [trigger] },
          '#withTriggerMixin':: d.fn(help='"The number/percent of time series for which\\nthe comparison must hold in order for the\\ncondition to trigger. If unspecified, then\\nthe condition will trigger if the comparison\\nis true for any of the time series that have\\nbeen identified by filter and aggregations,\\nor by the ratio, if denominator_filter and\\ndenominator_aggregations are specified.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='trigger', type=d.T.array)]),
          withTriggerMixin(trigger): { trigger+: if std.isArray(v=trigger) then trigger else [trigger] },
        },
        '#withConditionAbsent':: d.fn(help='"A condition that checks that a time series\\ncontinues to receive new data points.\\nStructure is documented below."', args=[d.arg(name='conditionAbsent', type=d.T.array)]),
        withConditionAbsent(conditionAbsent): { conditionAbsent: if std.isArray(v=conditionAbsent) then conditionAbsent else [conditionAbsent] },
        '#withConditionAbsentMixin':: d.fn(help='"A condition that checks that a time series\\ncontinues to receive new data points.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='conditionAbsent', type=d.T.array)]),
        withConditionAbsentMixin(conditionAbsent): { conditionAbsent+: if std.isArray(v=conditionAbsent) then conditionAbsent else [conditionAbsent] },
        '#withConditionMatchedLog':: d.fn(help='"A condition that checks for log messages matching given constraints.\\nIf set, no other conditions can be present.\\nStructure is documented below."', args=[d.arg(name='conditionMatchedLog', type=d.T.array)]),
        withConditionMatchedLog(conditionMatchedLog): { conditionMatchedLog: if std.isArray(v=conditionMatchedLog) then conditionMatchedLog else [conditionMatchedLog] },
        '#withConditionMatchedLogMixin':: d.fn(help='"A condition that checks for log messages matching given constraints.\\nIf set, no other conditions can be present.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='conditionMatchedLog', type=d.T.array)]),
        withConditionMatchedLogMixin(conditionMatchedLog): { conditionMatchedLog+: if std.isArray(v=conditionMatchedLog) then conditionMatchedLog else [conditionMatchedLog] },
        '#withConditionMonitoringQueryLanguage':: d.fn(help='"A Monitoring Query Language query that outputs a boolean stream\\nStructure is documented below."', args=[d.arg(name='conditionMonitoringQueryLanguage', type=d.T.array)]),
        withConditionMonitoringQueryLanguage(conditionMonitoringQueryLanguage): { conditionMonitoringQueryLanguage: if std.isArray(v=conditionMonitoringQueryLanguage) then conditionMonitoringQueryLanguage else [conditionMonitoringQueryLanguage] },
        '#withConditionMonitoringQueryLanguageMixin':: d.fn(help='"A Monitoring Query Language query that outputs a boolean stream\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='conditionMonitoringQueryLanguage', type=d.T.array)]),
        withConditionMonitoringQueryLanguageMixin(conditionMonitoringQueryLanguage): { conditionMonitoringQueryLanguage+: if std.isArray(v=conditionMonitoringQueryLanguage) then conditionMonitoringQueryLanguage else [conditionMonitoringQueryLanguage] },
        '#withConditionPrometheusQueryLanguage':: d.fn(help='"A condition type that allows alert policies to be defined using\\nPrometheus Query Language (PromQL).\\nThe PrometheusQueryLanguageCondition message contains information\\nfrom a Prometheus alerting rule and its associated rule group.\\nStructure is documented below."', args=[d.arg(name='conditionPrometheusQueryLanguage', type=d.T.array)]),
        withConditionPrometheusQueryLanguage(conditionPrometheusQueryLanguage): { conditionPrometheusQueryLanguage: if std.isArray(v=conditionPrometheusQueryLanguage) then conditionPrometheusQueryLanguage else [conditionPrometheusQueryLanguage] },
        '#withConditionPrometheusQueryLanguageMixin':: d.fn(help='"A condition type that allows alert policies to be defined using\\nPrometheus Query Language (PromQL).\\nThe PrometheusQueryLanguageCondition message contains information\\nfrom a Prometheus alerting rule and its associated rule group.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='conditionPrometheusQueryLanguage', type=d.T.array)]),
        withConditionPrometheusQueryLanguageMixin(conditionPrometheusQueryLanguage): { conditionPrometheusQueryLanguage+: if std.isArray(v=conditionPrometheusQueryLanguage) then conditionPrometheusQueryLanguage else [conditionPrometheusQueryLanguage] },
        '#withConditionThreshold':: d.fn(help='"A condition that compares a time series against a\\nthreshold.\\nStructure is documented below."', args=[d.arg(name='conditionThreshold', type=d.T.array)]),
        withConditionThreshold(conditionThreshold): { conditionThreshold: if std.isArray(v=conditionThreshold) then conditionThreshold else [conditionThreshold] },
        '#withConditionThresholdMixin':: d.fn(help='"A condition that compares a time series against a\\nthreshold.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='conditionThreshold', type=d.T.array)]),
        withConditionThresholdMixin(conditionThreshold): { conditionThreshold+: if std.isArray(v=conditionThreshold) then conditionThreshold else [conditionThreshold] },
        '#withDisplayName':: d.fn(help="\"A short name or phrase used to identify the\\ncondition in dashboards, notifications, and\\nincidents. To avoid confusion, don't use the same\\ndisplay name for multiple conditions in the same\\npolicy.\"", args=[d.arg(name='displayName', type=d.T.string)]),
        withDisplayName(displayName): { displayName: displayName },
      },
      '#documentation':: d.obj(help='"Documentation that is included with notifications and incidents related\\nto this policy. Best practice is for the documentation to include information\\nto help responders understand, mitigate, escalate, and correct the underlying\\nproblems detected by the alerting policy. Notification channels that have\\nlimited capacity might not show this documentation.\\nStructure is documented below."'),
      documentation: {
        '#links':: d.obj(help='"Links to content such as playbooks, repositories, and other resources. This field can contain up to 3 entries.\\nStructure is documented below."'),
        links: {
          '#withDisplayName':: d.fn(help='"A short display name for the link. The display name must not be empty or exceed 63 characters. Example: \\"playbook\\"."', args=[d.arg(name='displayName', type=d.T.string)]),
          withDisplayName(displayName): { displayName: displayName },
          '#withUrl':: d.fn(help='"The url of a webpage. A url can be templatized by using variables in the path or the query parameters. The total length of a URL should not exceed 2083 characters before and after variable expansion. Example: \\"https://my_domain.com/playbook?name=${resource.name}\\"."', args=[d.arg(name='url', type=d.T.string)]),
          withUrl(url): { url: url },
        },
        '#withContent':: d.fn(help='"The text of the documentation, interpreted according to mimeType.\\nThe content may not exceed 8,192 Unicode characters and may not\\nexceed more than 10,240 bytes when encoded in UTF-8 format,\\nwhichever is smaller."', args=[d.arg(name='content', type=d.T.string)]),
        withContent(content): { content: content },
        '#withLinks':: d.fn(help='"Links to content such as playbooks, repositories, and other resources. This field can contain up to 3 entries.\\nStructure is documented below."', args=[d.arg(name='links', type=d.T.array)]),
        withLinks(links): { links: if std.isArray(v=links) then links else [links] },
        '#withLinksMixin':: d.fn(help='"Links to content such as playbooks, repositories, and other resources. This field can contain up to 3 entries.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='links', type=d.T.array)]),
        withLinksMixin(links): { links+: if std.isArray(v=links) then links else [links] },
        '#withMimeType':: d.fn(help='"The format of the content field. Presently, only the value\\n\\"text/markdown\\" is supported."', args=[d.arg(name='mimeType', type=d.T.string)]),
        withMimeType(mimeType): { mimeType: mimeType },
        '#withSubject':: d.fn(help='"The subject line of the notification. The subject line may not\\nexceed 10,240 bytes. In notifications generated by this policy the contents\\nof the subject line after variable expansion will be truncated to 255 bytes\\nor shorter at the latest UTF-8 character boundary."', args=[d.arg(name='subject', type=d.T.string)]),
        withSubject(subject): { subject: subject },
      },
      '#withAlertStrategy':: d.fn(help="\"Control over how this alert policy's notification channels are notified.\\nStructure is documented below.\"", args=[d.arg(name='alertStrategy', type=d.T.array)]),
      withAlertStrategy(alertStrategy): { spec+: { initProvider+: { alertStrategy: if std.isArray(v=alertStrategy) then alertStrategy else [alertStrategy] } } },
      '#withAlertStrategyMixin':: d.fn(help="\"Control over how this alert policy's notification channels are notified.\\nStructure is documented below.\"\n\n**Note:** This function appends passed data to existing values", args=[d.arg(name='alertStrategy', type=d.T.array)]),
      withAlertStrategyMixin(alertStrategy): { spec+: { initProvider+: { alertStrategy+: if std.isArray(v=alertStrategy) then alertStrategy else [alertStrategy] } } },
      '#withCombiner':: d.fn(help='"How to combine the results of multiple conditions to\\ndetermine if an incident should be opened.\\nPossible values are: AND, OR, AND_WITH_MATCHING_RESOURCE."', args=[d.arg(name='combiner', type=d.T.string)]),
      withCombiner(combiner): { spec+: { initProvider+: { combiner: combiner } } },
      '#withConditions':: d.fn(help='"A list of conditions for the policy. The conditions are combined by\\nAND or OR according to the combiner field. If the combined conditions\\nevaluate to true, then an incident is created. A policy can have from\\none to six conditions.\\nStructure is documented below."', args=[d.arg(name='conditions', type=d.T.array)]),
      withConditions(conditions): { spec+: { initProvider+: { conditions: if std.isArray(v=conditions) then conditions else [conditions] } } },
      '#withConditionsMixin':: d.fn(help='"A list of conditions for the policy. The conditions are combined by\\nAND or OR according to the combiner field. If the combined conditions\\nevaluate to true, then an incident is created. A policy can have from\\none to six conditions.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='conditions', type=d.T.array)]),
      withConditionsMixin(conditions): { spec+: { initProvider+: { conditions+: if std.isArray(v=conditions) then conditions else [conditions] } } },
      '#withDisplayName':: d.fn(help="\"A short name or phrase used to identify the policy in\\ndashboards, notifications, and incidents. To avoid confusion, don't use\\nthe same display name for multiple policies in the same project. The\\nname is limited to 512 Unicode characters.\"", args=[d.arg(name='displayName', type=d.T.string)]),
      withDisplayName(displayName): { spec+: { initProvider+: { displayName: displayName } } },
      '#withDocumentation':: d.fn(help='"Documentation that is included with notifications and incidents related\\nto this policy. Best practice is for the documentation to include information\\nto help responders understand, mitigate, escalate, and correct the underlying\\nproblems detected by the alerting policy. Notification channels that have\\nlimited capacity might not show this documentation.\\nStructure is documented below."', args=[d.arg(name='documentation', type=d.T.array)]),
      withDocumentation(documentation): { spec+: { initProvider+: { documentation: if std.isArray(v=documentation) then documentation else [documentation] } } },
      '#withDocumentationMixin':: d.fn(help='"Documentation that is included with notifications and incidents related\\nto this policy. Best practice is for the documentation to include information\\nto help responders understand, mitigate, escalate, and correct the underlying\\nproblems detected by the alerting policy. Notification channels that have\\nlimited capacity might not show this documentation.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='documentation', type=d.T.array)]),
      withDocumentationMixin(documentation): { spec+: { initProvider+: { documentation+: if std.isArray(v=documentation) then documentation else [documentation] } } },
      '#withEnabled':: d.fn(help='"Whether or not the policy is enabled. The default is true."', args=[d.arg(name='enabled', type=d.T.boolean)]),
      withEnabled(enabled): { spec+: { initProvider+: { enabled: enabled } } },
      '#withNotificationChannels':: d.fn(help='"Identifies the notification channels to which notifications should be\\nsent when incidents are opened or closed or when new violations occur\\non an already opened incident. Each element of this array corresponds\\nto the name field in each of the NotificationChannel objects that are\\nreturned from the notificationChannels.list method. The syntax of the\\nentries in this field is\\nprojects/[PROJECT_ID]/notificationChannels/[CHANNEL_ID]"', args=[d.arg(name='notificationChannels', type=d.T.array)]),
      withNotificationChannels(notificationChannels): { spec+: { initProvider+: { notificationChannels: if std.isArray(v=notificationChannels) then notificationChannels else [notificationChannels] } } },
      '#withNotificationChannelsMixin':: d.fn(help='"Identifies the notification channels to which notifications should be\\nsent when incidents are opened or closed or when new violations occur\\non an already opened incident. Each element of this array corresponds\\nto the name field in each of the NotificationChannel objects that are\\nreturned from the notificationChannels.list method. The syntax of the\\nentries in this field is\\nprojects/[PROJECT_ID]/notificationChannels/[CHANNEL_ID]"\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='notificationChannels', type=d.T.array)]),
      withNotificationChannelsMixin(notificationChannels): { spec+: { initProvider+: { notificationChannels+: if std.isArray(v=notificationChannels) then notificationChannels else [notificationChannels] } } },
      '#withProject':: d.fn(help='"The ID of the project in which the resource belongs.\\nIf it is not provided, the provider project is used."', args=[d.arg(name='project', type=d.T.string)]),
      withProject(project): { spec+: { initProvider+: { project: project } } },
