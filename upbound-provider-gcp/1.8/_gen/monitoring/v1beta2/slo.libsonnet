              '#withDistributionFilter':: d.fn(help='"A TimeSeries monitoring filter\\naggregating values to quantify the good service provided.\\nMust have ValueType = DISTRIBUTION and\\nMetricKind = DELTA or MetricKind = CUMULATIVE."', args=[d.arg(name='distributionFilter', type=d.T.string)]),
              withDistributionFilter(distributionFilter): { spec+: { initProvider+: { windowsBasedSli+: { goodTotalRatioThreshold+: { performance+: { distributionCut+: { distributionFilter: distributionFilter } } } } } } },
