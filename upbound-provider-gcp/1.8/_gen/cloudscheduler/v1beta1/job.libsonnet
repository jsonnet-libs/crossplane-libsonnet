        '#withMaxBackoffDuration':: d.fn(help="\"The maximum amount of time to wait before retrying a job after it fails.\\nA duration in seconds with up to nine fractional digits, terminated by 's'.\"", args=[d.arg(name='maxBackoffDuration', type=d.T.string)]),
        withMaxBackoffDuration(maxBackoffDuration): { maxBackoffDuration: maxBackoffDuration },
        '#withMaxDoublings':: d.fn(help="\"The time between retries will double maxDoublings times.\\nA job's retry interval starts at minBackoffDuration,\\nthen doubles maxDoublings times, then increases linearly,\\nand finally retries retries at intervals of maxBackoffDuration up to retryCount times.\"", args=[d.arg(name='maxDoublings', type=d.T.number)]),
        withMaxDoublings(maxDoublings): { maxDoublings: maxDoublings },
        '#withMaxRetryDuration':: d.fn(help="\"The time limit for retrying a failed job, measured from time when an execution was first attempted.\\nIf specified with retryCount, the job will be retried until both limits are reached.\\nA duration in seconds with up to nine fractional digits, terminated by 's'.\"", args=[d.arg(name='maxRetryDuration', type=d.T.string)]),
        withMaxRetryDuration(maxRetryDuration): { maxRetryDuration: maxRetryDuration },
        '#withMinBackoffDuration':: d.fn(help="\"The minimum amount of time to wait before retrying a job after it fails.\\nA duration in seconds with up to nine fractional digits, terminated by 's'.\"", args=[d.arg(name='minBackoffDuration', type=d.T.string)]),
        withMinBackoffDuration(minBackoffDuration): { minBackoffDuration: minBackoffDuration },
        '#withRetryCount':: d.fn(help='"The number of attempts that the system will make to run a\\njob using the exponential backoff procedure described by maxDoublings.\\nValues greater than 5 and negative values are not allowed."', args=[d.arg(name='retryCount', type=d.T.number)]),
        withRetryCount(retryCount): { retryCount: retryCount },
      },
      '#withAppEngineHttpTarget':: d.fn(help='"App Engine HTTP target.\\nIf the job providers a App Engine HTTP target the cron will\\nsend a request to the service instance\\nStructure is documented below."', args=[d.arg(name='appEngineHttpTarget', type=d.T.array)]),
      withAppEngineHttpTarget(appEngineHttpTarget): { spec+: { forProvider+: { appEngineHttpTarget: if std.isArray(v=appEngineHttpTarget) then appEngineHttpTarget else [appEngineHttpTarget] } } },
      '#withAppEngineHttpTargetMixin':: d.fn(help='"App Engine HTTP target.\\nIf the job providers a App Engine HTTP target the cron will\\nsend a request to the service instance\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='appEngineHttpTarget', type=d.T.array)]),
      withAppEngineHttpTargetMixin(appEngineHttpTarget): { spec+: { forProvider+: { appEngineHttpTarget+: if std.isArray(v=appEngineHttpTarget) then appEngineHttpTarget else [appEngineHttpTarget] } } },
      '#withAttemptDeadline':: d.fn(help='"The deadline for job attempts. If the request handler does not respond by this deadline then the request is\\ncancelled and the attempt is marked as a DEADLINE_EXCEEDED failure. The failed attempt can be viewed in\\nexecution logs. Cloud Scheduler will retry the job according to the RetryConfig.\\nThe allowed duration for this deadline is:"', args=[d.arg(name='attemptDeadline', type=d.T.string)]),
      withAttemptDeadline(attemptDeadline): { spec+: { forProvider+: { attemptDeadline: attemptDeadline } } },
