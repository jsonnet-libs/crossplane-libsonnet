            '#withDescription':: d.fn(help='"A description of this ip range."', args=[d.arg(name='description', type=d.T.string)]),
            withDescription(description): { description: description },
            '#withValue':: d.fn(help='"IP address or range, defined using CIDR notation, of requests that this rule applies to.\\nExamples: 192.168.1.1 or 192.168.0.0/16 or 2001:db8::/32 or 2001:0db8:0000:0042:0000:8a2e:0370:7334.\\nIP range prefixes should be properly truncated. For example,\\n1.2.3.4/24 should be truncated to 1.2.3.0/24. Similarly, for IPv6, 2001:db8::1/32 should be truncated to 2001:db8::/32."', args=[d.arg(name='value', type=d.T.string)]),
            withValue(value): { value: value },
          },
          '#withAllowedIpRange':: d.fn(help='"A collection of allowed IP ranges with descriptions. Structure is documented below."', args=[d.arg(name='allowedIpRange', type=d.T.array)]),
          withAllowedIpRange(allowedIpRange): { allowedIpRange: if std.isArray(v=allowedIpRange) then allowedIpRange else [allowedIpRange] },
