        withDataRetentionConfig(dataRetentionConfig): { dataRetentionConfig: if std.isArray(v=dataRetentionConfig) then dataRetentionConfig else [dataRetentionConfig] },
        '#withDataRetentionConfigMixin':: d.fn(help='"Configuration setting for airflow data rentention mechanism. Structure is\\ndocumented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='dataRetentionConfig', type=d.T.array)]),
        withDataRetentionConfigMixin(dataRetentionConfig): { dataRetentionConfig+: if std.isArray(v=dataRetentionConfig) then dataRetentionConfig else [dataRetentionConfig] },
        '#withDatabaseConfig':: d.fn(help='"The configuration settings for Cloud SQL instance used internally\\nby Apache Airflow software."', args=[d.arg(name='databaseConfig', type=d.T.array)]),
        withDatabaseConfig(databaseConfig): { databaseConfig: if std.isArray(v=databaseConfig) then databaseConfig else [databaseConfig] },
        '#withDatabaseConfigMixin':: d.fn(help='"The configuration settings for Cloud SQL instance used internally\\nby Apache Airflow software."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='databaseConfig', type=d.T.array)]),
        withDatabaseConfigMixin(databaseConfig): { databaseConfig+: if std.isArray(v=databaseConfig) then databaseConfig else [databaseConfig] },
        '#withEncryptionConfig':: d.fn(help='"The encryption options for the Cloud Composer environment and its\\ndependencies."', args=[d.arg(name='encryptionConfig', type=d.T.array)]),
        withEncryptionConfig(encryptionConfig): { encryptionConfig: if std.isArray(v=encryptionConfig) then encryptionConfig else [encryptionConfig] },
        '#withEncryptionConfigMixin':: d.fn(help='"The encryption options for the Cloud Composer environment and its\\ndependencies."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='encryptionConfig', type=d.T.array)]),
        withEncryptionConfigMixin(encryptionConfig): { encryptionConfig+: if std.isArray(v=encryptionConfig) then encryptionConfig else [encryptionConfig] },
        '#withEnvironmentSize':: d.fn(help='"The environment size controls the performance parameters of the managed\\nCloud Composer infrastructure that includes the Airflow database. Values for\\nenvironment size are ENVIRONMENT_SIZE_SMALL, ENVIRONMENT_SIZE_MEDIUM,\\nand ENVIRONMENT_SIZE_LARGE."', args=[d.arg(name='environmentSize', type=d.T.string)]),
        withEnvironmentSize(environmentSize): { environmentSize: environmentSize },
