        withMaintenanceWindow(maintenanceWindow): { maintenanceWindow: if std.isArray(v=maintenanceWindow) then maintenanceWindow else [maintenanceWindow] },
        '#withMaintenanceWindowMixin':: d.fn(help='"The configuration settings for Cloud Composer maintenance windows."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='maintenanceWindow', type=d.T.array)]),
        withMaintenanceWindowMixin(maintenanceWindow): { maintenanceWindow+: if std.isArray(v=maintenanceWindow) then maintenanceWindow else [maintenanceWindow] },
        '#withMasterAuthorizedNetworksConfig':: d.fn(help='"Configuration options for the master authorized networks feature. Enabled\\nmaster authorized networks will disallow all external traffic to access\\nKubernetes master through HTTPS except traffic from the given CIDR blocks,\\nGoogle Compute Engine Public IPs and Google Prod IPs. Structure is\\ndocumented below."', args=[d.arg(name='masterAuthorizedNetworksConfig', type=d.T.array)]),
        withMasterAuthorizedNetworksConfig(masterAuthorizedNetworksConfig): { masterAuthorizedNetworksConfig: if std.isArray(v=masterAuthorizedNetworksConfig) then masterAuthorizedNetworksConfig else [masterAuthorizedNetworksConfig] },
        '#withMasterAuthorizedNetworksConfigMixin':: d.fn(help='"Configuration options for the master authorized networks feature. Enabled\\nmaster authorized networks will disallow all external traffic to access\\nKubernetes master through HTTPS except traffic from the given CIDR blocks,\\nGoogle Compute Engine Public IPs and Google Prod IPs. Structure is\\ndocumented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='masterAuthorizedNetworksConfig', type=d.T.array)]),
        withMasterAuthorizedNetworksConfigMixin(masterAuthorizedNetworksConfig): { masterAuthorizedNetworksConfig+: if std.isArray(v=masterAuthorizedNetworksConfig) then masterAuthorizedNetworksConfig else [masterAuthorizedNetworksConfig] },
        '#withNodeConfig':: d.fn(help='"The configuration used for the Kubernetes Engine cluster.  Structure is documented below."', args=[d.arg(name='nodeConfig', type=d.T.array)]),
        withNodeConfig(nodeConfig): { nodeConfig: if std.isArray(v=nodeConfig) then nodeConfig else [nodeConfig] },
        '#withNodeConfigMixin':: d.fn(help='"The configuration used for the Kubernetes Engine cluster.  Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='nodeConfig', type=d.T.array)]),
        withNodeConfigMixin(nodeConfig): { nodeConfig+: if std.isArray(v=nodeConfig) then nodeConfig else [nodeConfig] },
