          withCidrBlocks(cidrBlocks): { cidrBlocks: if std.isArray(v=cidrBlocks) then cidrBlocks else [cidrBlocks] },
          '#withCidrBlocksMixin':: d.fn(help='"cidr_blocks define up to 50 external networks that could access Kubernetes master through HTTPS. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='cidrBlocks', type=d.T.array)]),
