          withZone(zone): { zone: zone },
        },
        '#encryptionConfig':: d.obj(help='"The encryption options for the Cloud Composer environment and its\\ndependencies."'),
        encryptionConfig: {
          '#withKmsKeyName':: d.fn(help="\"Customer-managed Encryption Key available through Google's Key Management Service. It must\\nbe the fully qualified resource name,\\ni.e. projects/project-id/locations/location/keyRings/keyring/cryptoKeys/key. Cannot be updated.\"", args=[d.arg(name='kmsKeyName', type=d.T.string)]),
          withKmsKeyName(kmsKeyName): { kmsKeyName: kmsKeyName },
        },
        '#maintenanceWindow':: d.obj(help='"The configuration settings for Cloud Composer maintenance windows."'),
        maintenanceWindow: {
          '#withEndTime':: d.fn(help="\"Maintenance window end time. It is used only to calculate the duration of the maintenance window.\\nThe value for end-time must be in the future, relative to 'start_time'.\"", args=[d.arg(name='endTime', type=d.T.string)]),
          withEndTime(endTime): { endTime: endTime },
          '#withRecurrence':: d.fn(help="\"Maintenance window recurrence. Format is a subset of RFC-5545 (https://tools.ietf.org/html/rfc5545) 'RRULE'.\\nThe only allowed values for 'FREQ' field are 'FREQ=DAILY' and 'FREQ=WEEKLY;BYDAY=...'.\\nExample values: 'FREQ=WEEKLY;BYDAY=TU,WE', 'FREQ=DAILY'.\"", args=[d.arg(name='recurrence', type=d.T.string)]),
          withRecurrence(recurrence): { recurrence: recurrence },
