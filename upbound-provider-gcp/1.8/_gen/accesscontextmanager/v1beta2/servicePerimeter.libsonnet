            '#withIdentityType':: d.fn(help='"Specifies the type of identities that are allowed access from outside the\\nperimeter. If left unspecified, then members of identities field will be\\nallowed access.\\nPossible values are: IDENTITY_TYPE_UNSPECIFIED, ANY_IDENTITY, ANY_USER_ACCOUNT, ANY_SERVICE_ACCOUNT."', args=[d.arg(name='identityType', type=d.T.string)]),
            withIdentityType(identityType): { egressFrom+: { identityType: identityType } },
