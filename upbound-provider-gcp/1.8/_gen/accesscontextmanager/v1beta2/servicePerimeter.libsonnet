              '#withMethodSelectorsMixin':: d.fn(help='"API methods or permissions to allow. Method or permission must belong to\\nthe service specified by serviceName field. A single MethodSelector entry\\nwith * specified for the method field will allow all methods AND\\npermissions for the service specified in serviceName.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='methodSelectors', type=d.T.array)]),
