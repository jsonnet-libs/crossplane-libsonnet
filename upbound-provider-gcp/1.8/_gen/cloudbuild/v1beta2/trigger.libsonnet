  '#spec':: d.obj(help='"TriggerSpec defines the desired state of Trigger"'),
  spec: {
    '#forProvider':: d.obj(help=''),
    forProvider: {
      '#approvalConfig':: d.obj(help='"Configuration for manual approval to start a build invocation of this BuildTrigger.\\nBuilds created by this trigger will require approval before they execute.\\nAny user with a Cloud Build Approver role for the project can approve a build.\\nStructure is documented below."'),
      approvalConfig: {
        '#withApprovalRequired':: d.fn(help='"Whether or not approval is needed. If this is set on a build, it will become pending when run,\\nand will need to be explicitly approved to start."', args=[d.arg(name='approvalRequired', type=d.T.boolean)]),
        withApprovalRequired(approvalRequired): { spec+: { forProvider+: { approvalConfig+: { approvalRequired: approvalRequired } } } },
      },
      '#bitbucketServerTriggerConfig':: d.obj(help='"BitbucketServerTriggerConfig describes the configuration of a trigger that creates a build whenever a Bitbucket Server event is received.\\nStructure is documented below."'),
      bitbucketServerTriggerConfig: {
        '#pullRequest':: d.obj(help='"Filter to match changes in pull requests.\\nStructure is documented below."'),
        pullRequest: {
          '#withBranch':: d.fn(help='"Regex of branches to match.\\nThe syntax of the regular expressions accepted is the syntax accepted by\\nRE2 and described at https://github.com/google/re2/wiki/Syntax"', args=[d.arg(name='branch', type=d.T.string)]),
          withBranch(branch): { spec+: { forProvider+: { bitbucketServerTriggerConfig+: { pullRequest+: { branch: branch } } } } },
          '#withCommentControl':: d.fn(help='"Configure builds to run whether a repository owner or collaborator need to comment /gcbrun.\\nPossible values are: COMMENTS_DISABLED, COMMENTS_ENABLED, COMMENTS_ENABLED_FOR_EXTERNAL_CONTRIBUTORS_ONLY."', args=[d.arg(name='commentControl', type=d.T.string)]),
          withCommentControl(commentControl): { spec+: { forProvider+: { bitbucketServerTriggerConfig+: { pullRequest+: { commentControl: commentControl } } } } },
          '#withInvertRegex':: d.fn(help='"Only trigger a build if the revision regex does NOT match the revision regex."', args=[d.arg(name='invertRegex', type=d.T.boolean)]),
          withInvertRegex(invertRegex): { spec+: { forProvider+: { bitbucketServerTriggerConfig+: { pullRequest+: { invertRegex: invertRegex } } } } },
        },
        '#push':: d.obj(help='"Filter to match changes in refs like branches, tags.\\nStructure is documented below."'),
        push: {
          '#withBranch':: d.fn(help='"Regex of branches to match.\\nThe syntax of the regular expressions accepted is the syntax accepted by\\nRE2 and described at https://github.com/google/re2/wiki/Syntax"', args=[d.arg(name='branch', type=d.T.string)]),
          withBranch(branch): { spec+: { forProvider+: { bitbucketServerTriggerConfig+: { push+: { branch: branch } } } } },
          '#withInvertRegex':: d.fn(help='"Only trigger a build if the revision regex does NOT match the revision regex."', args=[d.arg(name='invertRegex', type=d.T.boolean)]),
          withInvertRegex(invertRegex): { spec+: { forProvider+: { bitbucketServerTriggerConfig+: { push+: { invertRegex: invertRegex } } } } },
          '#withTag':: d.fn(help='"Regex of tags to match.\\nThe syntax of the regular expressions accepted is the syntax accepted by\\nRE2 and described at https://github.com/google/re2/wiki/Syntax"', args=[d.arg(name='tag', type=d.T.string)]),
          withTag(tag): { spec+: { forProvider+: { bitbucketServerTriggerConfig+: { push+: { tag: tag } } } } },
        },
        '#withBitbucketServerConfigResource':: d.fn(help='"The Bitbucket server config resource that this trigger config maps to."', args=[d.arg(name='bitbucketServerConfigResource', type=d.T.string)]),
        withBitbucketServerConfigResource(bitbucketServerConfigResource): { spec+: { forProvider+: { bitbucketServerTriggerConfig+: { bitbucketServerConfigResource: bitbucketServerConfigResource } } } },
        '#withProjectKey':: d.fn(help='"Key of the project that the repo is in. For example: The key for https://mybitbucket.server/projects/TEST/repos/test-repo is \\"TEST\\"."', args=[d.arg(name='projectKey', type=d.T.string)]),
        withProjectKey(projectKey): { spec+: { forProvider+: { bitbucketServerTriggerConfig+: { projectKey: projectKey } } } },
        '#withRepoSlug':: d.fn(help="\"Slug of the repository. A repository slug is a URL-friendly version of a repository name, automatically generated by Bitbucket for use in the URL.\\nFor example, if the repository name is 'test repo', in the URL it would become 'test-repo' as in https://mybitbucket.server/projects/TEST/repos/test-repo.\"", args=[d.arg(name='repoSlug', type=d.T.string)]),
        withRepoSlug(repoSlug): { spec+: { forProvider+: { bitbucketServerTriggerConfig+: { repoSlug: repoSlug } } } },
