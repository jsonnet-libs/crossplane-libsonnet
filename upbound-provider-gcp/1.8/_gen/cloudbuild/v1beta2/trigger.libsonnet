            withPaths(paths): { spec+: { initProvider+: { build+: { artifacts+: { objects+: { paths: if std.isArray(v=paths) then paths else [paths] } } } } } },
            '#withPathsMixin':: d.fn(help="\"Path globs used to match files in the build's workspace. For Python/ Twine, this is usually dist/*, and sometimes additionally an .asc file.\"\n\n**Note:** This function appends passed data to existing values", args=[d.arg(name='paths', type=d.T.array)]),
