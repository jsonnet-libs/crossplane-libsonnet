          '#withQuote':: d.fn(help='"The value that is used to quote data sections in a\\nCSV file. If your data does not contain quoted sections, set the\\nproperty value to an empty string. If your data contains quoted newline\\ncharacters, you must also set the allow_quoted_newlines property to true."', args=[d.arg(name='quote', type=d.T.string)]),
