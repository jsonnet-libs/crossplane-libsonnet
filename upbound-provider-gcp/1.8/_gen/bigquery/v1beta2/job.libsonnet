          withDatasetId(datasetId): { spec+: { forProvider+: { query+: { destinationTable+: { datasetId: datasetId } } } } },
          '#withProjectId':: d.fn(help='"The ID of the project containing this table."', args=[d.arg(name='projectId', type=d.T.string)]),
          withProjectId(projectId): { spec+: { forProvider+: { query+: { destinationTable+: { projectId: projectId } } } } },
          '#withTableId':: d.fn(help='"The table. Can be specified {{table_id}} if project_id and dataset_id are also set,\\nor of the form projects/{{project}}/datasets/{{dataset_id}}/tables/{{table_id}} if not."', args=[d.arg(name='tableId', type=d.T.string)]),
          withTableId(tableId): { spec+: { forProvider+: { query+: { destinationTable+: { tableId: tableId } } } } },
        },
        '#scriptOptions':: d.obj(help='"Options controlling the execution of scripts.\\nStructure is documented below."'),
        scriptOptions: {
          '#withKeyResultStatement':: d.fn(help='"Determines which statement in the script represents the \\"key result\\",\\nused to populate the schema and query results of the script job.\\nPossible values are: LAST, FIRST_SELECT."', args=[d.arg(name='keyResultStatement', type=d.T.string)]),
          withKeyResultStatement(keyResultStatement): { spec+: { forProvider+: { query+: { scriptOptions+: { keyResultStatement: keyResultStatement } } } } },
          '#withStatementByteBudget':: d.fn(help='"Limit on the number of bytes billed per statement. Exceeding this budget results in an error."', args=[d.arg(name='statementByteBudget', type=d.T.string)]),
          withStatementByteBudget(statementByteBudget): { spec+: { forProvider+: { query+: { scriptOptions+: { statementByteBudget: statementByteBudget } } } } },
          '#withStatementTimeoutMs':: d.fn(help='"Timeout period for each statement in a script."', args=[d.arg(name='statementTimeoutMs', type=d.T.string)]),
          withStatementTimeoutMs(statementTimeoutMs): { spec+: { forProvider+: { query+: { scriptOptions+: { statementTimeoutMs: statementTimeoutMs } } } } },
        },
