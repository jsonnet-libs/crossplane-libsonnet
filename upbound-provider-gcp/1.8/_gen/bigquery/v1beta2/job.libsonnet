          '#withInlineCode':: d.fn(help='"An inline resource that contains code for a user-defined function (UDF).\\nProviding a inline code resource is equivalent to providing a URI for a file containing the same code."', args=[d.arg(name='inlineCode', type=d.T.string)]),
          withInlineCode(inlineCode): { inlineCode: inlineCode },
          '#withResourceUri':: d.fn(help='"A code resource to load from a Google Cloud Storage URI (gs://bucket/path)."', args=[d.arg(name='resourceUri', type=d.T.string)]),
          withResourceUri(resourceUri): { resourceUri: resourceUri },
        },
        '#withAllowLargeResults':: d.fn(help='"If true and query uses legacy SQL dialect, allows the query to produce arbitrarily large result tables at a slight cost in performance.\\nRequires destinationTable to be set. For standard SQL queries, this flag is ignored and large results are always allowed.\\nHowever, you must still set destinationTable when result size exceeds the allowed maximum response size."', args=[d.arg(name='allowLargeResults', type=d.T.boolean)]),
        withAllowLargeResults(allowLargeResults): { spec+: { forProvider+: { query+: { allowLargeResults: allowLargeResults } } } },
        '#withCreateDisposition':: d.fn(help="\"Specifies whether the job is allowed to create new tables. The following values are supported:\\nCREATE_IF_NEEDED: If the table does not exist, BigQuery creates the table.\\nCREATE_NEVER: The table must already exist. If it does not, a 'notFound' error is returned in the job result.\\nCreation, truncation and append actions occur as one atomic update upon job completion\\nDefault value is CREATE_IF_NEEDED.\\nPossible values are: CREATE_IF_NEEDED, CREATE_NEVER.\"", args=[d.arg(name='createDisposition', type=d.T.string)]),
        withCreateDisposition(createDisposition): { spec+: { forProvider+: { query+: { createDisposition: createDisposition } } } },
        '#withFlattenResults':: d.fn(help='"If true and query uses legacy SQL dialect, flattens all nested and repeated fields in the query results.\\nallowLargeResults must be true if this is set to false. For standard SQL queries, this flag is ignored and results are never flattened."', args=[d.arg(name='flattenResults', type=d.T.boolean)]),
        withFlattenResults(flattenResults): { spec+: { forProvider+: { query+: { flattenResults: flattenResults } } } },
        '#withMaximumBillingTier':: d.fn(help='"Limits the billing tier for this job. Queries that have resource usage beyond this tier will fail (without incurring a charge).\\nIf unspecified, this will be set to your project default."', args=[d.arg(name='maximumBillingTier', type=d.T.number)]),
        withMaximumBillingTier(maximumBillingTier): { spec+: { forProvider+: { query+: { maximumBillingTier: maximumBillingTier } } } },
        '#withMaximumBytesBilled':: d.fn(help='"Limits the bytes billed for this job. Queries that will have bytes billed beyond this limit will fail (without incurring a charge).\\nIf unspecified, this will be set to your project default."', args=[d.arg(name='maximumBytesBilled', type=d.T.string)]),
        withMaximumBytesBilled(maximumBytesBilled): { spec+: { forProvider+: { query+: { maximumBytesBilled: maximumBytesBilled } } } },
        '#withParameterMode':: d.fn(help='"Standard SQL only. Set to POSITIONAL to use positional (?) query parameters or to NAMED to use named (@myparam) query parameters in this query."', args=[d.arg(name='parameterMode', type=d.T.string)]),
        withParameterMode(parameterMode): { spec+: { forProvider+: { query+: { parameterMode: parameterMode } } } },
        '#withPriority':: d.fn(help='"Specifies a priority for the query.\\nDefault value is INTERACTIVE.\\nPossible values are: INTERACTIVE, BATCH."', args=[d.arg(name='priority', type=d.T.string)]),
        withPriority(priority): { spec+: { forProvider+: { query+: { priority: priority } } } },
        '#withQuery':: d.fn(help='"SQL query text to execute. The useLegacySql field can be used to indicate whether the query uses legacy SQL or standard SQL.\\nNOTE: queries containing DML language\\n(DELETE, UPDATE, MERGE, INSERT) must specify create_disposition = \\"\\" and write_disposition = \\"\\"."', args=[d.arg(name='query', type=d.T.string)]),
        withQuery(query): { spec+: { forProvider+: { query+: { query: query } } } },
        '#withSchemaUpdateOptions':: d.fn(help='"Allows the schema of the destination table to be updated as a side effect of the query job.\\nSchema update options are supported in two cases: when writeDisposition is WRITE_APPEND;\\nwhen writeDisposition is WRITE_TRUNCATE and the destination table is a partition of a table,\\nspecified by partition decorators. For normal tables, WRITE_TRUNCATE will always overwrite the schema.\\nOne or more of the following values are specified:\\nALLOW_FIELD_ADDITION: allow adding a nullable field to the schema.\\nALLOW_FIELD_RELAXATION: allow relaxing a required field in the original schema to nullable."', args=[d.arg(name='schemaUpdateOptions', type=d.T.array)]),
        withSchemaUpdateOptions(schemaUpdateOptions): { spec+: { forProvider+: { query+: { schemaUpdateOptions: if std.isArray(v=schemaUpdateOptions) then schemaUpdateOptions else [schemaUpdateOptions] } } } },
        '#withSchemaUpdateOptionsMixin':: d.fn(help='"Allows the schema of the destination table to be updated as a side effect of the query job.\\nSchema update options are supported in two cases: when writeDisposition is WRITE_APPEND;\\nwhen writeDisposition is WRITE_TRUNCATE and the destination table is a partition of a table,\\nspecified by partition decorators. For normal tables, WRITE_TRUNCATE will always overwrite the schema.\\nOne or more of the following values are specified:\\nALLOW_FIELD_ADDITION: allow adding a nullable field to the schema.\\nALLOW_FIELD_RELAXATION: allow relaxing a required field in the original schema to nullable."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='schemaUpdateOptions', type=d.T.array)]),
        withSchemaUpdateOptionsMixin(schemaUpdateOptions): { spec+: { forProvider+: { query+: { schemaUpdateOptions+: if std.isArray(v=schemaUpdateOptions) then schemaUpdateOptions else [schemaUpdateOptions] } } } },
        '#withUseLegacySql':: d.fn(help="\"Specifies whether to use BigQuery's legacy SQL dialect for this query. The default value is true.\\nIf set to false, the query will use BigQuery's standard SQL.\"", args=[d.arg(name='useLegacySql', type=d.T.boolean)]),
        withUseLegacySql(useLegacySql): { spec+: { forProvider+: { query+: { useLegacySql: useLegacySql } } } },
        '#withUseQueryCache':: d.fn(help='"Whether to look for the result in the query cache. The query cache is a best-effort cache that will be flushed whenever\\ntables in the query are modified. Moreover, the query cache is only available when a query does not have a destination table specified.\\nThe default value is true."', args=[d.arg(name='useQueryCache', type=d.T.boolean)]),
        withUseQueryCache(useQueryCache): { spec+: { forProvider+: { query+: { useQueryCache: useQueryCache } } } },
        '#withUserDefinedFunctionResources':: d.fn(help='"Describes user-defined function resources used in the query.\\nStructure is documented below."', args=[d.arg(name='userDefinedFunctionResources', type=d.T.array)]),
        withUserDefinedFunctionResources(userDefinedFunctionResources): { spec+: { forProvider+: { query+: { userDefinedFunctionResources: if std.isArray(v=userDefinedFunctionResources) then userDefinedFunctionResources else [userDefinedFunctionResources] } } } },
        '#withUserDefinedFunctionResourcesMixin':: d.fn(help='"Describes user-defined function resources used in the query.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='userDefinedFunctionResources', type=d.T.array)]),
        withUserDefinedFunctionResourcesMixin(userDefinedFunctionResources): { spec+: { forProvider+: { query+: { userDefinedFunctionResources+: if std.isArray(v=userDefinedFunctionResources) then userDefinedFunctionResources else [userDefinedFunctionResources] } } } },
        '#withWriteDisposition':: d.fn(help="\"Specifies the action that occurs if the destination table already exists. The following values are supported:\\nWRITE_TRUNCATE: If the table already exists, BigQuery overwrites the table data and uses the schema from the query result.\\nWRITE_APPEND: If the table already exists, BigQuery appends the data to the table.\\nWRITE_EMPTY: If the table already exists and contains data, a 'duplicate' error is returned in the job result.\\nEach action is atomic and only occurs if BigQuery is able to complete the job successfully.\\nCreation, truncation and append actions occur as one atomic update upon job completion.\\nDefault value is WRITE_EMPTY.\\nPossible values are: WRITE_TRUNCATE, WRITE_APPEND, WRITE_EMPTY.\"", args=[d.arg(name='writeDisposition', type=d.T.string)]),
        withWriteDisposition(writeDisposition): { spec+: { forProvider+: { query+: { writeDisposition: writeDisposition } } } },
      },
      '#withJobId':: d.fn(help='"The ID of the job. The ID must contain only letters (a-z, A-Z), numbers (0-9), underscores (_), or dashes (-). The maximum length is 1,024 characters."', args=[d.arg(name='jobId', type=d.T.string)]),
      withJobId(jobId): { spec+: { forProvider+: { jobId: jobId } } },
      '#withJobTimeoutMs':: d.fn(help='"Job timeout in milliseconds. If this time limit is exceeded, BigQuery may attempt to terminate the job."', args=[d.arg(name='jobTimeoutMs', type=d.T.string)]),
      withJobTimeoutMs(jobTimeoutMs): { spec+: { forProvider+: { jobTimeoutMs: jobTimeoutMs } } },
      '#withLabels':: d.fn(help='"The labels associated with this job. You can use these to organize and group your jobs."', args=[d.arg(name='labels', type=d.T.object)]),
      withLabels(labels): { spec+: { forProvider+: { labels: labels } } },
