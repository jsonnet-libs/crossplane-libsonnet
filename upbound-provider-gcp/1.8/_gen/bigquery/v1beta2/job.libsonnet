              withResolve(resolve): { spec+: { forProvider+: { query+: { destinationTable+: { datasetIdRef+: { policy+: { resolve: resolve } } } } } } },
            },
            '#withName':: d.fn(help='"Name of the referenced object."', args=[d.arg(name='name', type=d.T.string)]),
