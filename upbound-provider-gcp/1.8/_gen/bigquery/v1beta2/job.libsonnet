            withMatchControllerRef(matchControllerRef): { spec+: { forProvider+: { query+: { destinationTable+: { tableIdSelector+: { matchControllerRef: matchControllerRef } } } } } },
            '#withMatchLabels':: d.fn(help='"MatchLabels ensures an object with matching labels is selected."', args=[d.arg(name='matchLabels', type=d.T.object)]),
