          withCases(cases): { cases: cases },
        },
        '#messages':: d.obj(help='"The list of rich message responses to present to the user.\\nStructure is documented below."'),
        messages: {
          '#conversationSuccess':: d.obj(help="\"Indicates that the conversation succeeded, i.e., the bot handled the issue that the customer talked to it about.\\nDialogflow only uses this to determine which conversations should be counted as successful and doesn't process the metadata in this message in any way. Note that Dialogflow also considers conversations that get to the conversation end page as successful even if they don't return ConversationSuccess.\\nYou may set this, for example:\""),
          conversationSuccess: {
            '#withMetadata':: d.fn(help="\"Custom metadata. Dialogflow doesn't impose any structure on this.\"", args=[d.arg(name='metadata', type=d.T.string)]),
            withMetadata(metadata): { metadata: metadata },
          },
          '#liveAgentHandoff':: d.obj(help='"Indicates that the conversation should be handed off to a live agent.\\nDialogflow only uses this to determine which conversations were handed off to a human agent for measurement purposes. What else to do with this signal is up to you and your handoff procedures.\\nYou may set this, for example:"'),
          liveAgentHandoff: {
            '#withMetadata':: d.fn(help="\"Custom metadata. Dialogflow doesn't impose any structure on this.\"", args=[d.arg(name='metadata', type=d.T.string)]),
