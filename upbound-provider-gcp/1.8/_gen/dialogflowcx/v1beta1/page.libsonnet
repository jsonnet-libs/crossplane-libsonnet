  '#spec':: d.obj(help='"PageSpec defines the desired state of Page"'),
  spec: {
    '#forProvider':: d.obj(help=''),
    forProvider: {
      '#advancedSettings':: d.obj(help='"Hierarchical advanced settings for this page. The settings exposed at the lower level overrides the settings exposed at the higher level.\\nHierarchy: Agent->Flow->Page->Fulfillment/Parameter.\\nStructure is documented below."'),
      advancedSettings: {
        '#dtmfSettings':: d.obj(help='"Define behaviors for DTMF (dual tone multi frequency). DTMF settings does not override each other. DTMF settings set at different levels define DTMF detections running in parallel. Exposed at the following levels:"'),
        dtmfSettings: {
          '#withEnabled':: d.fn(help='"If true, incoming audio is processed for DTMF (dual tone multi frequency) events. For example, if the caller presses a button on their telephone keypad and DTMF processing is enabled, Dialogflow will detect the event (e.g. a \\"3\\" was pressed) in the incoming audio and pass the event to the bot to drive business logic (e.g. when 3 is pressed, return the account balance)."', args=[d.arg(name='enabled', type=d.T.boolean)]),
          withEnabled(enabled): { enabled: enabled },
          '#withFinishDigit':: d.fn(help='"The digit that terminates a DTMF digit sequence."', args=[d.arg(name='finishDigit', type=d.T.string)]),
          withFinishDigit(finishDigit): { finishDigit: finishDigit },
          '#withMaxDigits':: d.fn(help='"Max length of DTMF digits."', args=[d.arg(name='maxDigits', type=d.T.number)]),
          withMaxDigits(maxDigits): { maxDigits: maxDigits },
        },
        '#withDtmfSettings':: d.fn(help='"Define behaviors for DTMF (dual tone multi frequency). DTMF settings does not override each other. DTMF settings set at different levels define DTMF detections running in parallel. Exposed at the following levels:"', args=[d.arg(name='dtmfSettings', type=d.T.array)]),
        withDtmfSettings(dtmfSettings): { dtmfSettings: if std.isArray(v=dtmfSettings) then dtmfSettings else [dtmfSettings] },
        '#withDtmfSettingsMixin':: d.fn(help='"Define behaviors for DTMF (dual tone multi frequency). DTMF settings does not override each other. DTMF settings set at different levels define DTMF detections running in parallel. Exposed at the following levels:"\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='dtmfSettings', type=d.T.array)]),
        withDtmfSettingsMixin(dtmfSettings): { dtmfSettings+: if std.isArray(v=dtmfSettings) then dtmfSettings else [dtmfSettings] },
      },
      '#entryFulfillment':: d.obj(help='"The fulfillment to call when the session is entering the page.\\nStructure is documented below."'),
