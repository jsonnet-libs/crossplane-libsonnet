          withCreatedBefore(createdBefore): { condition+: { createdBefore: createdBefore } },
          '#withCustomTimeBefore':: d.fn(help='"A date in the RFC 3339 format YYYY-MM-DD. This condition is satisfied when the customTime metadata for the object is set to an earlier date than the date used in this lifecycle condition."', args=[d.arg(name='customTimeBefore', type=d.T.string)]),
          withCustomTimeBefore(customTimeBefore): { condition+: { customTimeBefore: customTimeBefore } },
