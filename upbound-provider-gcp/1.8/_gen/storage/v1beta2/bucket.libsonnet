        '#withMethod':: d.fn(help='"The list of HTTP methods on which to include CORS response headers, (GET, OPTIONS, POST, etc) Note: \\"*\\" is permitted in the list of methods, and means \\"any method\\"."', args=[d.arg(name='method', type=d.T.array)]),
        withMethod(method): { method: if std.isArray(v=method) then method else [method] },
        '#withMethodMixin':: d.fn(help='"The list of HTTP methods on which to include CORS response headers, (GET, OPTIONS, POST, etc) Note: \\"*\\" is permitted in the list of methods, and means \\"any method\\"."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='method', type=d.T.array)]),
        withMethodMixin(method): { method+: if std.isArray(v=method) then method else [method] },
