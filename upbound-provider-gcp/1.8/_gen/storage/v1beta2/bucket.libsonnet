          withDaysSinceCustomTime(daysSinceCustomTime): { condition+: { daysSinceCustomTime: daysSinceCustomTime } },
          '#withDaysSinceNoncurrentTime':: d.fn(help='"Relevant only for versioned objects. Number of days elapsed since the noncurrent timestamp of an object. When set to 0 it will be ignored, and your state will treat it as though you supplied no days_since_noncurrent_time condition."', args=[d.arg(name='daysSinceNoncurrentTime', type=d.T.number)]),
          withDaysSinceNoncurrentTime(daysSinceNoncurrentTime): { condition+: { daysSinceNoncurrentTime: daysSinceNoncurrentTime } },
          '#withMatchesPrefix':: d.fn(help='"One or more matching name prefixes to satisfy this condition."', args=[d.arg(name='matchesPrefix', type=d.T.array)]),
          withMatchesPrefix(matchesPrefix): { condition+: { matchesPrefix: if std.isArray(v=matchesPrefix) then matchesPrefix else [matchesPrefix] } },
          '#withMatchesPrefixMixin':: d.fn(help='"One or more matching name prefixes to satisfy this condition."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='matchesPrefix', type=d.T.array)]),
          withMatchesPrefixMixin(matchesPrefix): { condition+: { matchesPrefix+: if std.isArray(v=matchesPrefix) then matchesPrefix else [matchesPrefix] } },
          '#withMatchesStorageClass':: d.fn(help='"Storage Class of objects to satisfy this condition. Supported values include: STANDARD, MULTI_REGIONAL, REGIONAL, NEARLINE, COLDLINE, ARCHIVE, DURABLE_REDUCED_AVAILABILITY."', args=[d.arg(name='matchesStorageClass', type=d.T.array)]),
          withMatchesStorageClass(matchesStorageClass): { condition+: { matchesStorageClass: if std.isArray(v=matchesStorageClass) then matchesStorageClass else [matchesStorageClass] } },
          '#withMatchesStorageClassMixin':: d.fn(help='"Storage Class of objects to satisfy this condition. Supported values include: STANDARD, MULTI_REGIONAL, REGIONAL, NEARLINE, COLDLINE, ARCHIVE, DURABLE_REDUCED_AVAILABILITY."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='matchesStorageClass', type=d.T.array)]),
          withMatchesStorageClassMixin(matchesStorageClass): { condition+: { matchesStorageClass+: if std.isArray(v=matchesStorageClass) then matchesStorageClass else [matchesStorageClass] } },
