        withKernels(kernels): { kernels: if std.isArray(v=kernels) then kernels else [kernels] },
        '#withKernelsMixin':: d.fn(help='"Use a list of container images to use as Kernels in the notebook instance.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='kernels', type=d.T.array)]),
        withKernelsMixin(kernels): { kernels+: if std.isArray(v=kernels) then kernels else [kernels] },
