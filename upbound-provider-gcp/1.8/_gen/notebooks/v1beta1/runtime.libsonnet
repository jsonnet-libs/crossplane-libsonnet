  spec: {
    '#forProvider':: d.obj(help=''),
    forProvider: {
      '#accessConfig':: d.obj(help='"The config settings for accessing runtime.\\nStructure is documented below."'),
      accessConfig: {
        '#withAccessType':: d.fn(help='"The type of access mode this instance. For valid values, see\\nhttps://cloud.google.com/vertex-ai/docs/workbench/reference/ rest/v1/projects.locations.runtimes#RuntimeAccessType."', args=[d.arg(name='accessType', type=d.T.string)]),
        withAccessType(accessType): { accessType: accessType },
