            '#withInitializeParams':: d.fn(help='"Input only. Specifies the parameters for a new disk that will\\nbe created alongside the new instance. Use initialization\\nparameters to create boot disks or local SSDs attached to the\\nnew instance. This property is mutually exclusive with the\\nsource property; you can only define one or the other, but not\\nboth.\\nStructure is documented below."', args=[d.arg(name='initializeParams', type=d.T.array)]),
            withInitializeParams(initializeParams): { initializeParams: if std.isArray(v=initializeParams) then initializeParams else [initializeParams] },
            '#withInitializeParamsMixin':: d.fn(help='"Input only. Specifies the parameters for a new disk that will\\nbe created alongside the new instance. Use initialization\\nparameters to create boot disks or local SSDs attached to the\\nnew instance. This property is mutually exclusive with the\\nsource property; you can only define one or the other, but not\\nboth.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='initializeParams', type=d.T.array)]),
            withInitializeParamsMixin(initializeParams): { initializeParams+: if std.isArray(v=initializeParams) then initializeParams else [initializeParams] },
            '#withInterface':: d.fn(help='"\\"Specifies the disk interface to use for attaching this disk,\\nwhich is either SCSI or NVME. The default is SCSI. Persistent\\ndisks must always use SCSI and the request will fail if you attempt\\nto attach a persistent disk in any other format than SCSI. Local SSDs\\ncan use either NVME or SCSI. For performance characteristics of SCSI\\nover NVMe, see Local SSD performance. Valid values: * NVME * SCSI\\"."', args=[d.arg(name='interface', type=d.T.string)]),
            withInterface(interface): { interface: interface },
            '#withMode':: d.fn(help='"The mode in which to attach this disk, either READ_WRITE\\nor READ_ONLY. If not specified, the default is to attach\\nthe disk in READ_WRITE mode."', args=[d.arg(name='mode', type=d.T.string)]),
