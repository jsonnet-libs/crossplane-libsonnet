        '#withEnableHealthMonitoring':: d.fn(help='"Verifies core internal services are running. Default: True."', args=[d.arg(name='enableHealthMonitoring', type=d.T.boolean)]),
        withEnableHealthMonitoring(enableHealthMonitoring): { enableHealthMonitoring: enableHealthMonitoring },
        '#withIdleShutdown':: d.fn(help='"Runtime will automatically shutdown after idle_shutdown_time.\\nDefault: True"', args=[d.arg(name='idleShutdown', type=d.T.boolean)]),
        withIdleShutdown(idleShutdown): { idleShutdown: idleShutdown },
        '#withIdleShutdownTimeout':: d.fn(help='"Time in minutes to wait before shuting down runtime.\\nDefault: 180 minutes"', args=[d.arg(name='idleShutdownTimeout', type=d.T.number)]),
        withIdleShutdownTimeout(idleShutdownTimeout): { idleShutdownTimeout: idleShutdownTimeout },
        '#withInstallGpuDriver':: d.fn(help='"Install Nvidia Driver automatically."', args=[d.arg(name='installGpuDriver', type=d.T.boolean)]),
        withInstallGpuDriver(installGpuDriver): { installGpuDriver: installGpuDriver },
