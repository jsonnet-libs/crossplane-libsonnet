          encryptionConfig: {
            '#withKmsKey':: d.fn(help='"The Cloud KMS resource identifier of the customer-managed\\nencryption key used to protect a resource, such as a disks.\\nIt has the following format:\\nprojects/{PROJECT_ID}/locations/{REGION}/keyRings/ {KEY_RING_NAME}/cryptoKeys/{KEY_NAME}"', args=[d.arg(name='kmsKey', type=d.T.string)]),
            withKmsKey(kmsKey): { kmsKey: kmsKey },
