          '#withStartTimes':: d.fn(help='"The times during the day to start a backup. At least one start time must be provided. The start times are assumed to be in UTC and to be an exact hour (e.g., 04:00:00).\\nStructure is documented below."', args=[d.arg(name='startTimes', type=d.T.array)]),
