                  withFixedSizeBucketingConfigMixin(fixedSizeBucketingConfig): { fixedSizeBucketingConfig+: if std.isArray(v=fixedSizeBucketingConfig) then fixedSizeBucketingConfig else [fixedSizeBucketingConfig] },
