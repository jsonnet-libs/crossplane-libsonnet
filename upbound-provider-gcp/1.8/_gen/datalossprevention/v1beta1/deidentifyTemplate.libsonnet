              withBucketingConfigMixin(bucketingConfig): { bucketingConfig+: if std.isArray(v=bucketingConfig) then bucketingConfig else [bucketingConfig] },
              '#withCharacterMaskConfig':: d.fn(help='"Partially mask a string by replacing a given number of characters with a fixed character.\\nMasking can start from the beginning or end of the string.\\nStructure is documented below."', args=[d.arg(name='characterMaskConfig', type=d.T.array)]),
