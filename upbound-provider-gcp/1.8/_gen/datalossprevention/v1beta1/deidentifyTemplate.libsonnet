                  '#withBucketingConfigMixin':: d.fn(help='"Generalization function that buckets values based on ranges. The ranges and replacement values are dynamically provided by the user for custom behavior, such as 1-30 -> LOW 31-65 -> MEDIUM 66-100 -> HIGH\\nThis can be used on data of type: number, long, string, timestamp.\\nIf the provided value type differs from the type of data being transformed, we will first attempt converting the type of the data to be transformed to match the type of the bound before comparing.\\nSee https://cloud.google.com/dlp/docs/concepts-bucketing to learn more.\\nStructure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='bucketingConfig', type=d.T.array)]),
                  withBucketingConfigMixin(bucketingConfig): { bucketingConfig+: if std.isArray(v=bucketingConfig) then bucketingConfig else [bucketingConfig] },
                  '#withCharacterMaskConfig':: d.fn(help='"Partially mask a string by replacing a given number of characters with a fixed character.\\nMasking can start from the beginning or end of the string.\\nStructure is documented below."', args=[d.arg(name='characterMaskConfig', type=d.T.array)]),
                  withCharacterMaskConfig(characterMaskConfig): { characterMaskConfig: if std.isArray(v=characterMaskConfig) then characterMaskConfig else [characterMaskConfig] },
