            withEnableAutoPopulationOfTimespanConfig(enableAutoPopulationOfTimespanConfig): { spec+: { initProvider+: { inspectJob+: { storageConfig+: { timespanConfig+: { enableAutoPopulationOfTimespanConfig: enableAutoPopulationOfTimespanConfig } } } } } },
            '#withEndTime':: d.fn(help='"Exclude files, tables, or rows newer than this value. If not set, no upper time limit is applied."', args=[d.arg(name='endTime', type=d.T.string)]),
