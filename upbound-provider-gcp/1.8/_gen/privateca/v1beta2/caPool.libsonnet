              withCodeSigning(codeSigning): { spec+: { forProvider+: { issuancePolicy+: { baselineValues+: { keyUsage+: { extendedKeyUsage+: { codeSigning: codeSigning } } } } } } },
              '#withEmailProtection':: d.fn(help='"Corresponds to OID 1.3.6.1.5.5.7.3.4. Officially described as \\"Email protection\\"."', args=[d.arg(name='emailProtection', type=d.T.boolean)]),
              withEmailProtection(emailProtection): { spec+: { forProvider+: { issuancePolicy+: { baselineValues+: { keyUsage+: { extendedKeyUsage+: { emailProtection: emailProtection } } } } } } },
