            withZeroMaxIssuerPathLength(zeroMaxIssuerPathLength): { spec+: { forProvider+: { issuancePolicy+: { baselineValues+: { caOptions+: { zeroMaxIssuerPathLength: zeroMaxIssuerPathLength } } } } } },
