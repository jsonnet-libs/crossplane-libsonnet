  '#new':: d.fn(help='new returns an instance of CAPool', args=[d.arg(name='name', type=d.T.string)]),
  new(name): {
    apiVersion: 'privateca.gcp.upbound.io/v1beta2',
    kind: 'CAPool',
  } + self.metadata.withName(name=name) + self.metadata.withAnnotations(annotations={
    'tanka.dev/namespaced': 'false',
  }),
  '#spec':: d.obj(help='"CAPoolSpec defines the desired state of CAPool"'),
  spec: {
    '#forProvider':: d.obj(help=''),
    forProvider: {
      '#issuancePolicy':: d.obj(help='"The IssuancePolicy to control how Certificates will be issued from this CaPool.\\nStructure is documented below."'),
      issuancePolicy: {
        '#allowedIssuanceModes':: d.obj(help='"IssuanceModes specifies the allowed ways in which Certificates may be requested from this CaPool.\\nStructure is documented below."'),
        allowedIssuanceModes: {
          '#withAllowConfigBasedIssuance':: d.fn(help='"When true, allows callers to create Certificates by specifying a CertificateConfig."', args=[d.arg(name='allowConfigBasedIssuance', type=d.T.boolean)]),
          withAllowConfigBasedIssuance(allowConfigBasedIssuance): { spec+: { forProvider+: { issuancePolicy+: { allowedIssuanceModes+: { allowConfigBasedIssuance: allowConfigBasedIssuance } } } } },
          '#withAllowCsrBasedIssuance':: d.fn(help='"When true, allows callers to create Certificates by specifying a CSR."', args=[d.arg(name='allowCsrBasedIssuance', type=d.T.boolean)]),
          withAllowCsrBasedIssuance(allowCsrBasedIssuance): { spec+: { forProvider+: { issuancePolicy+: { allowedIssuanceModes+: { allowCsrBasedIssuance: allowCsrBasedIssuance } } } } },
        },
        '#allowedKeyTypes':: d.obj(help="\"If any AllowedKeyType is specified, then the certificate request's public key must match one of the key types listed here.\\nOtherwise, any key may be used.\\nStructure is documented below.\""),
