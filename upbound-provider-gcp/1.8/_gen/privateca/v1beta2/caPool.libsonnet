        withEncodingFormat(encodingFormat): { spec+: { initProvider+: { publishingOptions+: { encodingFormat: encodingFormat } } } },
        '#withPublishCaCert':: d.fn(help="\"When true, publishes each CertificateAuthority's CA certificate and includes its URL in the \\\"Authority Information Access\\\"\\nX.509 extension in all issued Certificates. If this is false, the CA certificate will not be published and the corresponding\\nX.509 extension will not be written in issued certificates.\"", args=[d.arg(name='publishCaCert', type=d.T.boolean)]),
