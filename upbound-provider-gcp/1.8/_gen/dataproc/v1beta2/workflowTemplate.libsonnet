            securityConfig: {
              '#kerberosConfig':: d.obj(help='"Kerberos related configuration."'),
              kerberosConfig: {
                '#withCrossRealmTrustAdminServer':: d.fn(help='"The admin server (IP or hostname) for the remote trusted realm in a cross realm trust relationship."', args=[d.arg(name='crossRealmTrustAdminServer', type=d.T.string)]),
                withCrossRealmTrustAdminServer(crossRealmTrustAdminServer): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { securityConfig+: { kerberosConfig+: { crossRealmTrustAdminServer: crossRealmTrustAdminServer } } } } } } } },
                '#withCrossRealmTrustKdc':: d.fn(help='"The KDC (IP or hostname) for the remote trusted realm in a cross realm trust relationship."', args=[d.arg(name='crossRealmTrustKdc', type=d.T.string)]),
                withCrossRealmTrustKdc(crossRealmTrustKdc): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { securityConfig+: { kerberosConfig+: { crossRealmTrustKdc: crossRealmTrustKdc } } } } } } } },
                '#withCrossRealmTrustRealm':: d.fn(help='"The remote realm the Dataproc on-cluster KDC will trust, should the user enable cross realm trust."', args=[d.arg(name='crossRealmTrustRealm', type=d.T.string)]),
                withCrossRealmTrustRealm(crossRealmTrustRealm): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { securityConfig+: { kerberosConfig+: { crossRealmTrustRealm: crossRealmTrustRealm } } } } } } } },
                '#withCrossRealmTrustSharedPassword':: d.fn(help='"The Cloud Storage URI of a KMS encrypted file containing the shared password between the on-cluster Kerberos realm and the remote trusted realm, in a cross realm trust relationship."', args=[d.arg(name='crossRealmTrustSharedPassword', type=d.T.string)]),
                withCrossRealmTrustSharedPassword(crossRealmTrustSharedPassword): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { securityConfig+: { kerberosConfig+: { crossRealmTrustSharedPassword: crossRealmTrustSharedPassword } } } } } } } },
                '#withEnableKerberos':: d.fn(help='"Flag to indicate whether to Kerberize the cluster (default: false). Set this field to true to enable Kerberos on a cluster."', args=[d.arg(name='enableKerberos', type=d.T.boolean)]),
                withEnableKerberos(enableKerberos): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { securityConfig+: { kerberosConfig+: { enableKerberos: enableKerberos } } } } } } } },
                '#withKdcDbKey':: d.fn(help='"The Cloud Storage URI of a KMS encrypted file containing the master key of the KDC database."', args=[d.arg(name='kdcDbKey', type=d.T.string)]),
                withKdcDbKey(kdcDbKey): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { securityConfig+: { kerberosConfig+: { kdcDbKey: kdcDbKey } } } } } } } },
                '#withKeyPassword':: d.fn(help='"The Cloud Storage URI of a KMS encrypted file containing the password to the user provided key. For the self-signed certificate, this password is generated by Dataproc."', args=[d.arg(name='keyPassword', type=d.T.string)]),
                withKeyPassword(keyPassword): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { securityConfig+: { kerberosConfig+: { keyPassword: keyPassword } } } } } } } },
                '#withKeystore':: d.fn(help='"The Cloud Storage URI of the keystore file used for SSL encryption. If not provided, Dataproc will provide a self-signed certificate."', args=[d.arg(name='keystore', type=d.T.string)]),
                withKeystore(keystore): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { securityConfig+: { kerberosConfig+: { keystore: keystore } } } } } } } },
                '#withKeystorePassword':: d.fn(help='"The Cloud Storage URI of a KMS encrypted file containing the password to the user provided keystore. For the self-signed certificate, this password is generated by Dataproc."', args=[d.arg(name='keystorePassword', type=d.T.string)]),
                withKeystorePassword(keystorePassword): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { securityConfig+: { kerberosConfig+: { keystorePassword: keystorePassword } } } } } } } },
                '#withKmsKey':: d.fn(help='"The uri of the KMS key used to encrypt various sensitive files."', args=[d.arg(name='kmsKey', type=d.T.string)]),
                withKmsKey(kmsKey): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { securityConfig+: { kerberosConfig+: { kmsKey: kmsKey } } } } } } } },
                '#withRealm':: d.fn(help='"The name of the on-cluster Kerberos realm. If not specified, the uppercased domain of hostnames will be the realm."', args=[d.arg(name='realm', type=d.T.string)]),
                withRealm(realm): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { securityConfig+: { kerberosConfig+: { realm: realm } } } } } } } },
                '#withRootPrincipalPassword':: d.fn(help='"The Cloud Storage URI of a KMS encrypted file containing the root principal password."', args=[d.arg(name='rootPrincipalPassword', type=d.T.string)]),
                withRootPrincipalPassword(rootPrincipalPassword): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { securityConfig+: { kerberosConfig+: { rootPrincipalPassword: rootPrincipalPassword } } } } } } } },
                '#withTgtLifetimeHours':: d.fn(help='"The lifetime of the ticket granting ticket, in hours. If not specified, or user specifies 0, then default value 10 will be used."', args=[d.arg(name='tgtLifetimeHours', type=d.T.number)]),
                withTgtLifetimeHours(tgtLifetimeHours): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { securityConfig+: { kerberosConfig+: { tgtLifetimeHours: tgtLifetimeHours } } } } } } } },
                '#withTruststore':: d.fn(help='"The Cloud Storage URI of the truststore file used for SSL encryption. If not provided, Dataproc will provide a self-signed certificate."', args=[d.arg(name='truststore', type=d.T.string)]),
                withTruststore(truststore): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { securityConfig+: { kerberosConfig+: { truststore: truststore } } } } } } } },
                '#withTruststorePassword':: d.fn(help='"The Cloud Storage URI of a KMS encrypted file containing the password to the user provided truststore. For the self-signed certificate, this password is generated by Dataproc."', args=[d.arg(name='truststorePassword', type=d.T.string)]),
                withTruststorePassword(truststorePassword): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { securityConfig+: { kerberosConfig+: { truststorePassword: truststorePassword } } } } } } } },
