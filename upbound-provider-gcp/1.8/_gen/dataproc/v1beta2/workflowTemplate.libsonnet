              '#withImage':: d.fn(help='"The Compute Engine image resource used for cluster instances. The URI can represent an image or image family. Image examples: * https://www.googleapis.com/compute/beta/projects/ If the URI is unspecified, it will be inferred from SoftwareConfig.image_version or the system default."', args=[d.arg(name='image', type=d.T.string)]),
