              '#withImageVersion':: d.fn(help='"The version of software inside the cluster. It must be one of the supported Dataproc Versions, such as \\"1.2\\" (including a subminor version, such as \\"1.2.29\\"), or the \\"preview\\" version. If unspecified, it defaults to the latest Debian version."', args=[d.arg(name='imageVersion', type=d.T.string)]),
              withImageVersion(imageVersion): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { softwareConfig+: { imageVersion: imageVersion } } } } } } },
