        '#withPrerequisiteStepIds':: d.fn(help='"The optional list of prerequisite job step_ids. If not specified, the job will start at the beginning of workflow."', args=[d.arg(name='prerequisiteStepIds', type=d.T.array)]),
        withPrerequisiteStepIds(prerequisiteStepIds): { prerequisiteStepIds: if std.isArray(v=prerequisiteStepIds) then prerequisiteStepIds else [prerequisiteStepIds] },
        '#withPrerequisiteStepIdsMixin':: d.fn(help='"The optional list of prerequisite job step_ids. If not specified, the job will start at the beginning of workflow."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='prerequisiteStepIds', type=d.T.array)]),
        withPrerequisiteStepIdsMixin(prerequisiteStepIds): { prerequisiteStepIds+: if std.isArray(v=prerequisiteStepIds) then prerequisiteStepIds else [prerequisiteStepIds] },
        '#withStepId':: d.fn(help='"Required. The step id. The id must be unique among all jobs within the template. The step id is used as prefix for job id, as job goog-dataproc-workflow-step-id label, and in field from other steps. The id must contain only letters (a-z, A-Z), numbers (0-9), underscores (_), and hyphens (-). Cannot begin or end with underscore or hyphen. Must consist of between 3 and 50 characters."', args=[d.arg(name='stepId', type=d.T.string)]),
        withStepId(stepId): { stepId: stepId },
      },
      '#parameters':: d.obj(help='"Template parameters whose values are substituted into the template. Values for parameters must be provided when the template is instantiated."'),
      parameters: {
        '#validation':: d.obj(help="\"Validation rules to be applied to this parameter's value.\""),
        validation: {
          '#regex':: d.obj(help='"Validation based on regular expressions."'),
          regex: {
            '#withRegexes':: d.fn(help="\"Required. RE2 regular expressions used to validate the parameter's value. The value must match the regex in its entirety (substring matches are not sufficient).\"", args=[d.arg(name='regexes', type=d.T.array)]),
            withRegexes(regexes): { validation+: { regex+: { regexes: if std.isArray(v=regexes) then regexes else [regexes] } } },
            '#withRegexesMixin':: d.fn(help="\"Required. RE2 regular expressions used to validate the parameter's value. The value must match the regex in its entirety (substring matches are not sufficient).\"\n\n**Note:** This function appends passed data to existing values", args=[d.arg(name='regexes', type=d.T.array)]),
            withRegexesMixin(regexes): { validation+: { regex+: { regexes+: if std.isArray(v=regexes) then regexes else [regexes] } } },
          },
          '#values':: d.obj(help='"Required. List of allowed values for the parameter."'),
          values: {
            '#withValues':: d.fn(help='"Required. List of allowed values for the parameter."', args=[d.arg(name='values', type=d.T.array)]),
            withValues(values): { validation+: { values+: { values: if std.isArray(v=values) then values else [values] } } },
            '#withValuesMixin':: d.fn(help='"Required. List of allowed values for the parameter."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='values', type=d.T.array)]),
            withValuesMixin(values): { validation+: { values+: { values+: if std.isArray(v=values) then values else [values] } } },
          },
        },
        '#withDescription':: d.fn(help='"Brief description of the parameter. Must not exceed 1024 characters."', args=[d.arg(name='description', type=d.T.string)]),
        withDescription(description): { description: description },
        '#withFields':: d.fn(help="\"Required. Paths to all fields that the parameter replaces. A field is allowed to appear in at most one parameter's list of field paths. A field path is similar in syntax to a .sparkJob.args\"", args=[d.arg(name='fields', type=d.T.array)]),
        withFields(fields): { fields: if std.isArray(v=fields) then fields else [fields] },
        '#withFieldsMixin':: d.fn(help="\"Required. Paths to all fields that the parameter replaces. A field is allowed to appear in at most one parameter's list of field paths. A field path is similar in syntax to a .sparkJob.args\"\n\n**Note:** This function appends passed data to existing values", args=[d.arg(name='fields', type=d.T.array)]),
        withFieldsMixin(fields): { fields+: if std.isArray(v=fields) then fields else [fields] },
        '#withName':: d.fn(help='"Required. Parameter name. The parameter name is used as the key, and paired with the parameter value, which are passed to the template when the template is instantiated. The name must contain only capital letters (A-Z), numbers (0-9), and underscores (_), and must not start with a number. The maximum length is 40 characters."', args=[d.arg(name='name', type=d.T.string)]),
        withName(name): { name: name },
      },
      '#placement':: d.obj(help='"Required. WorkflowTemplate scheduling information."'),
      placement: {
        '#clusterSelector':: d.obj(help='"A selector that chooses target cluster for jobs based on metadata. The selector is evaluated at the time each job is submitted."'),
        clusterSelector: {
          '#withClusterLabels':: d.fn(help='"Required. The cluster labels. Cluster must have all labels to match."', args=[d.arg(name='clusterLabels', type=d.T.object)]),
          withClusterLabels(clusterLabels): { spec+: { forProvider+: { placement+: { clusterSelector+: { clusterLabels: clusterLabels } } } } },
          '#withClusterLabelsMixin':: d.fn(help='"Required. The cluster labels. Cluster must have all labels to match."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='clusterLabels', type=d.T.object)]),
          withClusterLabelsMixin(clusterLabels): { spec+: { forProvider+: { placement+: { clusterSelector+: { clusterLabels+: clusterLabels } } } } },
          '#withZone':: d.fn(help='"The zone where the Compute Engine cluster will be located. On a create request, it is required in the \\"global\\" region. If omitted in a non-global Dataproc region, the service will pick a zone in the corresponding Compute Engine region. On a get request, zone will always be present. A full URL, partial URI, or short name are valid. Examples: * https://www.googleapis.com/compute/v1/projects/ * us-central1-f"', args=[d.arg(name='zone', type=d.T.string)]),
          withZone(zone): { spec+: { forProvider+: { placement+: { clusterSelector+: { zone: zone } } } } },
        },
        '#managedCluster':: d.obj(help='"A cluster that is managed by the workflow."'),
        managedCluster: {
          '#config':: d.obj(help='"Required. The cluster configuration."'),
          config: {
            '#autoscalingConfig':: d.obj(help='"Autoscaling config for the policy associated with the cluster. Cluster does not autoscale if this field is unset."'),
            autoscalingConfig: {
              '#withPolicy':: d.fn(help='"The autoscaling policy used by the cluster. Only resource names including projectid and location (region) are valid. Examples: * https://www.googleapis.com/compute/v1/projects/ Note that the policy must be in the same project and Dataproc region."', args=[d.arg(name='policy', type=d.T.string)]),
              withPolicy(policy): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { autoscalingConfig+: { policy: policy } } } } } } },
            },
            '#encryptionConfig':: d.obj(help='"Encryption settings for the cluster."'),
            encryptionConfig: {
              '#withGcePdKmsKeyName':: d.fn(help='"The Cloud KMS key name to use for PD disk encryption for all instances in the cluster."', args=[d.arg(name='gcePdKmsKeyName', type=d.T.string)]),
              withGcePdKmsKeyName(gcePdKmsKeyName): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { encryptionConfig+: { gcePdKmsKeyName: gcePdKmsKeyName } } } } } } },
            },
            '#endpointConfig':: d.obj(help='"Port/endpoint configuration for this cluster"'),
            endpointConfig: {
              '#withEnableHttpPortAccess':: d.fn(help='"If true, enable http access to specific ports on the cluster from external sources. Defaults to false."', args=[d.arg(name='enableHttpPortAccess', type=d.T.boolean)]),
              withEnableHttpPortAccess(enableHttpPortAccess): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { endpointConfig+: { enableHttpPortAccess: enableHttpPortAccess } } } } } } },
            },
            '#gceClusterConfig':: d.obj(help='"The shared Compute Engine config settings for all instances in a cluster."'),
            gceClusterConfig: {
              '#nodeGroupAffinity':: d.obj(help='"Node Group Affinity for sole-tenant clusters."'),
              nodeGroupAffinity: {
                '#withNodeGroup':: d.fn(help='"Required. The URI of a sole-tenant /zones/us-central1-a/nodeGroups/node-group-1*node-group-1`"', args=[d.arg(name='nodeGroup', type=d.T.string)]),
                withNodeGroup(nodeGroup): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { gceClusterConfig+: { nodeGroupAffinity+: { nodeGroup: nodeGroup } } } } } } } },
              },
              '#reservationAffinity':: d.obj(help='"Reservation Affinity for consuming Zonal reservation."'),
              reservationAffinity: {
                '#withConsumeReservationType':: d.fn(help='"Type of reservation to consume Possible values: TYPE_UNSPECIFIED, NO_RESERVATION, ANY_RESERVATION, SPECIFIC_RESERVATION"', args=[d.arg(name='consumeReservationType', type=d.T.string)]),
                withConsumeReservationType(consumeReservationType): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { gceClusterConfig+: { reservationAffinity+: { consumeReservationType: consumeReservationType } } } } } } } },
                '#withKey':: d.fn(help='"Corresponds to the label key of reservation resource."', args=[d.arg(name='key', type=d.T.string)]),
                withKey(key): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { gceClusterConfig+: { reservationAffinity+: { key: key } } } } } } } },
                '#withValues':: d.fn(help='"Required. List of allowed values for the parameter."', args=[d.arg(name='values', type=d.T.array)]),
                withValues(values): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { gceClusterConfig+: { reservationAffinity+: { values: if std.isArray(v=values) then values else [values] } } } } } } } },
                '#withValuesMixin':: d.fn(help='"Required. List of allowed values for the parameter."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='values', type=d.T.array)]),
                withValuesMixin(values): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { gceClusterConfig+: { reservationAffinity+: { values+: if std.isArray(v=values) then values else [values] } } } } } } } },
              },
              '#shieldedInstanceConfig':: d.obj(help='"Shielded Instance Config for clusters using Compute Engine Shielded VMs. Structure defined below."'),
              shieldedInstanceConfig: {
                '#withEnableIntegrityMonitoring':: d.fn(help='"Defines whether instances have Integrity Monitoring enabled."', args=[d.arg(name='enableIntegrityMonitoring', type=d.T.boolean)]),
                withEnableIntegrityMonitoring(enableIntegrityMonitoring): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { gceClusterConfig+: { shieldedInstanceConfig+: { enableIntegrityMonitoring: enableIntegrityMonitoring } } } } } } } },
                '#withEnableSecureBoot':: d.fn(help='"Defines whether instances have Secure Boot enabled."', args=[d.arg(name='enableSecureBoot', type=d.T.boolean)]),
                withEnableSecureBoot(enableSecureBoot): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { gceClusterConfig+: { shieldedInstanceConfig+: { enableSecureBoot: enableSecureBoot } } } } } } } },
                '#withEnableVtpm':: d.fn(help='"Defines whether instances have the vTPM enabled."', args=[d.arg(name='enableVtpm', type=d.T.boolean)]),
                withEnableVtpm(enableVtpm): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { gceClusterConfig+: { shieldedInstanceConfig+: { enableVtpm: enableVtpm } } } } } } } },
              },
              '#withInternalIpOnly':: d.fn(help='"If true, all instances in the cluster will only have internal IP addresses. By default, clusters are not restricted to internal IP addresses, and will have ephemeral external IP addresses assigned to each instance. This internal_ip_only restriction can only be enabled for subnetwork enabled networks, and all off-cluster dependencies must be configured to be accessible without external IP addresses."', args=[d.arg(name='internalIpOnly', type=d.T.boolean)]),
              withInternalIpOnly(internalIpOnly): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { gceClusterConfig+: { internalIpOnly: internalIpOnly } } } } } } },
              '#withMetadata':: d.fn(help='"The Compute Engine metadata entries to add to all instances (see (https://cloud.google.com/compute/docs/storing-retrieving-metadata#project_and_instance_metadata))."', args=[d.arg(name='metadata', type=d.T.object)]),
              withMetadata(metadata): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { gceClusterConfig+: { metadata: metadata } } } } } } },
              '#withMetadataMixin':: d.fn(help='"The Compute Engine metadata entries to add to all instances (see (https://cloud.google.com/compute/docs/storing-retrieving-metadata#project_and_instance_metadata))."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='metadata', type=d.T.object)]),
              withMetadataMixin(metadata): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { gceClusterConfig+: { metadata+: metadata } } } } } } },
              '#withNetwork':: d.fn(help='"The Compute Engine network to be used for machine communications. Cannot be specified with subnetwork_uri. If neither network_uri nor subnetwork_uri is specified, the \\"default\\" network of the project is used, if it exists. Cannot be a \\"Custom Subnet Network\\" (see /regions/global/default*default`"', args=[d.arg(name='network', type=d.T.string)]),
              withNetwork(network): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { gceClusterConfig+: { network: network } } } } } } },
              '#withPrivateIpv6GoogleAccess':: d.fn(help='"The type of IPv6 access for a cluster. Possible values: PRIVATE_IPV6_GOOGLE_ACCESS_UNSPECIFIED, INHERIT_FROM_SUBNETWORK, OUTBOUND, BIDIRECTIONAL"', args=[d.arg(name='privateIpv6GoogleAccess', type=d.T.string)]),
              withPrivateIpv6GoogleAccess(privateIpv6GoogleAccess): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { gceClusterConfig+: { privateIpv6GoogleAccess: privateIpv6GoogleAccess } } } } } } },
              '#withServiceAccount':: d.fn(help='"The (https://cloud.google.com/compute/docs/access/service-accounts#default_service_account) is used."', args=[d.arg(name='serviceAccount', type=d.T.string)]),
              withServiceAccount(serviceAccount): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { gceClusterConfig+: { serviceAccount: serviceAccount } } } } } } },
              '#withServiceAccountScopes':: d.fn(help='"The URIs of service account scopes to be included in Compute Engine instances. The following base set of scopes is always included: * https://www.googleapis.com/auth/cloud.useraccounts.readonly * https://www.googleapis.com/auth/devstorage.read_write * https://www.googleapis.com/auth/logging.write If no scopes are specified, the following defaults are also provided: * https://www.googleapis.com/auth/bigquery * https://www.googleapis.com/auth/bigtable.admin.table * https://www.googleapis.com/auth/bigtable.data * https://www.googleapis.com/auth/devstorage.full_control"', args=[d.arg(name='serviceAccountScopes', type=d.T.array)]),
              withServiceAccountScopes(serviceAccountScopes): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { gceClusterConfig+: { serviceAccountScopes: if std.isArray(v=serviceAccountScopes) then serviceAccountScopes else [serviceAccountScopes] } } } } } } },
              '#withServiceAccountScopesMixin':: d.fn(help='"The URIs of service account scopes to be included in Compute Engine instances. The following base set of scopes is always included: * https://www.googleapis.com/auth/cloud.useraccounts.readonly * https://www.googleapis.com/auth/devstorage.read_write * https://www.googleapis.com/auth/logging.write If no scopes are specified, the following defaults are also provided: * https://www.googleapis.com/auth/bigquery * https://www.googleapis.com/auth/bigtable.admin.table * https://www.googleapis.com/auth/bigtable.data * https://www.googleapis.com/auth/devstorage.full_control"\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='serviceAccountScopes', type=d.T.array)]),
              withServiceAccountScopesMixin(serviceAccountScopes): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { gceClusterConfig+: { serviceAccountScopes+: if std.isArray(v=serviceAccountScopes) then serviceAccountScopes else [serviceAccountScopes] } } } } } } },
              '#withSubnetwork':: d.fn(help='"The Compute Engine subnetwork to be used for machine communications. Cannot be specified with network_uri. A full URL, partial URI, or short name are valid. Examples: * https://www.googleapis.com/compute/v1/projects//regions/us-east1/subnetworks/sub0 * sub0"', args=[d.arg(name='subnetwork', type=d.T.string)]),
              withSubnetwork(subnetwork): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { gceClusterConfig+: { subnetwork: subnetwork } } } } } } },
              '#withTags':: d.fn(help='"The Compute Engine tags to add to all instances (see (https://cloud.google.com/compute/docs/label-or-tag-resources#tags))."', args=[d.arg(name='tags', type=d.T.array)]),
              withTags(tags): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { gceClusterConfig+: { tags: if std.isArray(v=tags) then tags else [tags] } } } } } } },
              '#withTagsMixin':: d.fn(help='"The Compute Engine tags to add to all instances (see (https://cloud.google.com/compute/docs/label-or-tag-resources#tags))."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='tags', type=d.T.array)]),
              withTagsMixin(tags): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { gceClusterConfig+: { tags+: if std.isArray(v=tags) then tags else [tags] } } } } } } },
              '#withZone':: d.fn(help='"The zone where the Compute Engine cluster will be located. On a create request, it is required in the \\"global\\" region. If omitted in a non-global Dataproc region, the service will pick a zone in the corresponding Compute Engine region. On a get request, zone will always be present. A full URL, partial URI, or short name are valid. Examples: * https://www.googleapis.com/compute/v1/projects/ * us-central1-f"', args=[d.arg(name='zone', type=d.T.string)]),
              withZone(zone): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { gceClusterConfig+: { zone: zone } } } } } } },
            },
            '#initializationActions':: d.obj(help="\"Commands to execute on each node after config is completed. By default, executables are run on master and all worker nodes. You can test a node's role metadata to run an executable on a master or worker node, as shown below using curl (you can also use wget): ROLE=$(curl -H Metadata-Flavor:Google http://metadata/computeMetadata/v1/instance/attributes/dataproc-role) if ; then ... master specific actions ... else ... worker specific actions ... fi\""),
            initializationActions: {
              '#withExecutableFile':: d.fn(help='"Required. Cloud Storage URI of executable file."', args=[d.arg(name='executableFile', type=d.T.string)]),
              withExecutableFile(executableFile): { executableFile: executableFile },
              '#withExecutionTimeout':: d.fn(help='"Amount of time executable has to complete. Default is 10 minutes (see JSON representation of (https://developers.google.com/protocol-buffers/docs/proto3#json)). Cluster creation fails with an explanatory error message (the name of the executable that caused the error and the exceeded timeout period) if the executable is not completed at end of the timeout period."', args=[d.arg(name='executionTimeout', type=d.T.string)]),
              withExecutionTimeout(executionTimeout): { executionTimeout: executionTimeout },
            },
            '#lifecycleConfig':: d.obj(help='"Lifecycle setting for the cluster."'),
            lifecycleConfig: {
              '#withAutoDeleteTime':: d.fn(help='"The time when cluster will be auto-deleted (see JSON representation of (https://developers.google.com/protocol-buffers/docs/proto3#json))."', args=[d.arg(name='autoDeleteTime', type=d.T.string)]),
              withAutoDeleteTime(autoDeleteTime): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { lifecycleConfig+: { autoDeleteTime: autoDeleteTime } } } } } } },
              '#withAutoDeleteTtl':: d.fn(help='"The lifetime duration of cluster. The cluster will be auto-deleted at the end of this period. Minimum value is 10 minutes; maximum value is 14 days (see JSON representation of (https://developers.google.com/protocol-buffers/docs/proto3#json))."', args=[d.arg(name='autoDeleteTtl', type=d.T.string)]),
              withAutoDeleteTtl(autoDeleteTtl): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { lifecycleConfig+: { autoDeleteTtl: autoDeleteTtl } } } } } } },
              '#withIdleDeleteTtl':: d.fn(help='"The duration to keep the cluster alive while idling (when no jobs are running). Passing this threshold will cause the cluster to be deleted. Minimum value is 5 minutes; maximum value is 14 days (see JSON representation of (https://developers.google.com/protocol-buffers/docs/proto3#json)."', args=[d.arg(name='idleDeleteTtl', type=d.T.string)]),
              withIdleDeleteTtl(idleDeleteTtl): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { lifecycleConfig+: { idleDeleteTtl: idleDeleteTtl } } } } } } },
            },
            '#masterConfig':: d.obj(help='"The Compute Engine config settings for additional worker instances in a cluster."'),
            masterConfig: {
              '#accelerators':: d.obj(help='"The Compute Engine accelerator configuration for these instances."'),
              accelerators: {
                '#withAcceleratorCount':: d.fn(help='"The number of the accelerator cards of this type exposed to this instance."', args=[d.arg(name='acceleratorCount', type=d.T.number)]),
                withAcceleratorCount(acceleratorCount): { acceleratorCount: acceleratorCount },
                '#withAcceleratorType':: d.fn(help='"Full URL, partial URI, or short name of the accelerator type resource to expose to this instance. See (https://cloud.google.com/dataproc/docs/concepts/configuring-clusters/auto-zone#using_auto_zone_placement) feature, you must use the short name of the accelerator type resource, for example, nvidia-tesla-k80."', args=[d.arg(name='acceleratorType', type=d.T.string)]),
                withAcceleratorType(acceleratorType): { acceleratorType: acceleratorType },
              },
              '#diskConfig':: d.obj(help='"Disk option config settings."'),
              diskConfig: {
                '#withBootDiskSizeGb':: d.fn(help='"Size in GB of the boot disk (default is 500GB)."', args=[d.arg(name='bootDiskSizeGb', type=d.T.number)]),
                withBootDiskSizeGb(bootDiskSizeGb): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { masterConfig+: { diskConfig+: { bootDiskSizeGb: bootDiskSizeGb } } } } } } } },
                '#withBootDiskType':: d.fn(help='"Type of the boot disk (default is \\"pd-standard\\"). Valid values: \\"pd-ssd\\" (Persistent Disk Solid State Drive) or \\"pd-standard\\" (Persistent Disk Hard Disk Drive)."', args=[d.arg(name='bootDiskType', type=d.T.string)]),
                withBootDiskType(bootDiskType): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { masterConfig+: { diskConfig+: { bootDiskType: bootDiskType } } } } } } } },
                '#withNumLocalSsds':: d.fn(help='"Number of attached SSDs, from 0 to 4 (default is 0). If SSDs are not attached, the boot disk is used to store runtime logs and (https://hadoop.apache.org/docs/r1.2.1/hdfs_user_guide.html) data. If one or more SSDs are attached, this runtime bulk data is spread across them, and the boot disk contains only basic config and installed binaries."', args=[d.arg(name='numLocalSsds', type=d.T.number)]),
                withNumLocalSsds(numLocalSsds): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { masterConfig+: { diskConfig+: { numLocalSsds: numLocalSsds } } } } } } } },
              },
              '#withAccelerators':: d.fn(help='"The Compute Engine accelerator configuration for these instances."', args=[d.arg(name='accelerators', type=d.T.array)]),
              withAccelerators(accelerators): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { masterConfig+: { accelerators: if std.isArray(v=accelerators) then accelerators else [accelerators] } } } } } } },
              '#withAcceleratorsMixin':: d.fn(help='"The Compute Engine accelerator configuration for these instances."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='accelerators', type=d.T.array)]),
              withAcceleratorsMixin(accelerators): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { masterConfig+: { accelerators+: if std.isArray(v=accelerators) then accelerators else [accelerators] } } } } } } },
              '#withImage':: d.fn(help='"The Compute Engine image resource used for cluster instances. The URI can represent an image or image family. Image examples: * https://www.googleapis.com/compute/beta/projects/ If the URI is unspecified, it will be inferred from SoftwareConfig.image_version or the system default."', args=[d.arg(name='image', type=d.T.string)]),
              withImage(image): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { masterConfig+: { image: image } } } } } } },
              '#withMachineType':: d.fn(help='"The Compute Engine machine type used for cluster instances. A full URL, partial URI, or short name are valid. Examples: * https://www.googleapis.com/compute/v1/projects/(https://cloud.google.com/dataproc/docs/concepts/configuring-clusters/auto-zone#using_auto_zone_placement) feature, you must use the short name of the machine type resource, for example, n1-standard-2`."', args=[d.arg(name='machineType', type=d.T.string)]),
              withMachineType(machineType): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { masterConfig+: { machineType: machineType } } } } } } },
              '#withMinCpuPlatform':: d.fn(help='"Specifies the minimum cpu platform for the Instance Group. See (https://cloud.google.com/dataproc/docs/concepts/compute/dataproc-min-cpu)."', args=[d.arg(name='minCpuPlatform', type=d.T.string)]),
              withMinCpuPlatform(minCpuPlatform): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { masterConfig+: { minCpuPlatform: minCpuPlatform } } } } } } },
              '#withNumInstances':: d.fn(help='"The number of VM instances in the instance group. For master instance groups, must be set to 1."', args=[d.arg(name='numInstances', type=d.T.number)]),
              withNumInstances(numInstances): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { masterConfig+: { numInstances: numInstances } } } } } } },
              '#withPreemptibility':: d.fn(help='"Specifies the preemptibility of the instance group. The default value for master and worker groups is NON_PREEMPTIBLE. This default cannot be changed. The default value for secondary instances is PREEMPTIBLE. Possible values: PREEMPTIBILITY_UNSPECIFIED, NON_PREEMPTIBLE, PREEMPTIBLE"', args=[d.arg(name='preemptibility', type=d.T.string)]),
              withPreemptibility(preemptibility): { spec+: { forProvider+: { placement+: { managedCluster+: { config+: { masterConfig+: { preemptibility: preemptibility } } } } } } },
