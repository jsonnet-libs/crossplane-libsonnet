              withOptionalComponents(optionalComponents): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { softwareConfig+: { optionalComponents: if std.isArray(v=optionalComponents) then optionalComponents else [optionalComponents] } } } } } } },
              '#withOptionalComponentsMixin':: d.fn(help='"The set of components to activate on the cluster."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='optionalComponents', type=d.T.array)]),
              withOptionalComponentsMixin(optionalComponents): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { softwareConfig+: { optionalComponents+: if std.isArray(v=optionalComponents) then optionalComponents else [optionalComponents] } } } } } } },
