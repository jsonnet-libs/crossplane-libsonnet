      '#withJobsMixin':: d.fn(help='"Required. The Directed Acyclic Graph of Jobs to submit."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='jobs', type=d.T.array)]),
      withJobsMixin(jobs): { spec+: { initProvider+: { jobs+: if std.isArray(v=jobs) then jobs else [jobs] } } },
      '#withLabels':: d.fn(help='"The labels to associate with this cluster. Label keys must be between 1 and 63 characters long, and must conform to the following PCRE regular expression: {0,63} No more than 32 labels can be associated with a given cluster."', args=[d.arg(name='labels', type=d.T.object)]),
      withLabels(labels): { spec+: { initProvider+: { labels: labels } } },
      '#withLabelsMixin':: d.fn(help='"The labels to associate with this cluster. Label keys must be between 1 and 63 characters long, and must conform to the following PCRE regular expression: {0,63} No more than 32 labels can be associated with a given cluster."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='labels', type=d.T.object)]),
      withLabelsMixin(labels): { spec+: { initProvider+: { labels+: labels } } },
      '#withParameters':: d.fn(help='"Template parameters whose values are substituted into the template. Values for parameters must be provided when the template is instantiated."', args=[d.arg(name='parameters', type=d.T.array)]),
      withParameters(parameters): { spec+: { initProvider+: { parameters: if std.isArray(v=parameters) then parameters else [parameters] } } },
      '#withParametersMixin':: d.fn(help='"Template parameters whose values are substituted into the template. Values for parameters must be provided when the template is instantiated."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='parameters', type=d.T.array)]),
