                '#withAcceleratorType':: d.fn(help='"Full URL, partial URI, or short name of the accelerator type resource to expose to this instance. See (https://cloud.google.com/dataproc/docs/concepts/configuring-clusters/auto-zone#using_auto_zone_placement) feature, you must use the short name of the accelerator type resource, for example, nvidia-tesla-k80."', args=[d.arg(name='acceleratorType', type=d.T.string)]),
                withAcceleratorType(acceleratorType): { acceleratorType: acceleratorType },
              },
              '#diskConfig':: d.obj(help='"Disk option config settings."'),
              diskConfig: {
                '#withBootDiskSizeGb':: d.fn(help='"Size in GB of the boot disk (default is 500GB)."', args=[d.arg(name='bootDiskSizeGb', type=d.T.number)]),
                withBootDiskSizeGb(bootDiskSizeGb): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { workerConfig+: { diskConfig+: { bootDiskSizeGb: bootDiskSizeGb } } } } } } } },
                '#withBootDiskType':: d.fn(help='"Type of the boot disk (default is \\"pd-standard\\"). Valid values: \\"pd-ssd\\" (Persistent Disk Solid State Drive) or \\"pd-standard\\" (Persistent Disk Hard Disk Drive)."', args=[d.arg(name='bootDiskType', type=d.T.string)]),
                withBootDiskType(bootDiskType): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { workerConfig+: { diskConfig+: { bootDiskType: bootDiskType } } } } } } } },
                '#withNumLocalSsds':: d.fn(help='"Number of attached SSDs, from 0 to 4 (default is 0). If SSDs are not attached, the boot disk is used to store runtime logs and (https://hadoop.apache.org/docs/r1.2.1/hdfs_user_guide.html) data. If one or more SSDs are attached, this runtime bulk data is spread across them, and the boot disk contains only basic config and installed binaries."', args=[d.arg(name='numLocalSsds', type=d.T.number)]),
                withNumLocalSsds(numLocalSsds): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { workerConfig+: { diskConfig+: { numLocalSsds: numLocalSsds } } } } } } } },
              },
              '#withAccelerators':: d.fn(help='"The Compute Engine accelerator configuration for these instances."', args=[d.arg(name='accelerators', type=d.T.array)]),
              withAccelerators(accelerators): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { workerConfig+: { accelerators: if std.isArray(v=accelerators) then accelerators else [accelerators] } } } } } } },
              '#withAcceleratorsMixin':: d.fn(help='"The Compute Engine accelerator configuration for these instances."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='accelerators', type=d.T.array)]),
              withAcceleratorsMixin(accelerators): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { workerConfig+: { accelerators+: if std.isArray(v=accelerators) then accelerators else [accelerators] } } } } } } },
              '#withImage':: d.fn(help='"The Compute Engine image resource used for cluster instances. The URI can represent an image or image family. Image examples: * https://www.googleapis.com/compute/beta/projects/ If the URI is unspecified, it will be inferred from SoftwareConfig.image_version or the system default."', args=[d.arg(name='image', type=d.T.string)]),
              withImage(image): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { workerConfig+: { image: image } } } } } } },
              '#withMachineType':: d.fn(help='"The Compute Engine machine type used for cluster instances. A full URL, partial URI, or short name are valid. Examples: * https://www.googleapis.com/compute/v1/projects/(https://cloud.google.com/dataproc/docs/concepts/configuring-clusters/auto-zone#using_auto_zone_placement) feature, you must use the short name of the machine type resource, for example, n1-standard-2`."', args=[d.arg(name='machineType', type=d.T.string)]),
              withMachineType(machineType): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { workerConfig+: { machineType: machineType } } } } } } },
              '#withMinCpuPlatform':: d.fn(help='"Specifies the minimum cpu platform for the Instance Group. See (https://cloud.google.com/dataproc/docs/concepts/compute/dataproc-min-cpu)."', args=[d.arg(name='minCpuPlatform', type=d.T.string)]),
              withMinCpuPlatform(minCpuPlatform): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { workerConfig+: { minCpuPlatform: minCpuPlatform } } } } } } },
              '#withNumInstances':: d.fn(help='"The number of VM instances in the instance group. For master instance groups, must be set to 1."', args=[d.arg(name='numInstances', type=d.T.number)]),
              withNumInstances(numInstances): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { workerConfig+: { numInstances: numInstances } } } } } } },
              '#withPreemptibility':: d.fn(help='"Specifies the preemptibility of the instance group. The default value for master and worker groups is NON_PREEMPTIBLE. This default cannot be changed. The default value for secondary instances is PREEMPTIBLE. Possible values: PREEMPTIBILITY_UNSPECIFIED, NON_PREEMPTIBLE, PREEMPTIBLE"', args=[d.arg(name='preemptibility', type=d.T.string)]),
              withPreemptibility(preemptibility): { spec+: { initProvider+: { placement+: { managedCluster+: { config+: { workerConfig+: { preemptibility: preemptibility } } } } } } },
            },
          },
          '#withClusterName':: d.fn(help='"Required. The cluster name prefix. A unique cluster name will be formed by appending a random suffix. The name must contain only lower-case letters (a-z), numbers (0-9), and hyphens (-). Must begin with a letter. Cannot begin or end with hyphen. Must consist of between 2 and 35 characters."', args=[d.arg(name='clusterName', type=d.T.string)]),
          withClusterName(clusterName): { spec+: { initProvider+: { placement+: { managedCluster+: { clusterName: clusterName } } } } },
          '#withLabels':: d.fn(help='"The labels to associate with this cluster. Label keys must be between 1 and 63 characters long, and must conform to the following PCRE regular expression: {0,63} No more than 32 labels can be associated with a given cluster."', args=[d.arg(name='labels', type=d.T.object)]),
          withLabels(labels): { spec+: { initProvider+: { placement+: { managedCluster+: { labels: labels } } } } },
          '#withLabelsMixin':: d.fn(help='"The labels to associate with this cluster. Label keys must be between 1 and 63 characters long, and must conform to the following PCRE regular expression: {0,63} No more than 32 labels can be associated with a given cluster."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='labels', type=d.T.object)]),
          withLabelsMixin(labels): { spec+: { initProvider+: { placement+: { managedCluster+: { labels+: labels } } } } },
        },
      },
      '#withDagTimeout':: d.fn(help='"(Beta only) Optional. Timeout duration for the DAG of jobs. You can use \\"s\\", \\"m\\", \\"h\\", and \\"d\\" suffixes for second, minute, hour, and day duration values, respectively. The timeout duration must be from 10 minutes (\\"10m\\") to 24 hours (\\"24h\\" or \\"1d\\"). The timer begins when the first job is submitted. If the workflow is running at the end of the timeout period, any remaining jobs are cancelled, the workflow is ended, and if the workflow was running on a (/dataproc/docs/concepts/workflows/using-workflows#configuring_or_selecting_a_cluster), the cluster is deleted."', args=[d.arg(name='dagTimeout', type=d.T.string)]),
      withDagTimeout(dagTimeout): { spec+: { initProvider+: { dagTimeout: dagTimeout } } },
