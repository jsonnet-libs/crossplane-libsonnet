          '#withPreemptibility':: d.fn(help='"Specifies the preemptibility of the secondary workers. The default value is PREEMPTIBLE\\nAccepted values are:"', args=[d.arg(name='preemptibility', type=d.T.string)]),
          withPreemptibility(preemptibility): { spec+: { initProvider+: { clusterConfig+: { preemptibleWorkerConfig+: { preemptibility: preemptibility } } } } },
