            '#withEnableIntegrityMonitoring':: d.fn(help='"Defines whether instances have integrity monitoring enabled."', args=[d.arg(name='enableIntegrityMonitoring', type=d.T.boolean)]),
            withEnableIntegrityMonitoring(enableIntegrityMonitoring): { spec+: { forProvider+: { clusterConfig+: { gceClusterConfig+: { shieldedInstanceConfig+: { enableIntegrityMonitoring: enableIntegrityMonitoring } } } } } },
            '#withEnableSecureBoot':: d.fn(help='"Defines whether instances have Secure Boot enabled."', args=[d.arg(name='enableSecureBoot', type=d.T.boolean)]),
            withEnableSecureBoot(enableSecureBoot): { spec+: { forProvider+: { clusterConfig+: { gceClusterConfig+: { shieldedInstanceConfig+: { enableSecureBoot: enableSecureBoot } } } } } },
            '#withEnableVtpm':: d.fn(help='"Defines whether instances have the vTPM enabled."', args=[d.arg(name='enableVtpm', type=d.T.boolean)]),
            withEnableVtpm(enableVtpm): { spec+: { forProvider+: { clusterConfig+: { gceClusterConfig+: { shieldedInstanceConfig+: { enableVtpm: enableVtpm } } } } } },
          },
          '#withInternalIpOnly':: d.fn(help='"By default, clusters are not restricted to internal IP addresses,\\nand will have ephemeral external IP addresses assigned to each instance. If set to true, all\\ninstances in the cluster will only have internal IP addresses. Note: Private Google Access\\n(also known as privateIpGoogleAccess) must be enabled on the subnetwork that the cluster\\nwill be launched in."', args=[d.arg(name='internalIpOnly', type=d.T.boolean)]),
          withInternalIpOnly(internalIpOnly): { spec+: { forProvider+: { clusterConfig+: { gceClusterConfig+: { internalIpOnly: internalIpOnly } } } } },
          '#withMetadata':: d.fn(help='"A map of the Compute Engine metadata entries to add to all instances\\n(see Project and instance metadata)."', args=[d.arg(name='metadata', type=d.T.object)]),
          withMetadata(metadata): { spec+: { forProvider+: { clusterConfig+: { gceClusterConfig+: { metadata: metadata } } } } },
          '#withMetadataMixin':: d.fn(help='"A map of the Compute Engine metadata entries to add to all instances\\n(see Project and instance metadata)."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='metadata', type=d.T.object)]),
          withMetadataMixin(metadata): { spec+: { forProvider+: { clusterConfig+: { gceClusterConfig+: { metadata+: metadata } } } } },
          '#withNetwork':: d.fn(help='"The name or self_link of the Google Compute Engine\\nnetwork to the cluster will be part of. Conflicts with subnetwork.\\nIf neither is specified, this defaults to the \\"default\\" network."', args=[d.arg(name='network', type=d.T.string)]),
          withNetwork(network): { spec+: { forProvider+: { clusterConfig+: { gceClusterConfig+: { network: network } } } } },
          '#withServiceAccount':: d.fn(help='"The service account to be used by the Node VMs.\\nIf not specified, the \\"default\\" service account is used."', args=[d.arg(name='serviceAccount', type=d.T.string)]),
          withServiceAccount(serviceAccount): { spec+: { forProvider+: { clusterConfig+: { gceClusterConfig+: { serviceAccount: serviceAccount } } } } },
          '#withServiceAccountScopes':: d.fn(help='"The set of Google API scopes\\nto be made available on all of the node VMs under the service_account\\nspecified. Both OAuth2 URLs and gcloud\\nshort names are supported. To allow full access to all Cloud APIs, use the\\ncloud-platform scope. See a complete list of scopes here."', args=[d.arg(name='serviceAccountScopes', type=d.T.array)]),
          withServiceAccountScopes(serviceAccountScopes): { spec+: { forProvider+: { clusterConfig+: { gceClusterConfig+: { serviceAccountScopes: if std.isArray(v=serviceAccountScopes) then serviceAccountScopes else [serviceAccountScopes] } } } } },
          '#withServiceAccountScopesMixin':: d.fn(help='"The set of Google API scopes\\nto be made available on all of the node VMs under the service_account\\nspecified. Both OAuth2 URLs and gcloud\\nshort names are supported. To allow full access to all Cloud APIs, use the\\ncloud-platform scope. See a complete list of scopes here."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='serviceAccountScopes', type=d.T.array)]),
          withServiceAccountScopesMixin(serviceAccountScopes): { spec+: { forProvider+: { clusterConfig+: { gceClusterConfig+: { serviceAccountScopes+: if std.isArray(v=serviceAccountScopes) then serviceAccountScopes else [serviceAccountScopes] } } } } },
          '#withSubnetwork':: d.fn(help='"The name or self_link of the Google Compute Engine\\nsubnetwork the cluster will be part of. Conflicts with network."', args=[d.arg(name='subnetwork', type=d.T.string)]),
          withSubnetwork(subnetwork): { spec+: { forProvider+: { clusterConfig+: { gceClusterConfig+: { subnetwork: subnetwork } } } } },
          '#withTags':: d.fn(help='"The list of instance tags applied to instances in the cluster.\\nTags are used to identify valid sources or targets for network firewalls."', args=[d.arg(name='tags', type=d.T.array)]),
          withTags(tags): { spec+: { forProvider+: { clusterConfig+: { gceClusterConfig+: { tags: if std.isArray(v=tags) then tags else [tags] } } } } },
          '#withTagsMixin':: d.fn(help='"The list of instance tags applied to instances in the cluster.\\nTags are used to identify valid sources or targets for network firewalls."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='tags', type=d.T.array)]),
          withTagsMixin(tags): { spec+: { forProvider+: { clusterConfig+: { gceClusterConfig+: { tags+: if std.isArray(v=tags) then tags else [tags] } } } } },
          '#withZone':: d.fn(help="\"The GCP zone where your data is stored and used (i.e. where\\nthe master and the worker nodes will be created in). If region is set to 'global' (default)\\nthen zone is mandatory, otherwise GCP is able to make use of Auto Zone Placement\\nto determine this automatically for you.\\nNote: This setting additionally determines and restricts\\nwhich computing resources are available for use with other configs such as\\ncluster_config.master_config.machine_type and cluster_config.worker_config.machine_type.\"", args=[d.arg(name='zone', type=d.T.string)]),
          withZone(zone): { spec+: { forProvider+: { clusterConfig+: { gceClusterConfig+: { zone: zone } } } } },
        },
        '#initializationAction':: d.obj(help='"Commands to execute on each node after config is completed.\\nYou can specify multiple versions of these. Structure defined below."'),
        initializationAction: {
          '#withScript':: d.fn(help='"The script to be executed during initialization of the cluster.\\nThe script must be a GCS file with a gs:// prefix."', args=[d.arg(name='script', type=d.T.string)]),
          withScript(script): { script: script },
          '#withTimeoutSec':: d.fn(help='"The maximum duration (in seconds) which script is\\nallowed to take to execute its action. GCP will default to a predetermined\\ncomputed value if not set (currently 300)."', args=[d.arg(name='timeoutSec', type=d.T.number)]),
          withTimeoutSec(timeoutSec): { timeoutSec: timeoutSec },
        },
        '#lifecycleConfig':: d.obj(help='"The settings for auto deletion cluster schedule.\\nStructure defined below."'),
        lifecycleConfig: {
          '#withAutoDeleteTime':: d.fn(help='"The time when cluster will be auto-deleted.\\nA timestamp in RFC3339 UTC \\"Zulu\\" format, accurate to nanoseconds.\\nExample: \\"2014-10-02T15:01:23.045123456Z\\"."', args=[d.arg(name='autoDeleteTime', type=d.T.string)]),
          withAutoDeleteTime(autoDeleteTime): { spec+: { forProvider+: { clusterConfig+: { lifecycleConfig+: { autoDeleteTime: autoDeleteTime } } } } },
          '#withIdleDeleteTtl':: d.fn(help='"The duration to keep the cluster alive while idling\\n(no jobs running). After this TTL, the cluster will be deleted. Valid range: [10m, 14d]."', args=[d.arg(name='idleDeleteTtl', type=d.T.string)]),
          withIdleDeleteTtl(idleDeleteTtl): { spec+: { forProvider+: { clusterConfig+: { lifecycleConfig+: { idleDeleteTtl: idleDeleteTtl } } } } },
        },
        '#masterConfig':: d.obj(help='"The Google Compute Engine config settings for the master instances\\nin a cluster. Structure defined below."'),
        masterConfig: {
          '#accelerators':: d.obj(help='"The Compute Engine accelerator (GPU) configuration for these instances. Can be specified multiple times."'),
          accelerators: {
            '#withAcceleratorCount':: d.fn(help='"The number of the accelerator cards of this type exposed to this instance. Often restricted to one of 1, 2, 4, or 8."', args=[d.arg(name='acceleratorCount', type=d.T.number)]),
            withAcceleratorCount(acceleratorCount): { acceleratorCount: acceleratorCount },
            '#withAcceleratorType':: d.fn(help='"The short name of the accelerator type to expose to this instance. For example, nvidia-tesla-k80."', args=[d.arg(name='acceleratorType', type=d.T.string)]),
            withAcceleratorType(acceleratorType): { acceleratorType: acceleratorType },
          },
          '#diskConfig':: d.obj(help='"Disk Config"'),
          diskConfig: {
            '#withBootDiskSizeGb':: d.fn(help='"Size of the primary disk attached to each node, specified\\nin GB. The primary disk contains the boot volume and system libraries, and the\\nsmallest allowed disk size is 10GB. GCP will default to a predetermined\\ncomputed value if not set (currently 500GB). Note: If SSDs are not\\nattached, it also contains the HDFS data blocks and Hadoop working directories."', args=[d.arg(name='bootDiskSizeGb', type=d.T.number)]),
            withBootDiskSizeGb(bootDiskSizeGb): { spec+: { forProvider+: { clusterConfig+: { masterConfig+: { diskConfig+: { bootDiskSizeGb: bootDiskSizeGb } } } } } },
            '#withBootDiskType':: d.fn(help='"The disk type of the primary disk attached to each node.\\nOne of \\"pd-ssd\\" or \\"pd-standard\\". Defaults to \\"pd-standard\\"."', args=[d.arg(name='bootDiskType', type=d.T.string)]),
            withBootDiskType(bootDiskType): { spec+: { forProvider+: { clusterConfig+: { masterConfig+: { diskConfig+: { bootDiskType: bootDiskType } } } } } },
            '#withLocalSsdInterface':: d.fn(help='"Optional. Interface type of local SSDs (default is \\"scsi\\").\\nValid values: \\"scsi\\" (Small Computer System Interface), \\"nvme\\" (Non-Volatile\\nMemory Express). See\\nlocal SSD performance."', args=[d.arg(name='localSsdInterface', type=d.T.string)]),
            withLocalSsdInterface(localSsdInterface): { spec+: { forProvider+: { clusterConfig+: { masterConfig+: { diskConfig+: { localSsdInterface: localSsdInterface } } } } } },
            '#withNumLocalSsds':: d.fn(help='"The amount of local SSD disks that will be\\nattached to each master cluster node. Defaults to 0."', args=[d.arg(name='numLocalSsds', type=d.T.number)]),
            withNumLocalSsds(numLocalSsds): { spec+: { forProvider+: { clusterConfig+: { masterConfig+: { diskConfig+: { numLocalSsds: numLocalSsds } } } } } },
          },
          '#withAccelerators':: d.fn(help='"The Compute Engine accelerator (GPU) configuration for these instances. Can be specified multiple times."', args=[d.arg(name='accelerators', type=d.T.array)]),
          withAccelerators(accelerators): { spec+: { forProvider+: { clusterConfig+: { masterConfig+: { accelerators: if std.isArray(v=accelerators) then accelerators else [accelerators] } } } } },
          '#withAcceleratorsMixin':: d.fn(help='"The Compute Engine accelerator (GPU) configuration for these instances. Can be specified multiple times."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='accelerators', type=d.T.array)]),
          withAcceleratorsMixin(accelerators): { spec+: { forProvider+: { clusterConfig+: { masterConfig+: { accelerators+: if std.isArray(v=accelerators) then accelerators else [accelerators] } } } } },
          '#withImageUri':: d.fn(help='"The URI for the image to use for this worker.  See the guide\\nfor more information."', args=[d.arg(name='imageUri', type=d.T.string)]),
          withImageUri(imageUri): { spec+: { forProvider+: { clusterConfig+: { masterConfig+: { imageUri: imageUri } } } } },
          '#withMachineType':: d.fn(help='"The name of a Google Compute Engine machine type\\nto create for the master. If not specified, GCP will default to a predetermined\\ncomputed value (currently n1-standard-4)."', args=[d.arg(name='machineType', type=d.T.string)]),
          withMachineType(machineType): { spec+: { forProvider+: { clusterConfig+: { masterConfig+: { machineType: machineType } } } } },
          '#withMinCpuPlatform':: d.fn(help='"The name of a minimum generation of CPU family\\nfor the master. If not specified, GCP will default to a predetermined computed value\\nfor each zone. See the guide\\nfor details about which CPU families are available (and defaulted) for each zone."', args=[d.arg(name='minCpuPlatform', type=d.T.string)]),
          withMinCpuPlatform(minCpuPlatform): { spec+: { forProvider+: { clusterConfig+: { masterConfig+: { minCpuPlatform: minCpuPlatform } } } } },
          '#withNumInstances':: d.fn(help='"Specifies the number of master nodes to create.\\nIf not specified, GCP will default to a predetermined computed value (currently 1)."', args=[d.arg(name='numInstances', type=d.T.number)]),
          withNumInstances(numInstances): { spec+: { forProvider+: { clusterConfig+: { masterConfig+: { numInstances: numInstances } } } } },
        },
        '#metastoreConfig':: d.obj(help='"The config setting for metastore service with the cluster.\\nStructure defined below."'),
        metastoreConfig: {
          '#withDataprocMetastoreService':: d.fn(help='"Resource name of an existing Dataproc Metastore service."', args=[d.arg(name='dataprocMetastoreService', type=d.T.string)]),
          withDataprocMetastoreService(dataprocMetastoreService): { spec+: { forProvider+: { clusterConfig+: { metastoreConfig+: { dataprocMetastoreService: dataprocMetastoreService } } } } },
        },
        '#preemptibleWorkerConfig':: d.obj(help='"The Google Compute Engine config settings for the additional\\ninstances in a cluster. Structure defined below."'),
        preemptibleWorkerConfig: {
          '#diskConfig':: d.obj(help='"Disk Config"'),
          diskConfig: {
            '#withBootDiskSizeGb':: d.fn(help='"Size of the primary disk attached to each node, specified\\nin GB. The primary disk contains the boot volume and system libraries, and the\\nsmallest allowed disk size is 10GB. GCP will default to a predetermined\\ncomputed value if not set (currently 500GB). Note: If SSDs are not\\nattached, it also contains the HDFS data blocks and Hadoop working directories."', args=[d.arg(name='bootDiskSizeGb', type=d.T.number)]),
            withBootDiskSizeGb(bootDiskSizeGb): { spec+: { forProvider+: { clusterConfig+: { preemptibleWorkerConfig+: { diskConfig+: { bootDiskSizeGb: bootDiskSizeGb } } } } } },
            '#withBootDiskType':: d.fn(help='"The disk type of the primary disk attached to each node.\\nOne of \\"pd-ssd\\" or \\"pd-standard\\". Defaults to \\"pd-standard\\"."', args=[d.arg(name='bootDiskType', type=d.T.string)]),
            withBootDiskType(bootDiskType): { spec+: { forProvider+: { clusterConfig+: { preemptibleWorkerConfig+: { diskConfig+: { bootDiskType: bootDiskType } } } } } },
            '#withLocalSsdInterface':: d.fn(help='"Optional. Interface type of local SSDs (default is \\"scsi\\").\\nValid values: \\"scsi\\" (Small Computer System Interface), \\"nvme\\" (Non-Volatile\\nMemory Express). See\\nlocal SSD performance."', args=[d.arg(name='localSsdInterface', type=d.T.string)]),
            withLocalSsdInterface(localSsdInterface): { spec+: { forProvider+: { clusterConfig+: { preemptibleWorkerConfig+: { diskConfig+: { localSsdInterface: localSsdInterface } } } } } },
            '#withNumLocalSsds':: d.fn(help='"The amount of local SSD disks that will be\\nattached to each master cluster node. Defaults to 0."', args=[d.arg(name='numLocalSsds', type=d.T.number)]),
            withNumLocalSsds(numLocalSsds): { spec+: { forProvider+: { clusterConfig+: { preemptibleWorkerConfig+: { diskConfig+: { numLocalSsds: numLocalSsds } } } } } },
          },
          '#instanceFlexibilityPolicy':: d.obj(help='"Instance flexibility Policy allowing a mixture of VM shapes and provisioning models."'),
          instanceFlexibilityPolicy: {
            '#instanceSelectionList':: d.obj(help='"List of instance selection options that the group will use when creating new VMs."'),
            instanceSelectionList: {
              '#withMachineTypes':: d.fn(help='"Full machine-type names, e.g. \\"n1-standard-16\\"."', args=[d.arg(name='machineTypes', type=d.T.array)]),
              withMachineTypes(machineTypes): { machineTypes: if std.isArray(v=machineTypes) then machineTypes else [machineTypes] },
              '#withMachineTypesMixin':: d.fn(help='"Full machine-type names, e.g. \\"n1-standard-16\\"."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='machineTypes', type=d.T.array)]),
              withMachineTypesMixin(machineTypes): { machineTypes+: if std.isArray(v=machineTypes) then machineTypes else [machineTypes] },
              '#withRank':: d.fn(help='"Preference of this instance selection. A lower number means higher preference. Dataproc will first try to create a VM based on the machine-type with priority rank and fallback to next rank based on availability. Machine types and instance selections with the same priority have the same preference."', args=[d.arg(name='rank', type=d.T.number)]),
              withRank(rank): { rank: rank },
            },
            '#withInstanceSelectionList':: d.fn(help='"List of instance selection options that the group will use when creating new VMs."', args=[d.arg(name='instanceSelectionList', type=d.T.array)]),
            withInstanceSelectionList(instanceSelectionList): { spec+: { forProvider+: { clusterConfig+: { preemptibleWorkerConfig+: { instanceFlexibilityPolicy+: { instanceSelectionList: if std.isArray(v=instanceSelectionList) then instanceSelectionList else [instanceSelectionList] } } } } } },
            '#withInstanceSelectionListMixin':: d.fn(help='"List of instance selection options that the group will use when creating new VMs."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='instanceSelectionList', type=d.T.array)]),
            withInstanceSelectionListMixin(instanceSelectionList): { spec+: { forProvider+: { clusterConfig+: { preemptibleWorkerConfig+: { instanceFlexibilityPolicy+: { instanceSelectionList+: if std.isArray(v=instanceSelectionList) then instanceSelectionList else [instanceSelectionList] } } } } } },
          },
          '#withNumInstances':: d.fn(help='"Specifies the number of preemptible nodes to create.\\nDefaults to 0."', args=[d.arg(name='numInstances', type=d.T.number)]),
          withNumInstances(numInstances): { spec+: { forProvider+: { clusterConfig+: { preemptibleWorkerConfig+: { numInstances: numInstances } } } } },
          '#withPreemptibility':: d.fn(help='"Specifies the preemptibility of the secondary workers. The default value is PREEMPTIBLE\\nAccepted values are:"', args=[d.arg(name='preemptibility', type=d.T.string)]),
          withPreemptibility(preemptibility): { spec+: { forProvider+: { clusterConfig+: { preemptibleWorkerConfig+: { preemptibility: preemptibility } } } } },
        },
        '#securityConfig':: d.obj(help='"Security related configuration. Structure defined below."'),
        securityConfig: {
          '#kerberosConfig':: d.obj(help='"Kerberos Configuration"'),
          kerberosConfig: {
            '#withCrossRealmTrustAdminServer':: d.fn(help='"The admin server (IP or hostname) for the\\nremote trusted realm in a cross realm trust relationship."', args=[d.arg(name='crossRealmTrustAdminServer', type=d.T.string)]),
            withCrossRealmTrustAdminServer(crossRealmTrustAdminServer): { spec+: { forProvider+: { clusterConfig+: { securityConfig+: { kerberosConfig+: { crossRealmTrustAdminServer: crossRealmTrustAdminServer } } } } } },
            '#withCrossRealmTrustKdc':: d.fn(help='"The KDC (IP or hostname) for the\\nremote trusted realm in a cross realm trust relationship."', args=[d.arg(name='crossRealmTrustKdc', type=d.T.string)]),
            withCrossRealmTrustKdc(crossRealmTrustKdc): { spec+: { forProvider+: { clusterConfig+: { securityConfig+: { kerberosConfig+: { crossRealmTrustKdc: crossRealmTrustKdc } } } } } },
            '#withCrossRealmTrustRealm':: d.fn(help='"The remote realm the Dataproc on-cluster KDC will\\ntrust, should the user enable cross realm trust."', args=[d.arg(name='crossRealmTrustRealm', type=d.T.string)]),
            withCrossRealmTrustRealm(crossRealmTrustRealm): { spec+: { forProvider+: { clusterConfig+: { securityConfig+: { kerberosConfig+: { crossRealmTrustRealm: crossRealmTrustRealm } } } } } },
            '#withCrossRealmTrustSharedPasswordUri':: d.fn(help='"The Cloud Storage URI of a KMS\\nencrypted file containing the shared password between the on-cluster Kerberos realm\\nand the remote trusted realm, in a cross realm trust relationship."', args=[d.arg(name='crossRealmTrustSharedPasswordUri', type=d.T.string)]),
            withCrossRealmTrustSharedPasswordUri(crossRealmTrustSharedPasswordUri): { spec+: { forProvider+: { clusterConfig+: { securityConfig+: { kerberosConfig+: { crossRealmTrustSharedPasswordUri: crossRealmTrustSharedPasswordUri } } } } } },
            '#withEnableKerberos':: d.fn(help='"Flag to indicate whether to Kerberize the cluster."', args=[d.arg(name='enableKerberos', type=d.T.boolean)]),
            withEnableKerberos(enableKerberos): { spec+: { forProvider+: { clusterConfig+: { securityConfig+: { kerberosConfig+: { enableKerberos: enableKerberos } } } } } },
            '#withKdcDbKeyUri':: d.fn(help='"The Cloud Storage URI of a KMS encrypted file containing\\nthe master key of the KDC database."', args=[d.arg(name='kdcDbKeyUri', type=d.T.string)]),
            withKdcDbKeyUri(kdcDbKeyUri): { spec+: { forProvider+: { clusterConfig+: { securityConfig+: { kerberosConfig+: { kdcDbKeyUri: kdcDbKeyUri } } } } } },
            '#withKeyPasswordUri':: d.fn(help='"The Cloud Storage URI of a KMS encrypted file containing\\nthe password to the user provided key. For the self-signed certificate, this password\\nis generated by Dataproc."', args=[d.arg(name='keyPasswordUri', type=d.T.string)]),
            withKeyPasswordUri(keyPasswordUri): { spec+: { forProvider+: { clusterConfig+: { securityConfig+: { kerberosConfig+: { keyPasswordUri: keyPasswordUri } } } } } },
            '#withKeystorePasswordUri':: d.fn(help='"The Cloud Storage URI of a KMS encrypted file containing\\nthe password to the user provided keystore. For the self-signed certificated, the password\\nis generated by Dataproc."', args=[d.arg(name='keystorePasswordUri', type=d.T.string)]),
            withKeystorePasswordUri(keystorePasswordUri): { spec+: { forProvider+: { clusterConfig+: { securityConfig+: { kerberosConfig+: { keystorePasswordUri: keystorePasswordUri } } } } } },
            '#withKeystoreUri':: d.fn(help='"The Cloud Storage URI of the keystore file used for SSL encryption.\\nIf not provided, Dataproc will provide a self-signed certificate."', args=[d.arg(name='keystoreUri', type=d.T.string)]),
            withKeystoreUri(keystoreUri): { spec+: { forProvider+: { clusterConfig+: { securityConfig+: { kerberosConfig+: { keystoreUri: keystoreUri } } } } } },
            '#withKmsKeyUri':: d.fn(help='"The URI of the KMS key used to encrypt various sensitive files."', args=[d.arg(name='kmsKeyUri', type=d.T.string)]),
            withKmsKeyUri(kmsKeyUri): { spec+: { forProvider+: { clusterConfig+: { securityConfig+: { kerberosConfig+: { kmsKeyUri: kmsKeyUri } } } } } },
            '#withRealm':: d.fn(help='"The name of the on-cluster Kerberos realm. If not specified, the\\nuppercased domain of hostnames will be the realm."', args=[d.arg(name='realm', type=d.T.string)]),
            withRealm(realm): { spec+: { forProvider+: { clusterConfig+: { securityConfig+: { kerberosConfig+: { realm: realm } } } } } },
            '#withRootPrincipalPasswordUri':: d.fn(help='"The Cloud Storage URI of a KMS encrypted file\\ncontaining the root principal password."', args=[d.arg(name='rootPrincipalPasswordUri', type=d.T.string)]),
            withRootPrincipalPasswordUri(rootPrincipalPasswordUri): { spec+: { forProvider+: { clusterConfig+: { securityConfig+: { kerberosConfig+: { rootPrincipalPasswordUri: rootPrincipalPasswordUri } } } } } },
            '#withTgtLifetimeHours':: d.fn(help='"The lifetime of the ticket granting ticket, in hours."', args=[d.arg(name='tgtLifetimeHours', type=d.T.number)]),
            withTgtLifetimeHours(tgtLifetimeHours): { spec+: { forProvider+: { clusterConfig+: { securityConfig+: { kerberosConfig+: { tgtLifetimeHours: tgtLifetimeHours } } } } } },
            '#withTruststorePasswordUri':: d.fn(help='"The Cloud Storage URI of a KMS encrypted file\\ncontaining the password to the user provided truststore. For the self-signed\\ncertificate, this password is generated by Dataproc."', args=[d.arg(name='truststorePasswordUri', type=d.T.string)]),
            withTruststorePasswordUri(truststorePasswordUri): { spec+: { forProvider+: { clusterConfig+: { securityConfig+: { kerberosConfig+: { truststorePasswordUri: truststorePasswordUri } } } } } },
            '#withTruststoreUri':: d.fn(help='"The Cloud Storage URI of the truststore file used for\\nSSL encryption. If not provided, Dataproc will provide a self-signed certificate."', args=[d.arg(name='truststoreUri', type=d.T.string)]),
            withTruststoreUri(truststoreUri): { spec+: { forProvider+: { clusterConfig+: { securityConfig+: { kerberosConfig+: { truststoreUri: truststoreUri } } } } } },
          },
        },
        '#softwareConfig':: d.obj(help='"The config settings for software inside the cluster.\\nStructure defined below."'),
        softwareConfig: {
          '#withImageVersion':: d.fn(help='"The Cloud Dataproc image version to use\\nfor the cluster - this controls the sets of software versions\\ninstalled onto the nodes when you create clusters. If not specified, defaults to the\\nlatest version. For a list of valid versions see\\nCloud Dataproc versions"', args=[d.arg(name='imageVersion', type=d.T.string)]),
          withImageVersion(imageVersion): { spec+: { forProvider+: { clusterConfig+: { softwareConfig+: { imageVersion: imageVersion } } } } },
          '#withOptionalComponents':: d.fn(help='"The set of optional components to activate on the cluster. See Available Optional Components."', args=[d.arg(name='optionalComponents', type=d.T.array)]),
          withOptionalComponents(optionalComponents): { spec+: { forProvider+: { clusterConfig+: { softwareConfig+: { optionalComponents: if std.isArray(v=optionalComponents) then optionalComponents else [optionalComponents] } } } } },
          '#withOptionalComponentsMixin':: d.fn(help='"The set of optional components to activate on the cluster. See Available Optional Components."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='optionalComponents', type=d.T.array)]),
          withOptionalComponentsMixin(optionalComponents): { spec+: { forProvider+: { clusterConfig+: { softwareConfig+: { optionalComponents+: if std.isArray(v=optionalComponents) then optionalComponents else [optionalComponents] } } } } },
          '#withOverrideProperties':: d.fn(help='"A list of override and additional properties (key/value pairs)\\nused to modify various aspects of the common configuration files used when creating\\na cluster. For a list of valid properties please see\\nCluster properties"', args=[d.arg(name='overrideProperties', type=d.T.object)]),
          withOverrideProperties(overrideProperties): { spec+: { forProvider+: { clusterConfig+: { softwareConfig+: { overrideProperties: overrideProperties } } } } },
          '#withOverridePropertiesMixin':: d.fn(help='"A list of override and additional properties (key/value pairs)\\nused to modify various aspects of the common configuration files used when creating\\na cluster. For a list of valid properties please see\\nCluster properties"\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='overrideProperties', type=d.T.object)]),
          withOverridePropertiesMixin(overrideProperties): { spec+: { forProvider+: { clusterConfig+: { softwareConfig+: { overrideProperties+: overrideProperties } } } } },
        },
        '#withAuxiliaryNodeGroups':: d.fn(help='"A Dataproc NodeGroup resource is a group of Dataproc cluster nodes that execute an assigned role.\\nStructure defined below."', args=[d.arg(name='auxiliaryNodeGroups', type=d.T.array)]),
        withAuxiliaryNodeGroups(auxiliaryNodeGroups): { spec+: { forProvider+: { clusterConfig+: { auxiliaryNodeGroups: if std.isArray(v=auxiliaryNodeGroups) then auxiliaryNodeGroups else [auxiliaryNodeGroups] } } } },
        '#withAuxiliaryNodeGroupsMixin':: d.fn(help='"A Dataproc NodeGroup resource is a group of Dataproc cluster nodes that execute an assigned role.\\nStructure defined below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='auxiliaryNodeGroups', type=d.T.array)]),
        withAuxiliaryNodeGroupsMixin(auxiliaryNodeGroups): { spec+: { forProvider+: { clusterConfig+: { auxiliaryNodeGroups+: if std.isArray(v=auxiliaryNodeGroups) then auxiliaryNodeGroups else [auxiliaryNodeGroups] } } } },
        '#withInitializationAction':: d.fn(help='"Commands to execute on each node after config is completed.\\nYou can specify multiple versions of these. Structure defined below."', args=[d.arg(name='initializationAction', type=d.T.array)]),
        withInitializationAction(initializationAction): { spec+: { forProvider+: { clusterConfig+: { initializationAction: if std.isArray(v=initializationAction) then initializationAction else [initializationAction] } } } },
        '#withInitializationActionMixin':: d.fn(help='"Commands to execute on each node after config is completed.\\nYou can specify multiple versions of these. Structure defined below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='initializationAction', type=d.T.array)]),
        withInitializationActionMixin(initializationAction): { spec+: { forProvider+: { clusterConfig+: { initializationAction+: if std.isArray(v=initializationAction) then initializationAction else [initializationAction] } } } },
        '#withStagingBucket':: d.fn(help="\"The Cloud Storage staging bucket used to stage files,\\nsuch as Hadoop jars, between client machines and the cluster.\\nNote: If you don't explicitly specify a staging_bucket\\nthen GCP will auto create / assign one for you. However, you are not guaranteed\\nan auto generated bucket which is solely dedicated to your cluster; it may be shared\\nwith other clusters in the same region/zone also choosing to use the auto generation\\noption.\"", args=[d.arg(name='stagingBucket', type=d.T.string)]),
        withStagingBucket(stagingBucket): { spec+: { forProvider+: { clusterConfig+: { stagingBucket: stagingBucket } } } },
        '#withTempBucket':: d.fn(help="\"The Cloud Storage temp bucket used to store ephemeral cluster\\nand jobs data, such as Spark and MapReduce history files.\\nNote: If you don't explicitly specify a temp_bucket then GCP will auto create / assign one for you.\"", args=[d.arg(name='tempBucket', type=d.T.string)]),
        withTempBucket(tempBucket): { spec+: { forProvider+: { clusterConfig+: { tempBucket: tempBucket } } } },
        '#workerConfig':: d.obj(help='"The Google Compute Engine config settings for the worker instances\\nin a cluster. Structure defined below."'),
        workerConfig: {
          '#accelerators':: d.obj(help='"The Compute Engine accelerator configuration for these instances. Can be specified multiple times."'),
          accelerators: {
            '#withAcceleratorCount':: d.fn(help='"The number of the accelerator cards of this type exposed to this instance. Often restricted to one of 1, 2, 4, or 8."', args=[d.arg(name='acceleratorCount', type=d.T.number)]),
            withAcceleratorCount(acceleratorCount): { acceleratorCount: acceleratorCount },
            '#withAcceleratorType':: d.fn(help='"The short name of the accelerator type to expose to this instance. For example, nvidia-tesla-k80."', args=[d.arg(name='acceleratorType', type=d.T.string)]),
            withAcceleratorType(acceleratorType): { acceleratorType: acceleratorType },
          },
          '#diskConfig':: d.obj(help='"Disk Config"'),
          diskConfig: {
            '#withBootDiskSizeGb':: d.fn(help='"Size of the primary disk attached to each node, specified\\nin GB. The primary disk contains the boot volume and system libraries, and the\\nsmallest allowed disk size is 10GB. GCP will default to a predetermined\\ncomputed value if not set (currently 500GB). Note: If SSDs are not\\nattached, it also contains the HDFS data blocks and Hadoop working directories."', args=[d.arg(name='bootDiskSizeGb', type=d.T.number)]),
            withBootDiskSizeGb(bootDiskSizeGb): { spec+: { forProvider+: { clusterConfig+: { workerConfig+: { diskConfig+: { bootDiskSizeGb: bootDiskSizeGb } } } } } },
            '#withBootDiskType':: d.fn(help='"The disk type of the primary disk attached to each node.\\nOne of \\"pd-ssd\\" or \\"pd-standard\\". Defaults to \\"pd-standard\\"."', args=[d.arg(name='bootDiskType', type=d.T.string)]),
            withBootDiskType(bootDiskType): { spec+: { forProvider+: { clusterConfig+: { workerConfig+: { diskConfig+: { bootDiskType: bootDiskType } } } } } },
            '#withLocalSsdInterface':: d.fn(help='"Optional. Interface type of local SSDs (default is \\"scsi\\").\\nValid values: \\"scsi\\" (Small Computer System Interface), \\"nvme\\" (Non-Volatile\\nMemory Express). See\\nlocal SSD performance."', args=[d.arg(name='localSsdInterface', type=d.T.string)]),
            withLocalSsdInterface(localSsdInterface): { spec+: { forProvider+: { clusterConfig+: { workerConfig+: { diskConfig+: { localSsdInterface: localSsdInterface } } } } } },
            '#withNumLocalSsds':: d.fn(help='"The amount of local SSD disks that will be\\nattached to each master cluster node. Defaults to 0."', args=[d.arg(name='numLocalSsds', type=d.T.number)]),
            withNumLocalSsds(numLocalSsds): { spec+: { forProvider+: { clusterConfig+: { workerConfig+: { diskConfig+: { numLocalSsds: numLocalSsds } } } } } },
          },
          '#withAccelerators':: d.fn(help='"The Compute Engine accelerator configuration for these instances. Can be specified multiple times."', args=[d.arg(name='accelerators', type=d.T.array)]),
          withAccelerators(accelerators): { spec+: { forProvider+: { clusterConfig+: { workerConfig+: { accelerators: if std.isArray(v=accelerators) then accelerators else [accelerators] } } } } },
          '#withAcceleratorsMixin':: d.fn(help='"The Compute Engine accelerator configuration for these instances. Can be specified multiple times."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='accelerators', type=d.T.array)]),
          withAcceleratorsMixin(accelerators): { spec+: { forProvider+: { clusterConfig+: { workerConfig+: { accelerators+: if std.isArray(v=accelerators) then accelerators else [accelerators] } } } } },
          '#withImageUri':: d.fn(help='"The URI for the image to use for this worker.  See the guide\\nfor more information."', args=[d.arg(name='imageUri', type=d.T.string)]),
          withImageUri(imageUri): { spec+: { forProvider+: { clusterConfig+: { workerConfig+: { imageUri: imageUri } } } } },
          '#withMachineType':: d.fn(help='"The name of a Google Compute Engine machine type\\nto create for the worker nodes. If not specified, GCP will default to a predetermined\\ncomputed value (currently n1-standard-4)."', args=[d.arg(name='machineType', type=d.T.string)]),
          withMachineType(machineType): { spec+: { forProvider+: { clusterConfig+: { workerConfig+: { machineType: machineType } } } } },
          '#withMinCpuPlatform':: d.fn(help='"The name of a minimum generation of CPU family\\nfor the master. If not specified, GCP will default to a predetermined computed value\\nfor each zone. See the guide\\nfor details about which CPU families are available (and defaulted) for each zone."', args=[d.arg(name='minCpuPlatform', type=d.T.string)]),
          withMinCpuPlatform(minCpuPlatform): { spec+: { forProvider+: { clusterConfig+: { workerConfig+: { minCpuPlatform: minCpuPlatform } } } } },
          '#withMinNumInstances':: d.fn(help='"The minimum number of primary worker instances to create.  If min_num_instances is set, cluster creation will succeed if the number of primary workers created is at least equal to the min_num_instances number."', args=[d.arg(name='minNumInstances', type=d.T.number)]),
          withMinNumInstances(minNumInstances): { spec+: { forProvider+: { clusterConfig+: { workerConfig+: { minNumInstances: minNumInstances } } } } },
          '#withNumInstances':: d.fn(help='"Specifies the number of worker nodes to create.\\nIf not specified, GCP will default to a predetermined computed value (currently 2).\\nThere is currently a beta feature which allows you to run a\\nSingle Node Cluster.\\nIn order to take advantage of this you need to set\\n\\"dataproc:dataproc.allow.zero.workers\\" = \\"true\\" in\\ncluster_config.software_config.properties"', args=[d.arg(name='numInstances', type=d.T.number)]),
          withNumInstances(numInstances): { spec+: { forProvider+: { clusterConfig+: { workerConfig+: { numInstances: numInstances } } } } },
        },
      },
      '#virtualClusterConfig':: d.obj(help='"Allows you to configure a virtual Dataproc on GKE cluster.\\nStructure defined below."'),
      virtualClusterConfig: {
        '#auxiliaryServicesConfig':: d.obj(help='"Configuration of auxiliary services used by this cluster.\\nStructure defined below."'),
        auxiliaryServicesConfig: {
          '#metastoreConfig':: d.obj(help='"The config setting for metastore service with the cluster.\\nStructure defined below."'),
          metastoreConfig: {
            '#withDataprocMetastoreService':: d.fn(help='"Resource name of an existing Dataproc Metastore service."', args=[d.arg(name='dataprocMetastoreService', type=d.T.string)]),
            withDataprocMetastoreService(dataprocMetastoreService): { spec+: { forProvider+: { virtualClusterConfig+: { auxiliaryServicesConfig+: { metastoreConfig+: { dataprocMetastoreService: dataprocMetastoreService } } } } } },
          },
          '#sparkHistoryServerConfig':: d.obj(help='"The Spark History Server configuration for the workload."'),
          sparkHistoryServerConfig: {
            '#withDataprocCluster':: d.fn(help='"Resource name of an existing Dataproc Cluster to act as a Spark History Server for the workload."', args=[d.arg(name='dataprocCluster', type=d.T.string)]),
            withDataprocCluster(dataprocCluster): { spec+: { forProvider+: { virtualClusterConfig+: { auxiliaryServicesConfig+: { sparkHistoryServerConfig+: { dataprocCluster: dataprocCluster } } } } } },
          },
        },
        '#kubernetesClusterConfig':: d.obj(help='"The configuration for running the Dataproc cluster on Kubernetes.\\nStructure defined below."'),
        kubernetesClusterConfig: {
          '#gkeClusterConfig':: d.obj(help='"The configuration for running the Dataproc cluster on GKE."'),
          gkeClusterConfig: {
            '#nodePoolTarget':: d.obj(help='"GKE node pools where workloads will be scheduled. At least one node pool must be assigned the DEFAULT\\nGkeNodePoolTarget.Role. If a GkeNodePoolTarget is not specified, Dataproc constructs a DEFAULT GkeNodePoolTarget.\\nEach role can be given to only one GkeNodePoolTarget. All node pools must have the same location settings."'),
            nodePoolTarget: {
              '#nodePoolConfig':: d.obj(help='"(Input only) The configuration for the GKE node pool.\\nIf specified, Dataproc attempts to create a node pool with the specified shape.\\nIf one with the same name already exists, it is verified against all specified fields.\\nIf a field differs, the virtual cluster creation will fail."'),
              nodePoolConfig: {
                '#autoscaling':: d.obj(help='"The autoscaler configuration for this node pool.\\nThe autoscaler is enabled only when a valid configuration is present."'),
                autoscaling: {
                  '#withMaxNodeCount':: d.fn(help='"The maximum number of nodes in the node pool. Must be >= minNodeCount, and must be > 0."', args=[d.arg(name='maxNodeCount', type=d.T.number)]),
                  withMaxNodeCount(maxNodeCount): { nodePoolConfig+: { autoscaling+: { maxNodeCount: maxNodeCount } } },
                  '#withMinNodeCount':: d.fn(help='"The minimum number of nodes in the node pool. Must be >= 0 and <= maxNodeCount."', args=[d.arg(name='minNodeCount', type=d.T.number)]),
                  withMinNodeCount(minNodeCount): { nodePoolConfig+: { autoscaling+: { minNodeCount: minNodeCount } } },
                },
                '#config':: d.obj(help='"The node pool configuration."'),
                config: {
                  '#withLocalSsdCount':: d.fn(help='"The number of local SSD disks to attach to the node,\\nwhich is limited by the maximum number of disks allowable per zone."', args=[d.arg(name='localSsdCount', type=d.T.number)]),
                  withLocalSsdCount(localSsdCount): { nodePoolConfig+: { config+: { localSsdCount: localSsdCount } } },
                  '#withMachineType':: d.fn(help='"The name of a Compute Engine machine type."', args=[d.arg(name='machineType', type=d.T.string)]),
                  withMachineType(machineType): { nodePoolConfig+: { config+: { machineType: machineType } } },
                  '#withMinCpuPlatform':: d.fn(help='"Minimum CPU platform to be used by this instance.\\nThe instance may be scheduled on the specified or a newer CPU platform.\\nSpecify the friendly names of CPU platforms, such as \\"Intel Haswell\\" or \\"Intel Sandy Bridge\\"."', args=[d.arg(name='minCpuPlatform', type=d.T.string)]),
                  withMinCpuPlatform(minCpuPlatform): { nodePoolConfig+: { config+: { minCpuPlatform: minCpuPlatform } } },
                  '#withPreemptible':: d.fn(help='"Whether the nodes are created as preemptible VM instances.\\nPreemptible nodes cannot be used in a node pool with the CONTROLLER role or in the DEFAULT node pool if the\\nCONTROLLER role is not assigned (the DEFAULT node pool will assume the CONTROLLER role)."', args=[d.arg(name='preemptible', type=d.T.boolean)]),
                  withPreemptible(preemptible): { nodePoolConfig+: { config+: { preemptible: preemptible } } },
                  '#withSpot':: d.fn(help='"Spot flag for enabling Spot VM, which is a rebrand of the existing preemptible flag."', args=[d.arg(name='spot', type=d.T.boolean)]),
                  withSpot(spot): { nodePoolConfig+: { config+: { spot: spot } } },
                },
                '#withLocations':: d.fn(help='"The list of Compute Engine zones where node pool nodes associated\\nwith a Dataproc on GKE virtual cluster will be located."', args=[d.arg(name='locations', type=d.T.array)]),
                withLocations(locations): { nodePoolConfig+: { locations: if std.isArray(v=locations) then locations else [locations] } },
                '#withLocationsMixin':: d.fn(help='"The list of Compute Engine zones where node pool nodes associated\\nwith a Dataproc on GKE virtual cluster will be located."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='locations', type=d.T.array)]),
                withLocationsMixin(locations): { nodePoolConfig+: { locations+: if std.isArray(v=locations) then locations else [locations] } },
              },
              '#withNodePool':: d.fn(help='"The target GKE node pool."', args=[d.arg(name='nodePool', type=d.T.string)]),
              withNodePool(nodePool): { nodePool: nodePool },
              '#withRoles':: d.fn(help='"The roles associated with the GKE node pool.\\nOne of \\"DEFAULT\\", \\"CONTROLLER\\", \\"SPARK_DRIVER\\" or \\"SPARK_EXECUTOR\\"."', args=[d.arg(name='roles', type=d.T.array)]),
              withRoles(roles): { roles: if std.isArray(v=roles) then roles else [roles] },
              '#withRolesMixin':: d.fn(help='"The roles associated with the GKE node pool.\\nOne of \\"DEFAULT\\", \\"CONTROLLER\\", \\"SPARK_DRIVER\\" or \\"SPARK_EXECUTOR\\"."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='roles', type=d.T.array)]),
              withRolesMixin(roles): { roles+: if std.isArray(v=roles) then roles else [roles] },
            },
            '#withGkeClusterTarget':: d.fn(help='"A target GKE cluster to deploy to. It must be in the same project and region as the Dataproc cluster\\n(the GKE cluster can be zonal or regional)"', args=[d.arg(name='gkeClusterTarget', type=d.T.string)]),
            withGkeClusterTarget(gkeClusterTarget): { spec+: { forProvider+: { virtualClusterConfig+: { kubernetesClusterConfig+: { gkeClusterConfig+: { gkeClusterTarget: gkeClusterTarget } } } } } },
            '#withNodePoolTarget':: d.fn(help='"GKE node pools where workloads will be scheduled. At least one node pool must be assigned the DEFAULT\\nGkeNodePoolTarget.Role. If a GkeNodePoolTarget is not specified, Dataproc constructs a DEFAULT GkeNodePoolTarget.\\nEach role can be given to only one GkeNodePoolTarget. All node pools must have the same location settings."', args=[d.arg(name='nodePoolTarget', type=d.T.array)]),
            withNodePoolTarget(nodePoolTarget): { spec+: { forProvider+: { virtualClusterConfig+: { kubernetesClusterConfig+: { gkeClusterConfig+: { nodePoolTarget: if std.isArray(v=nodePoolTarget) then nodePoolTarget else [nodePoolTarget] } } } } } },
            '#withNodePoolTargetMixin':: d.fn(help='"GKE node pools where workloads will be scheduled. At least one node pool must be assigned the DEFAULT\\nGkeNodePoolTarget.Role. If a GkeNodePoolTarget is not specified, Dataproc constructs a DEFAULT GkeNodePoolTarget.\\nEach role can be given to only one GkeNodePoolTarget. All node pools must have the same location settings."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='nodePoolTarget', type=d.T.array)]),
            withNodePoolTargetMixin(nodePoolTarget): { spec+: { forProvider+: { virtualClusterConfig+: { kubernetesClusterConfig+: { gkeClusterConfig+: { nodePoolTarget+: if std.isArray(v=nodePoolTarget) then nodePoolTarget else [nodePoolTarget] } } } } } },
          },
          '#kubernetesSoftwareConfig':: d.obj(help='"The software configuration for this Dataproc cluster running on Kubernetes."'),
          kubernetesSoftwareConfig: {
            '#withComponentVersion':: d.fn(help='"The components that should be installed in this Dataproc cluster. The key must be a string from the\\nKubernetesComponent enumeration. The value is the version of the software to be installed. At least one entry must be specified."', args=[d.arg(name='componentVersion', type=d.T.object)]),
            withComponentVersion(componentVersion): { spec+: { forProvider+: { virtualClusterConfig+: { kubernetesClusterConfig+: { kubernetesSoftwareConfig+: { componentVersion: componentVersion } } } } } },
            '#withComponentVersionMixin':: d.fn(help='"The components that should be installed in this Dataproc cluster. The key must be a string from the\\nKubernetesComponent enumeration. The value is the version of the software to be installed. At least one entry must be specified."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='componentVersion', type=d.T.object)]),
            withComponentVersionMixin(componentVersion): { spec+: { forProvider+: { virtualClusterConfig+: { kubernetesClusterConfig+: { kubernetesSoftwareConfig+: { componentVersion+: componentVersion } } } } } },
            '#withProperties':: d.fn(help='"The properties to set on daemon config files. Property keys are specified in prefix:property format,\\nfor example spark:spark.kubernetes.container.image."', args=[d.arg(name='properties', type=d.T.object)]),
            withProperties(properties): { spec+: { forProvider+: { virtualClusterConfig+: { kubernetesClusterConfig+: { kubernetesSoftwareConfig+: { properties: properties } } } } } },
            '#withPropertiesMixin':: d.fn(help='"The properties to set on daemon config files. Property keys are specified in prefix:property format,\\nfor example spark:spark.kubernetes.container.image."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='properties', type=d.T.object)]),
            withPropertiesMixin(properties): { spec+: { forProvider+: { virtualClusterConfig+: { kubernetesClusterConfig+: { kubernetesSoftwareConfig+: { properties+: properties } } } } } },
          },
          '#withKubernetesNamespace':: d.fn(help='"A namespace within the Kubernetes cluster to deploy into.\\nIf this namespace does not exist, it is created.\\nIf it  exists, Dataproc verifies that another Dataproc VirtualCluster is not installed into it.\\nIf not specified, the name of the Dataproc Cluster is used."', args=[d.arg(name='kubernetesNamespace', type=d.T.string)]),
          withKubernetesNamespace(kubernetesNamespace): { spec+: { forProvider+: { virtualClusterConfig+: { kubernetesClusterConfig+: { kubernetesNamespace: kubernetesNamespace } } } } },
        },
        '#withStagingBucket':: d.fn(help="\"The Cloud Storage staging bucket used to stage files,\\nsuch as Hadoop jars, between client machines and the cluster.\\nNote: If you don't explicitly specify a staging_bucket\\nthen GCP will auto create / assign one for you. However, you are not guaranteed\\nan auto generated bucket which is solely dedicated to your cluster; it may be shared\\nwith other clusters in the same region/zone also choosing to use the auto generation\\noption.\"", args=[d.arg(name='stagingBucket', type=d.T.string)]),
        withStagingBucket(stagingBucket): { spec+: { forProvider+: { virtualClusterConfig+: { stagingBucket: stagingBucket } } } },
      },
      '#withGracefulDecommissionTimeout':: d.fn(help='"Does not affect auto scaling decomissioning from an autoscaling policy.\\nGraceful decommissioning allows removing nodes from the cluster without interrupting jobs in progress.\\nTimeout specifies how long to wait for jobs in progress to finish before forcefully removing nodes (and potentially interrupting jobs).\\nDefault timeout is 0 (for forceful decommission), and the maximum allowed timeout is 1 day. (see JSON representation of\\nDuration).\\nOnly supported on Dataproc image versions 1.2 and higher.\\nFor more context see the docs"', args=[d.arg(name='gracefulDecommissionTimeout', type=d.T.string)]),
      withGracefulDecommissionTimeout(gracefulDecommissionTimeout): { spec+: { forProvider+: { gracefulDecommissionTimeout: gracefulDecommissionTimeout } } },
      '#withLabels':: d.fn(help='"Note: This field is non-authoritative, and will only manage the labels present in your configuration. Please refer to the field effective_labels for all of the labels present on the resource."', args=[d.arg(name='labels', type=d.T.object)]),
      withLabels(labels): { spec+: { forProvider+: { labels: labels } } },
      '#withLabelsMixin':: d.fn(help='"Note: This field is non-authoritative, and will only manage the labels present in your configuration. Please refer to the field effective_labels for all of the labels present on the resource."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='labels', type=d.T.object)]),
      withLabelsMixin(labels): { spec+: { forProvider+: { labels+: labels } } },
      '#withName':: d.fn(help='"The name of the cluster, unique within the project and\\nzone."', args=[d.arg(name='name', type=d.T.string)]),
      withName(name): { spec+: { forProvider+: { name: name } } },
      '#withProject':: d.fn(help='"The ID of the project in which the cluster will exist. If it\\nis not provided, the provider project is used."', args=[d.arg(name='project', type=d.T.string)]),
      withProject(project): { spec+: { forProvider+: { project: project } } },
      '#withRegion':: d.fn(help='"The region in which the cluster and associated nodes will be created in.\\nDefaults to global."', args=[d.arg(name='region', type=d.T.string)]),
      withRegion(region): { spec+: { forProvider+: { region: region } } },
    },
    '#initProvider':: d.obj(help='"THIS IS A BETA FIELD. It will be honored\\nunless the Management Policies feature flag is disabled.\\nInitProvider holds the same fields as ForProvider, with the exception\\nof Identifier and other resource reference fields. The fields that are\\nin InitProvider are merged into ForProvider when the resource is created.\\nThe same fields are also added to the terraform ignore_changes hook, to\\navoid updating them after creation. This is useful for fields that are\\nrequired on creation, but we do not desire to update them after creation,\\nfor example because of an external controller is managing them, like an\\nautoscaler."'),
    initProvider: {
      '#clusterConfig':: d.obj(help='"Allows you to configure various aspects of the cluster.\\nStructure defined below."'),
      clusterConfig: {
        '#autoscalingConfig':: d.obj(help='"The autoscaling policy config associated with the cluster.\\nNote that once set, if autoscaling_config is the only field set in cluster_config, it can\\nonly be removed by setting policy_uri = \\"\\", rather than removing the whole block.\\nStructure defined below."'),
        autoscalingConfig: {
          '#withPolicyUri':: d.fn(help='"The autoscaling policy used by the cluster."', args=[d.arg(name='policyUri', type=d.T.string)]),
          withPolicyUri(policyUri): { spec+: { initProvider+: { clusterConfig+: { autoscalingConfig+: { policyUri: policyUri } } } } },
        },
        '#auxiliaryNodeGroups':: d.obj(help='"A Dataproc NodeGroup resource is a group of Dataproc cluster nodes that execute an assigned role.\\nStructure defined below."'),
        auxiliaryNodeGroups: {
          '#nodeGroup':: d.obj(help='"Node group configuration."'),
          nodeGroup: {
            '#nodeGroupConfig':: d.obj(help='"The node group instance group configuration."'),
            nodeGroupConfig: {
              '#accelerators':: d.obj(help='"The Compute Engine accelerator configuration for these instances. Can be specified multiple times."'),
              accelerators: {
                '#withAcceleratorCount':: d.fn(help='"The number of the accelerator cards of this type exposed to this instance. Often restricted to one of 1, 2, 4, or 8."', args=[d.arg(name='acceleratorCount', type=d.T.number)]),
                withAcceleratorCount(acceleratorCount): { acceleratorCount: acceleratorCount },
                '#withAcceleratorType':: d.fn(help='"The short name of the accelerator type to expose to this instance. For example, nvidia-tesla-k80."', args=[d.arg(name='acceleratorType', type=d.T.string)]),
                withAcceleratorType(acceleratorType): { acceleratorType: acceleratorType },
              },
              '#diskConfig':: d.obj(help='"Disk Config"'),
              diskConfig: {
                '#withBootDiskSizeGb':: d.fn(help='"Size of the primary disk attached to each node, specified\\nin GB. The primary disk contains the boot volume and system libraries, and the\\nsmallest allowed disk size is 10GB. GCP will default to a predetermined\\ncomputed value if not set (currently 500GB). Note: If SSDs are not\\nattached, it also contains the HDFS data blocks and Hadoop working directories."', args=[d.arg(name='bootDiskSizeGb', type=d.T.number)]),
                withBootDiskSizeGb(bootDiskSizeGb): { nodeGroupConfig+: { diskConfig+: { bootDiskSizeGb: bootDiskSizeGb } } },
                '#withBootDiskType':: d.fn(help='"The disk type of the primary disk attached to each node.\\nOne of \\"pd-ssd\\" or \\"pd-standard\\". Defaults to \\"pd-standard\\"."', args=[d.arg(name='bootDiskType', type=d.T.string)]),
                withBootDiskType(bootDiskType): { nodeGroupConfig+: { diskConfig+: { bootDiskType: bootDiskType } } },
                '#withLocalSsdInterface':: d.fn(help='"Optional. Interface type of local SSDs (default is \\"scsi\\").\\nValid values: \\"scsi\\" (Small Computer System Interface), \\"nvme\\" (Non-Volatile\\nMemory Express). See\\nlocal SSD performance."', args=[d.arg(name='localSsdInterface', type=d.T.string)]),
                withLocalSsdInterface(localSsdInterface): { nodeGroupConfig+: { diskConfig+: { localSsdInterface: localSsdInterface } } },
                '#withNumLocalSsds':: d.fn(help='"The amount of local SSD disks that will be\\nattached to each master cluster node. Defaults to 0."', args=[d.arg(name='numLocalSsds', type=d.T.number)]),
                withNumLocalSsds(numLocalSsds): { nodeGroupConfig+: { diskConfig+: { numLocalSsds: numLocalSsds } } },
