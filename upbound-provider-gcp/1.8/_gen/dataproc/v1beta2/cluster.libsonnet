          '#withMachineType':: d.fn(help='"The name of a Google Compute Engine machine type\\nto create for the master. If not specified, GCP will default to a predetermined\\ncomputed value (currently n1-standard-4)."', args=[d.arg(name='machineType', type=d.T.string)]),
          withMachineType(machineType): { spec+: { initProvider+: { clusterConfig+: { masterConfig+: { machineType: machineType } } } } },
          '#withMinCpuPlatform':: d.fn(help='"The name of a minimum generation of CPU family\\nfor the master. If not specified, GCP will default to a predetermined computed value\\nfor each zone. See the guide\\nfor details about which CPU families are available (and defaulted) for each zone."', args=[d.arg(name='minCpuPlatform', type=d.T.string)]),
          withMinCpuPlatform(minCpuPlatform): { spec+: { initProvider+: { clusterConfig+: { masterConfig+: { minCpuPlatform: minCpuPlatform } } } } },
          '#withNumInstances':: d.fn(help='"Specifies the number of master nodes to create.\\nIf not specified, GCP will default to a predetermined computed value (currently 1)."', args=[d.arg(name='numInstances', type=d.T.number)]),
          withNumInstances(numInstances): { spec+: { initProvider+: { clusterConfig+: { masterConfig+: { numInstances: numInstances } } } } },
        },
