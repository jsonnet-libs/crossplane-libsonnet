            '#withNumLocalSsds':: d.fn(help='"The amount of local SSD disks that will be\\nattached to each master cluster node. Defaults to 0."', args=[d.arg(name='numLocalSsds', type=d.T.number)]),
            withNumLocalSsds(numLocalSsds): { spec+: { initProvider+: { clusterConfig+: { workerConfig+: { diskConfig+: { numLocalSsds: numLocalSsds } } } } } },
