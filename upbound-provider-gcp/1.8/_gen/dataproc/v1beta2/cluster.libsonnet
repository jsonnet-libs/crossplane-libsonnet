            withInstanceSelectionList(instanceSelectionList): { spec+: { initProvider+: { clusterConfig+: { preemptibleWorkerConfig+: { instanceFlexibilityPolicy+: { instanceSelectionList: if std.isArray(v=instanceSelectionList) then instanceSelectionList else [instanceSelectionList] } } } } } },
            '#withInstanceSelectionListMixin':: d.fn(help='"List of instance selection options that the group will use when creating new VMs."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='instanceSelectionList', type=d.T.array)]),
            withInstanceSelectionListMixin(instanceSelectionList): { spec+: { initProvider+: { clusterConfig+: { preemptibleWorkerConfig+: { instanceFlexibilityPolicy+: { instanceSelectionList+: if std.isArray(v=instanceSelectionList) then instanceSelectionList else [instanceSelectionList] } } } } } },
