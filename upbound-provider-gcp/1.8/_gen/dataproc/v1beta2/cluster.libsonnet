          '#diskConfig':: d.obj(help='"Disk Config"'),
          diskConfig: {
            '#withBootDiskSizeGb':: d.fn(help='"Size of the primary disk attached to each node, specified\\nin GB. The primary disk contains the boot volume and system libraries, and the\\nsmallest allowed disk size is 10GB. GCP will default to a predetermined\\ncomputed value if not set (currently 500GB). Note: If SSDs are not\\nattached, it also contains the HDFS data blocks and Hadoop working directories."', args=[d.arg(name='bootDiskSizeGb', type=d.T.number)]),
            withBootDiskSizeGb(bootDiskSizeGb): { spec+: { initProvider+: { clusterConfig+: { preemptibleWorkerConfig+: { diskConfig+: { bootDiskSizeGb: bootDiskSizeGb } } } } } },
            '#withBootDiskType':: d.fn(help='"The disk type of the primary disk attached to each node.\\nOne of \\"pd-ssd\\" or \\"pd-standard\\". Defaults to \\"pd-standard\\"."', args=[d.arg(name='bootDiskType', type=d.T.string)]),
            withBootDiskType(bootDiskType): { spec+: { initProvider+: { clusterConfig+: { preemptibleWorkerConfig+: { diskConfig+: { bootDiskType: bootDiskType } } } } } },
            '#withLocalSsdInterface':: d.fn(help='"Optional. Interface type of local SSDs (default is \\"scsi\\").\\nValid values: \\"scsi\\" (Small Computer System Interface), \\"nvme\\" (Non-Volatile\\nMemory Express). See\\nlocal SSD performance."', args=[d.arg(name='localSsdInterface', type=d.T.string)]),
            withLocalSsdInterface(localSsdInterface): { spec+: { initProvider+: { clusterConfig+: { preemptibleWorkerConfig+: { diskConfig+: { localSsdInterface: localSsdInterface } } } } } },
            '#withNumLocalSsds':: d.fn(help='"The amount of local SSD disks that will be\\nattached to each master cluster node. Defaults to 0."', args=[d.arg(name='numLocalSsds', type=d.T.number)]),
            withNumLocalSsds(numLocalSsds): { spec+: { initProvider+: { clusterConfig+: { preemptibleWorkerConfig+: { diskConfig+: { numLocalSsds: numLocalSsds } } } } } },
