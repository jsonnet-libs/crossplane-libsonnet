              '#withAbort':: d.fn(help='"The specification for how client requests are aborted as part of fault injection. Structure is documented below."', args=[d.arg(name='abort', type=d.T.array)]),
              withAbort(abort): { abort: if std.isArray(v=abort) then abort else [abort] },
              '#withAbortMixin':: d.fn(help='"The specification for how client requests are aborted as part of fault injection. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='abort', type=d.T.array)]),
              withAbortMixin(abort): { abort+: if std.isArray(v=abort) then abort else [abort] },
              '#withDelay':: d.fn(help='"The specification for how client requests are delayed as part of fault injection, before being sent to a backend service. Structure is documented below."', args=[d.arg(name='delay', type=d.T.array)]),
              withDelay(delay): { delay: if std.isArray(v=delay) then delay else [delay] },
