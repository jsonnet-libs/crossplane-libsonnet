            withRequestHeadersToRemove(requestHeadersToRemove): { requestHeadersToRemove: if std.isArray(v=requestHeadersToRemove) then requestHeadersToRemove else [requestHeadersToRemove] },
            '#withRequestHeadersToRemoveMixin':: d.fn(help='"A list of header names for headers that need to be removed from the request prior to forwarding the request to the backendService."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='requestHeadersToRemove', type=d.T.array)]),
            withRequestHeadersToRemoveMixin(requestHeadersToRemove): { requestHeadersToRemove+: if std.isArray(v=requestHeadersToRemove) then requestHeadersToRemove else [requestHeadersToRemove] },
