            '#withWeight':: d.fn(help="\"Specifies the fraction of traffic sent to backendService, computed as weight / (sum of all weightedBackendService weights in routeAction) . The selection of a backend service is determined only for new traffic. Once a user's request has been directed to a backendService, subsequent requests will be sent to the same backendService as determined by the BackendService's session affinity policy. The value must be between 0 and 1000\"", args=[d.arg(name='weight', type=d.T.number)]),
            withWeight(weight): { weight: weight },
          },
          '#withCorsPolicy':: d.fn(help='"The specification for allowing client side cross-origin requests. Please see W3C Recommendation for Cross Origin Resource Sharing Structure is documented below."', args=[d.arg(name='corsPolicy', type=d.T.array)]),
          withCorsPolicy(corsPolicy): { corsPolicy: if std.isArray(v=corsPolicy) then corsPolicy else [corsPolicy] },
          '#withCorsPolicyMixin':: d.fn(help='"The specification for allowing client side cross-origin requests. Please see W3C Recommendation for Cross Origin Resource Sharing Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='corsPolicy', type=d.T.array)]),
          withCorsPolicyMixin(corsPolicy): { corsPolicy+: if std.isArray(v=corsPolicy) then corsPolicy else [corsPolicy] },
          '#withFaultInjectionPolicy':: d.fn(help='"The specification for fault injection introduced into traffic to test the resiliency of clients to backend service failure. As part of fault injection, when clients send requests to a backend service, delays can be introduced by Loadbalancer on a percentage of requests before sending those request to the backend service. Similarly requests from clients can be aborted by the Loadbalancer for a percentage of requests. timeout and retry_policy will be ignored by clients that are configured with a fault_injection_policy. Structure is documented below."', args=[d.arg(name='faultInjectionPolicy', type=d.T.array)]),
          withFaultInjectionPolicy(faultInjectionPolicy): { faultInjectionPolicy: if std.isArray(v=faultInjectionPolicy) then faultInjectionPolicy else [faultInjectionPolicy] },
          '#withFaultInjectionPolicyMixin':: d.fn(help='"The specification for fault injection introduced into traffic to test the resiliency of clients to backend service failure. As part of fault injection, when clients send requests to a backend service, delays can be introduced by Loadbalancer on a percentage of requests before sending those request to the backend service. Similarly requests from clients can be aborted by the Loadbalancer for a percentage of requests. timeout and retry_policy will be ignored by clients that are configured with a fault_injection_policy. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='faultInjectionPolicy', type=d.T.array)]),
          withFaultInjectionPolicyMixin(faultInjectionPolicy): { faultInjectionPolicy+: if std.isArray(v=faultInjectionPolicy) then faultInjectionPolicy else [faultInjectionPolicy] },
          '#withRequestMirrorPolicy':: d.fn(help="\"Specifies the policy on how requests intended for the route's backends are shadowed to a separate mirrored backend service. Loadbalancer does not wait for responses from the shadow service. Prior to sending traffic to the shadow service, the host / authority header is suffixed with -shadow. Structure is documented below.\"", args=[d.arg(name='requestMirrorPolicy', type=d.T.array)]),
          withRequestMirrorPolicy(requestMirrorPolicy): { requestMirrorPolicy: if std.isArray(v=requestMirrorPolicy) then requestMirrorPolicy else [requestMirrorPolicy] },
          '#withRequestMirrorPolicyMixin':: d.fn(help="\"Specifies the policy on how requests intended for the route's backends are shadowed to a separate mirrored backend service. Loadbalancer does not wait for responses from the shadow service. Prior to sending traffic to the shadow service, the host / authority header is suffixed with -shadow. Structure is documented below.\"\n\n**Note:** This function appends passed data to existing values", args=[d.arg(name='requestMirrorPolicy', type=d.T.array)]),
          withRequestMirrorPolicyMixin(requestMirrorPolicy): { requestMirrorPolicy+: if std.isArray(v=requestMirrorPolicy) then requestMirrorPolicy else [requestMirrorPolicy] },
          '#withRetryPolicy':: d.fn(help='"Specifies the retry policy associated with this route. Structure is documented below."', args=[d.arg(name='retryPolicy', type=d.T.array)]),
          withRetryPolicy(retryPolicy): { retryPolicy: if std.isArray(v=retryPolicy) then retryPolicy else [retryPolicy] },
          '#withRetryPolicyMixin':: d.fn(help='"Specifies the retry policy associated with this route. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='retryPolicy', type=d.T.array)]),
          withRetryPolicyMixin(retryPolicy): { retryPolicy+: if std.isArray(v=retryPolicy) then retryPolicy else [retryPolicy] },
          '#withTimeout':: d.fn(help='"Specifies the timeout for the selected route. Timeout is computed from the time the request is has been fully processed (i.e. end-of-stream) up until the response has been completely processed. Timeout includes all retries. If not specified, the default value is 15 seconds. Structure is documented below."', args=[d.arg(name='timeout', type=d.T.array)]),
          withTimeout(timeout): { timeout: if std.isArray(v=timeout) then timeout else [timeout] },
          '#withTimeoutMixin':: d.fn(help='"Specifies the timeout for the selected route. Timeout is computed from the time the request is has been fully processed (i.e. end-of-stream) up until the response has been completely processed. Timeout includes all retries. If not specified, the default value is 15 seconds. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='timeout', type=d.T.array)]),
