              withAllowMethods(allowMethods): { allowMethods: if std.isArray(v=allowMethods) then allowMethods else [allowMethods] },
              '#withAllowMethodsMixin':: d.fn(help='"Specifies the content for the Access-Control-Allow-Methods header."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='allowMethods', type=d.T.array)]),
              withAllowMethodsMixin(allowMethods): { allowMethods+: if std.isArray(v=allowMethods) then allowMethods else [allowMethods] },
              '#withAllowOriginRegexes':: d.fn(help='"Specifies the regular expression patterns that match allowed origins. For regular expression grammar please see en.cppreference.com/w/cpp/regex/ecmascript An origin is allowed if it matches either allow_origins or allow_origin_regex."', args=[d.arg(name='allowOriginRegexes', type=d.T.array)]),
              withAllowOriginRegexes(allowOriginRegexes): { allowOriginRegexes: if std.isArray(v=allowOriginRegexes) then allowOriginRegexes else [allowOriginRegexes] },
