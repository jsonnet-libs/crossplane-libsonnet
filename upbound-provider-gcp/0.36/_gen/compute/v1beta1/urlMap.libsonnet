                  '#withReplace':: d.fn(help='"If false, headerValue is appended to any values that already exist for the header. If true, headerValue is set for the header, discarding any values that were set for that header."', args=[d.arg(name='replace', type=d.T.boolean)]),
                  withReplace(replace): { replace: replace },
