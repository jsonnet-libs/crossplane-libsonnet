              '#withAllowCredentials':: d.fn(help='"In response to a preflight request, setting this to true indicates that the actual request can include user credentials. This translates to the Access- Control-Allow-Credentials header. Defaults to false."', args=[d.arg(name='allowCredentials', type=d.T.boolean)]),
              withAllowCredentials(allowCredentials): { allowCredentials: allowCredentials },
              '#withAllowHeaders':: d.fn(help='"Specifies the content for the Access-Control-Allow-Headers header."', args=[d.arg(name='allowHeaders', type=d.T.array)]),
              withAllowHeaders(allowHeaders): { allowHeaders: if std.isArray(v=allowHeaders) then allowHeaders else [allowHeaders] },
              '#withAllowHeadersMixin':: d.fn(help='"Specifies the content for the Access-Control-Allow-Headers header."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='allowHeaders', type=d.T.array)]),
              withAllowHeadersMixin(allowHeaders): { allowHeaders+: if std.isArray(v=allowHeaders) then allowHeaders else [allowHeaders] },
              '#withAllowMethods':: d.fn(help='"Specifies the content for the Access-Control-Allow-Methods header."', args=[d.arg(name='allowMethods', type=d.T.array)]),
              withAllowMethods(allowMethods): { allowMethods: if std.isArray(v=allowMethods) then allowMethods else [allowMethods] },
              '#withAllowMethodsMixin':: d.fn(help='"Specifies the content for the Access-Control-Allow-Methods header."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='allowMethods', type=d.T.array)]),
              withAllowMethodsMixin(allowMethods): { allowMethods+: if std.isArray(v=allowMethods) then allowMethods else [allowMethods] },
              '#withAllowOriginRegexes':: d.fn(help='"Specifies the regular expression patterns that match allowed origins. For regular expression grammar please see en.cppreference.com/w/cpp/regex/ecmascript An origin is allowed if it matches either allow_origins or allow_origin_regex."', args=[d.arg(name='allowOriginRegexes', type=d.T.array)]),
              withAllowOriginRegexes(allowOriginRegexes): { allowOriginRegexes: if std.isArray(v=allowOriginRegexes) then allowOriginRegexes else [allowOriginRegexes] },
              '#withAllowOriginRegexesMixin':: d.fn(help='"Specifies the regular expression patterns that match allowed origins. For regular expression grammar please see en.cppreference.com/w/cpp/regex/ecmascript An origin is allowed if it matches either allow_origins or allow_origin_regex."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='allowOriginRegexes', type=d.T.array)]),
              withAllowOriginRegexesMixin(allowOriginRegexes): { allowOriginRegexes+: if std.isArray(v=allowOriginRegexes) then allowOriginRegexes else [allowOriginRegexes] },
              '#withAllowOrigins':: d.fn(help='"Specifies the list of origins that will be allowed to do CORS requests. An origin is allowed if it matches either allow_origins or allow_origin_regex."', args=[d.arg(name='allowOrigins', type=d.T.array)]),
