            '#withResponseHeadersToAddMixin':: d.fn(help='"Headers to add the response prior to sending the response back to the client. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='responseHeadersToAdd', type=d.T.array)]),
