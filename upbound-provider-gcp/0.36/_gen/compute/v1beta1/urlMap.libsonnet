          withUrlRewrite(urlRewrite): { urlRewrite: if std.isArray(v=urlRewrite) then urlRewrite else [urlRewrite] },
          '#withUrlRewriteMixin':: d.fn(help='"The spec to modify the URL of the request, prior to forwarding the request to the matched service Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='urlRewrite', type=d.T.array)]),
          withUrlRewriteMixin(urlRewrite): { urlRewrite+: if std.isArray(v=urlRewrite) then urlRewrite else [urlRewrite] },
          '#withWeightedBackendServices':: d.fn(help='"A list of weighted backend services to send traffic to when a route match occurs. The weights determine the fraction of traffic that flows to their corresponding backend service. If all traffic needs to go to a single backend service, there must be one  weightedBackendService with weight set to a non 0 number. Once a backendService is identified and before forwarding the request to the backend service, advanced routing actions like Url rewrites and header transformations are applied depending on additional settings specified in this HttpRouteAction. Structure is documented below."', args=[d.arg(name='weightedBackendServices', type=d.T.array)]),
          withWeightedBackendServices(weightedBackendServices): { weightedBackendServices: if std.isArray(v=weightedBackendServices) then weightedBackendServices else [weightedBackendServices] },
          '#withWeightedBackendServicesMixin':: d.fn(help='"A list of weighted backend services to send traffic to when a route match occurs. The weights determine the fraction of traffic that flows to their corresponding backend service. If all traffic needs to go to a single backend service, there must be one  weightedBackendService with weight set to a non 0 number. Once a backendService is identified and before forwarding the request to the backend service, advanced routing actions like Url rewrites and header transformations are applied depending on additional settings specified in this HttpRouteAction. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='weightedBackendServices', type=d.T.array)]),
          withWeightedBackendServicesMixin(weightedBackendServices): { weightedBackendServices+: if std.isArray(v=weightedBackendServices) then weightedBackendServices else [weightedBackendServices] },
