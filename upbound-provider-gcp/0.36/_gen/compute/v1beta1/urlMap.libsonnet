            withStripQuery(stripQuery): { stripQuery: stripQuery },
          },
          '#withPaths':: d.fn(help='"The list of path patterns to match. Each must start with / and the only place a * is allowed is at the end following a /. The string fed to the path matcher does not include any text after the first ? or #, and those chars are not allowed here."', args=[d.arg(name='paths', type=d.T.array)]),
