            withFixedDelay(fixedDelay): { fixedDelay: if std.isArray(v=fixedDelay) then fixedDelay else [fixedDelay] },
            '#withFixedDelayMixin':: d.fn(help='"Specifies the value of the fixed delay interval. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='fixedDelay', type=d.T.array)]),
            withFixedDelayMixin(fixedDelay): { fixedDelay+: if std.isArray(v=fixedDelay) then fixedDelay else [fixedDelay] },
            '#withPercentage':: d.fn(help='"The percentage of traffic (connections/operations/requests) on which delay will be introduced as part of fault injection. The value must be between 0.0 and 100.0 inclusive."', args=[d.arg(name='percentage', type=d.T.number)]),
            withPercentage(percentage): { percentage: percentage },
