          withStripQuery(stripQuery): { stripQuery: stripQuery },
        },
        '#headerAction':: d.obj(help='"Specifies changes to request and response headers that need to take effect for the selected backendService. HeaderAction specified here are applied after the matching HttpRouteRule HeaderAction and before the HeaderAction in the UrlMap Structure is documented below."'),
