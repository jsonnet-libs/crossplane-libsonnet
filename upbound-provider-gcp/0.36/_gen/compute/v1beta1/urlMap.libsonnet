              withFilterLabelsMixin(filterLabels): { filterLabels+: if std.isArray(v=filterLabels) then filterLabels else [filterLabels] },
              '#withFilterMatchCriteria':: d.fn(help='"Specifies how individual filterLabel matches within the list of filterLabels contribute towards the overall metadataFilter match. Supported values are:"', args=[d.arg(name='filterMatchCriteria', type=d.T.string)]),
              withFilterMatchCriteria(filterMatchCriteria): { filterMatchCriteria: filterMatchCriteria },
            },
            '#queryParameterMatches':: d.obj(help='"Specifies a list of query parameter match criteria, all of which must match corresponding query parameters in the request. Structure is documented below."'),
