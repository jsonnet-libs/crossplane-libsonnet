          '#withHostRedirect':: d.fn(help='"The host that will be used in the redirect response instead of the one that was supplied in the request. The value must be between 1 and 255 characters."', args=[d.arg(name='hostRedirect', type=d.T.string)]),
          withHostRedirect(hostRedirect): { hostRedirect: hostRedirect },
          '#withHttpsRedirect':: d.fn(help='"If set to true, the URL scheme in the redirected request is set to https. If set to false, the URL scheme of the redirected request will remain the same as that of the request. This must only be set for UrlMaps used in TargetHttpProxys. Setting this true for TargetHttpsProxy is not permitted. The default is set to false."', args=[d.arg(name='httpsRedirect', type=d.T.boolean)]),
          withHttpsRedirect(httpsRedirect): { httpsRedirect: httpsRedirect },
          '#withPathRedirect':: d.fn(help='"The path that will be used in the redirect response instead of the one that was supplied in the request. pathRedirect cannot be supplied together with prefixRedirect. Supply one alone or neither. If neither is supplied, the path of the original request will be used for the redirect. The value must be between 1 and 1024 characters."', args=[d.arg(name='pathRedirect', type=d.T.string)]),
          withPathRedirect(pathRedirect): { pathRedirect: pathRedirect },
          '#withPrefixRedirect':: d.fn(help='"The prefix that replaces the prefixMatch specified in the HttpRouteRuleMatch, retaining the remaining portion of the URL before redirecting the request. prefixRedirect cannot be supplied together with pathRedirect. Supply one alone or neither. If neither is supplied, the path of the original request will be used for the redirect. The value must be between 1 and 1024 characters."', args=[d.arg(name='prefixRedirect', type=d.T.string)]),
          withPrefixRedirect(prefixRedirect): { prefixRedirect: prefixRedirect },
          '#withRedirectResponseCode':: d.fn(help='"The HTTP Status code to use for this RedirectAction. Supported values are:"', args=[d.arg(name='redirectResponseCode', type=d.T.string)]),
          withRedirectResponseCode(redirectResponseCode): { redirectResponseCode: redirectResponseCode },
