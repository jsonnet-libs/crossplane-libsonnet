            withIgnoreCase(ignoreCase): { ignoreCase: ignoreCase },
            '#withMetadataFilters':: d.fn(help='"Opaque filter criteria used by Loadbalancer to restrict routing configuration to a limited set xDS compliant clients. In their xDS requests to Loadbalancer, xDS clients present node metadata. If a match takes place, the relevant routing configuration is made available to those proxies. For each metadataFilter in this list, if its filterMatchCriteria is set to MATCH_ANY, at least one of the filterLabels must match the corresponding label provided in the metadata. If its filterMatchCriteria is set to MATCH_ALL, then all of its filterLabels must match with corresponding labels in the provided metadata. metadataFilters specified here can be overrides those specified in ForwardingRule that refers to this UrlMap. metadataFilters only applies to Loadbalancers that have their loadBalancingScheme set to INTERNAL_SELF_MANAGED. Structure is documented below."', args=[d.arg(name='metadataFilters', type=d.T.array)]),
            withMetadataFilters(metadataFilters): { metadataFilters: if std.isArray(v=metadataFilters) then metadataFilters else [metadataFilters] },
            '#withMetadataFiltersMixin':: d.fn(help='"Opaque filter criteria used by Loadbalancer to restrict routing configuration to a limited set xDS compliant clients. In their xDS requests to Loadbalancer, xDS clients present node metadata. If a match takes place, the relevant routing configuration is made available to those proxies. For each metadataFilter in this list, if its filterMatchCriteria is set to MATCH_ANY, at least one of the filterLabels must match the corresponding label provided in the metadata. If its filterMatchCriteria is set to MATCH_ALL, then all of its filterLabels must match with corresponding labels in the provided metadata. metadataFilters specified here can be overrides those specified in ForwardingRule that refers to this UrlMap. metadataFilters only applies to Loadbalancers that have their loadBalancingScheme set to INTERNAL_SELF_MANAGED. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='metadataFilters', type=d.T.array)]),
            withMetadataFiltersMixin(metadataFilters): { metadataFilters+: if std.isArray(v=metadataFilters) then metadataFilters else [metadataFilters] },
            '#withPrefixMatch':: d.fn(help="\"For satisfying the matchRule condition, the request's path must begin with the specified prefixMatch. prefixMatch must begin with a /. The value must be between 1 and 1024 characters. Only one of prefixMatch, fullPathMatch or regexMatch must be specified.\"", args=[d.arg(name='prefixMatch', type=d.T.string)]),
            withPrefixMatch(prefixMatch): { prefixMatch: prefixMatch },
            '#withQueryParameterMatches':: d.fn(help='"Specifies a list of query parameter match criteria, all of which must match corresponding query parameters in the request. Structure is documented below."', args=[d.arg(name='queryParameterMatches', type=d.T.array)]),
            withQueryParameterMatches(queryParameterMatches): { queryParameterMatches: if std.isArray(v=queryParameterMatches) then queryParameterMatches else [queryParameterMatches] },
