              '#withAllowOrigins':: d.fn(help='"Specifies the list of origins that will be allowed to do CORS requests. An origin is allowed if it matches either allow_origins or allow_origin_regex."', args=[d.arg(name='allowOrigins', type=d.T.array)]),
              withAllowOrigins(allowOrigins): { allowOrigins: if std.isArray(v=allowOrigins) then allowOrigins else [allowOrigins] },
