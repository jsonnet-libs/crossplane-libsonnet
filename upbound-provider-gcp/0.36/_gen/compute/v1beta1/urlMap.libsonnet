          withPathsMixin(paths): { paths+: if std.isArray(v=paths) then paths else [paths] },
          '#withRouteAction':: d.fn(help='"In response to a matching matchRule, the load balancer performs advanced routing actions like URL rewrites, header transformations, etc. prior to forwarding the request to the selected backend. If  routeAction specifies any weightedBackendServices, service must not be set. Conversely if service is set, routeAction cannot contain any  weightedBackendServices. Only one of routeAction or urlRedirect must be set. Structure is documented below."', args=[d.arg(name='routeAction', type=d.T.array)]),
          withRouteAction(routeAction): { routeAction: if std.isArray(v=routeAction) then routeAction else [routeAction] },
          '#withRouteActionMixin':: d.fn(help='"In response to a matching matchRule, the load balancer performs advanced routing actions like URL rewrites, header transformations, etc. prior to forwarding the request to the selected backend. If  routeAction specifies any weightedBackendServices, service must not be set. Conversely if service is set, routeAction cannot contain any  weightedBackendServices. Only one of routeAction or urlRedirect must be set. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='routeAction', type=d.T.array)]),
          withRouteActionMixin(routeAction): { routeAction+: if std.isArray(v=routeAction) then routeAction else [routeAction] },
