                withResponseHeadersToRemove(responseHeadersToRemove): { responseHeadersToRemove: if std.isArray(v=responseHeadersToRemove) then responseHeadersToRemove else [responseHeadersToRemove] },
                '#withResponseHeadersToRemoveMixin':: d.fn(help='"A list of header names for headers that need to be removed from the response prior to sending the response back to the client."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='responseHeadersToRemove', type=d.T.array)]),
                withResponseHeadersToRemoveMixin(responseHeadersToRemove): { responseHeadersToRemove+: if std.isArray(v=responseHeadersToRemove) then responseHeadersToRemove else [responseHeadersToRemove] },
              },
              '#withBackendService':: d.fn(help='"The default BackendService resource. Before forwarding the request to backendService, the loadbalancer applies any relevant headerActions specified as part of this backendServiceWeight."', args=[d.arg(name='backendService', type=d.T.string)]),
              withBackendService(backendService): { backendService: backendService },
              '#withHeaderAction':: d.fn(help='"Specifies changes to request and response headers that need to take effect for the selected backendService. headerAction specified here take effect before headerAction in the enclosing HttpRouteRule, PathMatcher and UrlMap. Structure is documented below."', args=[d.arg(name='headerAction', type=d.T.array)]),
              withHeaderAction(headerAction): { headerAction: if std.isArray(v=headerAction) then headerAction else [headerAction] },
              '#withHeaderActionMixin':: d.fn(help='"Specifies changes to request and response headers that need to take effect for the selected backendService. headerAction specified here take effect before headerAction in the enclosing HttpRouteRule, PathMatcher and UrlMap. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='headerAction', type=d.T.array)]),
              withHeaderActionMixin(headerAction): { headerAction+: if std.isArray(v=headerAction) then headerAction else [headerAction] },
              '#withWeight':: d.fn(help="\"Specifies the fraction of traffic sent to backendService, computed as weight / (sum of all weightedBackendService weights in routeAction) . The selection of a backend service is determined only for new traffic. Once a user's request has been directed to a backendService, subsequent requests will be sent to the same backendService as determined by the BackendService's session affinity policy. The value must be between 0 and 1000\"", args=[d.arg(name='weight', type=d.T.number)]),
              withWeight(weight): { weight: weight },
