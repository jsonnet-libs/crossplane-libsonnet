      '#withIpProtocol':: d.fn(help='"The IP protocol to which this rule applies. For protocol forwarding, valid options are TCP, UDP, ESP, AH, SCTP, ICMP and L3_DEFAULT. The valid IP protocols are different for different load balancing products as described in Load balancing features. Possible values are: TCP, UDP, ESP, AH, SCTP, ICMP."', args=[d.arg(name='ipProtocol', type=d.T.string)]),
      withIpProtocol(ipProtocol): { spec+: { forProvider+: { ipProtocol: ipProtocol } } },
      '#withIpVersion':: d.fn(help='"The IP Version that will be used by this global forwarding rule. Possible values are: IPV4, IPV6."', args=[d.arg(name='ipVersion', type=d.T.string)]),
      withIpVersion(ipVersion): { spec+: { forProvider+: { ipVersion: ipVersion } } },
      '#withLabels':: d.fn(help='"Labels to apply to this forwarding rule.  A list of key->value pairs."', args=[d.arg(name='labels', type=d.T.object)]),
      withLabels(labels): { spec+: { forProvider+: { labels: labels } } },
      '#withLabelsMixin':: d.fn(help='"Labels to apply to this forwarding rule.  A list of key->value pairs."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='labels', type=d.T.object)]),
      withLabelsMixin(labels): { spec+: { forProvider+: { labels+: labels } } },
      '#withLoadBalancingScheme':: d.fn(help='"Specifies the forwarding rule type. For more information about forwarding rules, refer to Forwarding rule concepts. Default value is EXTERNAL. Possible values are: EXTERNAL, EXTERNAL_MANAGED, INTERNAL_SELF_MANAGED."', args=[d.arg(name='loadBalancingScheme', type=d.T.string)]),
      withLoadBalancingScheme(loadBalancingScheme): { spec+: { forProvider+: { loadBalancingScheme: loadBalancingScheme } } },
      '#withMetadataFilters':: d.fn(help='"Opaque filter criteria used by Loadbalancer to restrict routing configuration to a limited set xDS compliant clients. In their xDS requests to Loadbalancer, xDS clients present node metadata. If a match takes place, the relevant routing configuration is made available to those proxies. For each metadataFilter in this list, if its filterMatchCriteria is set to MATCH_ANY, at least one of the filterLabels must match the corresponding label provided in the metadata. If its filterMatchCriteria is set to MATCH_ALL, then all of its filterLabels must match with corresponding labels in the provided metadata. metadataFilters specified here can be overridden by those specified in the UrlMap that this ForwardingRule references. metadataFilters only applies to Loadbalancers that have their loadBalancingScheme set to INTERNAL_SELF_MANAGED. Structure is documented below."', args=[d.arg(name='metadataFilters', type=d.T.array)]),
      withMetadataFilters(metadataFilters): { spec+: { forProvider+: { metadataFilters: if std.isArray(v=metadataFilters) then metadataFilters else [metadataFilters] } } },
      '#withMetadataFiltersMixin':: d.fn(help='"Opaque filter criteria used by Loadbalancer to restrict routing configuration to a limited set xDS compliant clients. In their xDS requests to Loadbalancer, xDS clients present node metadata. If a match takes place, the relevant routing configuration is made available to those proxies. For each metadataFilter in this list, if its filterMatchCriteria is set to MATCH_ANY, at least one of the filterLabels must match the corresponding label provided in the metadata. If its filterMatchCriteria is set to MATCH_ALL, then all of its filterLabels must match with corresponding labels in the provided metadata. metadataFilters specified here can be overridden by those specified in the UrlMap that this ForwardingRule references. metadataFilters only applies to Loadbalancers that have their loadBalancingScheme set to INTERNAL_SELF_MANAGED. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='metadataFilters', type=d.T.array)]),
      withMetadataFiltersMixin(metadataFilters): { spec+: { forProvider+: { metadataFilters+: if std.isArray(v=metadataFilters) then metadataFilters else [metadataFilters] } } },
      '#withNetwork':: d.fn(help='"This field is not used for external load balancing. For Internal TCP/UDP Load Balancing, this field identifies the network that the load balanced IP should belong to for this Forwarding Rule. If the subnetwork is specified, the network of the subnetwork will be used. If neither subnetwork nor this field is specified, the default network will be used. For Private Service Connect forwarding rules that forward traffic to Google APIs, a network must be provided."', args=[d.arg(name='network', type=d.T.string)]),
      withNetwork(network): { spec+: { forProvider+: { network: network } } },
      '#withPortRange':: d.fn(help='"This field can only be used:"', args=[d.arg(name='portRange', type=d.T.string)]),
      withPortRange(portRange): { spec+: { forProvider+: { portRange: portRange } } },
      '#withProject':: d.fn(help='"The ID of the project in which the resource belongs. If it is not provided, the provider project is used."', args=[d.arg(name='project', type=d.T.string)]),
