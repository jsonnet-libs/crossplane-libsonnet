        '#withCustomPolicyMixin':: d.fn(help='"The configuration for a custom policy implemented by the user and deployed with the client. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='customPolicy', type=d.T.array)]),
        withCustomPolicyMixin(customPolicy): { customPolicy+: if std.isArray(v=customPolicy) then customPolicy else [customPolicy] },
        '#withPolicy':: d.fn(help='"The configuration for a built-in load balancing policy. Structure is documented below."', args=[d.arg(name='policy', type=d.T.array)]),
