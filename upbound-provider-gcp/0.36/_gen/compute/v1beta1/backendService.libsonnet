        '#negativeCachingPolicy':: d.obj(help="\"Sets a cache TTL for the specified HTTP status code. negativeCaching must be enabled to configure negativeCachingPolicy. Omitting the policy and leaving negativeCaching enabled will use Cloud CDN's default cache TTLs. Structure is documented below.\""),
        negativeCachingPolicy: {
          '#withCode':: d.fn(help='"The HTTP status code to define a TTL against. Only HTTP status codes 300, 301, 308, 404, 405, 410, 421, 451 and 501 can be specified as values, and you cannot specify a status code more than once."', args=[d.arg(name='code', type=d.T.number)]),
          withCode(code): { code: code },
          '#withTtl':: d.fn(help='"The TTL (in seconds) for which to cache responses with the corresponding status code. The maximum allowed value is 1800s (30 minutes), noting that infrequently accessed objects may be evicted from the cache before the defined TTL."', args=[d.arg(name='ttl', type=d.T.number)]),
          withTtl(ttl): { ttl: ttl },
        },
        '#withBypassCacheOnRequestHeaders':: d.fn(help='"Bypass the cache when the specified request headers are matched - e.g. Pragma or Authorization headers. Up to 5 headers can be specified. The cache is bypassed for all cdnPolicy.cacheMode settings. Structure is documented below."', args=[d.arg(name='bypassCacheOnRequestHeaders', type=d.T.array)]),
        withBypassCacheOnRequestHeaders(bypassCacheOnRequestHeaders): { bypassCacheOnRequestHeaders: if std.isArray(v=bypassCacheOnRequestHeaders) then bypassCacheOnRequestHeaders else [bypassCacheOnRequestHeaders] },
        '#withBypassCacheOnRequestHeadersMixin':: d.fn(help='"Bypass the cache when the specified request headers are matched - e.g. Pragma or Authorization headers. Up to 5 headers can be specified. The cache is bypassed for all cdnPolicy.cacheMode settings. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='bypassCacheOnRequestHeaders', type=d.T.array)]),
        withBypassCacheOnRequestHeadersMixin(bypassCacheOnRequestHeaders): { bypassCacheOnRequestHeaders+: if std.isArray(v=bypassCacheOnRequestHeaders) then bypassCacheOnRequestHeaders else [bypassCacheOnRequestHeaders] },
        '#withCacheKeyPolicy':: d.fn(help='"The CacheKeyPolicy for this CdnPolicy. Structure is documented below."', args=[d.arg(name='cacheKeyPolicy', type=d.T.array)]),
        withCacheKeyPolicy(cacheKeyPolicy): { cacheKeyPolicy: if std.isArray(v=cacheKeyPolicy) then cacheKeyPolicy else [cacheKeyPolicy] },
        '#withCacheKeyPolicyMixin':: d.fn(help='"The CacheKeyPolicy for this CdnPolicy. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='cacheKeyPolicy', type=d.T.array)]),
        withCacheKeyPolicyMixin(cacheKeyPolicy): { cacheKeyPolicy+: if std.isArray(v=cacheKeyPolicy) then cacheKeyPolicy else [cacheKeyPolicy] },
        '#withCacheMode':: d.fn(help='"Specifies the cache setting for all responses from this backend. The possible values are: USE_ORIGIN_HEADERS, FORCE_CACHE_ALL and CACHE_ALL_STATIC Possible values are: USE_ORIGIN_HEADERS, FORCE_CACHE_ALL, CACHE_ALL_STATIC."', args=[d.arg(name='cacheMode', type=d.T.string)]),
        withCacheMode(cacheMode): { cacheMode: cacheMode },
