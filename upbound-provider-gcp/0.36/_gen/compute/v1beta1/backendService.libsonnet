        '#bypassCacheOnRequestHeaders':: d.obj(help='"Bypass the cache when the specified request headers are matched - e.g. Pragma or Authorization headers. Up to 5 headers can be specified. The cache is bypassed for all cdnPolicy.cacheMode settings. Structure is documented below."'),
        bypassCacheOnRequestHeaders: {
          '#withHeaderName':: d.fn(help='"The header field name to match on when bypassing cache. Values are case-insensitive."', args=[d.arg(name='headerName', type=d.T.string)]),
