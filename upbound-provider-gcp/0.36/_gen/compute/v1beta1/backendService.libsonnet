        withPolicyMixin(policy): { policy+: if std.isArray(v=policy) then policy else [policy] },
      },
      '#logConfig':: d.obj(help='"This field denotes the logging options for the load balancer traffic served by this backend service. If logging is enabled, logs will be exported to Stackdriver. Structure is documented below."'),
      logConfig: {
        '#withEnable':: d.fn(help='"Whether to enable logging for the load balancer traffic served by this backend service."', args=[d.arg(name='enable', type=d.T.boolean)]),
        withEnable(enable): { enable: enable },
        '#withSampleRate':: d.fn(help='"This field can only be specified if logging is enabled for this backend service. The value of the field must be in [0, 1]. This configures the sampling rate of requests to the load balancer where 1.0 means all logged requests are reported and 0.0 means no logged requests are reported. The default value is 1.0."', args=[d.arg(name='sampleRate', type=d.T.number)]),
        withSampleRate(sampleRate): { sampleRate: sampleRate },
      },
      '#outlierDetection':: d.obj(help='"Settings controlling eviction of unhealthy hosts from the load balancing pool. This field is applicable only when the load_balancing_scheme is set to INTERNAL_SELF_MANAGED. Structure is documented below."'),
      outlierDetection: {
        '#baseEjectionTime':: d.obj(help='"The base time that a host is ejected for. The real time is equal to the base time multiplied by the number of times the host has been ejected. Defaults to 30000ms or 30s. Structure is documented below."'),
        baseEjectionTime: {
          '#withNanos':: d.fn(help="\"Span of time that's a fraction of a second at nanosecond resolution. Durations less than one second are represented with a 0 seconds field and a positive nanos field. Must be from 0 to 999,999,999 inclusive.\"", args=[d.arg(name='nanos', type=d.T.number)]),
          withNanos(nanos): { nanos: nanos },
          '#withSeconds':: d.fn(help='"Span of time at a resolution of a second. Must be from 0 to 315,576,000,000 inclusive."', args=[d.arg(name='seconds', type=d.T.number)]),
          withSeconds(seconds): { seconds: seconds },
        },
        '#interval':: d.obj(help='"Time interval between ejection sweep analysis. This can result in both new ejections as well as hosts being returned to service. Defaults to 10 seconds. Structure is documented below."'),
        interval: {
          '#withNanos':: d.fn(help="\"Span of time that's a fraction of a second at nanosecond resolution. Durations less than one second are represented with a 0 seconds field and a positive nanos field. Must be from 0 to 999,999,999 inclusive.\"", args=[d.arg(name='nanos', type=d.T.number)]),
          withNanos(nanos): { nanos: nanos },
          '#withSeconds':: d.fn(help='"Span of time at a resolution of a second. Must be from 0 to 315,576,000,000 inclusive."', args=[d.arg(name='seconds', type=d.T.number)]),
          withSeconds(seconds): { seconds: seconds },
        },
        '#withBaseEjectionTime':: d.fn(help='"The base time that a host is ejected for. The real time is equal to the base time multiplied by the number of times the host has been ejected. Defaults to 30000ms or 30s. Structure is documented below."', args=[d.arg(name='baseEjectionTime', type=d.T.array)]),
        withBaseEjectionTime(baseEjectionTime): { baseEjectionTime: if std.isArray(v=baseEjectionTime) then baseEjectionTime else [baseEjectionTime] },
        '#withBaseEjectionTimeMixin':: d.fn(help='"The base time that a host is ejected for. The real time is equal to the base time multiplied by the number of times the host has been ejected. Defaults to 30000ms or 30s. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='baseEjectionTime', type=d.T.array)]),
        withBaseEjectionTimeMixin(baseEjectionTime): { baseEjectionTime+: if std.isArray(v=baseEjectionTime) then baseEjectionTime else [baseEjectionTime] },
        '#withConsecutiveErrors':: d.fn(help='"Number of errors before a host is ejected from the connection pool. When the backend host is accessed over HTTP, a 5xx return code qualifies as an error. Defaults to 5."', args=[d.arg(name='consecutiveErrors', type=d.T.number)]),
        withConsecutiveErrors(consecutiveErrors): { consecutiveErrors: consecutiveErrors },
        '#withConsecutiveGatewayFailure':: d.fn(help='"The number of consecutive gateway failures (502, 503, 504 status or connection errors that are mapped to one of those status codes) before a consecutive gateway failure ejection occurs. Defaults to 5."', args=[d.arg(name='consecutiveGatewayFailure', type=d.T.number)]),
        withConsecutiveGatewayFailure(consecutiveGatewayFailure): { consecutiveGatewayFailure: consecutiveGatewayFailure },
        '#withEnforcingConsecutiveErrors':: d.fn(help='"The percentage chance that a host will be actually ejected when an outlier status is detected through consecutive 5xx. This setting can be used to disable ejection or to ramp it up slowly. Defaults to 100."', args=[d.arg(name='enforcingConsecutiveErrors', type=d.T.number)]),
        withEnforcingConsecutiveErrors(enforcingConsecutiveErrors): { enforcingConsecutiveErrors: enforcingConsecutiveErrors },
        '#withEnforcingConsecutiveGatewayFailure':: d.fn(help='"The percentage chance that a host will be actually ejected when an outlier status is detected through consecutive gateway failures. This setting can be used to disable ejection or to ramp it up slowly. Defaults to 0."', args=[d.arg(name='enforcingConsecutiveGatewayFailure', type=d.T.number)]),
        withEnforcingConsecutiveGatewayFailure(enforcingConsecutiveGatewayFailure): { enforcingConsecutiveGatewayFailure: enforcingConsecutiveGatewayFailure },
        '#withEnforcingSuccessRate':: d.fn(help='"The percentage chance that a host will be actually ejected when an outlier status is detected through success rate statistics. This setting can be used to disable ejection or to ramp it up slowly. Defaults to 100."', args=[d.arg(name='enforcingSuccessRate', type=d.T.number)]),
        withEnforcingSuccessRate(enforcingSuccessRate): { enforcingSuccessRate: enforcingSuccessRate },
        '#withInterval':: d.fn(help='"Time interval between ejection sweep analysis. This can result in both new ejections as well as hosts being returned to service. Defaults to 10 seconds. Structure is documented below."', args=[d.arg(name='interval', type=d.T.array)]),
        withInterval(interval): { interval: if std.isArray(v=interval) then interval else [interval] },
        '#withIntervalMixin':: d.fn(help='"Time interval between ejection sweep analysis. This can result in both new ejections as well as hosts being returned to service. Defaults to 10 seconds. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='interval', type=d.T.array)]),
        withIntervalMixin(interval): { interval+: if std.isArray(v=interval) then interval else [interval] },
        '#withMaxEjectionPercent':: d.fn(help='"Maximum percentage of hosts in the load balancing pool for the backend service that can be ejected. Defaults to 10%."', args=[d.arg(name='maxEjectionPercent', type=d.T.number)]),
        withMaxEjectionPercent(maxEjectionPercent): { maxEjectionPercent: maxEjectionPercent },
        '#withSuccessRateMinimumHosts':: d.fn(help='"The number of hosts in a cluster that must have enough request volume to detect success rate outliers. If the number of hosts is less than this setting, outlier detection via success rate statistics is not performed for any host in the cluster. Defaults to 5."', args=[d.arg(name='successRateMinimumHosts', type=d.T.number)]),
        withSuccessRateMinimumHosts(successRateMinimumHosts): { successRateMinimumHosts: successRateMinimumHosts },
        '#withSuccessRateRequestVolume':: d.fn(help='"The minimum number of total requests that must be collected in one interval (as defined by the interval duration above) to include this host in success rate based outlier detection. If the volume is lower than this setting, outlier detection via success rate statistics is not performed for that host. Defaults to 100."', args=[d.arg(name='successRateRequestVolume', type=d.T.number)]),
        withSuccessRateRequestVolume(successRateRequestVolume): { successRateRequestVolume: successRateRequestVolume },
        '#withSuccessRateStdevFactor':: d.fn(help='"This factor is used to determine the ejection threshold for success rate outlier ejection. The ejection threshold is the difference between the mean success rate, and the product of this factor and the standard deviation of the mean success rate: mean - (stdev * success_rate_stdev_factor). This factor is divided by a thousand to get a double. That is, if the desired factor is 1.9, the runtime value should be 1900. Defaults to 1900."', args=[d.arg(name='successRateStdevFactor', type=d.T.number)]),
        withSuccessRateStdevFactor(successRateStdevFactor): { successRateStdevFactor: successRateStdevFactor },
      },
      '#securitySettings':: d.obj(help='"The security settings that apply to this backend service. This field is applicable to either a regional backend service with the service_protocol set to HTTP, HTTPS, or HTTP2, and load_balancing_scheme set to INTERNAL_MANAGED; or a global backend service with the load_balancing_scheme set to INTERNAL_SELF_MANAGED. Structure is documented below."'),
      securitySettings: {
        '#withClientTlsPolicy':: d.fn(help='"ClientTlsPolicy is a resource that specifies how a client should authenticate connections to backends of a service. This resource itself does not affect configuration unless it is attached to a backend service resource."', args=[d.arg(name='clientTlsPolicy', type=d.T.string)]),
        withClientTlsPolicy(clientTlsPolicy): { clientTlsPolicy: clientTlsPolicy },
        '#withSubjectAltNames':: d.fn(help="\"A list of alternate names to verify the subject identity in the certificate. If specified, the client will verify that the server certificate's subject alt name matches one of the specified values.\"", args=[d.arg(name='subjectAltNames', type=d.T.array)]),
        withSubjectAltNames(subjectAltNames): { subjectAltNames: if std.isArray(v=subjectAltNames) then subjectAltNames else [subjectAltNames] },
        '#withSubjectAltNamesMixin':: d.fn(help="\"A list of alternate names to verify the subject identity in the certificate. If specified, the client will verify that the server certificate's subject alt name matches one of the specified values.\"\n\n**Note:** This function appends passed data to existing values", args=[d.arg(name='subjectAltNames', type=d.T.array)]),
        withSubjectAltNamesMixin(subjectAltNames): { subjectAltNames+: if std.isArray(v=subjectAltNames) then subjectAltNames else [subjectAltNames] },
      },
      '#withAffinityCookieTtlSec':: d.fn(help='"Lifetime of cookies in seconds if session_affinity is GENERATED_COOKIE. If set to 0, the cookie is non-persistent and lasts only until the end of the browser session (or equivalent). The maximum allowed value for TTL is one day. When the load balancing scheme is INTERNAL, this field is not used."', args=[d.arg(name='affinityCookieTtlSec', type=d.T.number)]),
      withAffinityCookieTtlSec(affinityCookieTtlSec): { spec+: { forProvider+: { affinityCookieTtlSec: affinityCookieTtlSec } } },
