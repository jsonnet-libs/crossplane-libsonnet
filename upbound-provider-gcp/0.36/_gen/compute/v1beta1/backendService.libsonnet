        withMaxRetries(maxRetries): { maxRetries: maxRetries },
      },
      '#consistentHash':: d.obj(help='"Consistent Hash-based load balancing can be used to provide soft session affinity based on HTTP headers, cookies or other properties. This load balancing policy is applicable only for HTTP connections. The affinity to a particular destination host will be lost when one or more hosts are added/removed from the destination service. This field specifies parameters that control consistent hashing. This field only applies if the load_balancing_scheme is set to INTERNAL_SELF_MANAGED. This field is only applicable when locality_lb_policy is set to MAGLEV or RING_HASH. Structure is documented below."'),
      consistentHash: {
        '#httpCookie':: d.obj(help='"Hash is based on HTTP Cookie. This field describes a HTTP cookie that will be used as the hash key for the consistent hash load balancer. If the cookie is not present, it will be generated. This field is applicable if the sessionAffinity is set to HTTP_COOKIE. Structure is documented below."'),
        httpCookie: {
          '#ttl':: d.obj(help='"The TTL (in seconds) for which to cache responses with the corresponding status code. The maximum allowed value is 1800s (30 minutes), noting that infrequently accessed objects may be evicted from the cache before the defined TTL."'),
          ttl: {
            '#withNanos':: d.fn(help="\"Span of time that's a fraction of a second at nanosecond resolution. Durations less than one second are represented with a 0 seconds field and a positive nanos field. Must be from 0 to 999,999,999 inclusive.\"", args=[d.arg(name='nanos', type=d.T.number)]),
            withNanos(nanos): { nanos: nanos },
            '#withSeconds':: d.fn(help='"Span of time at a resolution of a second. Must be from 0 to 315,576,000,000 inclusive."', args=[d.arg(name='seconds', type=d.T.number)]),
            withSeconds(seconds): { seconds: seconds },
          },
          '#withName':: d.fn(help='"The name of a locality load balancer policy to be used. The value should be one of the predefined ones as supported by localityLbPolicy, although at the moment only ROUND_ROBIN is supported. This field should only be populated when the customPolicy field is not used. Note that specifying the same policy more than once for a backend is not a valid configuration and will be rejected. The possible values are:"', args=[d.arg(name='name', type=d.T.string)]),
          withName(name): { name: name },
          '#withPath':: d.fn(help='"Path to set for the cookie."', args=[d.arg(name='path', type=d.T.string)]),
          withPath(path): { path: path },
          '#withTtl':: d.fn(help='"The TTL (in seconds) for which to cache responses with the corresponding status code. The maximum allowed value is 1800s (30 minutes), noting that infrequently accessed objects may be evicted from the cache before the defined TTL."', args=[d.arg(name='ttl', type=d.T.array)]),
          withTtl(ttl): { ttl: if std.isArray(v=ttl) then ttl else [ttl] },
          '#withTtlMixin':: d.fn(help='"The TTL (in seconds) for which to cache responses with the corresponding status code. The maximum allowed value is 1800s (30 minutes), noting that infrequently accessed objects may be evicted from the cache before the defined TTL."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='ttl', type=d.T.array)]),
          withTtlMixin(ttl): { ttl+: if std.isArray(v=ttl) then ttl else [ttl] },
        },
        '#withHttpCookie':: d.fn(help='"Hash is based on HTTP Cookie. This field describes a HTTP cookie that will be used as the hash key for the consistent hash load balancer. If the cookie is not present, it will be generated. This field is applicable if the sessionAffinity is set to HTTP_COOKIE. Structure is documented below."', args=[d.arg(name='httpCookie', type=d.T.array)]),
        withHttpCookie(httpCookie): { httpCookie: if std.isArray(v=httpCookie) then httpCookie else [httpCookie] },
        '#withHttpCookieMixin':: d.fn(help='"Hash is based on HTTP Cookie. This field describes a HTTP cookie that will be used as the hash key for the consistent hash load balancer. If the cookie is not present, it will be generated. This field is applicable if the sessionAffinity is set to HTTP_COOKIE. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='httpCookie', type=d.T.array)]),
        withHttpCookieMixin(httpCookie): { httpCookie+: if std.isArray(v=httpCookie) then httpCookie else [httpCookie] },
        '#withHttpHeaderName':: d.fn(help='"The hash based on the value of the specified header field. This field is applicable if the sessionAffinity is set to HEADER_FIELD."', args=[d.arg(name='httpHeaderName', type=d.T.string)]),
        withHttpHeaderName(httpHeaderName): { httpHeaderName: httpHeaderName },
        '#withMinimumRingSize':: d.fn(help='"The minimum number of virtual nodes to use for the hash ring. Larger ring sizes result in more granular load distributions. If the number of hosts in the load balancing pool is larger than the ring size, each host will be assigned a single virtual node. Defaults to 1024."', args=[d.arg(name='minimumRingSize', type=d.T.number)]),
        withMinimumRingSize(minimumRingSize): { minimumRingSize: minimumRingSize },
      },
      '#iap':: d.obj(help='"Settings for enabling Cloud Identity Aware Proxy Structure is documented below."'),
