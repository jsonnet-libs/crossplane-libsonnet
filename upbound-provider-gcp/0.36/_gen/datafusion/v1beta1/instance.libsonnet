      '#withEventPublishConfigMixin':: d.fn(help='"Option to enable and pass metadata for event publishing. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='eventPublishConfig', type=d.T.array)]),
      withEventPublishConfigMixin(eventPublishConfig): { spec+: { forProvider+: { eventPublishConfig+: if std.isArray(v=eventPublishConfig) then eventPublishConfig else [eventPublishConfig] } } },
