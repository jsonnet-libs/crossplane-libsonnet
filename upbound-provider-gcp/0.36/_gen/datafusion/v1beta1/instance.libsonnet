      withEnableStackdriverLogging(enableStackdriverLogging): { spec+: { forProvider+: { enableStackdriverLogging: enableStackdriverLogging } } },
      '#withEnableStackdriverMonitoring':: d.fn(help='"Option to enable Stackdriver Monitoring."', args=[d.arg(name='enableStackdriverMonitoring', type=d.T.boolean)]),
