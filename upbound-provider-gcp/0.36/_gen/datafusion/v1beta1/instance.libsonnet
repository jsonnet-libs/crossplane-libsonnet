      withCryptoKeyConfig(cryptoKeyConfig): { spec+: { forProvider+: { cryptoKeyConfig: if std.isArray(v=cryptoKeyConfig) then cryptoKeyConfig else [cryptoKeyConfig] } } },
      '#withCryptoKeyConfigMixin':: d.fn(help='"The crypto key configuration. This field is used by the Customer-Managed Encryption Keys (CMEK) feature. Structure is documented below."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='cryptoKeyConfig', type=d.T.array)]),
      withCryptoKeyConfigMixin(cryptoKeyConfig): { spec+: { forProvider+: { cryptoKeyConfig+: if std.isArray(v=cryptoKeyConfig) then cryptoKeyConfig else [cryptoKeyConfig] } } },
      '#withDataprocServiceAccount':: d.fn(help='"User-managed service account to set on Dataproc when Cloud Data Fusion creates Dataproc to run data processing pipelines."', args=[d.arg(name='dataprocServiceAccount', type=d.T.string)]),
      withDataprocServiceAccount(dataprocServiceAccount): { spec+: { forProvider+: { dataprocServiceAccount: dataprocServiceAccount } } },
      '#withDescription':: d.fn(help='"An optional description of the instance."', args=[d.arg(name='description', type=d.T.string)]),
