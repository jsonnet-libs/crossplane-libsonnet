      withNetworkConfigMixin(networkConfig): { spec+: { forProvider+: { networkConfig+: if std.isArray(v=networkConfig) then networkConfig else [networkConfig] } } },
      '#withOptions':: d.fn(help='"Map of additional options used to configure the behavior of Data Fusion instance."', args=[d.arg(name='options', type=d.T.object)]),
