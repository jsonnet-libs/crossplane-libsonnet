      '#withBacktrackWindow':: d.fn(help='"The target backtrack window, in seconds. Only available for aurora and aurora-mysql engines currently. To disable backtracking, set this value to 0. Defaults to 0. Must be between 0 and 259200 (72 hours)"', args=[d.arg(name='backtrackWindow', type=d.T.number)]),
      withBacktrackWindow(backtrackWindow): { spec+: { forProvider+: { backtrackWindow: backtrackWindow } } },
      '#withBackupRetentionPeriod':: d.fn(help='"The days to retain backups for. Default 1"', args=[d.arg(name='backupRetentionPeriod', type=d.T.number)]),
      withBackupRetentionPeriod(backupRetentionPeriod): { spec+: { forProvider+: { backupRetentionPeriod: backupRetentionPeriod } } },
