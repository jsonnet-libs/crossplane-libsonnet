      withGlobalClusterIdentifier(globalClusterIdentifier): { spec+: { forProvider+: { globalClusterIdentifier: globalClusterIdentifier } } },
      '#withIamDatabaseAuthenticationEnabled':: d.fn(help='"Specifies whether or not mappings of AWS Identity and Access Management (IAM) accounts to database accounts is enabled. Please see AWS Documentation for availability and limitations."', args=[d.arg(name='iamDatabaseAuthenticationEnabled', type=d.T.boolean)]),
      withIamDatabaseAuthenticationEnabled(iamDatabaseAuthenticationEnabled): { spec+: { forProvider+: { iamDatabaseAuthenticationEnabled: iamDatabaseAuthenticationEnabled } } },
      '#withIops':: d.fn(help='"The amount of Provisioned IOPS (input/output operations per second) to be initially allocated for each DB instance in the Multi-AZ DB cluster. For information about valid Iops values, see Amazon RDS Provisioned IOPS storage to improve performance in the Amazon RDS User Guide. (This setting is required to create a Multi-AZ DB cluster). Must be a multiple between .5 and 50 of the storage amount for the DB cluster."', args=[d.arg(name='iops', type=d.T.number)]),
      withIops(iops): { spec+: { forProvider+: { iops: iops } } },
      '#withKmsKeyId':: d.fn(help='"The ARN for the KMS encryption key. When specifying kms_key_id, storage_encrypted needs to be set to true."', args=[d.arg(name='kmsKeyId', type=d.T.string)]),
      withKmsKeyId(kmsKeyId): { spec+: { forProvider+: { kmsKeyId: kmsKeyId } } },
