      '#withClusterMembersMixin':: d.fn(help='"– List of RDS Instances that are a part of this cluster"\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='clusterMembers', type=d.T.array)]),
      withClusterMembersMixin(clusterMembers): { spec+: { forProvider+: { clusterMembers+: if std.isArray(v=clusterMembers) then clusterMembers else [clusterMembers] } } },
      '#withCopyTagsToSnapshot':: d.fn(help='"–  Copy all Cluster tags to snapshots. Default is false."', args=[d.arg(name='copyTagsToSnapshot', type=d.T.boolean)]),
      withCopyTagsToSnapshot(copyTagsToSnapshot): { spec+: { forProvider+: { copyTagsToSnapshot: copyTagsToSnapshot } } },
      '#withDatabaseName':: d.fn(help='"Name for an automatically created database on cluster creation. There are different naming restrictions per database engine: RDS Naming Constraints"', args=[d.arg(name='databaseName', type=d.T.string)]),
      withDatabaseName(databaseName): { spec+: { forProvider+: { databaseName: databaseName } } },
      '#withDbClusterInstanceClass':: d.fn(help='"The compute and memory capacity of each DB instance in the Multi-AZ DB cluster, for example db.m6g.xlarge. Not all DB instance classes are available in all AWS Regions, or for all database engines. For the full list of DB instance classes and availability for your engine, see DB instance class in the Amazon RDS User Guide. (This setting is required to create a Multi-AZ DB cluster)."', args=[d.arg(name='dbClusterInstanceClass', type=d.T.string)]),
      withDbClusterInstanceClass(dbClusterInstanceClass): { spec+: { forProvider+: { dbClusterInstanceClass: dbClusterInstanceClass } } },
      '#withDbClusterParameterGroupName':: d.fn(help='"A cluster parameter group to associate with the cluster."', args=[d.arg(name='dbClusterParameterGroupName', type=d.T.string)]),
