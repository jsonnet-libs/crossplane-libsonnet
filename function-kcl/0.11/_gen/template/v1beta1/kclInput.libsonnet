      '#withArgumentsMixin':: d.fn(help='"Arguments is the list of top level dynamic arguments for the kcl option function, e.g., env=\\"prod\\\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='arguments', type=d.T.array)]),
