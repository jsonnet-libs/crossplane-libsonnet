      '#withOverridesMixin':: d.fn(help='"Overrides is the list of override paths and values, e.g., app.image=\\"v2\\\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='overrides', type=d.T.array)]),
      withOverridesMixin(overrides): { spec+: { config+: { overrides+: if std.isArray(v=overrides) then overrides else [overrides] } } },
      '#withPathSelectors':: d.fn(help='"PathSelectors is the list of path selectors to select output result, e.g., a.b.c"', args=[d.arg(name='pathSelectors', type=d.T.array)]),
      withPathSelectors(pathSelectors): { spec+: { config+: { pathSelectors: if std.isArray(v=pathSelectors) then pathSelectors else [pathSelectors] } } },
      '#withPathSelectorsMixin':: d.fn(help='"PathSelectors is the list of path selectors to select output result, e.g., a.b.c"\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='pathSelectors', type=d.T.array)]),
      withPathSelectorsMixin(pathSelectors): { spec+: { config+: { pathSelectors+: if std.isArray(v=pathSelectors) then pathSelectors else [pathSelectors] } } },
      '#withSettings':: d.fn(help='"Settings is the list of kcl setting files including all of the CLI config."', args=[d.arg(name='settings', type=d.T.array)]),
      withSettings(settings): { spec+: { config+: { settings: if std.isArray(v=settings) then settings else [settings] } } },
      '#withSettingsMixin':: d.fn(help='"Settings is the list of kcl setting files including all of the CLI config."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='settings', type=d.T.array)]),
      withSettingsMixin(settings): { spec+: { config+: { settings+: if std.isArray(v=settings) then settings else [settings] } } },
      '#withShowHidden':: d.fn(help='"ShowHidden denotes output the hidden attribute in the result."', args=[d.arg(name='showHidden', type=d.T.boolean)]),
      withShowHidden(showHidden): { spec+: { config+: { showHidden: showHidden } } },
      '#withSortKeys':: d.fn(help='"SortKeys denotes sorting the output result keys, e.g., `{b = 1, a = 2} => {a = 2, b = 1}`."', args=[d.arg(name='sortKeys', type=d.T.boolean)]),
      withSortKeys(sortKeys): { spec+: { config+: { sortKeys: sortKeys } } },
      '#withStrictRangeCheck':: d.fn(help='"StrictRangeCheck performs the 32-bit strict numeric range checks on numbers."', args=[d.arg(name='strictRangeCheck', type=d.T.boolean)]),
      withStrictRangeCheck(strictRangeCheck): { spec+: { config+: { strictRangeCheck: strictRangeCheck } } },
      '#withVendor':: d.fn(help='"Vendor denotes running kcl in the vendor mode."', args=[d.arg(name='vendor', type=d.T.boolean)]),
