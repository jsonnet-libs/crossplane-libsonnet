          withOnExitCode(onExitCode): { onExitCode: onExitCode },
          '#withOnReason':: d.fn(help='"Contains a glob pattern to match against the Reason returned for a job. The pattern can be up to 512 characters in length. It can contain letters, numbers, periods (.), colons (:), and white space (including spaces and tabs). It can optionally end with an asterisk (*) so that only the start of the string needs to be an exact match."', args=[d.arg(name='onReason', type=d.T.string)]),
          withOnReason(onReason): { onReason: onReason },
          '#withOnStatusReason':: d.fn(help='"Contains a glob pattern to match against the StatusReason returned for a job. The pattern can be up to 512 characters in length. It can contain letters, numbers, periods (.), colons (:), and white space (including spaces or tabs). It can optionally end with an asterisk (*) so that only the start of the string needs to be an exact match."', args=[d.arg(name='onStatusReason', type=d.T.string)]),
