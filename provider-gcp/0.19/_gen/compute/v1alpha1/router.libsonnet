      withBgpPeers(bgpPeers): { spec+: { forProvider+: { bgpPeers: if std.isArray(v=bgpPeers) then bgpPeers else [bgpPeers] } } },
      '#withBgpPeersMixin':: d.fn(help='"BgpPeers: BGP information that must be configured into the routing stack to establish BGP peering. This information must specify the peer ASN and either the interface name, IP address, or peer IP address. Please refer to RFC4273."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='bgpPeers', type=d.T.array)]),
