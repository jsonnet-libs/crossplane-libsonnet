        '#withAdvertiseMode':: d.fn(help='"AdvertiseMode: User-specified flag to indicate which mode to use for advertisement. The options are DEFAULT or CUSTOM. \\n Possible values:   \\"CUSTOM\\"   \\"DEFAULT\\', args=[d.arg(name='advertiseMode', type=d.T.string)]),
