        '#withAdvertisedGroups':: d.fn(help='"AdvertisedGroups: User-specified list of prefix groups to advertise in custom mode. This field can only be populated if advertise_mode is CUSTOM and is advertised to all peers of the router. These groups will be advertised in addition to any specified prefixes. Leave this field blank to advertise no custom groups. \\n Possible values:   \\"ALL_SUBNETS\\', args=[d.arg(name='advertisedGroups', type=d.T.array)]),
        withAdvertisedGroups(advertisedGroups): { spec+: { forProvider+: { bgp+: { advertisedGroups: if std.isArray(v=advertisedGroups) then advertisedGroups else [advertisedGroups] } } } },
        '#withAdvertisedGroupsMixin':: d.fn(help='"AdvertisedGroups: User-specified list of prefix groups to advertise in custom mode. This field can only be populated if advertise_mode is CUSTOM and is advertised to all peers of the router. These groups will be advertised in addition to any specified prefixes. Leave this field blank to advertise no custom groups. \\n Possible values:   \\"ALL_SUBNETS\\\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='advertisedGroups', type=d.T.array)]),
        withAdvertisedGroupsMixin(advertisedGroups): { spec+: { forProvider+: { bgp+: { advertisedGroups+: if std.isArray(v=advertisedGroups) then advertisedGroups else [advertisedGroups] } } } },
        '#withAdvertisedIpRanges':: d.fn(help='"AdvertisedIpRanges: User-specified list of individual IP ranges to advertise in custom mode. This field can only be populated if advertise_mode is CUSTOM and is advertised to all peers of the router. These IP ranges will be advertised in addition to any specified groups. Leave this field blank to advertise no custom IP ranges."', args=[d.arg(name='advertisedIpRanges', type=d.T.array)]),
        withAdvertisedIpRanges(advertisedIpRanges): { spec+: { forProvider+: { bgp+: { advertisedIpRanges: if std.isArray(v=advertisedIpRanges) then advertisedIpRanges else [advertisedIpRanges] } } } },
        '#withAdvertisedIpRangesMixin':: d.fn(help='"AdvertisedIpRanges: User-specified list of individual IP ranges to advertise in custom mode. This field can only be populated if advertise_mode is CUSTOM and is advertised to all peers of the router. These IP ranges will be advertised in addition to any specified groups. Leave this field blank to advertise no custom IP ranges."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='advertisedIpRanges', type=d.T.array)]),
        withAdvertisedIpRangesMixin(advertisedIpRanges): { spec+: { forProvider+: { bgp+: { advertisedIpRanges+: if std.isArray(v=advertisedIpRanges) then advertisedIpRanges else [advertisedIpRanges] } } } },
        '#withAsn':: d.fn(help='"Asn: Local BGP Autonomous System Number (ASN). Must be an RFC6996 private ASN, either 16-bit or 32-bit. The value will be fixed for this router resource. All VPN tunnels that link to this router will have the same local ASN."', args=[d.arg(name='asn', type=d.T.integer)]),
        withAsn(asn): { spec+: { forProvider+: { bgp+: { asn: asn } } } },
