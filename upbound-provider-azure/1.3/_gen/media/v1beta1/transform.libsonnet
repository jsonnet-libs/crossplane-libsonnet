          withExperimentalOptions(experimentalOptions): { experimentalOptions: experimentalOptions },
          '#withExperimentalOptionsMixin':: d.fn(help='"Dictionary containing key value pairs for parameters not exposed in the preset itself."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='experimentalOptions', type=d.T.object)]),
          withExperimentalOptionsMixin(experimentalOptions): { experimentalOptions+: experimentalOptions },
          '#withFaceRedactorMode':: d.fn(help='"This mode provides the ability to choose between the following settings: 1) Analyze - For detection only. This mode generates a metadata JSON file marking appearances of faces throughout the video. Where possible, appearances of the same person are assigned the same ID. 2) Combined - Additionally redacts(blurs) detected faces. 3) Redact - This enables a 2-pass process, allowing for selective redaction of a subset of detected faces. It takes in the metadata file from a prior analyze pass, along with the source video, and a user-selected subset of IDs that require redaction. Default to Analyze."', args=[d.arg(name='faceRedactorMode', type=d.T.string)]),
          withFaceRedactorMode(faceRedactorMode): { faceRedactorMode: faceRedactorMode },
        },
        '#videoAnalyzerPreset':: d.obj(help='"A video_analyzer_preset block as defined below."'),
        videoAnalyzerPreset: {
          '#withAudioAnalysisMode':: d.fn(help='"Possible values are Basic or Standard. Determines the set of audio analysis operations to be performed. Default to Standard."', args=[d.arg(name='audioAnalysisMode', type=d.T.string)]),
          withAudioAnalysisMode(audioAnalysisMode): { audioAnalysisMode: audioAnalysisMode },
          '#withAudioLanguage':: d.fn(help="\"The language for the audio payload in the input using the BCP-47 format of 'language tag-region' (e.g: 'en-US'). If you know the language of your content, it is recommended that you specify it. The language must be specified explicitly for AudioAnalysisMode:Basic, since automatic language detection is not included in basic mode. If the language isn't specified, automatic language detection will choose the first language detected and process with the selected language for the duration of the file. It does not currently support dynamically switching between languages after the first language is detected. The automatic detection works best with audio recordings with clearly discernible speech. If automatic detection fails to find the language, transcription would fall back to en-US. The list of supported languages is available here: https://go.microsoft.com/fwlink/?linkid=2109463.\"", args=[d.arg(name='audioLanguage', type=d.T.string)]),
          withAudioLanguage(audioLanguage): { audioLanguage: audioLanguage },
