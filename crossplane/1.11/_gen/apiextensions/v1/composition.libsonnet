          '#withMapMixin':: d.fn(help='"Map uses the input as a key in the given map and returns the value."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='map', type=d.T.object)]),
          withMapMixin(map): { map+: map },
          '#withType':: d.fn(help='"Type of the transform to be run."', args=[d.arg(name='type', type=d.T.string)]),
